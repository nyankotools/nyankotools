---
import type { Locale } from '../data/tools';
import { useTranslations } from '../i18n/ui';

interface Props {
  slug: string;
  locale: Locale;
  class?: string;
}

const { slug, locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);
---

<!-- 星アイコンは子要素を持たず CSS の mask で描く（global.css の .fav-toggle）。ツール数ぶん繰り返されるため、DOMとHTMLを小さく保つ -->
<button
  type="button"
  data-favorite-toggle={slug}
  aria-pressed="false"
  aria-label={t('favorite.add')}
  title={t('favorite.add')}
  class:list={['fav-toggle print:hidden', className]}
></button>
