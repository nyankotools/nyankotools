---
import type { Locale } from '../data/tools';
import { useTranslations } from '../i18n/ui';

interface Props {
  slug: string;
  locale: Locale;
  class?: string;
}

const { slug, locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

const iconClass = 'h-5 w-5';
---

<button
  type="button"
  data-favorite-toggle={slug}
  aria-pressed="false"
  aria-label={t('favorite.add')}
  title={t('favorite.add')}
  data-label-add={t('favorite.add')}
  data-label-remove={t('favorite.remove')}
  class:list={['print:hidden', className]}
>
  <svg
    data-star-outline
    class={iconClass}
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
    ></path>
  </svg>
  <svg
    data-star-filled
    class={`hidden text-yellow-500 dark:text-yellow-400 ${iconClass}`}
    fill="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.635 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.03-1.96 1.425L12 18.354 7.373 21.18c-.996.605-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.886-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006Z"
      clip-rule="evenodd"
    ></path>
  </svg>
</button>
