---
import Layout from '../layouts/Layout.astro';
import { shortcuts } from '../i18n/shortcuts';
import type { Locale } from '../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = shortcuts[locale];

/** 「Ctrl/⌘+K」→ [['Ctrl','⌘'],['K']]（`+` で同時押し、`/` で択一） */
const parseKeys = (keys: string) =>
  keys.split('+').map((part) => part.split('/'));
---

<Layout title={c.title} description={c.description}>
  <h1 class="mb-2 text-2xl font-bold">{c.h1}</h1>
  <p class="mb-8 text-gray-600 dark:text-gray-400">{c.intro}</p>

  <div class="max-w-2xl space-y-8 text-gray-800 dark:text-gray-300">
    {c.groups.map((group) => (
      <section>
        <h2 class="mb-1 text-lg font-semibold">{group.heading}</h2>
        {group.note && (
          <p class="mb-2 text-sm text-gray-600 dark:text-gray-400">
            {group.note}
          </p>
        )}
        <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 dark:divide-gray-800 dark:border-gray-800">
          {group.rows.map((row) => (
            <li class="flex flex-col gap-1 px-3 py-2 sm:flex-row sm:items-center sm:gap-4">
              <span class="flex shrink-0 flex-wrap items-center gap-1 sm:w-56">
                {parseKeys(row.keys).map((alts, i) => (
                  <>
                    {i > 0 && (
                      <span aria-hidden="true" class="text-gray-400">
                        +
                      </span>
                    )}
                    {alts.map((key, j) => (
                      <>
                        {j > 0 && (
                          <span class="text-xs text-gray-500 dark:text-gray-400">
                            /
                          </span>
                        )}
                        <kbd class="rounded border border-gray-300 bg-gray-100 px-1.5 py-0.5 font-mono text-xs dark:border-gray-600 dark:bg-gray-800">
                          {key}
                        </kbd>
                      </>
                    ))}
                  </>
                ))}
              </span>
              <span>{row.action}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section>
      <h2 class="mb-2 text-lg font-semibold">{c.notesHeading}</h2>
      <ul class="list-disc space-y-1 pl-5 text-sm">
        {c.footnotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
