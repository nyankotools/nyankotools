---
import { resolveLocale, useTranslations } from '../i18n/ui';

interface Props {
  id?: string;
}

const { id } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));
---

<!--
  ライト → ダーク → システム を順に切り替える1ボタン。
  どのアイコンを見せるか・ラベルは initTheme（layout-nav.ts）が現在のテーマに合わせて更新する。
-->
<button
  id={id}
  type="button"
  data-theme-cycle
  data-label-light={t('nav.theme.light')}
  data-label-dark={t('nav.theme.dark')}
  data-label-system={t('nav.theme.system')}
  data-label-prefix={t('nav.theme')}
  aria-label={t('nav.theme')}
  class="flex h-10 w-10 items-center justify-center rounded text-gray-700 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-blue-600 dark:text-gray-300 dark:hover:bg-gray-800"
>
  <svg
    data-theme-icon="light"
    xmlns="http://www.w3.org/2000/svg"
    class="hidden h-5 w-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
    ></path>
  </svg>
  <svg
    data-theme-icon="dark"
    xmlns="http://www.w3.org/2000/svg"
    class="hidden h-5 w-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
    ></path>
  </svg>
  <svg
    data-theme-icon="system"
    xmlns="http://www.w3.org/2000/svg"
    class="h-5 w-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z"
    ></path>
  </svg>
</button>
