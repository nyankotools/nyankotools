---
import { getSortedUpdates } from '../data/updates';
import { getLocalizedTools, type Locale } from '../data/tools';
import { localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entries = getSortedUpdates();
const toolBySlug = new Map(
  getLocalizedTools(locale).map((tool) => [tool.slug, tool]),
);
const toolBasePath = localePath(locale, '/tools/');
const dateFormatter = new Intl.DateTimeFormat(
  locale === 'en' ? 'en-US' : 'ja-JP',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
);

function formatDate(date: string): string {
  const [year, month, day] = date.split('-').map(Number);
  return dateFormatter.format(new Date(Date.UTC(year, month - 1, day)));
}
---

<ol class="space-y-8">
  {entries.map((entry) => (
    <li class="border-b border-gray-200 pb-8 last:border-b-0 last:pb-0 dark:border-gray-800">
      <time
        datetime={entry.date}
        class="block text-sm font-semibold text-gray-500 dark:text-gray-400"
      >
        {formatDate(entry.date)}
      </time>
      <p class="mt-1 text-gray-800 dark:text-gray-300">
        {entry.translations[locale].summary}
      </p>
      {entry.toolSlugs && entry.toolSlugs.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {entry.toolSlugs.map((slug) => {
            const tool = toolBySlug.get(slug);
            return (
              tool && (
                <li>
                  <a
                    href={`${toolBasePath}${slug}/`}
                    class="inline-flex min-h-11 items-center rounded-full border border-gray-300 px-3 text-xs text-gray-700 hover:border-blue-700 hover:text-blue-700 dark:border-gray-700 dark:text-gray-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
                  >
                    {tool.name}
                  </a>
                </li>
              )
            );
          })}
        </ul>
      )}
    </li>
  ))}
</ol>
