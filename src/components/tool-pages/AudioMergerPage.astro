---
import ToolShell from '../ToolShell.astro';
import { audioMergerContent } from '../../i18n/tools/audio-merger';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = audioMergerContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="am-file-input" class="ui-label">
      {t.dropLabel}
    </label>
    <div id="am-dropzone" class="ui-dropzone">
      <input
        id="am-file-input"
        type="file"
        multiple
        accept="audio/*,video/mp4,video/webm,.mp3,.wav,.m4a,.aac,.ogg,.opus,.flac,.aif,.aiff"
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="am-error"
      role="alert"
      hidden
      data-unsupported={t.errorUnsupportedFile}
      data-decode-template={t.errorDecodeTemplate}
      data-too-large-template={t.errorFileTooLargeTemplate}
      data-too-many-template={t.errorTooManyTemplate}
      data-total-too-long={t.errorTotalTooLong}
      data-gap-invalid={t.errorGapInvalid}
      data-gap-out-of-range={t.errorGapOutOfRange}
      data-crossfade-invalid={t.errorCrossfadeInvalid}
      data-crossfade-out-of-range={t.errorCrossfadeOutOfRange}
      data-fade-in-invalid={t.errorFadeInInvalid}
      data-fade-in-out-of-range={t.errorFadeInOutOfRange}
      data-fade-out-invalid={t.errorFadeOutInvalid}
      data-fade-out-out-of-range={t.errorFadeOutOutOfRange}
      data-failed={t.errorFailed}
      class="ui-error mt-2"
    ></p>
  </div>

  <div class="mt-4">
    <h2 class="mb-2 text-lg font-bold">{t.listHeading}</h2>
    <p id="am-empty" class="text-sm text-gray-500 dark:text-gray-400">
      {t.listEmpty}
    </p>
    <ol
      id="am-list"
      hidden
      data-info-template={t.itemInfoTemplate}
      data-up-aria={t.moveUpAria}
      data-down-aria={t.moveDownAria}
      data-remove-aria={t.removeAria}
      data-up-label={t.moveUpButton}
      data-down-label={t.moveDownButton}
      data-remove-label={t.removeButton}
      class="space-y-2"
    ></ol>
    <p
      id="am-summary"
      data-template={t.summaryTemplate}
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
    ></p>
  </div>

  <div class="mt-4">
    <label for="am-transition" class="ui-label">
      {t.transitionLabel}
    </label>
    <select
      id="am-transition"
      class="ui-input h-11 w-full px-3 dark:bg-gray-900"
    >
      <option value="gap" selected>
        {t.transitionGap}
      </option>
      <option value="crossfade">{t.transitionCrossfade}</option>
    </select>
  </div>

  <div class="mt-4 flex flex-wrap items-start gap-4">
    <div class="min-w-48 flex-1">
      <label for="am-gap" class="ui-label">
        {t.gapLabel}
      </label>
      <input
        id="am-gap"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value="0"
        aria-describedby="am-gap-hint"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      />
      <p id="am-gap-hint" class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        {t.gapHint}
      </p>
    </div>
    <div class="min-w-48 flex-1">
      <label for="am-crossfade" class="ui-label">
        {t.crossfadeLabel}
      </label>
      <input
        id="am-crossfade"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value="2"
        aria-describedby="am-crossfade-hint"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      />
      <p
        id="am-crossfade-hint"
        class="mt-1 text-xs text-gray-500 dark:text-gray-400"
      >
        {t.crossfadeHint}
      </p>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-start gap-4">
    <div class="min-w-48 flex-1">
      <label for="am-fade-in" class="ui-label">
        {t.fadeInLabel}
      </label>
      <input
        id="am-fade-in"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value="0"
        aria-describedby="am-fade-hint"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      />
    </div>
    <div class="min-w-48 flex-1">
      <label for="am-fade-out" class="ui-label">
        {t.fadeOutLabel}
      </label>
      <input
        id="am-fade-out"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value="0"
        aria-describedby="am-fade-hint"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      />
    </div>
  </div>
  <p id="am-fade-hint" class="mt-1 text-xs text-gray-500 dark:text-gray-400">
    {t.fadeHint}
  </p>

  <div class="mt-4 flex flex-wrap gap-3">
    <button
      id="am-merge-button"
      type="button"
      disabled
      class="ui-btn-primary disabled:cursor-not-allowed disabled:opacity-50"
    >
      {t.mergeButton}
    </button>
    <button
      id="am-clear-button"
      type="button"
      disabled
      class="ui-btn disabled:cursor-not-allowed disabled:opacity-50"
    >
      {t.clearButton}
    </button>
  </div>

  <p
    id="am-status"
    role="status"
    hidden
    data-loading={t.loading}
    data-processing={t.processing}
    class="mt-3 text-sm text-gray-700 dark:text-gray-300"
  ></p>

  <div id="am-results-section" hidden class="mt-6">
    <h2 class="mb-2 text-lg font-bold">{t.resultsHeading}</h2>
    <audio id="am-result-audio" controls class="w-full"></audio>
    <p
      id="am-result-info"
      data-template={t.resultInfoTemplate}
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
    ></p>
    <button id="am-download-button" type="button" class="ui-btn-primary mt-3">
      {t.downloadButton}
    </button>
  </div>
</ToolShell>

<script>
  import { enableFileDrop } from '../../lib/file-drop';
  import { downloadBlob } from '../../lib/download';
  import {
    MAX_CLIPS,
    MAX_CROSSFADE_SECONDS,
    MAX_FADE_SECONDS,
    MAX_FILE_SIZE,
    MAX_GAP_SECONDS,
    MAX_TOTAL_SECONDS,
    buildOutputFileName,
    encodeWavBlob,
    estimateDuration,
    formatDuration,
    formatFileSize,
    isAcceptedAudioFile,
    mergeClips,
    moveItem,
    parseSeconds,
    removeItem,
    type MergeOptions,
    type ParseResult,
    type Transition,
  } from '../../lib/tools/audio-merger';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const dropzone = $('am-dropzone');
  const fileInput = $<HTMLInputElement>('am-file-input');
  const errorEl = $('am-error');
  const emptyEl = $('am-empty');
  const listEl = $('am-list');
  const summaryEl = $('am-summary');
  const transitionSelect = $<HTMLSelectElement>('am-transition');
  const gapInput = $<HTMLInputElement>('am-gap');
  const crossfadeInput = $<HTMLInputElement>('am-crossfade');
  const fadeInInput = $<HTMLInputElement>('am-fade-in');
  const fadeOutInput = $<HTMLInputElement>('am-fade-out');
  const mergeButton = $<HTMLButtonElement>('am-merge-button');
  const clearButton = $<HTMLButtonElement>('am-clear-button');
  const statusEl = $('am-status');
  const resultsSection = $('am-results-section');
  const resultAudio = $<HTMLAudioElement>('am-result-audio');
  const resultInfoEl = $('am-result-info');
  const downloadButton = $<HTMLButtonElement>('am-download-button');

  /** ブラウザのデコード時に揃えるサンプルレート（異なるレートのファイルはここへ変換される） */
  const TARGET_RATE = 48000;

  interface Item {
    name: string;
    size: number;
    channels: Float32Array[];
    sampleRate: number;
    duration: number;
  }

  let items: Item[] = [];
  let resultBlob: Blob | null = null;
  let resultName = '';
  let resultUrl: string | null = null;
  let generation = 0;
  let busy: 'loading' | 'processing' | null = null;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function revokeResult() {
    if (resultUrl) URL.revokeObjectURL(resultUrl);
    resultUrl = null;
    resultBlob = null;
    resultAudio.pause();
    resultAudio.removeAttribute('src');
    resultAudio.load();
    resultsSection.hidden = true;
    resultInfoEl.textContent = '';
  }

  function lenient(input: HTMLInputElement, max: number): number {
    const r = parseSeconds(input.value, max);
    return r.ok ? r.value : 0;
  }

  /** 画面の値から（不正値は0として）見積もり用の設定を作る */
  function previewOptions(): MergeOptions {
    return {
      transition: transitionSelect.value === 'crossfade' ? 'crossfade' : 'gap',
      gapSeconds: lenient(gapInput, MAX_GAP_SECONDS),
      crossfadeSeconds: lenient(crossfadeInput, MAX_CROSSFADE_SECONDS),
      fadeInSeconds: 0,
      fadeOutSeconds: 0,
    };
  }

  function renderList() {
    listEl.textContent = '';
    const ds = listEl.dataset;
    items.forEach((item, index) => {
      const li = document.createElement('li');
      li.className =
        'flex flex-wrap items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 dark:border-gray-700';

      const text = document.createElement('div');
      text.className = 'min-w-0 flex-1';
      const nameEl = document.createElement('p');
      nameEl.className = 'truncate text-sm font-medium';
      nameEl.textContent = `${index + 1}. ${item.name}`;
      const infoEl = document.createElement('p');
      infoEl.className = 'text-xs text-gray-500 dark:text-gray-400';
      infoEl.textContent = (ds.infoTemplate ?? '')
        .replace('{duration}', formatDuration(item.duration))
        .replace('{channels}', String(item.channels.length));
      text.append(nameEl, infoEl);

      const makeButton = (
        action: string,
        label: string,
        aria: string,
        disabled: boolean,
      ) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className =
          'ui-btn h-9 px-3 text-sm disabled:cursor-not-allowed disabled:opacity-50';
        b.textContent = label;
        b.dataset.action = action;
        b.dataset.index = String(index);
        b.setAttribute('aria-label', aria.replace('{name}', item.name));
        b.disabled = disabled || busy !== null;
        return b;
      };
      const actions = document.createElement('div');
      actions.className = 'flex gap-2';
      actions.append(
        makeButton('up', ds.upLabel ?? '', ds.upAria ?? '', index === 0),
        makeButton(
          'down',
          ds.downLabel ?? '',
          ds.downAria ?? '',
          index === items.length - 1,
        ),
        makeButton('remove', ds.removeLabel ?? '', ds.removeAria ?? '', false),
      );
      li.append(text, actions);
      listEl.append(li);
    });
  }

  function updateUi() {
    const isCross = transitionSelect.value === 'crossfade';
    gapInput.disabled = isCross || busy !== null;
    crossfadeInput.disabled = !isCross || busy !== null;
    transitionSelect.disabled = busy !== null;
    fadeInInput.disabled = busy !== null;
    fadeOutInput.disabled = busy !== null;
    fileInput.disabled = busy !== null;
    mergeButton.disabled = busy !== null || items.length === 0;
    clearButton.disabled = busy !== null || items.length === 0;
    statusEl.hidden = busy === null;
    if (busy) statusEl.textContent = statusEl.dataset[busy] ?? '';
    emptyEl.hidden = items.length > 0;
    listEl.hidden = items.length === 0;
    if (items.length === 0) {
      summaryEl.textContent = '';
    } else {
      const total = estimateDuration(
        items.map((i) => i.duration),
        previewOptions(),
      );
      summaryEl.textContent = (summaryEl.dataset.template ?? '')
        .replace('{count}', String(items.length))
        .replace('{duration}', formatDuration(total));
    }
    renderList();
  }

  function setItems(next: Item[]) {
    items = next;
    revokeResult();
    updateUi();
  }

  async function decodeFile(file: File): Promise<Item> {
    const data = await file.arrayBuffer();
    // decodeAudioData はコンテキストのサンプルレートへ変換して返す
    const ctx = new OfflineAudioContext(1, 1, TARGET_RATE);
    const buffer = await ctx.decodeAudioData(data);
    const channels: Float32Array[] = [];
    for (let i = 0; i < buffer.numberOfChannels; i++) {
      channels.push(buffer.getChannelData(i).slice());
    }
    return {
      name: file.name,
      size: file.size,
      channels,
      sampleRate: buffer.sampleRate,
      duration: buffer.duration,
    };
  }

  async function addFiles(files: File[]) {
    clearError();
    if (busy || files.length === 0) return;
    const gen = generation;
    busy = 'loading';
    updateUi();
    let next = items.slice();
    let errorMessage = '';
    for (const file of files) {
      if (!isAcceptedAudioFile(file)) {
        errorMessage = errorEl.dataset.unsupported ?? '';
        continue;
      }
      if (next.length >= MAX_CLIPS) {
        errorMessage = (errorEl.dataset.tooManyTemplate ?? '').replace(
          '{max}',
          String(MAX_CLIPS),
        );
        break;
      }
      if (file.size > MAX_FILE_SIZE) {
        errorMessage = (errorEl.dataset.tooLargeTemplate ?? '').replace(
          '{max}',
          formatFileSize(MAX_FILE_SIZE),
        );
        continue;
      }
      let item: Item;
      try {
        item = await decodeFile(file);
      } catch {
        errorMessage = (errorEl.dataset.decodeTemplate ?? '').replace(
          '{name}',
          file.name,
        );
        continue;
      }
      if (gen !== generation) return;
      const candidate = [...next, item];
      const total = estimateDuration(
        candidate.map((i) => i.duration),
        previewOptions(),
      );
      if (total > MAX_TOTAL_SECONDS) {
        errorMessage = errorEl.dataset.totalTooLong ?? '';
        continue;
      }
      next = candidate;
    }
    if (gen !== generation) return;
    busy = null;
    if (errorMessage) showError(errorMessage);
    setItems(next);
  }

  function readOptions(): MergeOptions | null {
    const read = (
      input: HTMLInputElement,
      max: number,
      invalidKey: string,
      rangeKey: string,
    ): number | null => {
      const r: ParseResult = parseSeconds(input.value, max);
      if (r.ok) return r.value;
      showError(
        (r.error === 'invalid'
          ? errorEl.dataset[invalidKey]
          : errorEl.dataset[rangeKey]) ?? '',
      );
      return null;
    };
    const transition: Transition =
      transitionSelect.value === 'crossfade' ? 'crossfade' : 'gap';
    let gap = 0;
    let crossfade = 0;
    if (transition === 'gap') {
      const g = read(gapInput, MAX_GAP_SECONDS, 'gapInvalid', 'gapOutOfRange');
      if (g === null) return null;
      gap = g;
    } else {
      const c = read(
        crossfadeInput,
        MAX_CROSSFADE_SECONDS,
        'crossfadeInvalid',
        'crossfadeOutOfRange',
      );
      if (c === null) return null;
      crossfade = c;
    }
    const fadeIn = read(
      fadeInInput,
      MAX_FADE_SECONDS,
      'fadeInInvalid',
      'fadeInOutOfRange',
    );
    if (fadeIn === null) return null;
    const fadeOut = read(
      fadeOutInput,
      MAX_FADE_SECONDS,
      'fadeOutInvalid',
      'fadeOutOutOfRange',
    );
    if (fadeOut === null) return null;
    return {
      transition,
      gapSeconds: gap,
      crossfadeSeconds: crossfade,
      fadeInSeconds: fadeIn,
      fadeOutSeconds: fadeOut,
    };
  }

  async function startMerge() {
    if (busy || items.length === 0) return;
    clearError();
    const options = readOptions();
    if (!options) return;
    const total = estimateDuration(
      items.map((i) => i.duration),
      options,
    );
    if (total > MAX_TOTAL_SECONDS) {
      showError(errorEl.dataset.totalTooLong ?? '');
      return;
    }
    revokeResult();

    const gen = generation;
    const sources = items.slice();
    busy = 'processing';
    updateUi();
    // 「結合中」の表示を先に描画させる
    await new Promise((resolve) => setTimeout(resolve, 30));

    try {
      const out = mergeClips(
        sources.map((s) => ({
          channels: s.channels,
          sampleRate: s.sampleRate,
        })),
        options,
      );
      if (gen !== generation) return;
      const blob = encodeWavBlob(out.channels, out.sampleRate);
      resultBlob = blob;
      resultName = buildOutputFileName(sources.map((s) => s.name));
      resultUrl = URL.createObjectURL(blob);
      resultAudio.src = resultUrl;
      resultInfoEl.textContent = (resultInfoEl.dataset.template ?? '')
        .replace('{duration}', formatDuration(out.duration))
        .replace('{rate}', String(out.sampleRate))
        .replace('{size}', formatFileSize(blob.size));
      resultsSection.hidden = false;
    } catch {
      if (gen === generation) showError(errorEl.dataset.failed ?? '');
    } finally {
      if (gen === generation) {
        busy = null;
        updateUi();
      }
    }
  }

  fileInput.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    fileInput.value = '';
    void addFiles(files);
  });

  enableFileDrop(dropzone, fileInput);

  listEl.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('button');
    if (!target || busy) return;
    const index = Number(target.dataset.index);
    clearError();
    if (target.dataset.action === 'up') setItems(moveItem(items, index, -1));
    else if (target.dataset.action === 'down') {
      setItems(moveItem(items, index, 1));
    } else if (target.dataset.action === 'remove') {
      setItems(removeItem(items, index));
    }
  });

  for (const el of [transitionSelect, gapInput, crossfadeInput]) {
    el.addEventListener('input', updateUi);
    el.addEventListener('change', updateUi);
  }
  mergeButton.addEventListener('click', () => void startMerge());
  clearButton.addEventListener('click', () => {
    generation++;
    busy = null;
    clearError();
    setItems([]);
  });
  downloadButton.addEventListener('click', () => {
    if (resultBlob) downloadBlob(resultBlob, resultName);
  });

  updateUi();
</script>
