---
import Glossary from '../Glossary.astro';
import Notes from '../Notes.astro';
import Layout from '../../layouts/Layout.astro';
import { base64Content } from '../../i18n/tools/base64';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = base64Content[locale];
---

<Layout title={t.title} description={t.description}>
  <h1 class="mb-2 text-2xl font-bold">{t.h1}</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400" set:html={t.introHtml} />

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="base64-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label={t.modeLabel}
    >
      <button
        type="button"
        data-mode="encode"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        {t.modeEncode}
      </button>
      <button
        type="button"
        data-mode="decode"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        {t.modeDecode}
      </button>
    </div>
    <button
      id="base64-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      {t.copy}
    </button>
    <span
      id="base64-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="base64-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.inputLabel}
      </label>
      <textarea
        id="base64-input"
        class="h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="base64-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.outputLabel}
      </label>
      <textarea
        id="base64-output"
        readonly
        class="h-64 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="base64-error"
    hidden
    data-message={t.decodeError}
    class="mt-4 max-w-2xl rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Notes heading={t.notesHeading} items={t.notes} />

  <Glossary terms={t.glossaryTerms} heading={t.glossaryHeading} />
</Layout>

<script>
  import { decodeBase64, encodeBase64 } from '../../lib/tools/base64';

  type Mode = 'encode' | 'decode';

  const input = document.getElementById('base64-input') as HTMLTextAreaElement;
  const output = document.getElementById(
    'base64-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#base64-mode [data-mode]',
  );
  const copyButton = document.getElementById(
    'base64-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('base64-status')!;
  const errorEl = document.getElementById('base64-error')!;

  let mode: Mode = 'encode';

  function showError() {
    output.value = '';
    errorEl.textContent = errorEl.dataset.message ?? '';
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value === '') {
      showOutput('');
      return;
    }
    const result =
      mode === 'encode' ? encodeBase64(input.value) : decodeBase64(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError();
    }
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = copyButton.dataset.copied ?? '';
    } catch {
      statusEl.textContent = copyButton.dataset.copyFailed ?? '';
    }
  });

  convert();
</script>
