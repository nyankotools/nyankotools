---
import ToolShell from '../ToolShell.astro';
import { bpmDelayCalculatorContent } from '../../i18n/tools/bpm-delay-calculator';
import {
  DEFAULT_BPM,
  MAX_BPM,
  MIN_BPM,
  NOTE_KINDS,
  delayTable,
  formatMs,
  reverbGuide,
} from '../../lib/tools/bpm-delay-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = bpmDelayCalculatorContent[locale];

const rows = delayTable(DEFAULT_BPM);
const reverb = reverbGuide(DEFAULT_BPM);

const selectClass =
  'min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100';
const cellClass =
  'min-h-11 w-full rounded-md px-2 py-2 text-right font-mono text-sm tabular-nums hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-blue-600 dark:hover:bg-gray-800';
const thClass =
  'border-b border-gray-300 px-2 py-2 text-left text-xs font-bold text-gray-700 dark:border-gray-700 dark:text-gray-300';
---

<ToolShell t={t}>
  <div
    id="bpmd-root"
    data-copy-cell={t.copyCellLabel}
    data-copied={t.copiedMessage}
    data-copy-failed={t.copyFailedMessage}
    data-tap-empty={t.tapEmpty}
    data-tap-result={t.tapResult}
    data-tap-need-more={t.tapNeedMore}
  >
    <div class="grid max-w-md gap-4 sm:grid-cols-2">
      <div>
        <label for="bpmd-bpm" class="ui-label">
          {t.bpmLabel}
        </label>
        <input
          id="bpmd-bpm"
          type="number"
          inputmode="decimal"
          min={MIN_BPM}
          max={MAX_BPM}
          step="any"
          value={DEFAULT_BPM}
          class="ui-input h-11 min-w-0 px-3 text-center text-lg font-bold"
        />
      </div>
      <div>
        <label for="bpmd-unit" class="ui-label">
          {t.unitLabel}
        </label>
        <select id="bpmd-unit" class={selectClass}>
          <option value="ms" selected>
            {t.unitMs}
          </option>
          <option value="hz">{t.unitHz}</option>
        </select>
      </div>
    </div>

    <h2 class="mt-8 mb-2 text-lg font-bold">{t.tapHeading}</h2>
    <p class="mb-3 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
      {t.tapHint}
    </p>
    <div class="flex max-w-md flex-wrap gap-3">
      <button
        id="bpmd-tap"
        type="button"
        class="ui-btn h-16 min-w-0 flex-1 text-lg font-bold"
      >
        {t.tapLabel}
      </button>
      <button id="bpmd-tap-reset" type="button" class="ui-btn h-16">
        {t.tapResetLabel}
      </button>
    </div>
    <p
      id="bpmd-tap-result"
      role="status"
      class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      {t.tapEmpty}
    </p>

    <h2 class="mt-8 mb-2 text-lg font-bold">{t.delayHeading}</h2>
    <p class="mb-3 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
      {t.delayHint}
    </p>
    <div class="max-w-2xl">
      <table class="w-full table-fixed border-collapse text-sm">
        <thead>
          <tr>
            <th scope="col" class={`${thClass} w-[34%]`}>
              {t.noteColumn}
            </th>
            {NOTE_KINDS.map((k) => (
              <th scope="col" class={`${thClass} text-right`}>
                {t.kindLabels[k]}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-gray-200 dark:border-gray-800">
              <th
                scope="row"
                class="px-2 py-1 text-left text-xs font-medium break-words text-gray-800 dark:text-gray-200"
              >
                {t.noteNames[String(row.denominator) as '1']}
              </th>
              {NOTE_KINDS.map((k) => (
                <td class="p-0">
                  <button
                    type="button"
                    class={cellClass}
                    data-delay-den={row.denominator}
                    data-kind={k}
                    data-label={`${t.noteNames[String(row.denominator) as '1']} ${t.kindLabels[k]}`}
                    aria-label={t.copyCellLabel
                      .replace(
                        '{label}',
                        `${t.noteNames[String(row.denominator) as '1']} ${t.kindLabels[k]}`,
                      )
                      .replace('{value}', `${formatMs(row[k])} ms`)}
                  >
                    {formatMs(row[k])}
                  </button>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button
        id="bpmd-copy-button"
        type="button"
        class="ui-btn ui-btn-primary h-11"
      >
        {t.copyAllLabel}
      </button>
      <span
        id="bpmd-copy-status"
        role="status"
        class="text-sm text-gray-600 dark:text-gray-400"
      ></span>
    </div>

    <h2 class="mt-8 mb-2 text-lg font-bold">{t.reverbHeading}</h2>
    <p class="mb-3 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
      {t.reverbHint}
    </p>
    <div class="max-w-2xl">
      <table class="w-full table-fixed border-collapse text-sm">
        <thead>
          <tr>
            <th scope="col" class={`${thClass} w-[34%]`}>
              {t.reverbGroupColumn}
            </th>
            <th scope="col" class={thClass}>
              {t.noteColumn}
            </th>
            <th scope="col" class={`${thClass} text-right`}>
              {t.reverbValueColumn}
            </th>
          </tr>
        </thead>
        <tbody>
          {reverb.map((item, i) => (
            <tr class="border-b border-gray-200 dark:border-gray-800">
              <th
                scope="row"
                class="px-2 py-1 text-left text-xs font-medium text-gray-800 dark:text-gray-200"
              >
                {t.reverbGroups[item.group]}
              </th>
              <td class="px-2 py-1 text-xs break-words text-gray-700 dark:text-gray-300">
                {t.noteNames[String(item.denominator) as '1']}
              </td>
              <td class="p-0">
                <button
                  type="button"
                  class={cellClass}
                  data-reverb-index={i}
                  data-label={`${t.reverbGroups[item.group]} ${t.noteNames[String(item.denominator) as '1']}`}
                  aria-label={t.copyCellLabel
                    .replace(
                      '{label}',
                      `${t.reverbGroups[item.group]} ${t.noteNames[String(item.denominator) as '1']}`,
                    )
                    .replace('{value}', `${formatMs(item.ms)} ms`)}
                >
                  {formatMs(item.ms)}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</ToolShell>

<script>
  import {
    addTap,
    bpmFromTaps,
    clampBpm,
    formatHz,
    formatMs,
    msToHz,
    noteMs,
    reverbGuide,
    type NoteDenominator,
    type NoteKind,
  } from '../../lib/tools/bpm-delay-calculator';
  import { copyText } from '../../lib/clipboard';

  const root = document.getElementById('bpmd-root')!;
  const d = root.dataset;
  const bpmInput = document.getElementById('bpmd-bpm') as HTMLInputElement;
  const unitSelect = document.getElementById('bpmd-unit') as HTMLSelectElement;
  const tapButton = document.getElementById('bpmd-tap') as HTMLButtonElement;
  const tapReset = document.getElementById(
    'bpmd-tap-reset',
  ) as HTMLButtonElement;
  const tapResult = document.getElementById('bpmd-tap-result')!;
  const copyAll = document.getElementById('bpmd-copy-button')!;
  const copyStatus = document.getElementById('bpmd-copy-status')!;
  const delayCells = Array.from(
    root.querySelectorAll<HTMLButtonElement>('[data-delay-den]'),
  );
  const reverbCells = Array.from(
    root.querySelectorAll<HTMLButtonElement>('[data-reverb-index]'),
  );

  let taps: number[] = [];
  let statusTimer = 0;

  function currentBpm(): number {
    const raw = Number(bpmInput.value);
    return bpmInput.value === '' ? NaN : raw;
  }

  function show(ms: number, hz: boolean): string {
    return hz ? formatHz(msToHz(ms)) : formatMs(ms);
  }

  function render() {
    const raw = currentBpm();
    const bpm = clampBpm(raw);
    const hz = unitSelect.value === 'hz';
    const unit = hz ? 'Hz' : 'ms';
    const apply = (cell: HTMLButtonElement, ms: number) => {
      const value = show(ms, hz);
      cell.textContent = value;
      cell.dataset.value = value;
      cell.setAttribute(
        'aria-label',
        d
          .copyCell!.replace('{label}', cell.dataset.label!)
          .replace('{value}', `${value} ${unit}`),
      );
    };
    for (const cell of delayCells) {
      apply(
        cell,
        noteMs(
          bpm,
          Number(cell.dataset.delayDen) as NoteDenominator,
          cell.dataset.kind as NoteKind,
        ),
      );
    }
    const guide = reverbGuide(bpm);
    for (const cell of reverbCells) {
      apply(cell, guide[Number(cell.dataset.reverbIndex)].ms);
    }
  }

  function flash(message: string) {
    copyStatus.textContent = message;
    window.clearTimeout(statusTimer);
    statusTimer = window.setTimeout(() => {
      copyStatus.textContent = '';
    }, 2000);
  }

  async function copy(text: string) {
    flash((await copyText(text)) ? d.copied! : d.copyFailed!);
  }

  function showTap() {
    const measured = bpmFromTaps(taps);
    if (taps.length === 0) {
      tapResult.textContent = d.tapEmpty!;
    } else if (measured === null) {
      tapResult.textContent = d.tapNeedMore!;
    } else {
      tapResult.textContent = d
        .tapResult!.replace('{bpm}', measured.toFixed(1))
        .replace('{count}', String(taps.length));
    }
  }

  bpmInput.addEventListener('input', render);
  bpmInput.addEventListener('change', () => {
    const bpm = clampBpm(currentBpm());
    bpmInput.value = String(bpm);
    render();
  });
  unitSelect.addEventListener('change', render);

  root.addEventListener('click', (event) => {
    const cell = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-delay-den], [data-reverb-index]',
    );
    if (cell) void copy(cell.dataset.value ?? cell.textContent ?? '');
  });

  copyAll.addEventListener('click', () => {
    const lines = Array.from(
      root.querySelectorAll<HTMLTableRowElement>('tbody tr'),
    )
      .filter((tr) => tr.querySelector('[data-delay-den]'))
      .map((tr) =>
        [
          tr.querySelector('th')!.textContent!.trim(),
          ...Array.from(tr.querySelectorAll('button')).map((b) =>
            b.textContent!.trim(),
          ),
        ].join('\t'),
      );
    void copy(lines.join('\n'));
  });

  tapButton.addEventListener('click', () => {
    taps = addTap(taps, performance.now());
    const measured = bpmFromTaps(taps);
    if (measured !== null) {
      bpmInput.value = String(clampBpm(measured));
      render();
    }
    showTap();
  });
  tapReset.addEventListener('click', () => {
    taps = [];
    showTap();
  });

  render();
</script>
