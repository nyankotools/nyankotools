---
import ToolShell from '../ToolShell.astro';
import { breakEvenCalculatorContent } from '../../i18n/tools/break-even-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = breakEvenCalculatorContent[locale];

const rows = [
  ['contribution', t.labelContribution],
  ['ratio', t.labelContributionRatio],
  ['be-units', t.labelBreakEvenUnits],
  ['be-sales', t.labelBreakEvenSales],
  ['target-units', t.labelTargetUnits],
  ['target-sales', t.labelTargetSales],
  ['expected-profit', t.labelExpectedProfit],
  ['safety', t.labelMarginOfSafety],
] as const;
---

<ToolShell t={t}>
  <section
    id="be"
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-number-locale={t.numberLocale}
    data-currency={t.currency}
    data-errors={JSON.stringify(t.errors)}
    data-units-suffix={t.unitsSuffix}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="be-price-input" class="ui-label">
          {t.priceLabel}
        </label>
        <input
          id="be-price-input"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value={t.defaultPrice}
          class="ui-input h-11 w-36 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="be-variable-input" class="ui-label">
          {t.variableCostLabel}
        </label>
        <input
          id="be-variable-input"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value={t.defaultVariableCost}
          class="ui-input h-11 w-36 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="be-fixed-input" class="ui-label">
          {t.fixedCostLabel}
        </label>
        <input
          id="be-fixed-input"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value={t.defaultFixedCost}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="be-target-input" class="ui-label">
          {t.targetProfitLabel}
        </label>
        <input
          id="be-target-input"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value={t.defaultTargetProfit}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="be-expected-input" class="ui-label">
          {t.expectedUnitsLabel}
        </label>
        <input
          id="be-expected-input"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900"
        />
      </div>
    </div>
    <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
      {t.expectedUnitsHint}
    </p>

    <p
      id="be-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div id="be-results" class="mt-4 hidden" aria-live="polite">
      <h2 class="mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.resultHeading}
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <tbody>
            {rows.map(([key, label]) => (
              <tr
                id={`be-row-${key}`}
                class="border-b border-gray-100 dark:border-gray-800"
              >
                <th scope="row" class="py-2 pr-3 font-normal">
                  {label}
                </th>
                <td id={`be-${key}`} class="py-2 font-semibold break-all" />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-3 flex items-center gap-3">
        <button type="button" id="be-copy-button" class="ui-btn">
          {t.copyButton}
        </button>
        <span
          id="be-copy-status"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    calculateBreakEven,
    type BreakEvenError,
  } from '../../lib/tools/break-even-calculator';

  const section = document.getElementById('be')!;
  const numberLocale = section.dataset.numberLocale ?? 'en-US';
  const currency = section.dataset.currency ?? 'USD';
  const errors: Record<BreakEvenError, string> = JSON.parse(
    section.dataset.errors ?? '{}',
  );
  const unitsSuffix = section.dataset.unitsSuffix ?? '';
  const copiedMessage = section.dataset.copied ?? '';
  const copyFailedMessage = section.dataset.copyFailed ?? '';

  const money = new Intl.NumberFormat(numberLocale, {
    style: 'currency',
    currency,
    maximumFractionDigits: 2,
  });
  const count = new Intl.NumberFormat(numberLocale, {
    maximumFractionDigits: 0,
  });
  const percent = new Intl.NumberFormat(numberLocale, {
    style: 'percent',
    maximumFractionDigits: 1,
  });

  const input = (id: string) => document.getElementById(id) as HTMLInputElement;
  const priceInput = input('be-price-input');
  const variableInput = input('be-variable-input');
  const fixedInput = input('be-fixed-input');
  const targetInput = input('be-target-input');
  const expectedInput = input('be-expected-input');
  const errorEl = document.getElementById('be-error')!;
  const resultsEl = document.getElementById('be-results')!;
  const copyButton = document.getElementById('be-copy-button')!;
  const copyStatus = document.getElementById('be-copy-status')!;

  let copyTextValue = '';

  function setCell(key: string, text: string | null) {
    document
      .getElementById(`be-row-${key}`)!
      .classList.toggle('hidden', text === null);
    if (text !== null) document.getElementById(`be-${key}`)!.textContent = text;
  }

  function render() {
    errorEl.textContent = '';
    copyStatus.textContent = '';
    resultsEl.classList.add('hidden');

    if (
      [priceInput, variableInput, fixedInput].some(
        (el) => el.value.trim() === '',
      )
    )
      return;

    const result = calculateBreakEven({
      price: Number(priceInput.value),
      variableCost: Number(variableInput.value),
      fixedCost: Number(fixedInput.value),
      targetProfit:
        targetInput.value.trim() === '' ? 0 : Number(targetInput.value),
      expectedUnits:
        expectedInput.value.trim() === '' ? null : Number(expectedInput.value),
    });
    if ('error' in result) {
      errorEl.textContent = errors[result.error];
      return;
    }

    const hasTarget = Number(targetInput.value || 0) > 0;
    setCell('contribution', money.format(result.contributionPerUnit));
    setCell('ratio', percent.format(result.contributionRatio));
    setCell('be-units', `${count.format(result.breakEvenUnits)}${unitsSuffix}`);
    setCell('be-sales', money.format(result.breakEvenSales));
    setCell(
      'target-units',
      hasTarget ? `${count.format(result.targetUnits)}${unitsSuffix}` : null,
    );
    setCell(
      'target-sales',
      hasTarget ? money.format(result.targetSales) : null,
    );
    setCell(
      'expected-profit',
      result.expectedProfit === null
        ? null
        : money.format(result.expectedProfit),
    );
    setCell(
      'safety',
      result.marginOfSafety === null
        ? null
        : percent.format(result.marginOfSafety),
    );

    copyTextValue = [...document.querySelectorAll('#be-results tbody tr')]
      .filter((tr) => !tr.classList.contains('hidden'))
      .map(
        (tr) =>
          `${tr.querySelector('th')!.textContent!.trim()}: ${tr.querySelector('td')!.textContent}`,
      )
      .join('\n');
    resultsEl.classList.remove('hidden');
  }

  [priceInput, variableInput, fixedInput, targetInput, expectedInput].forEach(
    (el) => el.addEventListener('input', render),
  );

  copyButton.addEventListener('click', async () => {
    if (copyTextValue === '') return;
    copyStatus.textContent = (await copyText(copyTextValue))
      ? copiedMessage
      : copyFailedMessage;
  });

  render();
</script>
