---
import ToolShell from '../ToolShell.astro';
import { checksumCalculatorContent } from '../../i18n/tools/checksum-calculator';
import { MAX_FILE_SIZE } from '../../lib/tools/checksum-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = checksumCalculatorContent[locale];
const maxMb = String(MAX_FILE_SIZE / 1024 / 1024);
---

<ToolShell t={t}>
  <div
    id="cks-root"
    data-max-mb={maxMb}
    data-max-bytes={MAX_FILE_SIZE}
    data-text-title={t.textResultTitle}
    data-computing={t.computing}
    data-error-too-large={t.errorTooLarge}
    data-error-read-failed={t.errorReadFailed}
    data-compare-match={t.compareMatch}
    data-compare-mismatch={t.compareMismatch}
    data-compare-invalid={t.compareInvalid}
    data-copy-label={t.copy}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <label for="cks-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="cks-input"
      class="ui-input h-32 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
    ></textarea>

    <label for="cks-file-input" class="ui-label mt-4">
      {t.dropLabel}
    </label>
    <div id="cks-dropzone" class="ui-dropzone">
      <input id="cks-file-input" type="file" multiple class="ui-file" />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="cks-error"
      role="alert"
      hidden
      class="mt-2 text-sm text-red-600 dark:text-red-400"
    ></p>

    <div class="mt-4">
      <label for="cks-compare" class="ui-label">
        {t.compareLabel}
      </label>
      <input
        id="cks-compare"
        type="text"
        class="ui-input h-11 w-full px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.comparePlaceholder}
        spellcheck="false"
        autocomplete="off"
      />
    </div>

    <label class="ui-check">
      <input id="cks-uppercase" type="checkbox" class="h-4 w-4" />
      {t.uppercaseLabel}
    </label>

    <p
      id="cks-status"
      class="text-sm text-green-700 dark:text-green-400"
      aria-live="polite"
    ></p>

    <div id="cks-results" class="mt-4 space-y-4"></div>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { enableFileDrop } from '../../lib/file-drop';
  import { onTextInput } from '../../lib/input-scheduler';
  import {
    CHECKSUM_ALGORITHMS,
    CHUNK_SIZE,
    checksumText,
    compareChecksum,
    createChecksumState,
    type ChecksumResult,
  } from '../../lib/tools/checksum-calculator';

  const root = document.getElementById('cks-root')!;
  const textInput = document.getElementById('cks-input') as HTMLTextAreaElement;
  const dropzone = document.getElementById('cks-dropzone')!;
  const fileInput = document.getElementById(
    'cks-file-input',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('cks-error')!;
  const compareInput = document.getElementById(
    'cks-compare',
  ) as HTMLInputElement;
  const uppercaseCheckbox = document.getElementById(
    'cks-uppercase',
  ) as HTMLInputElement;
  const statusEl = document.getElementById('cks-status')!;
  const resultsEl = document.getElementById('cks-results')!;

  const d = root.dataset;
  const maxBytes = Number(d.maxBytes);

  interface Entry {
    card: HTMLElement;
    result: ChecksumResult;
    inputs: HTMLInputElement[];
    compareEl: HTMLElement;
  }
  const fileEntries: Entry[] = [];
  let textEntry: Entry | null = null;

  function allEntries(): Entry[] {
    return textEntry ? [textEntry, ...fileEntries] : fileEntries;
  }

  function showError(messages: string[]) {
    errorEl.textContent = messages.join(' ');
    errorEl.hidden = messages.length === 0;
  }

  function applyCase(entry: Entry) {
    CHECKSUM_ALGORITHMS.forEach((a, i) => {
      const value = entry.result[a.id];
      entry.inputs[i]!.value = uppercaseCheckbox.checked
        ? value.toUpperCase()
        : value;
    });
  }

  function applyCompare(entry: Entry) {
    const result = compareChecksum(compareInput.value, entry.result);
    const el = entry.compareEl;
    if (result.status === 'empty') {
      el.hidden = true;
      el.textContent = '';
      return;
    }
    el.hidden = false;
    const good = result.status === 'match';
    el.className =
      'mt-2 text-sm font-medium ' +
      (good
        ? 'text-green-700 dark:text-green-400'
        : 'text-red-600 dark:text-red-400');
    if (result.status === 'invalid') {
      el.textContent = d.compareInvalid ?? '';
    } else if (result.status === 'mismatch') {
      el.textContent = d.compareMismatch ?? '';
    } else {
      const names = result.ids
        .map((id) => CHECKSUM_ALGORITHMS.find((a) => a.id === id)!.label)
        .join(', ');
      el.textContent = (d.compareMatch ?? '').replace('{algorithm}', names);
    }
  }

  function buildEntry(name: string, result: ChecksumResult): Entry {
    const card = document.createElement('section');
    card.className =
      'rounded-lg border border-gray-200 p-4 dark:border-gray-700';

    const title = document.createElement('h2');
    title.className =
      'break-all text-sm font-semibold text-gray-900 dark:text-gray-100';
    title.textContent = name;
    card.append(title);

    const compareEl = document.createElement('p');
    compareEl.hidden = true;
    compareEl.setAttribute('role', 'status');
    card.append(compareEl);

    const inputs: HTMLInputElement[] = [];
    for (const algorithm of CHECKSUM_ALGORITHMS) {
      const row = document.createElement('div');
      row.className = 'mt-3';

      const label = document.createElement('div');
      label.className = 'ui-label';
      label.textContent = algorithm.label;

      const line = document.createElement('div');
      line.className = 'flex gap-2';

      const input = document.createElement('input');
      input.type = 'text';
      input.readOnly = true;
      input.setAttribute('aria-label', `${name} ${algorithm.label}`);
      input.className =
        'ui-input h-11 w-full min-w-0 bg-gray-50 px-3 font-mono dark:bg-gray-900';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'ui-btn shrink-0';
      button.textContent = d.copyLabel ?? '';
      button.addEventListener('click', async () => {
        statusEl.textContent = (await copyText(input.value))
          ? (d.copied ?? '')
          : (d.copyFailed ?? '');
      });

      line.append(input, button);
      row.append(label, line);
      card.append(row);
      inputs.push(input);
    }

    const entry: Entry = { card, result, inputs, compareEl };
    applyCase(entry);
    applyCompare(entry);
    return entry;
  }

  function updateText() {
    textEntry?.card.remove();
    textEntry = null;
    if (textInput.value !== '') {
      textEntry = buildEntry(d.textTitle ?? '', checksumText(textInput.value));
      resultsEl.prepend(textEntry.card);
    }
  }

  async function checksumFile(file: File): Promise<ChecksumResult> {
    const state = createChecksumState();
    for (let offset = 0; offset < file.size; offset += CHUNK_SIZE) {
      const buffer = await file
        .slice(offset, offset + CHUNK_SIZE)
        .arrayBuffer();
      state.update(new Uint8Array(buffer));
      // 描画とUI操作に時間を譲る
      await new Promise((resolve) => setTimeout(resolve, 0));
    }
    return state.digest();
  }

  let queue: Promise<void> = Promise.resolve();

  async function handleFiles(files: File[]) {
    const errors: string[] = [];
    statusEl.textContent = '';
    showError([]);

    for (const file of files) {
      if (file.size > maxBytes) {
        errors.push(
          (d.errorTooLarge ?? '')
            .replace('{max}', d.maxMb ?? '')
            .replace('{name}', () => file.name),
        );
        continue;
      }
      statusEl.textContent = `${d.computing ?? ''} ${file.name}`;
      try {
        const result = await checksumFile(file);
        const entry = buildEntry(file.name, result);
        fileEntries.unshift(entry);
        if (textEntry) {
          textEntry.card.after(entry.card);
        } else {
          resultsEl.prepend(entry.card);
        }
      } catch {
        errors.push(
          (d.errorReadFailed ?? '').replace('{name}', () => file.name),
        );
      }
    }

    statusEl.textContent = '';
    showError(errors);
  }

  fileInput.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    fileInput.value = '';
    if (files.length > 0) queue = queue.then(() => handleFiles(files));
  });
  enableFileDrop(dropzone, fileInput);

  onTextInput(textInput, updateText);
  compareInput.addEventListener('input', () =>
    allEntries().forEach(applyCompare),
  );
  uppercaseCheckbox.addEventListener('change', () =>
    allEntries().forEach(applyCase),
  );
</script>
