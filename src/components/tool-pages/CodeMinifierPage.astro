---
import ToolShell from '../ToolShell.astro';
import { codeMinifierContent } from '../../i18n/tools/code-minifier';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = codeMinifierContent[locale];
---

<ToolShell t={t}>
  <div
    id="code-minifier-controls"
    class="flex flex-wrap items-center gap-3"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-error-template={t.errorTemplate}
  >
    <label
      for="code-minifier-language"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.languageLabel}
    </label>
    <select
      id="code-minifier-language"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.languageOptions.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>

    <label
      for="code-minifier-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.indentLabel}
    </label>
    <select
      id="code-minifier-indent"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.indentOptions.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>

    <button id="code-minifier-minify-button" type="button" class="ui-btn">
      {t.minifyButton}
    </button>
    <button id="code-minifier-copy-button" type="button" class="ui-btn">
      {t.copyButton}
    </button>
    <span
      id="code-minifier-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="code-minifier-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="code-minifier-input"
        class="ui-input h-80 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="code-minifier-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="code-minifier-output"
        readonly
        class="ui-input h-80 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <p
    id="code-minifier-error"
    hidden
    class="ui-error mt-4 max-w-2xl whitespace-pre-line"
  ></p>

  <p
    class="mt-6 text-sm text-gray-600 dark:text-gray-400"
    set:html={t.footnoteHtml}
  />
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import {
    formatCode,
    minifyCode,
    type CodeLanguage,
  } from '../../lib/tools/code-minifier';

  const controls = document.getElementById('code-minifier-controls')!;
  const copied = controls.dataset.copied ?? '';
  const copyFailed = controls.dataset.copyFailed ?? '';
  const errorTemplate = controls.dataset.errorTemplate ?? '';

  const input = document.getElementById(
    'code-minifier-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'code-minifier-output',
  ) as HTMLTextAreaElement;
  const languageSelect = document.getElementById(
    'code-minifier-language',
  ) as HTMLSelectElement;
  const indentSelect = document.getElementById(
    'code-minifier-indent',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('code-minifier-minify-button')!;
  const copyButton = document.getElementById('code-minifier-copy-button')!;
  const statusEl = document.getElementById('code-minifier-status')!;
  const errorEl = document.getElementById('code-minifier-error')!;

  // 入力中に前の処理が後から完了して結果を上書きしてしまわないよう、
  // 実行のたびにトークンを発行し、最新の実行結果だけを反映する
  let requestToken = 0;

  function getIndentOptions(): { tabWidth: number; useTabs: boolean } {
    if (indentSelect.value === 'tab') {
      return { tabWidth: 2, useTabs: true };
    }
    return { tabWidth: Number(indentSelect.value), useTabs: false };
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = errorTemplate.replace('{message}', () => message);
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  async function format() {
    const token = ++requestToken;
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const { tabWidth, useTabs } = getIndentOptions();
    try {
      const result = await formatCode(
        input.value,
        languageSelect.value as CodeLanguage,
        { tabWidth, useTabs },
      );
      if (token !== requestToken) return;
      showOutput(result);
    } catch (error) {
      if (token !== requestToken) return;
      const message = error instanceof Error ? error.message : String(error);
      showError(message.split('\n')[0]);
    }
  }

  async function minify() {
    const token = ++requestToken;
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    try {
      const result = await minifyCode(
        input.value,
        languageSelect.value as CodeLanguage,
      );
      if (token !== requestToken) return;
      showOutput(result);
    } catch (error) {
      if (token !== requestToken) return;
      const message = error instanceof Error ? error.message : String(error);
      showError(message.split('\n')[0]);
    }
  }

  onTextInput(input, format);
  languageSelect.addEventListener('change', format);
  indentSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value)) ? copied : copyFailed;
  });

  format();
</script>
