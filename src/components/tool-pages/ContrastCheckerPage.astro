---
import ToolShell from '../ToolShell.astro';
import { contrastCheckerContent } from '../../i18n/tools/contrast-checker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = contrastCheckerContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <div class="flex-1">
      <label for="contrast-checker-fg" class="ui-label">
        {t.foregroundLabel}
      </label>
      <div class="flex gap-2">
        <input
          id="contrast-checker-fg"
          type="text"
          value="#111827"
          placeholder={t.colorPlaceholder}
          spellcheck="false"
          class="ui-input h-11 w-full min-w-0 px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <input
          id="contrast-checker-fg-picker"
          type="color"
          value="#111827"
          aria-label={t.foregroundPickerAriaLabel}
          class="h-11 w-14 shrink-0 cursor-pointer rounded-lg border border-gray-300 bg-transparent p-1 dark:border-gray-700"
        />
      </div>
    </div>

    <button
      id="contrast-checker-swap"
      type="button"
      aria-label={t.swapLabel}
      title={t.swapLabel}
      class="ui-btn mt-6 flex shrink-0 items-center justify-center px-3 sm:mt-7"
    >
      ⇄
    </button>

    <div class="flex-1">
      <label for="contrast-checker-bg" class="ui-label">
        {t.backgroundLabel}
      </label>
      <div class="flex gap-2">
        <input
          id="contrast-checker-bg"
          type="text"
          value="#ffffff"
          placeholder={t.colorPlaceholder}
          spellcheck="false"
          class="ui-input h-11 w-full min-w-0 px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <input
          id="contrast-checker-bg-picker"
          type="color"
          value="#ffffff"
          aria-label={t.backgroundPickerAriaLabel}
          class="h-11 w-14 shrink-0 cursor-pointer rounded-lg border border-gray-300 bg-transparent p-1 dark:border-gray-700"
        />
      </div>
    </div>
  </div>

  <p
    id="contrast-checker-error"
    data-color-error={t.colorError}
    class="mt-3 text-sm text-red-600 dark:text-red-400"
    aria-live="polite"
  ></p>

  <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-start">
    <div class="flex-1">
      <h2 class="mb-2 text-lg font-bold">{t.previewHeading}</h2>
      <div
        id="contrast-checker-preview"
        class="rounded-lg border border-gray-300 p-6 dark:border-gray-700"
      >
        <p id="contrast-checker-preview-large" class="mb-2 text-2xl font-bold">
          {t.previewLargeText}
        </p>
        <p id="contrast-checker-preview-normal" class="text-base">
          {t.previewNormalText}
        </p>
      </div>
      <p class="mt-3 text-sm text-gray-700 dark:text-gray-300">
        {t.ratioLabel}:{' '}
        <span
          id="contrast-checker-ratio"
          class="font-mono text-lg font-bold"
        ></span>
      </p>
    </div>

    <div class="flex-1">
      <h2 class="mb-2 text-lg font-bold">{t.resultsHeading}</h2>
      <ul class="space-y-2">
        {t.results.map((result) => (
          <li
            data-result-row={result.id}
            class="flex items-center justify-between gap-3 rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-700"
          >
            <span class="text-gray-700 dark:text-gray-300">{result.label}</span>
            <span
              data-result-badge
              data-pass={t.pass}
              data-fail={t.fail}
              class="shrink-0 rounded-full px-3 py-1 text-xs font-bold"
            ></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</ToolShell>

<script>
  import {
    evaluateContrast,
    parseColorInput,
  } from '../../lib/tools/contrast-checker';
  import { rgbToHex, type RgbColor } from '../../lib/tools/color-converter';

  const fgInput = document.getElementById(
    'contrast-checker-fg',
  ) as HTMLInputElement;
  const fgPicker = document.getElementById(
    'contrast-checker-fg-picker',
  ) as HTMLInputElement;
  const bgInput = document.getElementById(
    'contrast-checker-bg',
  ) as HTMLInputElement;
  const bgPicker = document.getElementById(
    'contrast-checker-bg-picker',
  ) as HTMLInputElement;
  const swapButton = document.getElementById(
    'contrast-checker-swap',
  ) as HTMLButtonElement;
  const errorEl = document.getElementById('contrast-checker-error')!;
  const preview = document.getElementById('contrast-checker-preview')!;
  const previewLarge = document.getElementById(
    'contrast-checker-preview-large',
  )!;
  const previewNormal = document.getElementById(
    'contrast-checker-preview-normal',
  )!;
  const ratioEl = document.getElementById('contrast-checker-ratio')!;
  const resultRows =
    document.querySelectorAll<HTMLElement>('[data-result-row]');

  const colorError = errorEl.dataset.colorError ?? '';

  function readColor(input: HTMLInputElement): RgbColor | null {
    const value = input.value.trim();
    if (value === '') return null;
    return parseColorInput(value);
  }

  function setResultBadge(el: HTMLElement, pass: boolean) {
    const badge = el.querySelector<HTMLElement>('[data-result-badge]')!;
    badge.textContent = pass
      ? (badge.dataset.pass ?? '')
      : (badge.dataset.fail ?? '');
    badge.classList.toggle('bg-green-100', pass);
    badge.classList.toggle('text-green-800', pass);
    badge.classList.toggle('dark:bg-green-900', pass);
    badge.classList.toggle('dark:text-green-200', pass);
    badge.classList.toggle('bg-red-100', !pass);
    badge.classList.toggle('text-red-800', !pass);
    badge.classList.toggle('dark:bg-red-900', !pass);
    badge.classList.toggle('dark:text-red-200', !pass);
  }

  function sync() {
    const fgRaw = fgInput.value.trim();
    const bgRaw = bgInput.value.trim();
    const fg = readColor(fgInput);
    const bg = readColor(bgInput);

    if ((fgRaw !== '' && !fg) || (bgRaw !== '' && !bg)) {
      errorEl.textContent = colorError;
      return;
    }
    if (!fg || !bg) {
      errorEl.textContent = '';
      ratioEl.textContent = '';
      return;
    }

    errorEl.textContent = '';
    const fgHex = rgbToHex(fg);
    const bgHex = rgbToHex(bg);
    fgPicker.value = fgHex;
    bgPicker.value = bgHex;
    preview.style.color = fgHex;
    preview.style.backgroundColor = bgHex;
    previewLarge.style.color = fgHex;
    previewNormal.style.color = fgHex;

    const result = evaluateContrast(fg, bg);
    ratioEl.textContent = `${result.ratio.toFixed(2)} : 1`;
    resultRows.forEach((row) => {
      const id = row.dataset.resultRow as
        'normalAA' | 'normalAAA' | 'largeAA' | 'largeAAA';
      setResultBadge(row, result[id]);
    });
  }

  fgInput.addEventListener('input', sync);
  bgInput.addEventListener('input', sync);
  fgPicker.addEventListener('input', () => {
    fgInput.value = fgPicker.value;
    sync();
  });
  bgPicker.addEventListener('input', () => {
    bgInput.value = bgPicker.value;
    sync();
  });

  swapButton.addEventListener('click', () => {
    const fgValue = fgInput.value;
    fgInput.value = bgInput.value;
    bgInput.value = fgValue;
    sync();
  });

  sync();
</script>
