---
import ToolShell from '../ToolShell.astro';
import { cookingUnitConverterContent } from '../../i18n/tools/cooking-unit-converter';
import {
  buildIngredientTable,
  formatAmount,
  INGREDIENT_IDS,
} from '../../lib/tools/cooking-unit-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cookingUnitConverterContent[locale];
const rows = buildIngredientTable('jp');
const units = [
  { id: 'tsp', label: t.unitTsp },
  { id: 'tbsp', label: t.unitTbsp },
  { id: 'cup', label: t.unitCup },
  { id: 'ml', label: t.unitMl },
  { id: 'g', label: t.unitG },
];
---

<ToolShell t={t}>
  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    id="cook-root"
    data-error={t.error}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="cook-amount" class="ui-label">
          {t.amountLabel}
        </label>
        <input
          id="cook-amount"
          type="number"
          inputmode="decimal"
          min="0"
          step="any"
          value="1"
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="cook-from" class="ui-label">
          {t.fromLabel}
        </label>
        <select
          id="cook-from"
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        >
          {units.map((u) => (
            <option value={u.id} selected={u.id === 'tbsp'}>
              {u.label}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label for="cook-ingredient" class="ui-label">
          {t.ingredientLabel}
        </label>
        <select
          id="cook-ingredient"
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        >
          {INGREDIENT_IDS.map((id) => (
            <option value={id} selected={id === 'flour'}>
              {t.ingredients[id]}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label for="cook-cup" class="ui-label">
          {t.cupLabel}
        </label>
        <select
          id="cook-cup"
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        >
          <option value="jp" selected>
            {t.cupJp}
          </option>
          <option value="us">{t.cupUs}</option>
          <option value="metric">{t.cupMetric}</option>
        </select>
      </div>
    </div>

    <p
      id="cook-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div id="cook-results" class="mt-4" aria-live="polite">
      <h2 class="mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.resultHeading}
      </h2>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-5">
        {units.map((u) => (
          <div class="rounded-md bg-gray-50 p-2 dark:bg-gray-800">
            <dt class="text-xs text-gray-600 dark:text-gray-400">{u.label}</dt>
            <dd
              class="text-lg font-semibold break-all"
              id={`cook-result-${u.id}`}
              data-label={u.label}
            />
          </div>
        ))}
      </dl>
      <div class="mt-3 flex items-center gap-3">
        <button type="button" id="cook-copy-button" class="ui-btn">
          {t.copyLabel}
        </button>
        <span
          id="cook-copy-status"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="mb-3 text-lg font-semibold">{t.tableHeading}</h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[20rem] text-left text-sm">
        <caption class="sr-only">{t.tableCaption}</caption>
        <thead>
          <tr class="border-b border-gray-300 dark:border-gray-600">
            <th scope="col" class="px-2 py-1.5">
              {t.tableIngredient}
            </th>
            <th scope="col" class="px-2 py-1.5">
              {t.tableTsp}
            </th>
            <th scope="col" class="px-2 py-1.5">
              {t.tableTbsp}
            </th>
            <th scope="col" class="px-2 py-1.5">
              {t.tableCup}
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th scope="row" class="px-2 py-1.5 font-medium">
                {t.ingredients[r.id]}
              </th>
              <td class="px-2 py-1.5">{formatAmount(r.tsp)} g</td>
              <td class="px-2 py-1.5">{formatAmount(r.tbsp)} g</td>
              <td class="px-2 py-1.5">{formatAmount(r.cup)} g</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</ToolShell>

<script>
  import {
    convertCooking,
    COOKING_UNITS,
    formatAmount,
    type CookingUnit,
    type CupStandard,
    type IngredientId,
  } from '../../lib/tools/cooking-unit-converter';
  import { copyText } from '../../lib/clipboard';

  const root = document.getElementById('cook-root')!;
  const amountInput = document.getElementById(
    'cook-amount',
  ) as HTMLInputElement;
  const fromSelect = document.getElementById('cook-from') as HTMLSelectElement;
  const ingredientSelect = document.getElementById(
    'cook-ingredient',
  ) as HTMLSelectElement;
  const cupSelect = document.getElementById('cook-cup') as HTMLSelectElement;
  const errorEl = document.getElementById('cook-error')!;
  const resultsEl = document.getElementById('cook-results')!;
  const copyButton = document.getElementById('cook-copy-button')!;
  const copyStatus = document.getElementById('cook-copy-status')!;

  let copyText_ = '';

  function render() {
    errorEl.textContent = '';
    copyStatus.textContent = '';
    const raw = amountInput.value.trim();
    if (raw === '') {
      resultsEl.classList.add('hidden');
      return;
    }
    const result = convertCooking({
      amount: Number(raw),
      from: fromSelect.value as CookingUnit,
      ingredient: ingredientSelect.value as IngredientId,
      cup: cupSelect.value as CupStandard,
    });
    if (result === null) {
      errorEl.textContent = root.dataset.error ?? '';
      resultsEl.classList.add('hidden');
      return;
    }
    const lines: string[] = [];
    for (const unit of COOKING_UNITS) {
      const el = document.getElementById(`cook-result-${unit}`)!;
      const value = formatAmount(result[unit]);
      el.textContent = value;
      lines.push(`${el.dataset.label} ${value}`);
    }
    copyText_ = lines.join(' / ');
    resultsEl.classList.remove('hidden');
  }

  amountInput.addEventListener('input', render);
  for (const el of [fromSelect, ingredientSelect, cupSelect]) {
    el.addEventListener('change', render);
  }
  copyButton.addEventListener('click', async () => {
    const ok = await copyText(copyText_);
    copyStatus.textContent =
      (ok ? root.dataset.copied : root.dataset.copyFailed) ?? '';
  });

  render();
</script>
