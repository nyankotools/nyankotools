---
import ToolShell from '../ToolShell.astro';
import { cssBorderRadiusGeneratorContent } from '../../i18n/tools/css-border-radius-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = cssBorderRadiusGeneratorContent[locale];
---

<ToolShell t={t}>
  <div class="mb-6 flex flex-wrap items-end gap-4">
    <label class="ui-check">
      <input id="br-link-corners" type="checkbox" class="h-4 w-4" checked />
      {t.linkCornersLabel}
    </label>
    <label class="text-sm text-gray-700 dark:text-gray-300">
      <span class="mb-1 block">{t.unitLabel}</span>
      <select
        id="br-unit-select"
        class="ui-input h-11 w-24 px-3 dark:bg-gray-900"
      >
        <option value="px">px</option>
        <option value="%">%</option>
      </select>
    </label>
  </div>

  <div class="mb-6">
    <h2 class="mb-2 text-lg font-bold">{t.cornersHeading}</h2>
    <div class="flex flex-wrap gap-3">
      <label class="text-sm text-gray-700 dark:text-gray-300">
        <span class="mb-1 block">{t.topLeftLabel}</span>
        <input
          id="br-top-left"
          data-corner
          type="number"
          min="0"
          max="500"
          value="8"
          class="ui-input h-11 w-24 px-2 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-gray-900"
        />
      </label>
      <label class="text-sm text-gray-700 dark:text-gray-300">
        <span class="mb-1 block">{t.topRightLabel}</span>
        <input
          id="br-top-right"
          data-corner
          type="number"
          min="0"
          max="500"
          value="8"
          class="ui-input h-11 w-24 px-2 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-gray-900"
        />
      </label>
      <label class="text-sm text-gray-700 dark:text-gray-300">
        <span class="mb-1 block">{t.bottomRightLabel}</span>
        <input
          id="br-bottom-right"
          data-corner
          type="number"
          min="0"
          max="500"
          value="8"
          class="ui-input h-11 w-24 px-2 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-gray-900"
        />
      </label>
      <label class="text-sm text-gray-700 dark:text-gray-300">
        <span class="mb-1 block">{t.bottomLeftLabel}</span>
        <input
          id="br-bottom-left"
          data-corner
          type="number"
          min="0"
          max="500"
          value="8"
          class="ui-input h-11 w-24 px-2 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-gray-900"
        />
      </label>
    </div>
  </div>

  <h2 class="mb-2 text-lg font-bold">{t.previewHeading}</h2>
  <div class="mb-6 flex h-48 w-full items-center justify-center overflow-auto rounded-lg border border-gray-300 bg-gray-100 p-10 sm:h-64 dark:border-gray-700 dark:bg-gray-950">
    <div id="br-preview" class="h-24 w-40 shrink-0 bg-blue-500"></div>
  </div>

  <div data-copied={t.copied} data-copy-failed={t.copyFailed}>
    <label for="br-css-output" class="ui-label">
      {t.cssHeading}
    </label>
    <div class="flex gap-2">
      <textarea
        id="br-css-output"
        readonly
        rows="2"
        class="ui-input h-16 w-full min-w-0 resize-none bg-gray-50 p-3 font-mono dark:bg-gray-900"
      ></textarea>
      <button
        id="br-copy-button"
        type="button"
        class="ui-btn shrink-0 self-start"
      >
        {t.copyButton}
      </button>
    </div>
    <span
      id="br-status"
      class="mt-2 block text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    buildBorderRadiusValue,
    buildCssDeclaration,
    clampRadius,
    MAX_RADIUS,
    type BorderRadiusCorners,
    type BorderRadiusUnit,
  } from '../../lib/tools/css-border-radius-generator';

  const linkCheckbox = document.getElementById(
    'br-link-corners',
  ) as HTMLInputElement;
  const unitSelect = document.getElementById(
    'br-unit-select',
  ) as HTMLSelectElement;
  const topLeftInput = document.getElementById(
    'br-top-left',
  ) as HTMLInputElement;
  const topRightInput = document.getElementById(
    'br-top-right',
  ) as HTMLInputElement;
  const bottomRightInput = document.getElementById(
    'br-bottom-right',
  ) as HTMLInputElement;
  const bottomLeftInput = document.getElementById(
    'br-bottom-left',
  ) as HTMLInputElement;
  const cornerInputs = [
    topLeftInput,
    topRightInput,
    bottomRightInput,
    bottomLeftInput,
  ];

  const preview = document.getElementById('br-preview')!;
  const cssOutput = document.getElementById(
    'br-css-output',
  ) as HTMLTextAreaElement;
  const copyButton = document.getElementById('br-copy-button')!;
  const statusEl = document.getElementById('br-status')!;

  const copyContainer = cssOutput.closest('[data-copied]') as HTMLElement;
  const copied = copyContainer.dataset.copied ?? '';
  const copyFailed = copyContainer.dataset.copyFailed ?? '';

  function currentUnit(): BorderRadiusUnit {
    return unitSelect.value === '%' ? '%' : 'px';
  }

  function readCorners(): BorderRadiusCorners {
    return {
      topLeft: Number(topLeftInput.value) || 0,
      topRight: Number(topRightInput.value) || 0,
      bottomRight: Number(bottomRightInput.value) || 0,
      bottomLeft: Number(bottomLeftInput.value) || 0,
    };
  }

  function updateOutputs() {
    const unit = currentUnit();
    const corners = readCorners();
    preview.style.borderRadius = buildBorderRadiusValue(corners, unit);
    cssOutput.value = buildCssDeclaration(corners, unit);
  }

  function updateLinkedState() {
    const linked = linkCheckbox.checked;
    [topRightInput, bottomRightInput, bottomLeftInput].forEach((input) => {
      input.disabled = linked;
    });
    if (linked) {
      const value = topLeftInput.value;
      topRightInput.value = value;
      bottomRightInput.value = value;
      bottomLeftInput.value = value;
    }
  }

  function applyUnitToInputs() {
    const unit = currentUnit();
    const max = MAX_RADIUS[unit];
    cornerInputs.forEach((input) => {
      input.max = String(max);
      input.value = String(clampRadius(Number(input.value) || 0, unit));
    });
  }

  cornerInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
      if (linkCheckbox.checked && index === 0) {
        const value = topLeftInput.value;
        topRightInput.value = value;
        bottomRightInput.value = value;
        bottomLeftInput.value = value;
      }
      updateOutputs();
    });
    input.addEventListener('change', () => {
      const unit = currentUnit();
      input.value = String(clampRadius(Number(input.value) || 0, unit));
      if (linkCheckbox.checked && index === 0) {
        const value = topLeftInput.value;
        topRightInput.value = value;
        bottomRightInput.value = value;
        bottomLeftInput.value = value;
      }
      updateOutputs();
    });
  });

  linkCheckbox.addEventListener('change', () => {
    updateLinkedState();
    updateOutputs();
  });

  unitSelect.addEventListener('change', () => {
    applyUnitToInputs();
    updateOutputs();
  });

  copyButton.addEventListener('click', async () => {
    if (!cssOutput.value) return;
    statusEl.textContent = (await copyText(cssOutput.value))
      ? copied
      : copyFailed;
  });

  updateLinkedState();
  updateOutputs();
</script>
