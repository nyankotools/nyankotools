---
import ToolShell from '../ToolShell.astro';
import { curlConverterContent } from '../../i18n/tools/curl-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = curlConverterContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="curl-converter-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="curl-converter-input"
      class="ui-input h-48 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      data-sample={t.sampleCommand}
      spellcheck="false"
    ></textarea>
  </div>

  <div
    id="curl-converter-controls"
    class="mt-4 flex flex-wrap items-center gap-3"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-error-not-curl={t.errorNotCurl}
    data-error-no-url={t.errorNoUrl}
    data-error-unclosed-quote={t.errorUnclosedQuote}
    data-warn-unsupported-option={t.warnUnsupportedOptionTemplate}
    data-warn-file-reference={t.warnFileReferenceTemplate}
    data-warn-insecure={t.warnInsecure}
    data-warn-multiple-urls={t.warnMultipleUrlsTemplate}
    data-warn-body-not-allowed={t.warnBodyNotAllowedTemplate}
  >
    <span class="text-sm text-gray-700 dark:text-gray-300">
      {t.formatLabel}
    </span>
    <div
      id="curl-converter-format"
      class="ui-seg"
      role="group"
      aria-label={t.formatLabel}
    >
      <button
        type="button"
        data-format="fetch"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.formatFetchLabel}
      </button>
      <button
        type="button"
        data-format="axios"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.formatAxiosLabel}
      </button>
    </div>
    <button id="curl-converter-copy-button" type="button" class="ui-btn">
      {t.copyButton}
    </button>
    <span
      id="curl-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <p
    id="curl-converter-error"
    hidden
    role="alert"
    class="ui-error mt-4 max-w-2xl"
  ></p>
  <ul
    id="curl-converter-warnings"
    hidden
    class="mt-4 list-inside list-disc space-y-1 text-sm text-amber-700 dark:text-amber-400"
  ></ul>

  <div class="mt-4">
    <label for="curl-converter-output" class="ui-label">
      {t.outputLabel}
    </label>
    <textarea
      id="curl-converter-output"
      readonly
      class="ui-input h-72 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      spellcheck="false"
    ></textarea>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { onTextInput } from '../../lib/input-scheduler';
  import {
    convertCurl,
    type CurlOutputFormat,
    type CurlWarning,
  } from '../../lib/tools/curl-converter';

  const controls = document.getElementById('curl-converter-controls')!;
  const input = document.getElementById(
    'curl-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'curl-converter-output',
  ) as HTMLTextAreaElement;
  const formatGroup = document.getElementById('curl-converter-format')!;
  const formatButtons =
    formatGroup.querySelectorAll<HTMLButtonElement>('[data-format]');
  const copyButton = document.getElementById('curl-converter-copy-button')!;
  const statusEl = document.getElementById('curl-converter-status')!;
  const errorEl = document.getElementById('curl-converter-error')!;
  const warningsEl = document.getElementById('curl-converter-warnings')!;

  const d = controls.dataset;
  const errorMessages = {
    'not-curl': d.errorNotCurl ?? '',
    'no-url': d.errorNoUrl ?? '',
    'unclosed-quote': d.errorUnclosedQuote ?? '',
  };

  let format: CurlOutputFormat = 'fetch';

  function describeWarning(warning: CurlWarning): string {
    switch (warning.code) {
      case 'unsupported-option':
        return (d.warnUnsupportedOption ?? '').replace(
          '{option}',
          () => warning.option,
        );
      case 'file-reference':
        return (d.warnFileReference ?? '').replace(
          '{value}',
          () => warning.value,
        );
      case 'insecure':
        return d.warnInsecure ?? '';
      case 'body-not-allowed':
        return (d.warnBodyNotAllowed ?? '').replace(
          '{method}',
          () => warning.method,
        );
      case 'multiple-urls':
        return (d.warnMultipleUrls ?? '').replace('{url}', () => warning.url);
    }
  }

  function render() {
    statusEl.textContent = '';
    errorEl.hidden = true;
    errorEl.textContent = '';
    warningsEl.hidden = true;
    warningsEl.replaceChildren();

    const result = convertCurl(input.value, format);
    if (!result.success) {
      output.value = '';
      if (result.reason !== 'empty') {
        errorEl.textContent = errorMessages[result.reason];
        errorEl.hidden = false;
      }
      return;
    }

    output.value = result.code;
    if (result.warnings.length > 0) {
      for (const warning of result.warnings) {
        const li = document.createElement('li');
        li.textContent = describeWarning(warning);
        warningsEl.appendChild(li);
      }
      warningsEl.hidden = false;
    }
  }

  formatButtons.forEach((button) => {
    button.addEventListener('click', () => {
      format = button.dataset.format as CurlOutputFormat;
      formatButtons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button)),
      );
      render();
    });
  });

  onTextInput(input, render);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (d.copied ?? '')
      : (d.copyFailed ?? '');
  });

  input.value = input.dataset.sample ?? '';
  render();
</script>
