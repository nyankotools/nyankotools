---
import ToolShell from '../ToolShell.astro';
import { dueDateCalculatorContent } from '../../i18n/tools/due-date-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dueDateCalculatorContent[locale];
---

<ToolShell t={t}>
  <p
    class="mb-4 rounded-md border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100"
    role="note"
  >
    {t.disclaimer}
  </p>

  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    id="due-root"
    data-locale={locale}
    data-error-date={t.errorInvalidDate}
    data-error-cycle={t.errorCycle}
    data-date-labels={JSON.stringify({
      lmp: t.dateLabelLmp,
      ovulation: t.dateLabelOvulation,
      due: t.dateLabelDue,
    })}
    data-result-format={JSON.stringify(t.resultFormat)}
  >
    <div class="flex flex-wrap items-end gap-4">
      <div>
        <label for="due-mode" class="ui-label">
          {t.modeLabel}
        </label>
        <select id="due-mode" class="ui-input h-11 px-3 dark:bg-gray-900">
          <option value="lmp">{t.modeLmp}</option>
          <option value="ovulation">{t.modeOvulation}</option>
          <option value="due">{t.modeDue}</option>
        </select>
      </div>
      <div>
        <label for="due-date" id="due-date-label" class="ui-label">
          {t.dateLabelLmp}
        </label>
        <input
          id="due-date"
          type="date"
          min="1900-01-01"
          max="2100-12-31"
          class="ui-input h-11 px-3 dark:bg-gray-900"
        />
      </div>
      <div id="due-cycle-field">
        <label for="due-cycle" class="ui-label">
          {t.cycleLabel}
        </label>
        <div class="flex items-center gap-1">
          <input
            id="due-cycle"
            type="number"
            inputmode="numeric"
            min="21"
            max="45"
            value="28"
            class="ui-input h-11 w-20 px-3 dark:bg-gray-900"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {t.cycleUnit}
          </span>
        </div>
      </div>
      <div>
        <label for="due-reference" class="ui-label">
          {t.referenceLabel}
        </label>
        <input
          id="due-reference"
          type="date"
          min="1900-01-01"
          max="2100-12-31"
          class="ui-input h-11 px-3 dark:bg-gray-900"
        />
      </div>
    </div>
    <p
      id="due-cycle-hint"
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
    >
      {t.cycleHint}
    </p>
    <p
      id="due-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div id="due-results" class="mt-4 hidden space-y-4" aria-live="polite">
      <dl class="space-y-3">
        <div>
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.dueDateLabel}
          </dt>
          <dd class="text-2xl font-bold" id="due-result-due"></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.currentLabel}
          </dt>
          <dd class="text-lg font-semibold" id="due-result-current"></dd>
          <dd
            class="text-sm text-gray-600 dark:text-gray-400"
            id="due-result-status"
          ></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.monthLabel}
          </dt>
          <dd class="text-lg font-semibold" id="due-result-month"></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.startLabel}
          </dt>
          <dd class="text-lg font-semibold" id="due-result-start"></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.ovulationLabel}
          </dt>
          <dd class="text-lg font-semibold" id="due-result-ovulation"></dd>
        </div>
      </dl>
      <div>
        <h2 class="text-sm font-semibold text-gray-700 dark:text-gray-300">
          {t.milestonesLabel}
        </h2>
        <ul id="due-milestones" class="mt-2 space-y-2 text-sm"></ul>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import {
    calculateDueDate,
    calculateGestationalAge,
    calculateMilestones,
    MAX_CYCLE_DAYS,
    MIN_CYCLE_DAYS,
    type DueDateMode,
  } from '../../lib/tools/due-date-calculator';
  import { count, fill } from '../../lib/format-template';
  import type { DueDateResultFormat } from '../../i18n/tools/due-date-calculator';
  import { getWeekday, type DateParts } from '../../lib/tools/date-calculator';

  const root = document.getElementById('due-root')!;
  const format: DueDateResultFormat = JSON.parse(
    root.dataset.resultFormat ?? '{}',
  );
  const dateLabels: Record<string, string> = JSON.parse(
    root.dataset.dateLabels ?? '{}',
  );
  const errorDate = root.dataset.errorDate ?? '';
  const errorCycle = root.dataset.errorCycle ?? '';

  const modeSelect = document.getElementById('due-mode') as HTMLSelectElement;
  const dateInput = document.getElementById('due-date') as HTMLInputElement;
  const dateLabel = document.getElementById('due-date-label')!;
  const cycleField = document.getElementById('due-cycle-field')!;
  const cycleHint = document.getElementById('due-cycle-hint')!;
  const cycleInput = document.getElementById('due-cycle') as HTMLInputElement;
  const referenceInput = document.getElementById(
    'due-reference',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('due-error')!;
  const resultsEl = document.getElementById('due-results')!;
  const dueEl = document.getElementById('due-result-due')!;
  const currentEl = document.getElementById('due-result-current')!;
  const statusEl = document.getElementById('due-result-status')!;
  const monthEl = document.getElementById('due-result-month')!;
  const startEl = document.getElementById('due-result-start')!;
  const ovulationEl = document.getElementById('due-result-ovulation')!;
  const milestonesEl = document.getElementById('due-milestones')!;

  function parseDate(value: string): DateParts | null {
    const m = /^(\d{4,6})-(\d{2})-(\d{2})$/.exec(value);
    if (!m) return null;
    return { year: Number(m[1]), month: Number(m[2]), day: Number(m[3]) };
  }

  const pad2 = (n: number) => String(n).padStart(2, '0');
  function formatDate(date: DateParts): string {
    const w = getWeekday(date.year, date.month, date.day) ?? 0;
    return fill(format.date, {
      y: String(date.year),
      m: String(date.month),
      d: String(date.day),
      mm: pad2(date.month),
      dd: pad2(date.day),
      w: format.weekdayLabels[w],
    });
  }
  function relative(days: number): string {
    if (days === 0) return format.relativeToday;
    const text = count(format.relativeDays, Math.abs(days));
    return fill(days > 0 ? format.relativeFuture : format.relativePast, {
      days: text,
    });
  }

  function render() {
    const mode = modeSelect.value as DueDateMode;
    dateLabel.textContent = dateLabels[mode] ?? '';
    const isLmp = mode === 'lmp';
    cycleField.classList.toggle('hidden', !isLmp);
    cycleHint.classList.toggle('hidden', !isLmp);

    errorEl.textContent = '';
    resultsEl.classList.add('hidden');

    if (dateInput.value === '') return;
    const date = parseDate(dateInput.value);
    if (!date) {
      errorEl.textContent = errorDate;
      return;
    }
    let cycleLength: number | undefined;
    if (isLmp) {
      cycleLength =
        cycleInput.value.trim() === '' ? 28 : Number(cycleInput.value);
      if (
        !Number.isInteger(cycleLength) ||
        cycleLength < MIN_CYCLE_DAYS ||
        cycleLength > MAX_CYCLE_DAYS
      ) {
        errorEl.textContent = errorCycle;
        return;
      }
    }
    const result = calculateDueDate({ mode, date, cycleLength });
    if (!result) {
      errorEl.textContent = errorDate;
      return;
    }
    const reference = parseDate(referenceInput.value);
    if (!reference) return;
    const age = calculateGestationalAge(result, reference);
    if (!age) {
      errorEl.textContent = errorDate;
      return;
    }

    dueEl.textContent = formatDate(result.dueDate);
    startEl.textContent = formatDate(result.startDate);
    ovulationEl.textContent = formatDate(result.ovulationDate);

    if (age.status === 'beforeStart') {
      currentEl.textContent = '-';
      monthEl.textContent = '-';
      statusEl.textContent = format.beforeStart;
    } else {
      currentEl.textContent = fill(format.gestation, {
        weeks: count(format.weeks, age.weeks),
        days: count(format.days, age.days),
      });
      monthEl.textContent = fill(format.month, { n: String(age.month) });
      const parts: string[] = [];
      if (age.daysToDue > 0) {
        parts.push(
          fill(format.dueIn, { days: count(format.days, age.daysToDue) }),
        );
      } else if (age.daysToDue === 0) {
        parts.push(format.dueToday);
      } else {
        parts.push(
          fill(format.dueOver, {
            days: count(format.days, -age.daysToDue),
          }),
        );
      }
      if (age.status === 'overdue') parts.push(format.overdue);
      statusEl.textContent = parts.join(' ');
    }

    milestonesEl.textContent = '';
    for (const m of calculateMilestones(result, reference)) {
      const text = format.milestones[m.key];
      const li = document.createElement('li');
      const head = document.createElement('div');
      head.className = 'font-medium';
      head.textContent = fill(format.milestoneLine, {
        week: String(m.week),
        date: formatDate(m.date),
        name: text.name,
        relative: relative(m.daysFromReference),
      });
      const desc = document.createElement('div');
      desc.className = 'text-gray-600 dark:text-gray-400';
      desc.textContent = text.description;
      li.append(head, desc);
      milestonesEl.append(li);
    }

    resultsEl.classList.remove('hidden');
  }

  modeSelect.addEventListener('change', render);
  dateInput.addEventListener('input', render);
  dateInput.addEventListener('change', render);
  cycleInput.addEventListener('input', render);
  referenceInput.addEventListener('input', render);
  referenceInput.addEventListener('change', render);

  const today = new Date();
  referenceInput.value = `${today.getFullYear()}-${pad2(today.getMonth() + 1)}-${pad2(today.getDate())}`;
  render();
</script>
