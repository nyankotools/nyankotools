---
import ToolShell from '../ToolShell.astro';
import { emailHeaderAnalyzerContent } from '../../i18n/tools/email-header-analyzer';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = emailHeaderAnalyzerContent[locale];

const clientText = {
  summaryLabels: t.summaryLabels,
  none: t.none,
  noWarnings: t.noWarnings,
  warnings: t.warnings,
  authNone: t.authNone,
  authStatusLabels: t.authStatusLabels,
  hopsNone: t.hopsNone,
  invalidNotice: t.invalidNotice,
  emptyError: t.emptyError,
};
---

<ToolShell t={t}>
  <section id="eha" data-text={JSON.stringify(clientText)}>
    <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
      <label for="eha-input" class="ui-label mb-0">
        {t.inputLabel}
      </label>
      <button type="button" id="eha-sample-button" class="ui-btn">
        {t.sampleButton}
      </button>
    </div>
    <textarea
      id="eha-input"
      rows="10"
      placeholder={t.inputPlaceholder}
      class="ui-input w-full p-3 font-mono text-sm dark:bg-gray-900"
      spellcheck="false"
      autocomplete="off"
      data-sample-text={t.sampleText}
    ></textarea>
    <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">{t.inputHint}</p>

    <div class="mt-3 flex flex-wrap gap-2">
      <button
        type="button"
        id="eha-analyze-button"
        class="ui-btn ui-btn-primary"
      >
        {t.analyzeButton}
      </button>
      <button type="button" id="eha-clear-button" class="ui-btn">
        {t.clearButton}
      </button>
    </div>
    <p
      id="eha-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      id="eha-invalid"
      class="mt-1 text-xs text-gray-600 dark:text-gray-400"
      aria-live="polite"
    ></p>

    <div id="eha-results" class="mt-5 hidden">
      <h2 class="mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.summaryHeading}
      </h2>
      <dl id="eha-summary" class="space-y-1 text-sm"></dl>

      <h2 class="mt-6 mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.warningsHeading}
      </h2>
      <ul id="eha-warnings" class="space-y-2"></ul>

      <h2 class="mt-6 mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.authHeading}
      </h2>
      <p id="eha-auth-none" class="hidden text-sm"></p>
      <div id="eha-auth-wrap" class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.authMethodLabel}
              </th>
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.authResultLabel}
              </th>
              <th scope="col" class="py-2 font-medium">
                {t.authDetailLabel}
              </th>
            </tr>
          </thead>
          <tbody id="eha-auth"></tbody>
        </table>
      </div>

      <h2 class="mt-6 mb-2 text-sm text-gray-600 dark:text-gray-400">
        {t.hopsHeading}
      </h2>
      <p id="eha-hops-none" class="hidden text-sm"></p>
      <div id="eha-hops-wrap" class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.hopNumberLabel}
              </th>
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.hopFromLabel}
              </th>
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.hopByLabel}
              </th>
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.hopIpLabel}
              </th>
              <th scope="col" class="py-2 pr-3 font-medium">
                {t.hopTimeLabel}
              </th>
              <th scope="col" class="py-2 font-medium">
                {t.hopDelayLabel}
              </th>
            </tr>
          </thead>
          <tbody id="eha-hops"></tbody>
        </table>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import {
    analyzeEmailHeaders,
    formatDuration,
    LONG_DELAY_SECONDS,
    parseRawHeaders,
    type AuthStatus,
    type Mailbox,
    type WarningCode,
  } from '../../lib/tools/email-header-analyzer';

  interface ClientText {
    summaryLabels: Record<string, string>;
    none: string;
    noWarnings: string;
    warnings: Record<WarningCode, string>;
    authNone: string;
    authStatusLabels: Record<AuthStatus, string>;
    hopsNone: string;
    invalidNotice: string;
    emptyError: string;
  }

  const section = document.getElementById('eha')!;
  const text: ClientText = JSON.parse(section.dataset.text ?? '{}');

  const input = document.getElementById('eha-input') as HTMLTextAreaElement;
  const sampleButton = document.getElementById('eha-sample-button')!;
  const analyzeButton = document.getElementById('eha-analyze-button')!;
  const clearButton = document.getElementById('eha-clear-button')!;
  const errorEl = document.getElementById('eha-error')!;
  const invalidEl = document.getElementById('eha-invalid')!;
  const resultsEl = document.getElementById('eha-results')!;
  const summaryEl = document.getElementById('eha-summary')!;
  const warningsEl = document.getElementById('eha-warnings')!;
  const authEl = document.getElementById('eha-auth')!;
  const authWrap = document.getElementById('eha-auth-wrap')!;
  const authNone = document.getElementById('eha-auth-none')!;
  const hopsEl = document.getElementById('eha-hops')!;
  const hopsWrap = document.getElementById('eha-hops-wrap')!;
  const hopsNone = document.getElementById('eha-hops-none')!;

  const badgeClass: Record<AuthStatus, string> = {
    pass: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
    warn: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    fail: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
  };

  function cell(
    tag: 'td' | 'th',
    content: string | Node,
    className = 'py-2 pr-3 align-top break-all',
  ) {
    const el = document.createElement(tag);
    el.className = className;
    if (tag === 'th') el.scope = 'row';
    if (typeof content === 'string') el.textContent = content;
    else el.append(content);
    return el;
  }

  function mailboxText(m: Mailbox | null): string {
    if (!m) return text.none;
    const addr = m.address ?? '<>';
    return m.displayName ? `${m.displayName} <${addr}>` : addr;
  }

  function badge(status: AuthStatus, label: string) {
    const span = document.createElement('span');
    span.className = `rounded px-2 py-0.5 text-xs font-medium ${badgeClass[status]}`;
    span.textContent = label;
    return span;
  }

  function analyze() {
    errorEl.textContent = '';
    invalidEl.textContent = '';
    resultsEl.classList.add('hidden');

    const parsed = parseRawHeaders(input.value);
    if (parsed.headers.length === 0) {
      errorEl.textContent = text.emptyError;
      return;
    }
    if (parsed.invalidCount > 0) {
      invalidEl.textContent = text.invalidNotice.replace(
        '{count}',
        String(parsed.invalidCount),
      );
    }

    const a = analyzeEmailHeaders(parsed.headers);
    const labels = text.summaryLabels;

    const rows: [string, string][] = [
      [labels.subject, a.summary.subject || text.none],
      [labels.from, mailboxText(a.summary.from)],
      [labels.to, a.summary.to || text.none],
      [labels.date, a.summary.date || text.none],
      [labels.messageId, a.summary.messageId || text.none],
      [labels.returnPath, mailboxText(a.summary.returnPath)],
      [labels.replyTo, mailboxText(a.summary.replyTo)],
    ];
    if (a.totalDelaySeconds !== null) {
      rows.push([labels.totalDelay, formatDuration(a.totalDelaySeconds)]);
    }
    summaryEl.replaceChildren(
      ...rows.map(([label, value]) => {
        const wrap = document.createElement('div');
        wrap.className = 'grid gap-x-3 sm:grid-cols-[10rem_1fr]';
        const dt = document.createElement('dt');
        dt.className = 'text-gray-600 dark:text-gray-400';
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.className = 'break-all';
        dd.textContent = value;
        wrap.append(dt, dd);
        return wrap;
      }),
    );

    if (a.warnings.length === 0) {
      const li = document.createElement('li');
      li.className = 'text-sm';
      li.textContent = text.noWarnings;
      warningsEl.replaceChildren(li);
    } else {
      warningsEl.replaceChildren(
        ...a.warnings.map((w) => {
          const li = document.createElement('li');
          li.className =
            'rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-gray-900 dark:border-amber-700 dark:bg-amber-900/20 dark:text-gray-100';
          li.textContent = text.warnings[w.code];
          if (w.detail) {
            const code = document.createElement('code');
            code.className = 'mt-1 block text-xs break-all';
            code.textContent = w.detail;
            li.append(code);
          }
          return li;
        }),
      );
    }

    authNone.textContent = text.authNone;
    authNone.classList.toggle('hidden', a.auth.length > 0);
    authWrap.classList.toggle('hidden', a.auth.length === 0);
    authEl.replaceChildren(
      ...a.auth.map((r) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-gray-100 dark:border-gray-800';
        tr.append(
          cell('th', r.method.toUpperCase(), 'py-2 pr-3 align-top font-normal'),
          cell(
            'td',
            badge(r.status, `${r.result} (${text.authStatusLabels[r.status]})`),
          ),
          cell('td', r.detail || '-', 'py-2 align-top break-all'),
        );
        return tr;
      }),
    );

    hopsNone.textContent = text.hopsNone;
    hopsNone.classList.toggle('hidden', a.hops.length > 0);
    hopsWrap.classList.toggle('hidden', a.hops.length === 0);
    hopsEl.replaceChildren(
      ...a.hops.map((h) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-gray-100 dark:border-gray-800';
        const delay =
          h.delaySeconds === null ? '-' : formatDuration(h.delaySeconds);
        const slow =
          h.delaySeconds !== null && h.delaySeconds >= LONG_DELAY_SECONDS;
        const negative = h.delaySeconds !== null && h.delaySeconds < -60;
        tr.append(
          cell('th', String(h.index), 'py-2 pr-3 align-top font-normal'),
          cell('td', h.from ?? '-'),
          cell('td', h.by ?? '-'),
          cell('td', h.ip ?? '-'),
          cell('td', h.rawDate.replace(/\([^)]*\)/g, '').trim() || '-'),
          cell(
            'td',
            delay,
            `py-2 align-top break-all ${
              slow || negative
                ? 'font-semibold text-red-700 dark:text-red-400'
                : ''
            }`,
          ),
        );
        return tr;
      }),
    );

    resultsEl.classList.remove('hidden');
  }

  analyzeButton.addEventListener('click', analyze);
  sampleButton.addEventListener('click', () => {
    input.value = input.dataset.sampleText ?? '';
    analyze();
  });
  clearButton.addEventListener('click', () => {
    input.value = '';
    errorEl.textContent = '';
    invalidEl.textContent = '';
    resultsEl.classList.add('hidden');
    input.focus();
  });
</script>
