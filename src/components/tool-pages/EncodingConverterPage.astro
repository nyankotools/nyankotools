---
import ToolShell from '../ToolShell.astro';
import { encodingConverterContent } from '../../i18n/tools/encoding-converter';
import { ENCODINGS } from '../../lib/tools/encoding-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = encodingConverterContent[locale];

const selectClass =
  'min-h-11 rounded-lg border border-gray-300 bg-white px-3 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100';
const buttonClass = 'ui-btn';
const labelClass =
  'mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300';
const textareaClass =
  'h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500';
---

<ToolShell t={t}>
  <div id="enc-mode" class="ui-seg mb-6" role="group" aria-label={t.modeLabel}>
    <button
      type="button"
      data-mode="convert"
      aria-pressed="true"
      class="ui-seg-btn flex-1"
    >
      {t.modeConvert}
    </button>
    <button
      type="button"
      data-mode="diagnose"
      aria-pressed="false"
      class="ui-seg-btn flex-1"
    >
      {t.modeDiagnose}
    </button>
  </div>

  <section
    id="enc-convert-section"
    data-labels={JSON.stringify(t.encodingLabels)}
    data-detected-template={t.detectedTemplate}
    data-detected-ascii={t.detectedAscii}
    data-detected-unknown={t.detectedUnknown}
    data-invalid-template={t.invalidBytesTemplate}
    data-unmappable-template={t.unmappableTemplate}
    data-read-failed={t.readFailed}
  >
    <label for="enc-file-input" class={labelClass}>
      {t.fileLabel}
    </label>
    <div id="enc-dropzone" class="ui-dropzone">
      <input id="enc-file-input" type="file" class="ui-file" />
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{t.fileHint}</p>
    </div>
    <p
      id="enc-file-error"
      role="alert"
      hidden
      class="mt-1 text-xs text-red-600 dark:text-red-400"
    ></p>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <label
        for="enc-source"
        class="text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.sourceLabel}
      </label>
      <select id="enc-source" class={selectClass}>
        <option value="auto">{t.sourceAuto}</option>
        {ENCODINGS.map((enc) => (
          <option value={enc}>{t.encodingLabels[enc]}</option>
        ))}
      </select>
      <span
        id="enc-detected"
        class="text-sm text-gray-600 dark:text-gray-400"
        aria-live="polite"
      ></span>
    </div>
    <p
      id="enc-invalid"
      role="alert"
      hidden
      class="mt-2 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300"
    ></p>

    <label for="enc-text" class={`${labelClass} mt-4`}>
      {t.textLabel}
    </label>
    <textarea
      id="enc-text"
      class={textareaClass}
      placeholder={t.textPlaceholder}
      spellcheck="false"
    ></textarea>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <label
        for="enc-target"
        class="text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.targetLabel}
      </label>
      <select id="enc-target" class={selectClass}>
        {ENCODINGS.map((enc) => (
          <option value={enc}>{t.encodingLabels[enc]}</option>
        ))}
      </select>
      <label class="inline-flex min-h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <input id="enc-bom" type="checkbox" class="h-4 w-4" />
        {t.bomLabel}
      </label>
      <label
        for="enc-line-ending"
        class="text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.lineEndingLabel}
      </label>
      <select id="enc-line-ending" class={selectClass}>
        <option value="keep">{t.lineEndingKeep}</option>
        <option value="lf">LF</option>
        <option value="crlf">CRLF</option>
      </select>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <label
        for="enc-filename"
        class="text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.filenameLabel}
      </label>
      <input
        id="enc-filename"
        type="text"
        value="converted.txt"
        class="min-h-11 w-64 max-w-full rounded-lg border border-gray-300 px-3 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      />
      <button id="enc-download" type="button" class={buttonClass}>
        {t.downloadButton}
      </button>
    </div>
    <p
      id="enc-unmappable"
      hidden
      class="mt-2 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300"
    ></p>
  </section>

  <section
    id="enc-diagnose-section"
    hidden
    data-labels={JSON.stringify({
      ...t.encodingLabels,
      'windows-1252': t.windows1252Label,
    })}
    data-candidate-template={t.diagnoseCandidateTemplate}
    data-copy={t.copy}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <label for="enc-garbled" class={labelClass}>
      {t.diagnoseInputLabel}
    </label>
    <textarea
      id="enc-garbled"
      class={`${textareaClass} h-40`}
      placeholder={t.diagnoseInputPlaceholder}
      spellcheck="false"
    ></textarea>

    <h2 class="mt-6 mb-2 text-lg font-bold">{t.diagnoseResultHeading}</h2>
    <p
      id="enc-diagnose-message"
      class="text-sm text-gray-600 dark:text-gray-400"
      data-none={t.diagnoseNone}
      data-empty={t.diagnoseEmptyHint}
    >
      {t.diagnoseEmptyHint}
    </p>
    <ul id="enc-diagnose-results" class="space-y-3"></ul>
  </section>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { enableFileDrop } from '../../lib/file-drop';
  import { downloadBlob } from '../../lib/download';
  import { copyText } from '../../lib/clipboard';
  import {
    applyLineEnding,
    decodeBytes,
    detectEncoding,
    detectLineEnding,
    diagnoseMojibake,
    encodeText,
    type Encoding,
    type LineEnding,
  } from '../../lib/tools/encoding-converter';

  const convertSection = document.getElementById('enc-convert-section')!;
  const diagnoseSection = document.getElementById('enc-diagnose-section')!;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#enc-mode [data-mode]',
  );

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const diagnose = button.dataset.mode === 'diagnose';
      convertSection.hidden = diagnose;
      diagnoseSection.hidden = !diagnose;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
    });
  });

  function fill(template: string, values: Record<string, string>) {
    return template.replace(/\{(\w+)\}/g, (_, key) => values[key] ?? '');
  }

  // ---------- ファイル変換 ----------
  const fileInput = document.getElementById(
    'enc-file-input',
  ) as HTMLInputElement;
  const fileError = document.getElementById('enc-file-error')!;
  const sourceSelect = document.getElementById(
    'enc-source',
  ) as HTMLSelectElement;
  const detectedEl = document.getElementById('enc-detected')!;
  const invalidEl = document.getElementById('enc-invalid')!;
  const textArea = document.getElementById('enc-text') as HTMLTextAreaElement;
  const targetSelect = document.getElementById(
    'enc-target',
  ) as HTMLSelectElement;
  const lineEndingSelect = document.getElementById(
    'enc-line-ending',
  ) as HTMLSelectElement;
  const bomCheck = document.getElementById('enc-bom') as HTMLInputElement;
  const filenameInput = document.getElementById(
    'enc-filename',
  ) as HTMLInputElement;
  const downloadButton = document.getElementById(
    'enc-download',
  ) as HTMLButtonElement;
  const unmappableEl = document.getElementById('enc-unmappable')!;

  const convertLabels = JSON.parse(
    convertSection.dataset.labels ?? '{}',
  ) as Record<string, string>;

  let fileBytes: Uint8Array | null = null;
  // textarea の value は改行を LF に正規化するため、読み込み時の改行を別に覚えておく
  let sourceLineEnding: LineEnding = 'lf';

  function loadBytes() {
    if (!fileBytes) return;
    const detected = detectEncoding(fileBytes);
    const chosen = sourceSelect.value;
    const encoding: Encoding =
      chosen === 'auto' ? detected.best : (chosen as Encoding);

    if (chosen === 'auto') {
      if (detected.ascii) {
        detectedEl.textContent = convertSection.dataset.detectedAscii ?? '';
      } else if (detected.candidates.length === 0) {
        detectedEl.textContent = convertSection.dataset.detectedUnknown ?? '';
      } else {
        detectedEl.textContent = fill(
          convertSection.dataset.detectedTemplate ?? '',
          { encoding: convertLabels[encoding] },
        );
      }
    } else {
      detectedEl.textContent = '';
    }

    const { text, errorCount } = decodeBytes(fileBytes, encoding);
    sourceLineEnding = detectLineEnding(text);
    textArea.value = text;
    if (errorCount > 0) {
      invalidEl.textContent = fill(
        convertSection.dataset.invalidTemplate ?? '',
        { count: String(errorCount) },
      );
      invalidEl.hidden = false;
    } else {
      invalidEl.hidden = true;
    }
    updateUnmappable();
  }

  function updateUnmappable() {
    const target = targetSelect.value as Encoding;
    const { unmappable } = encodeText(textArea.value, target);
    if (unmappable.length === 0) {
      unmappableEl.hidden = true;
      return;
    }
    const shown = unmappable.slice(0, 10).join(' ');
    unmappableEl.textContent = fill(
      convertSection.dataset.unmappableTemplate ?? '',
      {
        encoding: convertLabels[target],
        chars: unmappable.length > 10 ? `${shown} …` : shown,
      },
    );
    unmappableEl.hidden = false;
  }

  function updateBomState() {
    const target = targetSelect.value;
    const supportsBom = target === 'utf-8' || target.startsWith('utf-16');
    bomCheck.disabled = !supportsBom;
    if (!supportsBom) bomCheck.checked = false;
  }

  async function handleFile(file: File) {
    fileError.hidden = true;
    try {
      fileBytes = new Uint8Array(await file.arrayBuffer());
    } catch {
      fileBytes = null;
      fileError.textContent = convertSection.dataset.readFailed ?? '';
      fileError.hidden = false;
      return;
    }
    const base = file.name.replace(/\.[^.]*$/, '') || 'converted';
    const ext = /\.[^.]+$/.exec(file.name)?.[0] ?? '.txt';
    filenameInput.value = `${base}_converted${ext}`;
    loadBytes();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    // 同じファイルを続けて選んでも change が発火するようクリアする
    fileInput.value = '';
    if (file) void handleFile(file);
  });

  const dropzone = document.getElementById('enc-dropzone')!;
  enableFileDrop(dropzone, fileInput);

  sourceSelect.addEventListener('change', loadBytes);
  onTextInput(textArea, updateUnmappable);
  targetSelect.addEventListener('change', () => {
    updateBomState();
    updateUnmappable();
  });

  downloadButton.addEventListener('click', () => {
    const target = targetSelect.value as Encoding;
    const ending =
      lineEndingSelect.value === 'keep'
        ? sourceLineEnding
        : (lineEndingSelect.value as LineEnding);
    const { bytes } = encodeText(
      applyLineEnding(textArea.value, ending),
      target,
      {
        bom: bomCheck.checked,
      },
    );
    const blob = new Blob([bytes as BlobPart], {
      type: 'application/octet-stream',
    });
    downloadBlob(blob, filenameInput.value.trim() || 'converted.txt');
  });

  updateBomState();

  // ---------- 文字化け診断 ----------
  const garbledInput = document.getElementById(
    'enc-garbled',
  ) as HTMLTextAreaElement;
  const messageEl = document.getElementById('enc-diagnose-message')!;
  const resultsEl = document.getElementById('enc-diagnose-results')!;
  const diagnoseLabels = JSON.parse(
    diagnoseSection.dataset.labels ?? '{}',
  ) as Record<string, string>;

  function renderDiagnosis() {
    resultsEl.replaceChildren();
    const input = garbledInput.value;
    if (input.trim() === '') {
      messageEl.textContent = messageEl.dataset.empty ?? '';
      messageEl.hidden = false;
      return;
    }
    const candidates = diagnoseMojibake(input);
    if (candidates.length === 0) {
      messageEl.textContent = messageEl.dataset.none ?? '';
      messageEl.hidden = false;
      return;
    }
    messageEl.hidden = true;
    for (const c of candidates) {
      const li = document.createElement('li');
      li.className =
        'rounded-lg border border-gray-200 p-3 dark:border-gray-700';
      const caption = document.createElement('p');
      caption.className = 'mb-1 text-xs text-gray-500 dark:text-gray-400';
      caption.textContent = fill(
        diagnoseSection.dataset.candidateTemplate ?? '',
        {
          actual: diagnoseLabels[c.actual],
          misread: diagnoseLabels[c.misread],
        },
      );
      const pre = document.createElement('pre');
      pre.className =
        'max-h-48 overflow-auto rounded bg-gray-50 p-2 font-mono text-sm break-all whitespace-pre-wrap dark:bg-gray-900 dark:text-gray-100';
      pre.textContent = c.text;
      const row = document.createElement('div');
      row.className = 'mt-2 flex items-center gap-3';
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className =
        'min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800';
      copy.textContent = diagnoseSection.dataset.copy ?? '';
      const status = document.createElement('span');
      status.className = 'text-sm text-green-600 dark:text-green-400';
      status.setAttribute('aria-live', 'polite');
      copy.addEventListener('click', async () => {
        status.textContent = (await copyText(c.text))
          ? (diagnoseSection.dataset.copied ?? '')
          : (diagnoseSection.dataset.copyFailed ?? '');
      });
      row.append(copy, status);
      li.append(caption, pre, row);
      resultsEl.append(li);
    }
  }

  onTextInput(garbledInput, renderDiagnosis);
</script>
