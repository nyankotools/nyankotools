---
import ToolShell from '../ToolShell.astro';
import { fileBase64ConverterContent } from '../../i18n/tools/file-base64-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = fileBase64ConverterContent[locale];
---

<ToolShell t={t}>
  <div id="fb-mode" class="ui-seg mb-6" role="group" aria-label={t.modeLabel}>
    <button
      type="button"
      data-mode="encode"
      aria-pressed="true"
      class="ui-seg-btn flex-1"
    >
      {t.modeEncode}
    </button>
    <button
      type="button"
      data-mode="decode"
      aria-pressed="false"
      class="ui-seg-btn flex-1"
    >
      {t.modeDecode}
    </button>
  </div>

  <section id="fb-encode-section">
    <label for="fb-file-input" class="ui-label">
      {t.encodeDropLabel}
    </label>
    <div id="fb-dropzone" class="ui-dropzone">
      <input id="fb-file-input" type="file" class="ui-file" />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        {t.encodeDropHint}
      </p>
    </div>
    <p
      id="fb-encode-error"
      role="alert"
      hidden
      data-too-large-template={t.errorFileTooLargeTemplate}
      data-read-failed={t.errorReadFailed}
      class="ui-error mt-2 max-w-2xl"
    ></p>
    <p
      id="fb-encode-warn"
      role="status"
      hidden
      data-template={t.warnLargeTemplate}
      class="mt-2 max-w-2xl rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200"
    ></p>

    <div
      id="fb-encode-result"
      hidden
      class="mt-4"
      data-file-info-template={t.encodeFileInfoTemplate}
    >
      <p
        id="fb-encode-file-info"
        class="text-sm text-gray-600 dark:text-gray-400"
      ></p>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
          {t.encodeOutputStyleLabel}
        </span>
        <div
          id="fb-output-style"
          class="ui-seg"
          role="group"
          aria-label={t.encodeOutputStyleLabel}
        >
          <button
            type="button"
            data-style="data-uri"
            aria-pressed="true"
            class="ui-seg-btn"
          >
            {t.encodeOutputStyleDataUri}
          </button>
          <button
            type="button"
            data-style="base64-only"
            aria-pressed="false"
            class="ui-seg-btn"
          >
            {t.encodeOutputStyleBase64Only}
          </button>
        </div>
        <label class="ui-check">
          <input id="fb-wrap" type="checkbox" disabled />
          <span>{t.encodeWrapLabel}</span>
        </label>
      </div>

      <label for="fb-output" class="ui-label mt-4">
        {t.encodeOutputLabel}
      </label>
      <textarea
        id="fb-output"
        readonly
        spellcheck="false"
        class="ui-input h-48 w-full bg-gray-50 p-4 font-mono break-all dark:bg-gray-900"
      ></textarea>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button
          id="fb-copy-button"
          type="button"
          data-copied={t.copiedMessage}
          data-copy-failed={t.copyFailedMessage}
          class="ui-btn"
        >
          {t.copyButton}
        </button>
        <button id="fb-download-button" type="button" class="ui-btn">
          {t.downloadButton}
        </button>
        <button id="fb-clear-button" type="button" class="ui-btn">
          {t.clearButton}
        </button>
        <span
          id="fb-copy-status"
          class="text-sm text-green-700 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>

  <section id="fb-decode-section" hidden>
    <label for="fb-decode-input" class="ui-label">
      {t.decodeInputLabel}
    </label>
    <textarea
      id="fb-decode-input"
      class="ui-input h-48 w-full p-4 font-mono break-all dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.decodeInputPlaceholder}
      spellcheck="false"
    ></textarea>

    <p
      id="fb-decode-error"
      role="alert"
      hidden
      data-message={t.decodeErrorMessage}
      class="ui-error mt-2 max-w-2xl"
    ></p>

    <div
      id="fb-decode-result"
      hidden
      class="mt-4"
      data-info-template={t.decodeInfoTemplate}
    >
      <label for="fb-decode-name" class="ui-label">
        {t.decodeFileNameLabel}
      </label>
      <input
        id="fb-decode-name"
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="ui-input h-11 w-full max-w-sm px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder="file.pdf"
      />
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        {t.decodeFileNameHint}
      </p>

      <span class="ui-label mt-4">{t.decodeResultLabel}</span>
      <p
        id="fb-decode-info"
        class="text-sm text-gray-600 dark:text-gray-400"
      ></p>
      <p
        id="fb-decode-guess"
        hidden
        class="mt-1 text-xs text-gray-500 dark:text-gray-400"
      >
        {t.decodeTypeGuessedNote}
      </p>
      <button id="fb-decode-download" type="button" class="ui-btn-primary mt-3">
        {t.decodeDownloadButton}
      </button>
    </div>
  </section>
</ToolShell>

<script>
  import { enableFileDrop } from '../../lib/file-drop';
  import { copyText } from '../../lib/clipboard';
  import { downloadBlob } from '../../lib/download';
  import {
    MAX_FILE_SIZE,
    bytesToBase64,
    checkFileSize,
    decodeToFile,
    formatFileSize,
    formatOutput,
    getExtensionForMimeType,
    guessMimeType,
    type OutputStyle,
  } from '../../lib/tools/file-base64-converter';

  type Mode = 'encode' | 'decode';

  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#fb-mode [data-mode]',
  );
  const encodeSection = document.getElementById('fb-encode-section')!;
  const decodeSection = document.getElementById('fb-decode-section')!;

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      encodeSection.hidden = mode !== 'encode';
      decodeSection.hidden = mode !== 'decode';
    });
  });

  // --- ファイル→Base64 ---

  const dropzone = document.getElementById('fb-dropzone')!;
  const fileInput = document.getElementById(
    'fb-file-input',
  ) as HTMLInputElement;
  const encodeErrorEl = document.getElementById('fb-encode-error')!;
  const encodeWarnEl = document.getElementById('fb-encode-warn')!;
  const encodeResultEl = document.getElementById('fb-encode-result')!;
  const encodeFileInfoEl = document.getElementById('fb-encode-file-info')!;
  const styleButtons = document.querySelectorAll<HTMLButtonElement>(
    '#fb-output-style [data-style]',
  );
  const wrapCheck = document.getElementById('fb-wrap') as HTMLInputElement;
  const output = document.getElementById('fb-output') as HTMLTextAreaElement;
  const copyButton = document.getElementById(
    'fb-copy-button',
  ) as HTMLButtonElement;
  const downloadButton = document.getElementById(
    'fb-download-button',
  ) as HTMLButtonElement;
  const clearButton = document.getElementById(
    'fb-clear-button',
  ) as HTMLButtonElement;
  const copyStatusEl = document.getElementById('fb-copy-status')!;

  let currentBase64: string | null = null;
  let currentMime = '';
  let currentName = '';
  let style: OutputStyle = 'data-uri';
  let loadToken = 0;

  function showEncodeError(message: string) {
    encodeErrorEl.textContent = message;
    encodeErrorEl.hidden = false;
  }

  function clearMessages() {
    encodeErrorEl.hidden = true;
    encodeErrorEl.textContent = '';
    encodeWarnEl.hidden = true;
    encodeWarnEl.textContent = '';
  }

  function updateOutput() {
    if (currentBase64 === null) return;
    wrapCheck.disabled = style !== 'base64-only';
    output.value = formatOutput(
      currentBase64,
      currentMime,
      style,
      style === 'base64-only' && wrapCheck.checked ? 76 : 0,
    );
  }

  function resetEncode() {
    loadToken++;
    currentBase64 = null;
    output.value = '';
    encodeResultEl.hidden = true;
    copyStatusEl.textContent = '';
  }

  async function handleFile(file: File) {
    const token = ++loadToken;
    clearMessages();
    const sizeState = checkFileSize(file.size);
    if (sizeState === 'too-large') {
      resetEncode();
      showEncodeError(
        (encodeErrorEl.dataset.tooLargeTemplate ?? '').replace(
          '{max}',
          formatFileSize(MAX_FILE_SIZE),
        ),
      );
      return;
    }
    if (sizeState === 'warn') {
      encodeWarnEl.textContent = (encodeWarnEl.dataset.template ?? '')
        .replace('{size}', formatFileSize(file.size))
        .replace('{max}', formatFileSize(MAX_FILE_SIZE));
      encodeWarnEl.hidden = false;
    }

    let base64: string;
    try {
      base64 = bytesToBase64(new Uint8Array(await file.arrayBuffer()));
    } catch {
      showEncodeError(encodeErrorEl.dataset.readFailed ?? '');
      return;
    }
    if (token !== loadToken) return;

    currentBase64 = base64;
    currentName = file.name;
    currentMime = guessMimeType(file.name, file.type);
    encodeFileInfoEl.textContent = (
      encodeResultEl.dataset.fileInfoTemplate ?? ''
    )
      .replace('{name}', () => file.name)
      .replace('{type}', currentMime)
      .replace('{size}', formatFileSize(file.size));
    encodeResultEl.hidden = false;
    copyStatusEl.textContent = '';
    updateOutput();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) void handleFile(file);
  });
  enableFileDrop(dropzone, fileInput);

  styleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      style = button.dataset.style as OutputStyle;
      styleButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      updateOutput();
    });
  });
  wrapCheck.addEventListener('change', updateOutput);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    copyStatusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  downloadButton.addEventListener('click', () => {
    if (!output.value) return;
    downloadBlob(
      new Blob([output.value], { type: 'text/plain' }),
      `${currentName || 'file'}-base64.txt`,
    );
  });

  clearButton.addEventListener('click', () => {
    resetEncode();
    clearMessages();
  });

  // --- Base64→ファイル ---

  const decodeInput = document.getElementById(
    'fb-decode-input',
  ) as HTMLTextAreaElement;
  const decodeErrorEl = document.getElementById('fb-decode-error')!;
  const decodeResultEl = document.getElementById('fb-decode-result')!;
  const decodeNameInput = document.getElementById(
    'fb-decode-name',
  ) as HTMLInputElement;
  const decodeInfoEl = document.getElementById('fb-decode-info')!;
  const decodeGuessEl = document.getElementById('fb-decode-guess')!;
  const decodeDownload = document.getElementById(
    'fb-decode-download',
  ) as HTMLButtonElement;

  let decoded: { bytes: Uint8Array<ArrayBuffer>; mimeType: string } | null =
    null;

  function runDecode() {
    const value = decodeInput.value;
    decoded = null;
    if (value.trim() === '') {
      decodeResultEl.hidden = true;
      decodeErrorEl.hidden = true;
      return;
    }
    const result = decodeToFile(value);
    if (!result.success) {
      decodeResultEl.hidden = true;
      decodeErrorEl.textContent = decodeErrorEl.dataset.message ?? '';
      decodeErrorEl.hidden = false;
      return;
    }
    decodeErrorEl.hidden = true;
    decoded = { bytes: result.bytes, mimeType: result.mimeType };
    decodeInfoEl.textContent = (decodeResultEl.dataset.infoTemplate ?? '')
      .replace('{type}', result.mimeType)
      .replace('{size}', formatFileSize(result.bytes.length));
    decodeGuessEl.hidden = result.mimeFromHeader;
    decodeResultEl.hidden = false;
  }

  let decodeDebounce: ReturnType<typeof setTimeout> | undefined;
  decodeInput.addEventListener('input', () => {
    clearTimeout(decodeDebounce);
    decodeDebounce = setTimeout(runDecode, 250);
  });

  decodeDownload.addEventListener('click', () => {
    if (!decoded) return;
    let name = decodeNameInput.value.trim().replace(/[\\/:*?"<>|]/g, '_');
    if (!name) name = 'file';
    if (!/\.[A-Za-z0-9]{1,8}$/.test(name)) {
      name += `.${getExtensionForMimeType(decoded.mimeType)}`;
    }
    downloadBlob(new Blob([decoded.bytes], { type: decoded.mimeType }), name);
  });
</script>
