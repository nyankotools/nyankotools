---
import ToolShell from '../ToolShell.astro';
import { furusatoNozeiCalculatorContent } from '../../i18n/tools/furusato-nozei-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = furusatoNozeiCalculatorContent[locale];

const results = [
  { id: 'safe-limit', label: t.resultSafeLimitLabel },
  { id: 'deductible', label: t.resultDeductibleLabel },
  { id: 'levy', label: t.resultLevyLabel },
  { id: 'marginal-rate', label: t.resultMarginalRateLabel },
  { id: 'salary-income', label: t.resultSalaryIncomeLabel },
];
---

<ToolShell t={t}>
  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-number-locale={t.numberLocale}
    data-error={t.error}
  >
    <h2 class="mb-3 text-lg font-bold">{t.sectionHeading}</h2>

    <div class="mb-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="furusato-calc-gross" class="ui-label">
          {t.grossLabel}
        </label>
        <input
          id="furusato-calc-gross"
          type="text"
          inputmode="decimal"
          placeholder={t.grossPlaceholder}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <label class="flex h-11 items-center gap-2 text-sm">
        <input id="furusato-calc-age40" type="checkbox" />
        {t.age40Label}
      </label>
    </div>

    <div class="mb-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="furusato-calc-social-insurance" class="ui-label">
          {t.socialInsuranceLabel}
        </label>
        <input
          id="furusato-calc-social-insurance"
          type="text"
          inputmode="decimal"
          placeholder={t.socialInsurancePlaceholder}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <p class="mt-1 max-w-md text-xs text-gray-600 dark:text-gray-400">
          {t.socialInsuranceHint}
        </p>
      </div>
      <div>
        <label for="furusato-calc-other-deductions" class="ui-label">
          {t.otherDeductionsLabel}
        </label>
        <input
          id="furusato-calc-other-deductions"
          type="text"
          inputmode="decimal"
          placeholder={t.otherDeductionsPlaceholder}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
    </div>

    <p
      id="furusato-calc-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div id="furusato-calc-results" class="mt-4 hidden" aria-live="polite">
      <div class="mb-4 rounded-lg bg-gray-50 p-4 dark:bg-gray-800/60">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          {t.resultLimitLabel}
        </p>
        <p id="furusato-calc-result-limit" class="text-2xl font-bold"></p>
        <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
          {t.resultLimitNote}
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {results.map((r) => (
          <div>
            <dt class="text-sm text-gray-600 dark:text-gray-400">{r.label}</dt>
            <dd
              class="text-lg font-semibold"
              id={`furusato-calc-result-${r.id}`}
            />
          </div>
        ))}
      </dl>
    </div>
  </section>
</ToolShell>

<script>
  import { calculateFurusatoLimit } from '../../lib/tools/furusato-nozei-calculator';
  import {
    attachCommaFormatting,
    formatNumberWithCommas,
    stripCommas,
  } from '../../lib/comma-number-input';

  const configEl = document.querySelector<HTMLElement>(
    'section[data-number-locale]',
  )!;
  const numberLocale = configEl.dataset.numberLocale ?? 'en-US';
  const errorMessage = configEl.dataset.error ?? '';

  const yen = new Intl.NumberFormat(numberLocale, {
    style: 'currency',
    currency: 'JPY',
    maximumFractionDigits: 0,
  });
  const percent = new Intl.NumberFormat(numberLocale, {
    maximumFractionDigits: 0,
  });

  const grossInput = document.getElementById(
    'furusato-calc-gross',
  ) as HTMLInputElement;
  const age40Input = document.getElementById(
    'furusato-calc-age40',
  ) as HTMLInputElement;
  const socialInsuranceInput = document.getElementById(
    'furusato-calc-social-insurance',
  ) as HTMLInputElement;
  const otherDeductionsInput = document.getElementById(
    'furusato-calc-other-deductions',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('furusato-calc-error')!;
  const resultsEl = document.getElementById('furusato-calc-results')!;

  function setResult(id: string, text: string) {
    document.getElementById(`furusato-calc-result-${id}`)!.textContent = text;
  }

  attachCommaFormatting(grossInput);
  attachCommaFormatting(socialInsuranceInput);
  attachCommaFormatting(otherDeductionsInput);

  function render() {
    errorEl.textContent = '';
    resultsEl.classList.add('hidden');

    if (grossInput.value.trim() === '') return;

    const socialInsuranceText = stripCommas(socialInsuranceInput.value).trim();
    const result = calculateFurusatoLimit({
      grossSalary: Number(stripCommas(grossInput.value)),
      age40OrOver: age40Input.checked,
      socialInsuranceOverride:
        socialInsuranceText === '' ? null : Number(socialInsuranceText),
      otherDeductions: Number(stripCommas(otherDeductionsInput.value) || '0'),
    });

    if (result === null) {
      errorEl.textContent = errorMessage;
      return;
    }

    setResult('limit', yen.format(result.donationLimit));
    // 上限の約9割（千円未満切り捨て。上限が1,000円未満なら0円）
    setResult(
      'safe-limit',
      yen.format(Math.floor((result.donationLimit * 0.9) / 1000) * 1000),
    );
    setResult('deductible', yen.format(result.deductibleTotal));
    setResult('levy', yen.format(result.residentTaxIncomeLevy));
    setResult(
      'marginal-rate',
      `${percent.format(result.incomeTaxMarginalRate * 100)}%`,
    );
    setResult('salary-income', yen.format(result.tax.salaryIncome));
    resultsEl.classList.remove('hidden');
  }

  grossInput.addEventListener('input', render);
  age40Input.addEventListener('change', render);
  socialInsuranceInput.addEventListener('input', render);
  otherDeductionsInput.addEventListener('input', render);

  grossInput.value = formatNumberWithCommas('5000000');
  otherDeductionsInput.value = '0';
  render();
</script>
