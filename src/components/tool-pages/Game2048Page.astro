---
import ToolShell from '../ToolShell.astro';
import { game2048Content } from '../../i18n/tools/game-2048';
import { DEFAULT_SIZE, SIZES } from '../../lib/tools/game-2048';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = game2048Content[locale];
const sizeNames = { 4: t.size4, 5: t.size5, 6: t.size6 };
const moveButtons = [
  { direction: 'up', symbol: '↑', label: t.moveUp },
  { direction: 'left', symbol: '←', label: t.moveLeft },
  { direction: 'down', symbol: '↓', label: t.moveDown },
  { direction: 'right', symbol: '→', label: t.moveRight },
];
---

<ToolShell t={t}>
  <section
    id="g2048-root"
    data-tile-label={t.tileLabel}
    data-started={t.started}
    data-undone={t.undone}
    data-won={t.won}
    data-game-over={t.gameOver}
    data-won-title={t.wonTitle}
    data-game-over-title={t.gameOverTitle}
    data-best-none={t.bestNone}
    data-best-value={t.bestValue}
    data-records-cleared={t.recordsCleared}
  >
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span id="g2048-size-label" class="ui-label">
          {t.sizeLabel}
        </span>
        <div class="ui-seg" role="group" aria-labelledby="g2048-size-label">
          {SIZES.map((s) => (
            <button
              type="button"
              class="ui-seg-btn"
              data-size={s}
              aria-pressed={s === DEFAULT_SIZE ? 'true' : 'false'}
            >
              {sizeNames[s]}
            </button>
          ))}
        </div>
      </div>
      <button id="g2048-new-button" type="button" class="ui-btn-primary">
        {t.newGame}
      </button>
      <button id="g2048-undo-button" type="button" class="ui-btn" disabled>
        {t.undo}
      </button>
    </div>

    <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-700 dark:text-gray-300">
      <div class="flex gap-2">
        <dt>{t.scoreLabel}</dt>
        <dd id="g2048-score" class="font-semibold tabular-nums">
          0
        </dd>
      </div>
      <div class="flex gap-2">
        <dt>{t.bestScoreLabel}</dt>
        <dd id="g2048-best-score" class="font-semibold tabular-nums">
          0
        </dd>
      </div>
      <div class="flex gap-2">
        <dt>{t.maxTileLabel}</dt>
        <dd id="g2048-max-tile" class="font-semibold tabular-nums">
          0
        </dd>
      </div>
    </dl>

    <div
      id="g2048-board"
      role="group"
      aria-label={t.boardLabel}
      class="relative mt-3 grid w-full max-w-md touch-none gap-1.5 rounded-lg bg-gray-300 p-1.5 select-none sm:gap-2 sm:p-2 dark:bg-gray-700"
    ></div>

    <div
      role="group"
      aria-label={t.controlsLabel}
      class="mt-3 flex flex-wrap gap-2"
    >
      {moveButtons.map((b) => (
        <button
          type="button"
          class="ui-btn h-11 w-14 text-lg"
          data-move={b.direction}
          aria-label={b.label}
        >
          {b.symbol}
        </button>
      ))}
    </div>

    <p
      id="g2048-status"
      role="status"
      class="mt-3 min-h-6 text-sm font-medium text-gray-800 dark:text-gray-200"
    ></p>

    <div class="mt-4 max-w-xl">
      <h2 class="text-base font-semibold">{t.bestHeading}</h2>
      <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300">
        {SIZES.map((s) => (
          <li class="flex flex-wrap gap-x-3">
            <span class="font-medium">{sizeNames[s]}</span>
            <span id={`g2048-best-${s}`} class="tabular-nums"></span>
          </li>
        ))}
      </ul>
      <button id="g2048-reset-button" type="button" class="ui-btn mt-3">
        {t.resetRecords}
      </button>
    </div>
  </section>
</ToolShell>

<script>
  import {
    DEFAULT_SIZE,
    EMPTY,
    SIZES,
    isGameOver,
    maxTile,
    move,
    newGame,
    parseRecords,
    planMove,
    serializeRecords,
    swipeDirection,
    updateBest,
    type BestRecords,
    type BoardSize,
    type Direction,
    type GameState,
  } from '../../lib/tools/game-2048';

  const STORAGE_KEY = 'game-2048-best';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const root = $('g2048-root');
  const msg = root.dataset;
  const boardEl = $('g2048-board');
  const statusEl = $('g2048-status');
  const scoreEl = $('g2048-score');
  const bestScoreEl = $('g2048-best-score');
  const maxTileEl = $('g2048-max-tile');
  const undoButton = $<HTMLButtonElement>('g2048-undo-button');
  const sizeButtons = Array.from(
    root.querySelectorAll<HTMLButtonElement>('[data-size]'),
  );
  const moveButtons = Array.from(
    root.querySelectorAll<HTMLButtonElement>('[data-move]'),
  );

  function fill(template: string | undefined, values: Record<string, string>) {
    return (template ?? '').replace(/\{(\w+)\}/g, (match, key: string) =>
      Object.hasOwn(values, key) ? values[key] : match,
    );
  }

  let size: BoardSize = DEFAULT_SIZE;
  let state: GameState = newGame(size);
  // 「元に戻す」で戻る1手前の状態（戻したあと、次に動かすまでは null）
  let previous: GameState | null = null;
  let records: BestRecords = loadRecords();
  let cells: HTMLElement[] = [];
  // どちらも buildBoard() で作られる（startGame より前に使われない）
  let tilesEl!: HTMLElement;
  let overlayEl!: HTMLElement;
  let overlayMode: 'none' | 'won' | 'over' = 'none';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function loadRecords(): BestRecords {
    try {
      return parseRecords(localStorage.getItem(STORAGE_KEY));
    } catch {
      // localStorageが使えない環境では、このページを開いている間だけの記録にする
      return {};
    }
  }

  function saveRecords() {
    try {
      localStorage.setItem(STORAGE_KEY, serializeRecords(records));
    } catch {
      // 保存できない環境では今回の表示だけ反映する
    }
  }

  function setStatus(text: string) {
    statusEl.textContent = text;
  }

  function renderRecords() {
    for (const s of SIZES) {
      const best = records[s];
      $(`g2048-best-${s}`).textContent = best
        ? fill(msg.bestValue, {
            score: String(best.score),
            tile: String(best.maxTile),
          })
        : (msg.bestNone ?? '');
    }
  }

  const CELL_BASE =
    'flex h-full w-full min-w-0 items-center justify-center rounded-md font-bold leading-none';
  const SLIDE_MS = 100;
  const LABEL_BASE =
    'rounded-md px-4 py-2 text-center text-2xl font-bold sm:text-4xl';
  const EMPTY_CLASS = 'bg-gray-200 dark:bg-gray-800';
  // 2, 4, 8, … の順。値が大きいものは最後の色を使う
  const TILE_COLORS = [
    'bg-amber-100 text-gray-800',
    'bg-amber-200 text-gray-800',
    'bg-orange-300 text-gray-900',
    'bg-orange-400 text-gray-900',
    'bg-orange-600 text-white',
    'bg-red-600 text-white',
    'bg-yellow-400 text-gray-900',
    'bg-yellow-500 text-gray-900',
    'bg-lime-500 text-gray-900',
    'bg-emerald-600 text-white',
    'bg-sky-600 text-white',
    'bg-violet-700 text-white',
  ];
  // 盤面が大きいほど1マスが小さいので、桁数に応じて文字を小さくする
  const FONT_SIZES: Record<number, string[]> = {
    4: ['text-2xl sm:text-4xl', 'text-xl sm:text-3xl', 'text-lg sm:text-2xl'],
    5: ['text-xl sm:text-3xl', 'text-lg sm:text-2xl', 'text-base sm:text-xl'],
    6: ['text-lg sm:text-2xl', 'text-base sm:text-xl', 'text-sm sm:text-lg'],
  };

  function tileClass(value: number) {
    const colorIndex = Math.min(Math.log2(value) - 1, TILE_COLORS.length - 1);
    const digits = String(value).length;
    const fonts = FONT_SIZES[size] ?? FONT_SIZES[4];
    const font = fonts[Math.min(Math.max(digits - 2, 0), fonts.length - 1)];
    return `${TILE_COLORS[colorIndex]} ${font}`;
  }

  interface MoveAnimation {
    /** 動かす前の盤面 */
    prevBoard: readonly number[];
    transitions: { from: number; to: number }[];
    /** 動かしたあとに新しいタイルが出たマス */
    spawned: number;
    /** この手で初めて 2048 に到達したか */
    reachedWin: boolean;
  }

  function placeTile(el: HTMLElement, index: number) {
    el.style.gridRow = String(Math.floor(index / size) + 1);
    el.style.gridColumn = String((index % size) + 1);
  }

  /** 元のマスの位置から現在のマスへ滑り込む動き */
  function slideFrom(el: HTMLElement, from: number, to: number) {
    if (from === to) return;
    const a = cells[from].getBoundingClientRect();
    const b = cells[to].getBoundingClientRect();
    el.animate(
      [
        {
          transform: `translate(${a.left - b.left}px, ${a.top - b.top}px)`,
        },
        { transform: 'none' },
      ],
      { duration: SLIDE_MS, easing: 'ease-out' },
    );
  }

  function animateMove(tiles: (HTMLElement | null)[], anim: MoveAnimation) {
    const seen = new Set<number>();
    for (const { from, to } of anim.transitions) {
      const tile = tiles[to];
      if (!tile) continue;
      if (!seen.has(to)) {
        seen.add(to);
        slideFrom(tile, from, to);
        continue;
      }
      // 合体した相手のタイルは、同じマスへ滑り込んでから消える
      const value = anim.prevBoard[from];
      const ghost = document.createElement('div');
      ghost.className = `${CELL_BASE} ${tileClass(value)}`;
      ghost.textContent = String(value);
      ghost.setAttribute('aria-hidden', 'true');
      placeTile(ghost, to);
      tilesEl.prepend(ghost);
      slideFrom(ghost, from, to);
      window.setTimeout(() => ghost.remove(), SLIDE_MS);
      // 合体したタイルは、滑り込んだあとに少し膨らむ
      tile.animate(
        [
          { transform: 'scale(1)' },
          { transform: 'scale(1.15)' },
          { transform: 'scale(1)' },
        ],
        { duration: 140, delay: SLIDE_MS },
      );
    }
    const spawned = tiles[anim.spawned];
    if (spawned) {
      spawned.animate(
        [
          { transform: 'scale(0)', opacity: 0 },
          { transform: 'scale(1)', opacity: 1 },
        ],
        { duration: 120, delay: SLIDE_MS, fill: 'backwards' },
      );
    }
  }

  // 見出しの配色（ゲームオーバーは落ち着いた色、達成は明るい色）
  const LABEL_COLORS = {
    won: 'bg-amber-400 text-gray-900',
    over: 'bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900',
  };

  /**
   * 盤面中央の表示（2048 達成・ゲームオーバー）の出し入れ。
   * 出す瞬間だけ、少し遅れて拡大しながら現れる。達成の表示は次に動かすまで残る
   */
  function updateOverlay(animate: boolean, reachedWin: boolean) {
    const mode = isGameOver(state) ? 'over' : reachedWin ? 'won' : 'none';
    if (mode === overlayMode) return;
    overlayMode = mode;
    overlayEl.style.display = mode === 'none' ? 'none' : 'flex';
    const label = overlayEl.firstElementChild as HTMLElement | null;
    if (label && mode !== 'none') {
      label.textContent =
        (mode === 'won' ? msg.wonTitle : msg.gameOverTitle) ?? '';
      label.className = `${LABEL_BASE} ${LABEL_COLORS[mode]}`;
    }
    if (mode !== 'none' && animate && !reducedMotion.matches) {
      overlayEl.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 300,
        delay: SLIDE_MS + 120,
        fill: 'backwards',
      });
      overlayEl.firstElementChild?.animate(
        [
          { transform: 'scale(0.4)', opacity: 0 },
          { transform: 'scale(1.1)', opacity: 1, offset: 0.7 },
          { transform: 'scale(1)', opacity: 1 },
        ],
        {
          duration: 450,
          delay: SLIDE_MS + 120,
          easing: 'ease-out',
          fill: 'backwards',
        },
      );
    }
  }

  function render(anim?: MoveAnimation) {
    tilesEl.replaceChildren();
    const tiles = state.board.map((value, i) => {
      if (value === EMPTY) return null;
      const tile = document.createElement('div');
      tile.className = `${CELL_BASE} ${tileClass(value)}`;
      tile.textContent = String(value);
      tile.dataset.index = String(i);
      tile.setAttribute('role', 'img');
      tile.setAttribute(
        'aria-label',
        fill(msg.tileLabel, { n: String(value) }),
      );
      placeTile(tile, i);
      tilesEl.append(tile);
      return tile;
    });
    if (anim && !reducedMotion.matches) animateMove(tiles, anim);
    updateOverlay(Boolean(anim), anim?.reachedWin ?? false);
    scoreEl.textContent = String(state.score);
    bestScoreEl.textContent = String(
      Math.max(records[size]?.score ?? 0, state.score),
    );
    maxTileEl.textContent = String(maxTile(state.board));
    undoButton.disabled = previous === null;
  }

  function buildBoard() {
    const columns = `repeat(${size}, minmax(0, 1fr))`;
    boardEl.style.gridTemplateColumns = columns;
    boardEl.replaceChildren();
    cells = state.board.map(() => {
      const cell = document.createElement('div');
      cell.dataset.cell = '';
      cell.setAttribute('aria-hidden', 'true');
      cell.className = `${CELL_BASE} aspect-square ${EMPTY_CLASS}`;
      boardEl.append(cell);
      return cell;
    });
    // タイルは背景のマスと同じ格子の上に重ねる（操作は盤面側で受ける）
    tilesEl = document.createElement('div');
    tilesEl.className =
      'pointer-events-none absolute inset-1.5 grid gap-1.5 sm:inset-2 sm:gap-2';
    tilesEl.style.gridTemplateColumns = columns;
    tilesEl.style.gridTemplateRows = columns;
    boardEl.append(tilesEl);
    // 達成・ゲームオーバーの表示（読み上げはステータス側で行うため、見た目だけの要素）
    overlayEl = document.createElement('div');
    overlayEl.setAttribute('aria-hidden', 'true');
    overlayEl.className =
      'pointer-events-none absolute inset-0 items-center justify-center rounded-lg bg-white/70 dark:bg-black/60';
    overlayEl.style.display = 'none';
    const label = document.createElement('span');
    label.className = `${LABEL_BASE} ${LABEL_COLORS.over}`;
    overlayEl.append(label);
    boardEl.append(overlayEl);
    overlayMode = 'none';
  }

  function startGame() {
    state = newGame(size);
    previous = null;
    buildBoard();
    render();
  }

  function applyMove(direction: Direction) {
    const next = move(state, direction);
    if (next === state) return;
    const plan = planMove(state.board, size, direction);
    const anim: MoveAnimation = {
      prevBoard: state.board,
      transitions: plan.transitions,
      spawned: next.board.findIndex((v, i) => v !== plan.board[i]),
      reachedWin: next.won && !state.won,
    };
    const wasWon = state.won;
    previous = state;
    state = next;
    const updated = updateBest(
      records,
      size,
      state.score,
      maxTile(state.board),
    );
    if (updated !== records) {
      records = updated;
      saveRecords();
      renderRecords();
    }
    if (isGameOver(state)) {
      setStatus(fill(msg.gameOver, { score: String(state.score) }));
    } else if (state.won && !wasWon) {
      setStatus(msg.won ?? '');
    } else {
      setStatus('');
    }
    render(anim);
  }

  const KEY_DIRECTIONS: Record<string, Direction> = {
    ArrowUp: 'up',
    ArrowDown: 'down',
    ArrowLeft: 'left',
    ArrowRight: 'right',
    w: 'up',
    s: 'down',
    a: 'left',
    d: 'right',
  };
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.isComposing) return;
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    const direction = KEY_DIRECTIONS[key];
    if (!direction) return;
    const el = e.target as HTMLElement;
    if (
      el.closest(
        'input, select, textarea, [contenteditable="true"], a, nav, aside',
      ) ||
      document.querySelector('dialog[open]')
    ) {
      return;
    }
    // 盤面が見えていないとき（下の説明を読んでいるときなど）は通常のスクロールを妨げない
    const rect = boardEl.getBoundingClientRect();
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    e.preventDefault();
    applyMove(direction);
  });

  let swipeStart: { x: number; y: number } | null = null;
  boardEl.addEventListener('pointerdown', (e) => {
    if (!e.isPrimary || e.button !== 0) return;
    swipeStart = { x: e.clientX, y: e.clientY };
    try {
      boardEl.setPointerCapture(e.pointerId);
    } catch {
      // キャプチャできなくても、盤面の上で離せばスワイプとして扱える
    }
  });
  boardEl.addEventListener('pointerup', (e) => {
    if (!swipeStart || !e.isPrimary) return;
    const direction = swipeDirection(
      e.clientX - swipeStart.x,
      e.clientY - swipeStart.y,
    );
    swipeStart = null;
    if (direction) applyMove(direction);
  });
  boardEl.addEventListener('pointercancel', () => {
    swipeStart = null;
  });

  moveButtons.forEach((b) =>
    b.addEventListener('click', () => {
      applyMove(b.dataset.move as Direction);
    }),
  );

  $('g2048-new-button').addEventListener('click', () => {
    startGame();
    setStatus(msg.started ?? '');
  });
  undoButton.addEventListener('click', () => {
    if (!previous) return;
    state = previous;
    previous = null;
    setStatus(msg.undone ?? '');
    render();
  });
  $('g2048-reset-button').addEventListener('click', () => {
    records = {};
    saveRecords();
    renderRecords();
    setStatus(msg.recordsCleared ?? '');
    render();
  });
  sizeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      size = Number(b.dataset.size) as BoardSize;
      sizeButtons.forEach((x) =>
        x.setAttribute('aria-pressed', String(x === b)),
      );
      startGame();
      setStatus(msg.started ?? '');
    }),
  );

  renderRecords();
  startGame();
</script>
