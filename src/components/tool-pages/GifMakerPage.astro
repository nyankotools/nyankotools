---
import ToolShell from '../ToolShell.astro';
import { gifMakerContent } from '../../i18n/tools/gif-maker';
import { MAX_DIMENSION } from '../../lib/tools/image-cropper';
import {
  MAX_DELAY_MS,
  MAX_FRAMES,
  MAX_GIF_WIDTH,
  MIN_DELAY_MS,
} from '../../lib/tools/gif-maker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = gifMakerContent[locale];
---

<ToolShell t={t}>
  <div
    id="gif-root"
    data-progress={t.progress}
    data-result-info={t.resultInfo}
    data-downloaded={t.downloaded}
    data-move-up-aria={t.moveUpAria}
    data-move-down-aria={t.moveDownAria}
    data-remove-aria={t.removeAria}
    data-move-up={t.moveUpButton}
    data-move-down={t.moveDownButton}
    data-remove={t.removeButton}
    data-max-frames={MAX_FRAMES}
    data-max-width={MAX_GIF_WIDTH}
    data-min-delay={MIN_DELAY_MS}
    data-max-delay={MAX_DELAY_MS}
    data-error-not-image={t.errorNotImage}
    data-error-load-failed={t.errorLoadFailed}
    data-error-too-large={t.errorTooLarge.replace(
      '{max}',
      String(MAX_DIMENSION),
    )}
    data-error-too-many={t.errorTooMany.replace('{max}', String(MAX_FRAMES))}
    data-error-need-images={t.errorNeedImages}
    data-error-failed={t.errorFailed}
  >
    <label for="gif-file" class="ui-label">
      {t.dropLabel}
    </label>
    <div id="gif-dropzone" class="ui-dropzone">
      <input
        id="gif-file"
        type="file"
        accept="image/*"
        multiple
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="gif-error"
      role="alert"
      hidden
      class="mt-3 text-sm whitespace-pre-line text-red-600 dark:text-red-400"
    ></p>

    <div id="gif-workspace" hidden class="mt-6 grid gap-6 md:grid-cols-2">
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="ui-label mb-0">{t.listLabel}</span>
          <button id="gif-clear" type="button" class="ui-btn px-3">
            {t.clearButton}
          </button>
        </div>
        <ol id="gif-list" class="mt-2 grid gap-2"></ol>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div>
            <label for="gif-width" class="ui-label">
              {t.widthLabel}
            </label>
            <input
              id="gif-width"
              type="number"
              min="16"
              max={MAX_GIF_WIDTH}
              step="1"
              value="480"
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="gif-delay" class="ui-label">
              {t.delayLabel}
            </label>
            <input
              id="gif-delay"
              type="number"
              min={MIN_DELAY_MS}
              max={MAX_DELAY_MS}
              step="10"
              value="500"
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="gif-bg" class="ui-label">
              {t.backgroundLabel}
            </label>
            <input
              id="gif-bg"
              type="color"
              value="#ffffff"
              class="h-11 w-16 cursor-pointer rounded border border-gray-300 dark:border-gray-700"
            />
          </div>
        </div>
        <label class="mt-4 flex items-center gap-2 text-sm">
          <input id="gif-loop" type="checkbox" checked class="ui-check" />
          {t.loopLabel}
        </label>
        <label class="mt-2 flex items-center gap-2 text-sm">
          <input id="gif-pingpong" type="checkbox" class="ui-check" />
          {t.pingpongLabel}
        </label>
        <button
          id="gif-generate-button"
          type="button"
          class="ui-btn-primary mt-4"
        >
          {t.generateButton}
        </button>
      </div>

      <div class="flex flex-col items-center gap-3">
        <p class="ui-label self-start">{t.previewLabel}</p>
        <div
          class="w-fit max-w-full overflow-hidden rounded-lg border border-gray-300 dark:border-gray-700"
          style="background-image: conic-gradient(#e5e7eb 25%, #fff 0 50%, #e5e7eb 0 75%, #fff 0); background-size: 16px 16px;"
        >
          <img
            id="gif-preview"
            alt={t.previewLabel}
            hidden
            class="block max-h-[70vh] max-w-full"
          />
        </div>
        <p
          id="gif-info"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></p>
        <button id="gif-download" type="button" disabled class="ui-btn">
          {t.downloadButton}
        </button>
        <span
          id="gif-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </div>
</ToolShell>

<script>
  import { downloadBlob } from '../../lib/download';
  import { enableFileDrop } from '../../lib/file-drop';
  import { isWithinSourceLimit } from '../../lib/tools/image-cropper';
  import {
    encodeGifSteps,
    frameOrder,
    gifFileName,
    gifSizeForWidth,
    MAX_DELAY_MS,
    MIN_DELAY_MS,
    quantize,
    type GifFrame,
    type QuantizedFrame,
  } from '../../lib/tools/gif-maker';
  import { moveItem } from '../../lib/tools/image-merger';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const root = $('gif-root');
  const fileInput = $<HTMLInputElement>('gif-file');
  const errorEl = $('gif-error');
  const workspace = $('gif-workspace');
  const listEl = $('gif-list');
  const widthInput = $<HTMLInputElement>('gif-width');
  const delayInput = $<HTMLInputElement>('gif-delay');
  const bgInput = $<HTMLInputElement>('gif-bg');
  const loopInput = $<HTMLInputElement>('gif-loop');
  const pingpongInput = $<HTMLInputElement>('gif-pingpong');
  const generateButton = $<HTMLButtonElement>('gif-generate-button');
  const downloadButton = $<HTMLButtonElement>('gif-download');
  const previewImg = $<HTMLImageElement>('gif-preview');
  const infoEl = $('gif-info');
  const statusEl = $('gif-status');

  const d = root.dataset;
  const maxFrames = Number(d.maxFrames);
  interface Item {
    name: string;
    bitmap: ImageBitmap;
  }
  let items: Item[] = [];
  let resultBlob: Blob | null = null;
  let previewUrl: string | null = null;
  let busy = false;
  // 画像の読み込み中の件数。読み込みと一覧の操作が競合しないよう、操作を止める
  let loading = 0;
  // 読み込みは順番に1回ずつ行う（上限の判定が競合しないように）
  let queue: Promise<void> = Promise.resolve();

  const fill = (template: string | undefined, values: Record<string, string>) =>
    Object.entries(values).reduce(
      (s, [k, v]) => s.split(`{${k}}`).join(v),
      template ?? '',
    );

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = message === '';
  }

  function clearResult() {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    resultBlob = null;
    previewImg.hidden = true;
    previewImg.removeAttribute('src');
    downloadButton.disabled = true;
    infoEl.textContent = '';
    statusEl.textContent = '';
  }

  function renderList() {
    listEl.replaceChildren();
    items.forEach((item, i) => {
      const li = document.createElement('li');
      li.className =
        'flex flex-wrap items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm dark:border-gray-700';
      const label = document.createElement('span');
      label.className = 'min-w-0 flex-1 break-all';
      label.textContent = `${i + 1}. ${item.name} (${item.bitmap.width}×${item.bitmap.height})`;
      li.append(label);
      const actions: [string, string, () => void, boolean][] = [
        [d.moveUp ?? '', d.moveUpAria ?? '', () => move(i, i - 1), i === 0],
        [
          d.moveDown ?? '',
          d.moveDownAria ?? '',
          () => move(i, i + 1),
          i === items.length - 1,
        ],
        [d.remove ?? '', d.removeAria ?? '', () => remove(i), false],
      ];
      for (const [text, aria, onClick, disabled] of actions) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'ui-btn px-3';
        b.textContent = text;
        b.setAttribute('aria-label', fill(aria, { name: item.name }));
        b.disabled = disabled;
        b.addEventListener('click', onClick);
        li.append(b);
      }
      listEl.append(li);
    });
    workspace.hidden = items.length === 0;
  }

  /** コマの構成が変わったら、前に作ったGIFは古いので消す */
  function changed() {
    clearResult();
    renderList();
  }

  function move(from: number, to: number) {
    if (busy || loading > 0) return;
    items = moveItem(items, from, to);
    changed();
  }

  function remove(index: number) {
    if (busy || loading > 0) return;
    items[index].bitmap.close();
    items = items.filter((_, i) => i !== index);
    changed();
  }

  async function addFiles(files: File[]) {
    showError('');
    const messages: string[] = [];
    loading++;
    for (const file of files) {
      if (items.length >= maxFrames) {
        messages.push(fill(d.errorTooMany, {}));
        break;
      }
      if (!file.type.startsWith('image/')) {
        messages.push(fill(d.errorNotImage, { name: file.name }));
        continue;
      }
      let bitmap: ImageBitmap;
      try {
        bitmap = await createImageBitmap(file);
      } catch {
        messages.push(fill(d.errorLoadFailed, { name: file.name }));
        continue;
      }
      if (
        !isWithinSourceLimit({ width: bitmap.width, height: bitmap.height })
      ) {
        bitmap.close();
        messages.push(fill(d.errorTooLarge, { name: file.name }));
        continue;
      }
      items.push({ name: file.name, bitmap });
    }
    loading--;
    changed();
    showError(messages.join('\n'));
  }

  fileInput.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    fileInput.value = '';
    if (files.length > 0) queue = queue.then(() => addFiles(files));
  });
  enableFileDrop($('gif-dropzone'), fileInput);

  $('gif-clear').addEventListener('click', () => {
    if (busy || loading > 0) return;
    for (const item of items) item.bitmap.close();
    items = [];
    showError('');
    changed();
  });

  // 設定を変えたら、前に作ったGIFは古いので消す
  for (const el of [
    widthInput,
    delayInput,
    bgInput,
    loopInput,
    pingpongInput,
  ]) {
    el.addEventListener('input', clearResult);
    el.addEventListener('change', clearResult);
  }

  const yieldToBrowser = () => new Promise((r) => setTimeout(r, 0));

  const formatSize = (bytes: number) =>
    bytes < 1024 * 1024
      ? `${Math.max(1, Math.round(bytes / 1024))} KB`
      : `${(bytes / 1024 / 1024).toFixed(1)} MB`;

  generateButton.addEventListener('click', async () => {
    if (busy) return;
    if (items.length === 0) return showError(d.errorNeedImages ?? '');
    busy = true;
    generateButton.disabled = true;
    showError('');
    clearResult();
    try {
      const { width, height } = gifSizeForWidth(
        items[0].bitmap,
        Math.max(Number(widthInput.value) || 480, 16),
      );
      const delayMs = Math.min(
        Math.max(Number(delayInput.value) || 500, MIN_DELAY_MS),
        MAX_DELAY_MS,
      );
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) throw new Error('no canvas');
      ctx.imageSmoothingQuality = 'high';

      // 往復再生で同じコマが複数回出るため、減色は1コマにつき1回だけ行う
      const quantized: (QuantizedFrame | undefined)[] = [];
      const order = frameOrder(items.length, pingpongInput.checked);
      for (let i = 0; i < items.length; i++) {
        statusEl.textContent = fill(d.progress, {
          current: String(i + 1),
          total: String(items.length),
        });
        await yieldToBrowser();
        const { bitmap } = items[i];
        ctx.fillStyle = bgInput.value;
        ctx.fillRect(0, 0, width, height);
        // 縦横比を保って中央に収める
        const scale = Math.min(width / bitmap.width, height / bitmap.height);
        const w = Math.max(1, Math.round(bitmap.width * scale));
        const h = Math.max(1, Math.round(bitmap.height * scale));
        ctx.drawImage(
          bitmap,
          Math.round((width - w) / 2),
          Math.round((height - h) / 2),
          w,
          h,
        );
        const { data } = ctx.getImageData(0, 0, width, height);
        quantized[i] = quantize(data, width * height);
      }
      const frames: GifFrame[] = order.map((i) => ({
        ...quantized[i]!,
        delayMs,
      }));
      const steps = encodeGifSteps({
        width,
        height,
        frames,
        loop: loopInput.checked,
      });
      let bytes: Uint8Array;
      for (;;) {
        const step = steps.next();
        if (step.done) {
          bytes = step.value;
          break;
        }
        statusEl.textContent = fill(d.progress, {
          current: String(step.value),
          total: String(frames.length),
        });
        await yieldToBrowser();
      }
      resultBlob = new Blob([bytes as BlobPart], { type: 'image/gif' });
      previewUrl = URL.createObjectURL(resultBlob);
      previewImg.src = previewUrl;
      previewImg.hidden = false;
      downloadButton.disabled = false;
      statusEl.textContent = '';
      infoEl.textContent = fill(d.resultInfo, {
        width: String(width),
        height: String(height),
        frames: String(frames.length),
        size: formatSize(resultBlob.size),
      });
    } catch {
      clearResult();
      showError(d.errorFailed ?? '');
    } finally {
      busy = false;
      generateButton.disabled = false;
    }
  });

  downloadButton.addEventListener('click', () => {
    if (!resultBlob) return;
    downloadBlob(resultBlob, gifFileName());
    statusEl.textContent = d.downloaded ?? '';
  });
</script>
