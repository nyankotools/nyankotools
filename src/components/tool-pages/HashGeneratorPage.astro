---
import ToolShell from '../ToolShell.astro';
import { hashGeneratorContent } from '../../i18n/tools/hash-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = hashGeneratorContent[locale];

const algorithms = [
  { id: 'md5', label: 'MD5' },
  { id: 'sha1', label: 'SHA-1' },
  { id: 'sha256', label: 'SHA-256' },
];
---

<ToolShell t={t}>
  <div>
    <label for="hash-generator-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="hash-generator-input"
      class="ui-input h-40 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
    ></textarea>
  </div>

  <div class="mt-4 space-y-3">
    {algorithms.map((algorithm) => (
      <div>
        <label for={`hash-generator-${algorithm.id}`} class="ui-label">
          {algorithm.label}
        </label>
        <div class="flex gap-2">
          <input
            id={`hash-generator-${algorithm.id}`}
            type="text"
            readonly
            class="ui-input h-11 w-full min-w-0 bg-gray-50 px-3 font-mono dark:bg-gray-900"
          />
          <button
            type="button"
            data-copy-target={`hash-generator-${algorithm.id}`}
            class="ui-btn shrink-0"
          >
            {t.copy}
          </button>
        </div>
      </div>
    ))}
    <span
      id="hash-generator-status"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { computeHashes } from '../../lib/tools/hash-generator';

  const input = document.getElementById(
    'hash-generator-input',
  ) as HTMLTextAreaElement;
  const outputs = {
    MD5: document.getElementById('hash-generator-md5') as HTMLInputElement,
    'SHA-1': document.getElementById('hash-generator-sha1') as HTMLInputElement,
    'SHA-256': document.getElementById(
      'hash-generator-sha256',
    ) as HTMLInputElement,
  };
  const statusEl = document.getElementById('hash-generator-status')!;
  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');

  async function generate() {
    statusEl.textContent = '';
    const hashes = await computeHashes(input.value);
    for (const [algorithm, value] of Object.entries(hashes)) {
      outputs[algorithm as keyof typeof outputs].value = value;
    }
  }

  input.addEventListener('input', generate);

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      statusEl.textContent = (await copyText(target.value))
        ? (statusEl.dataset.copied ?? '')
        : (statusEl.dataset.copyFailed ?? '');
    });
  });

  generate();
</script>
