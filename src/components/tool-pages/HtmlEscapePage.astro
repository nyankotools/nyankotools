---
import ToolShell from '../ToolShell.astro';
import { htmlEscapeContent } from '../../i18n/tools/html-escape';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = htmlEscapeContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <div
      id="html-escape-mode"
      class="ui-seg flex-wrap gap-1"
      role="group"
      aria-label={t.modeLabel}
    >
      <button
        type="button"
        data-mode="html-escape"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modeHtmlEscape}
      </button>
      <button
        type="button"
        data-mode="html-unescape"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeHtmlUnescape}
      </button>
      <button
        type="button"
        data-mode="js-escape"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeJsEscape}
      </button>
      <button
        type="button"
        data-mode="js-unescape"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeJsUnescape}
      </button>
    </div>
    <button
      id="html-escape-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="html-escape-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="html-escape-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="html-escape-input"
        data-query-target="text"
        class="ui-input h-64 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="html-escape-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="html-escape-output"
        readonly
        class="ui-input h-64 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { convertEscape, type EscapeMode } from '../../lib/tools/html-escape';

  const input = document.getElementById(
    'html-escape-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'html-escape-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#html-escape-mode [data-mode]',
  );
  const copyButton = document.getElementById(
    'html-escape-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('html-escape-status')!;

  let mode: EscapeMode = 'html-escape';

  function convert() {
    statusEl.textContent = '';
    output.value = input.value === '' ? '' : convertEscape(input.value, mode);
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as EscapeMode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  convert();
</script>
