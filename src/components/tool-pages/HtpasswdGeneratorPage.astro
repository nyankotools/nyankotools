---
import ToolShell from '../ToolShell.astro';
import { htpasswdGeneratorContent } from '../../i18n/tools/htpasswd-generator';
import {
  DEFAULT_COST,
  MAX_COST,
  MIN_COST,
} from '../../lib/tools/htpasswd-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = htpasswdGeneratorContent[locale];
const costs = Array.from(
  { length: MAX_COST - MIN_COST + 1 },
  (_, i) => MIN_COST + i,
);
---

<ToolShell t={t}>
  <section>
    <label for="htpasswd-generator-users" class="ui-label">
      {t.usersLabel}
    </label>
    <textarea
      id="htpasswd-generator-users"
      rows="5"
      autocomplete="off"
      spellcheck="false"
      class="ui-input w-full px-3 py-2 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.usersPlaceholder}
      aria-describedby="htpasswd-generator-users-hint"
    ></textarea>
    <p
      id="htpasswd-generator-users-hint"
      class="mt-1 text-sm text-gray-600 dark:text-gray-400"
    >
      {t.usersHint}
    </p>

    <div class="mt-4 flex flex-wrap gap-4">
      <div>
        <label for="htpasswd-generator-algorithm" class="ui-label">
          {t.algorithmLabel}
        </label>
        <select
          id="htpasswd-generator-algorithm"
          class="ui-input h-11 px-3 dark:bg-gray-900"
        >
          <option value="bcrypt" selected>
            {t.algorithmBcrypt}
          </option>
          <option value="sha1">{t.algorithmSha1}</option>
        </select>
      </div>
      <div id="htpasswd-generator-cost-area">
        <label for="htpasswd-generator-cost" class="ui-label">
          {t.costLabel}
        </label>
        <select
          id="htpasswd-generator-cost"
          class="ui-input h-11 px-3 dark:bg-gray-900"
          aria-describedby="htpasswd-generator-cost-hint"
        >
          {costs.map((cost) => (
            <option value={cost} selected={cost === DEFAULT_COST}>
              {cost}
            </option>
          ))}
        </select>
      </div>
    </div>
    <p
      id="htpasswd-generator-cost-hint"
      class="mt-1 text-sm text-gray-600 dark:text-gray-400"
    >
      {t.costHint}
    </p>

    <button
      id="htpasswd-generator-generate-button"
      type="button"
      data-label={t.generateButton}
      data-working={t.working}
      class="ui-btn ui-btn-primary mt-4"
    >
      {t.generateButton}
    </button>

    <div
      id="htpasswd-generator-issues"
      hidden
      role="alert"
      data-missing-colon={t.issueMissingColon}
      data-empty-username={t.issueEmptyUsername}
      data-invalid-username={t.issueInvalidUsername}
      data-empty-password={t.issueEmptyPassword}
      data-duplicate-username={t.issueDuplicateUsername}
      data-password-too-long={t.issuePasswordTooLong}
      data-truncated={t.truncated}
      data-no-users={t.noUsers}
      class="ui-error mt-4 max-w-2xl"
    ></div>

    <div id="htpasswd-generator-result-area" hidden class="mt-6">
      <label for="htpasswd-generator-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="htpasswd-generator-output"
        rows="5"
        readonly
        wrap="off"
        class="ui-input w-full bg-gray-50 px-3 py-2 font-mono dark:bg-gray-900"
      ></textarea>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <button
          id="htpasswd-generator-copy-button"
          type="button"
          data-copied={t.copied}
          data-copy-failed={t.copyFailed}
          class="ui-btn"
        >
          {t.copy}
        </button>
        <button
          id="htpasswd-generator-download-button"
          type="button"
          class="ui-btn"
        >
          {t.download}
        </button>
        <span
          id="htpasswd-generator-status"
          class="text-sm text-green-700 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>

      <div class="mt-6">
        <label for="htpasswd-generator-headers" class="ui-label">
          {t.headersLabel}
        </label>
        <textarea
          id="htpasswd-generator-headers"
          rows="3"
          readonly
          wrap="off"
          aria-describedby="htpasswd-generator-headers-hint"
          class="ui-input w-full bg-gray-50 px-3 py-2 font-mono dark:bg-gray-900"
        ></textarea>
        <p
          id="htpasswd-generator-headers-hint"
          class="mt-1 text-sm text-gray-600 dark:text-gray-400"
        >
          {t.headersHint}
        </p>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { downloadBlob } from '../../lib/download';
  import { fill } from '../../lib/format-template';
  import {
    MAX_USERS,
    generateHtpasswd,
    type HtpasswdAlgorithm,
  } from '../../lib/tools/htpasswd-generator';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(`htpasswd-generator-${id}`) as T;
  const users = $<HTMLTextAreaElement>('users');
  const algorithm = $<HTMLSelectElement>('algorithm');
  const costArea = $<HTMLElement>('cost-area');
  const costHint = $<HTMLElement>('cost-hint');
  const cost = $<HTMLSelectElement>('cost');
  const generateButton = $<HTMLButtonElement>('generate-button');
  const issuesEl = $<HTMLElement>('issues');
  const resultArea = $<HTMLElement>('result-area');
  const output = $<HTMLTextAreaElement>('output');
  const headers = $<HTMLTextAreaElement>('headers');
  const copyButton = $<HTMLButtonElement>('copy-button');
  const downloadButton = $<HTMLButtonElement>('download-button');
  const statusEl = $<HTMLElement>('status');

  const ISSUE_KEYS: Record<string, string> = {
    'missing-colon': 'missingColon',
    'empty-username': 'emptyUsername',
    'invalid-username': 'invalidUsername',
    'empty-password': 'emptyPassword',
    'duplicate-username': 'duplicateUsername',
    'password-too-long': 'passwordTooLong',
  };

  function syncAlgorithm() {
    const isBcrypt = algorithm.value === 'bcrypt';
    costArea.hidden = !isBcrypt;
    costHint.hidden = !isBcrypt;
  }
  algorithm.addEventListener('change', syncAlgorithm);
  syncAlgorithm();

  function showIssues(messages: string[]) {
    issuesEl.replaceChildren();
    for (const message of messages) {
      const p = document.createElement('p');
      p.textContent = message;
      issuesEl.append(p);
    }
    issuesEl.hidden = messages.length === 0;
  }

  generateButton.addEventListener('click', async () => {
    generateButton.disabled = true;
    generateButton.textContent = generateButton.dataset.working ?? '';
    statusEl.textContent = '';
    try {
      const result = await generateHtpasswd(
        users.value,
        algorithm.value as HtpasswdAlgorithm,
        Number(cost.value),
      );
      const messages = result.issues.map((issue) =>
        fill(issuesEl.dataset[ISSUE_KEYS[issue.error]] ?? '', {
          line: String(issue.line),
        }),
      );
      if (result.truncated) {
        messages.push(
          fill(issuesEl.dataset.truncated ?? '', { n: String(MAX_USERS) }),
        );
      }
      if (result.lines.length === 0 && result.issues.length === 0) {
        messages.push(issuesEl.dataset.noUsers ?? '');
      }
      showIssues(messages);
      resultArea.hidden = result.lines.length === 0;
      output.value = result.lines.join('\n');
      headers.value = result.headers.join('\n');
    } finally {
      generateButton.disabled = false;
      generateButton.textContent = generateButton.dataset.label ?? '';
    }
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  downloadButton.addEventListener('click', () => {
    if (!output.value) return;
    downloadBlob(
      new Blob([`${output.value}\n`], { type: 'text/plain;charset=utf-8' }),
      'htpasswd.txt',
    );
  });
</script>
