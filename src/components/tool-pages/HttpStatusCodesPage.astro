---
import ToolShell from '../ToolShell.astro';
import { httpStatusCodesContent } from '../../i18n/tools/http-status-codes';
import type { Locale } from '../../data/tools';
import {
  STATUS_CATEGORIES,
  STATUS_CODES,
  categoryOf,
} from '../../lib/tools/http-status-codes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = httpStatusCodesContent[locale];

const badgeClass: Record<string, string> = {
  '1xx': 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300',
  '2xx': 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300',
  '3xx': 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
  '4xx': 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  '5xx': 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300',
};

const rows = STATUS_CODES.map((s) => ({
  ...s,
  category: categoryOf(s.code)!,
  text: t.codes[s.code],
}));
---

<ToolShell t={t}>
  <section id="hsc" data-count-template={t.countTemplate}>
    <label for="hsc-query" class="ui-label">
      {t.searchLabel}
    </label>
    <input
      id="hsc-query"
      type="search"
      class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.searchPlaceholder}
      autocomplete="off"
      spellcheck="false"
      data-query-target="text"
    />
    <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">{t.searchHint}</p>

    <div
      id="hsc-category"
      class="ui-seg w-fit max-w-full mt-3 flex-wrap"
      role="group"
      aria-label={t.categoryLabel}
    >
      <button
        type="button"
        data-category="all"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.allLabel}
      </button>
      {STATUS_CATEGORIES.map((c) => (
        <button
          type="button"
          data-category={c}
          aria-pressed="false"
          class="ui-seg-btn"
          title={t.categories[c].summary}
        >
          {t.categories[c].label}
        </button>
      ))}
    </div>

    <p
      id="hsc-count"
      class="mt-3 text-sm text-gray-600 dark:text-gray-400"
      aria-live="polite"
    ></p>
    <p
      id="hsc-empty"
      class="mt-3 hidden text-sm text-gray-700 dark:text-gray-300"
      role="status"
    >
      {t.noResults}
    </p>

    <ul id="hsc-list" class="mt-3 space-y-3">
      {rows.map((r) => (
        <li
          data-code={r.code}
          data-category={r.category}
          data-search={[
            r.phrase,
            r.text.name,
            r.text.meaning,
            r.text.cause,
            r.text.advice,
          ].join(' ')}
          class="rounded-lg border border-gray-200 p-3 dark:border-gray-700"
        >
          <div class="flex flex-wrap items-center gap-2">
            <span
              class={`rounded px-2 py-0.5 text-xs font-medium ${badgeClass[r.category]}`}
            >
              {r.category} {t.categories[r.category].summary}
            </span>
            <h2 class="text-base font-semibold break-words">
              <span class="font-mono">{r.code}</span> {r.phrase}
            </h2>
            {r.text.name !== r.phrase && (
              <span class="text-sm text-gray-600 dark:text-gray-400">
                {r.text.name}
              </span>
            )}
          </div>
          <p class="mt-2 text-sm">{r.text.meaning}</p>
          <dl class="mt-2 space-y-1 text-sm">
            <div>
              <dt class="inline font-medium">{t.causeLabel}</dt>
              <dd class="ml-1 inline">{r.text.cause}</dd>
            </div>
            <div>
              <dt class="inline font-medium">{t.adviceLabel}</dt>
              <dd class="ml-1 inline">{r.text.advice}</dd>
            </div>
          </dl>
          <p class="mt-2 text-xs text-gray-600 dark:text-gray-400">
            {t.specLabel}: {r.rfc}
          </p>
        </li>
      ))}
    </ul>
  </section>
</ToolShell>

<script>
  import {
    matchesStatus,
    type CategoryFilter,
  } from '../../lib/tools/http-status-codes';

  const section = document.getElementById('hsc')!;
  const queryEl = document.getElementById('hsc-query') as HTMLInputElement;
  const countEl = document.getElementById('hsc-count')!;
  const emptyEl = document.getElementById('hsc-empty')!;
  const items = Array.from(
    document.querySelectorAll<HTMLLIElement>('#hsc-list > li'),
  );
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '#hsc-category [data-category]',
  );
  const countTemplate = section.dataset.countTemplate ?? '{shown} / {total}';

  // 各カードの表示テキストを検索対象にする（初回に1回だけ取得）
  const haystacks = items.map((li) => li.dataset.search ?? '');

  let category: CategoryFilter = 'all';

  function render() {
    const query = queryEl.value;
    let shown = 0;
    items.forEach((li, i) => {
      const code = Number(li.dataset.code);
      const match = matchesStatus(code, haystacks[i], query, category);
      li.classList.toggle('hidden', !match);
      if (match) shown++;
    });
    countEl.textContent = countTemplate
      .replace('{shown}', String(shown))
      .replace('{total}', String(items.length));
    emptyEl.classList.toggle('hidden', shown > 0);
  }

  queryEl.addEventListener('input', render);
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      category = button.dataset.category as CategoryFilter;
      buttons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button)),
      );
      render();
    });
  });

  render();
</script>
