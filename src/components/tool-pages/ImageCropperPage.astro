---
import ToolShell from '../ToolShell.astro';
import { imageCropperContent } from '../../i18n/tools/image-cropper';
import { MAX_DIMENSION } from '../../lib/tools/image-cropper';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = imageCropperContent[locale];

const pressedBtn =
  'ui-btn px-3 aria-pressed:border-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white aria-pressed:hover:bg-blue-700';
---

<ToolShell t={t}>
  <div
    id="crop-root"
    data-output-info={t.outputInfo}
    data-downloaded={t.downloaded}
    data-error-not-image={t.errorNotImage}
    data-error-too-large={t.errorTooLarge.replace(
      '{max}',
      String(MAX_DIMENSION),
    )}
    data-error-load-failed={t.errorLoadFailed}
    data-error-export-failed={t.errorExportFailed}
  >
    <label for="crop-file" class="ui-label">
      {t.dropLabel}
    </label>
    <div id="crop-dropzone" class="ui-dropzone">
      <input id="crop-file" type="file" accept="image/*" class="ui-file" />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="crop-error"
      role="alert"
      hidden
      class="mt-3 text-sm text-red-600 dark:text-red-400"
    ></p>

    <div id="crop-workspace" hidden class="mt-6 grid gap-6 md:grid-cols-2">
      <div>
        <span class="ui-label">{t.transformLabel}</span>
        <div class="flex flex-wrap gap-2">
          <button id="crop-rotate-left" type="button" class="ui-btn px-3">
            {t.rotateLeftButton}
          </button>
          <button id="crop-rotate-right" type="button" class="ui-btn px-3">
            {t.rotateRightButton}
          </button>
          <button
            id="crop-flip-h"
            type="button"
            aria-pressed="false"
            class={pressedBtn}
          >
            {t.flipHorizontalButton}
          </button>
          <button
            id="crop-flip-v"
            type="button"
            aria-pressed="false"
            class={pressedBtn}
          >
            {t.flipVerticalButton}
          </button>
        </div>

        <div class="mt-4">
          <label for="crop-aspect" class="ui-label">
            {t.aspectLabel}
          </label>
          <select id="crop-aspect" class="ui-input h-11 px-3 dark:bg-gray-900">
            {t.aspectOptions.map(({ value, label, selected }) => (
              <option value={value} selected={selected}>
                {label}
              </option>
            ))}
          </select>
        </div>

        <fieldset class="mt-4">
          <legend class="ui-label">{t.selectionLabel}</legend>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="crop-x" class="ui-label">
                {t.xLabel}
              </label>
              <input
                id="crop-x"
                type="number"
                min="0"
                step="1"
                data-no-persist
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
            <div>
              <label for="crop-y" class="ui-label">
                {t.yLabel}
              </label>
              <input
                id="crop-y"
                type="number"
                min="0"
                step="1"
                data-no-persist
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
            <div>
              <label for="crop-w" class="ui-label">
                {t.widthLabel}
              </label>
              <input
                id="crop-w"
                type="number"
                min="1"
                step="1"
                data-no-persist
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
            <div>
              <label for="crop-h" class="ui-label">
                {t.heightLabel}
              </label>
              <input
                id="crop-h"
                type="number"
                min="1"
                step="1"
                data-no-persist
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
          </div>
          <button id="crop-select-all" type="button" class="ui-btn mt-3 px-3">
            {t.selectAllButton}
          </button>
        </fieldset>

        <div class="mt-4 flex flex-wrap items-end gap-4">
          <div>
            <span class="ui-label">{t.formatLabel}</span>
            <div
              id="crop-format"
              class="ui-seg"
              role="group"
              aria-label={t.formatLabel}
            >
              <button
                type="button"
                data-format="png"
                aria-pressed="true"
                class="ui-seg-btn"
              >
                PNG
              </button>
              <button
                type="button"
                data-format="jpeg"
                aria-pressed="false"
                class="ui-seg-btn"
              >
                JPEG
              </button>
              <button
                type="button"
                data-format="webp"
                aria-pressed="false"
                class="ui-seg-btn"
              >
                WebP
              </button>
            </div>
          </div>
          <div id="crop-quality-wrap" hidden class="min-w-40 flex-1">
            <label for="crop-quality" class="ui-label">
              {t.qualityLabel}
              <span id="crop-quality-value">90</span>
            </label>
            <input
              id="crop-quality"
              type="range"
              min="10"
              max="100"
              value="90"
              class="h-11 w-full"
            />
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center gap-3">
        <p class="ui-label self-start">{t.previewLabel}</p>
        <div
          id="crop-stage"
          class="relative w-fit max-w-full touch-none overflow-hidden rounded-lg border border-gray-300 select-none dark:border-gray-700"
          style="background-image: conic-gradient(#e5e7eb 25%, #fff 0 50%, #e5e7eb 0 75%, #fff 0); background-size: 16px 16px; cursor: crosshair;"
        >
          <canvas
            id="crop-canvas"
            role="img"
            aria-label={t.previewLabel}
            class="block max-h-[70vh] max-w-full"
          ></canvas>
          <div
            id="crop-selection"
            class="pointer-events-none absolute border-2 border-white"
            style="box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.55); outline: 1px solid #2563eb;"
          ></div>
        </div>
        <p class="self-start text-xs text-gray-500 dark:text-gray-400">
          {t.previewHint}
        </p>
        <p
          id="crop-size"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></p>
        <button
          id="crop-download"
          type="button"
          disabled
          class="ui-btn-primary"
        >
          {t.downloadButton}
        </button>
        <span
          id="crop-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </div>
</ToolShell>

<script>
  import { downloadBlob } from '../../lib/download';
  import { enableFileDrop } from '../../lib/file-drop';
  import {
    clampRect,
    croppedFileName,
    fitAspect,
    fullRect,
    isWithinSourceLimit,
    outputFormat,
    parseAspect,
    rectFromDrag,
    rotateBy,
    rotatedSize,
    type OutputFormat,
    type Point,
    type Rect,
    type Rotation,
    type Size,
  } from '../../lib/tools/image-cropper';

  const root = document.getElementById('crop-root')!;
  const fileInput = document.getElementById('crop-file') as HTMLInputElement;
  const dropzone = document.getElementById('crop-dropzone')!;
  const errorEl = document.getElementById('crop-error')!;
  const workspace = document.getElementById('crop-workspace')!;
  const stage = document.getElementById('crop-stage')!;
  const canvas = document.getElementById('crop-canvas') as HTMLCanvasElement;
  const selectionEl = document.getElementById('crop-selection')!;
  const aspectSelect = document.getElementById(
    'crop-aspect',
  ) as HTMLSelectElement;
  const xInput = document.getElementById('crop-x') as HTMLInputElement;
  const yInput = document.getElementById('crop-y') as HTMLInputElement;
  const wInput = document.getElementById('crop-w') as HTMLInputElement;
  const hInput = document.getElementById('crop-h') as HTMLInputElement;
  const sizeEl = document.getElementById('crop-size')!;
  const statusEl = document.getElementById('crop-status')!;
  const downloadButton = document.getElementById(
    'crop-download',
  ) as HTMLButtonElement;
  const qualityWrap = document.getElementById('crop-quality-wrap')!;
  const qualityInput = document.getElementById(
    'crop-quality',
  ) as HTMLInputElement;
  const qualityValue = document.getElementById('crop-quality-value')!;
  const flipH = document.getElementById('crop-flip-h') as HTMLButtonElement;
  const flipV = document.getElementById('crop-flip-v') as HTMLButtonElement;
  const formatButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#crop-format [data-format]'),
  );

  const d = root.dataset;
  let bitmap: ImageBitmap | null = null;
  let sourceName: string | null = null;
  let rotation: Rotation = 0;
  let selection: Rect = { x: 0, y: 0, width: 1, height: 1 };
  let format: OutputFormat = 'png';
  // 画像の読み込みは非同期なので、古い読み込みが新しい選択を上書きしないよう世代で管理する
  let generation = 0;

  const bounds = (): Size => ({ width: canvas.width, height: canvas.height });
  const ratio = () => parseAspect(aspectSelect.value);

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = message === '';
  }

  function drawImage() {
    if (!bitmap) return;
    const size = rotatedSize(
      { width: bitmap.width, height: bitmap.height },
      rotation,
    );
    canvas.width = size.width;
    canvas.height = size.height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return showError(d.errorExportFailed ?? '');
    ctx.save();
    ctx.translate(size.width / 2, size.height / 2);
    // 反転は回転後の見た目に対して行う（先に scale、あとから rotate が点には先に作用する）
    ctx.scale(
      flipH.getAttribute('aria-pressed') === 'true' ? -1 : 1,
      flipV.getAttribute('aria-pressed') === 'true' ? -1 : 1,
    );
    ctx.rotate((rotation * Math.PI) / 180);
    ctx.drawImage(bitmap, -bitmap.width / 2, -bitmap.height / 2);
    ctx.restore();
  }

  function renderSelection() {
    const { width: cw, height: ch } = bounds();
    selectionEl.style.left = `${(selection.x / cw) * 100}%`;
    selectionEl.style.top = `${(selection.y / ch) * 100}%`;
    selectionEl.style.width = `${(selection.width / cw) * 100}%`;
    selectionEl.style.height = `${(selection.height / ch) * 100}%`;
    sizeEl.textContent = (d.outputInfo ?? '')
      .replace('{width}', String(selection.width))
      .replace('{height}', String(selection.height));
  }

  function setSelection(rect: Rect, syncInputs = true) {
    selection = clampRect(rect, bounds());
    if (syncInputs) {
      xInput.value = String(selection.x);
      yInput.value = String(selection.y);
      wInput.value = String(selection.width);
      hInput.value = String(selection.height);
    }
    renderSelection();
  }

  /** 向きが変わったときの再描画。切り抜く範囲は全体に戻す */
  function redraw() {
    statusEl.textContent = '';
    drawImage();
    const r = ratio();
    setSelection(
      r ? fitAspect(fullRect(bounds()), r, bounds()) : fullRect(bounds()),
    );
  }

  async function loadFile(file: File) {
    const current = ++generation;
    showError('');
    statusEl.textContent = '';
    if (!file.type.startsWith('image/'))
      return showError(d.errorNotImage ?? '');
    let loaded: ImageBitmap;
    try {
      loaded = await createImageBitmap(file);
    } catch {
      if (current === generation) showError(d.errorLoadFailed ?? '');
      return;
    }
    if (current !== generation) return loaded.close();
    if (!isWithinSourceLimit({ width: loaded.width, height: loaded.height })) {
      loaded.close();
      return showError(d.errorTooLarge ?? '');
    }
    bitmap?.close();
    bitmap = loaded;
    sourceName = file.name;
    rotation = 0;
    flipH.setAttribute('aria-pressed', 'false');
    flipV.setAttribute('aria-pressed', 'false');
    workspace.hidden = false;
    downloadButton.disabled = false;
    redraw();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) void loadFile(file);
  });
  enableFileDrop(dropzone, fileInput);

  document.getElementById('crop-rotate-left')!.addEventListener('click', () => {
    rotation = rotateBy(rotation, -90);
    redraw();
  });
  document
    .getElementById('crop-rotate-right')!
    .addEventListener('click', () => {
      rotation = rotateBy(rotation, 90);
      redraw();
    });
  for (const button of [flipH, flipV]) {
    button.addEventListener('click', () => {
      const on = button.getAttribute('aria-pressed') === 'true';
      button.setAttribute('aria-pressed', String(!on));
      redraw();
    });
  }

  aspectSelect.addEventListener('change', () => {
    const r = ratio();
    if (r) setSelection(fitAspect(selection, r, bounds()));
  });

  // 数値入力は確定（change）時に反映する。入力の途中で値を書き換えると打ちにくいため
  for (const input of [xInput, yInput, wInput, hInput]) {
    input.addEventListener('change', () => {
      const r = ratio();
      let rect: Rect = {
        x: Number(xInput.value),
        y: Number(yInput.value),
        width: Number(wInput.value),
        height: Number(hInput.value),
      };
      if (r) {
        // 高さを編集したときは、その高さに合う幅へ。それ以外は幅を基準に高さを合わせる
        if (input === hInput) {
          rect = { ...rect, width: Math.round(rect.height * r) };
        }
        rect = fitAspect(rect, r, bounds());
      }
      setSelection(rect);
    });
  }

  document.getElementById('crop-select-all')!.addEventListener('click', () => {
    const r = ratio();
    setSelection(
      r ? fitAspect(fullRect(bounds()), r, bounds()) : fullRect(bounds()),
    );
  });

  // プレビュー上のドラッグで範囲を選び直す
  let dragStart: Point | null = null;
  function toImagePoint(e: PointerEvent): Point {
    const box = canvas.getBoundingClientRect();
    const { width, height } = bounds();
    return {
      x: ((e.clientX - box.left) / box.width) * width,
      y: ((e.clientY - box.top) / box.height) * height,
    };
  }
  stage.addEventListener('pointerdown', (e) => {
    if (!bitmap || e.button !== 0) return;
    dragStart = toImagePoint(e);
    stage.setPointerCapture(e.pointerId);
    e.preventDefault();
  });
  stage.addEventListener('pointermove', (e) => {
    if (!dragStart) return;
    setSelection(rectFromDrag(dragStart, toImagePoint(e), bounds(), ratio()));
  });
  const endDrag = () => {
    dragStart = null;
  };
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);

  function applyFormat(next: OutputFormat) {
    format = next;
    for (const b of formatButtons) {
      b.setAttribute('aria-pressed', String(b.dataset.format === next));
    }
    qualityWrap.hidden = next === 'png';
  }
  for (const b of formatButtons) {
    b.addEventListener('click', () =>
      applyFormat(b.dataset.format as OutputFormat),
    );
  }
  qualityInput.addEventListener('input', () => {
    qualityValue.textContent = qualityInput.value;
  });

  downloadButton.addEventListener('click', () => {
    if (!bitmap) return;
    const { x, y, width, height } = selection;
    const out = document.createElement('canvas');
    out.width = width;
    out.height = height;
    const ctx = out.getContext('2d');
    if (!ctx) return showError(d.errorExportFailed ?? '');
    if (format === 'jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
    }
    ctx.drawImage(canvas, x, y, width, height, 0, 0, width, height);
    const { mime } = outputFormat(format);
    out.toBlob(
      (blob) => {
        // 非対応の形式はブラウザがPNGで返すため、種類が違えば失敗として扱う
        if (!blob || blob.type !== mime) {
          return showError(d.errorExportFailed ?? '');
        }
        showError('');
        downloadBlob(blob, croppedFileName(sourceName, format));
        statusEl.textContent = d.downloaded ?? '';
      },
      mime,
      format === 'png' ? undefined : Number(qualityInput.value) / 100,
    );
  });
</script>
