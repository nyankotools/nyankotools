---
import ToolShell from '../ToolShell.astro';
import { imagePaddingContent } from '../../i18n/tools/image-padding';
import { MAX_DIMENSION, MAX_MARGIN } from '../../lib/tools/image-padding';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = imagePaddingContent[locale];
---

<ToolShell t={t}>
  <div
    id="pad-root"
    data-output-info={t.outputInfo}
    data-downloaded={t.downloaded}
    data-error-not-image={t.errorNotImage}
    data-error-too-large={t.errorTooLarge.replace(
      '{max}',
      String(MAX_DIMENSION),
    )}
    data-error-output-too-large={t.errorOutputTooLarge.replace(
      '{max}',
      String(MAX_DIMENSION),
    )}
    data-error-load-failed={t.errorLoadFailed}
    data-error-export-failed={t.errorExportFailed}
  >
    <label for="pad-file" class="ui-label">
      {t.dropLabel}
    </label>
    <div id="pad-dropzone" class="ui-dropzone">
      <input id="pad-file" type="file" accept="image/*" class="ui-file" />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="pad-error"
      role="alert"
      hidden
      class="mt-3 text-sm text-red-600 dark:text-red-400"
    ></p>

    <div id="pad-workspace" hidden class="mt-6 grid gap-6 md:grid-cols-2">
      <div>
        <label for="pad-aspect" class="ui-label">
          {t.aspectLabel}
        </label>
        <select id="pad-aspect" class="ui-input h-11 px-3 dark:bg-gray-900">
          {t.aspectOptions.map(({ value, label, selected }) => (
            <option value={value} selected={selected}>
              {label}
            </option>
          ))}
        </select>

        <div id="pad-custom-wrap" hidden class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <label for="pad-custom-w" class="ui-label">
              {t.customWidthLabel}
            </label>
            <input
              id="pad-custom-w"
              type="number"
              min="1"
              step="any"
              value="21"
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="pad-custom-h" class="ui-label">
              {t.customHeightLabel}
            </label>
            <input
              id="pad-custom-h"
              type="number"
              min="1"
              step="any"
              value="9"
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
        </div>

        <div class="mt-4">
          <label for="pad-margin" class="ui-label">
            {t.marginLabel}
          </label>
          <input
            id="pad-margin"
            type="number"
            min="0"
            max={MAX_MARGIN}
            step="1"
            value="0"
            class="ui-input h-11 w-full px-3 dark:bg-gray-900"
          />
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            {t.marginHint}
          </p>
        </div>

        <div class="mt-4 flex flex-wrap items-end gap-4">
          <div>
            <label for="pad-color" class="ui-label">
              {t.backgroundLabel}
            </label>
            <input
              id="pad-color"
              type="color"
              value="#ffffff"
              class="h-11 w-20 cursor-pointer rounded border border-gray-300 bg-white p-1 dark:border-gray-700 dark:bg-gray-900"
            />
          </div>
          <label class="ui-check h-11">
            <input id="pad-transparent" type="checkbox" />
            <span>{t.transparentLabel}</span>
          </label>
        </div>

        <div class="mt-4 flex flex-wrap items-end gap-4">
          <div>
            <span class="ui-label">{t.formatLabel}</span>
            <div
              id="pad-format"
              class="ui-seg"
              role="group"
              aria-label={t.formatLabel}
            >
              <button
                type="button"
                data-format="png"
                aria-pressed="true"
                class="ui-seg-btn"
              >
                PNG
              </button>
              <button
                type="button"
                data-format="jpeg"
                aria-pressed="false"
                class="ui-seg-btn"
              >
                JPEG
              </button>
              <button
                type="button"
                data-format="webp"
                aria-pressed="false"
                class="ui-seg-btn"
              >
                WebP
              </button>
            </div>
          </div>
          <div id="pad-quality-wrap" hidden class="min-w-40 flex-1">
            <label for="pad-quality" class="ui-label">
              {t.qualityLabel}
              <span id="pad-quality-value">90</span>
            </label>
            <input
              id="pad-quality"
              type="range"
              min="10"
              max="100"
              value="90"
              class="h-11 w-full"
            />
          </div>
        </div>
        <p
          id="pad-jpeg-note"
          hidden
          class="mt-2 text-xs text-gray-500 dark:text-gray-400"
        >
          {t.jpegTransparentNote}
        </p>
      </div>

      <div class="flex flex-col items-center gap-3">
        <p class="ui-label self-start">{t.previewLabel}</p>
        <div
          class="w-fit max-w-full overflow-hidden rounded-lg border border-gray-300 dark:border-gray-700"
          style="background-image: conic-gradient(#e5e7eb 25%, #fff 0 50%, #e5e7eb 0 75%, #fff 0); background-size: 16px 16px;"
        >
          <canvas
            id="pad-canvas"
            role="img"
            aria-label={t.previewLabel}
            class="block max-h-[70vh] max-w-full"
          ></canvas>
        </div>
        <p
          id="pad-size"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></p>
        <button id="pad-download" type="button" disabled class="ui-btn-primary">
          {t.downloadButton}
        </button>
        <span
          id="pad-status"
          class="text-sm text-green-700 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </div>
</ToolShell>

<script>
  import { downloadBlob } from '../../lib/download';
  import { enableFileDrop } from '../../lib/file-drop';
  import {
    clampMargin,
    computeLayout,
    isWithinLimit,
    outputFormat,
    paddedFileName,
    parseAspect,
    type OutputFormat,
  } from '../../lib/tools/image-padding';

  const root = document.getElementById('pad-root')!;
  const fileInput = document.getElementById('pad-file') as HTMLInputElement;
  const dropzone = document.getElementById('pad-dropzone')!;
  const errorEl = document.getElementById('pad-error')!;
  const workspace = document.getElementById('pad-workspace')!;
  const canvas = document.getElementById('pad-canvas') as HTMLCanvasElement;
  const aspectSelect = document.getElementById(
    'pad-aspect',
  ) as HTMLSelectElement;
  const customWrap = document.getElementById('pad-custom-wrap')!;
  const customW = document.getElementById('pad-custom-w') as HTMLInputElement;
  const customH = document.getElementById('pad-custom-h') as HTMLInputElement;
  const marginInput = document.getElementById('pad-margin') as HTMLInputElement;
  const colorInput = document.getElementById('pad-color') as HTMLInputElement;
  const transparentInput = document.getElementById(
    'pad-transparent',
  ) as HTMLInputElement;
  const sizeEl = document.getElementById('pad-size')!;
  const statusEl = document.getElementById('pad-status')!;
  const downloadButton = document.getElementById(
    'pad-download',
  ) as HTMLButtonElement;
  const qualityWrap = document.getElementById('pad-quality-wrap')!;
  const qualityInput = document.getElementById(
    'pad-quality',
  ) as HTMLInputElement;
  const qualityValue = document.getElementById('pad-quality-value')!;
  const jpegNote = document.getElementById('pad-jpeg-note')!;
  const formatButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#pad-format [data-format]'),
  );

  const d = root.dataset;
  let bitmap: ImageBitmap | null = null;
  let sourceName: string | null = null;
  let format: OutputFormat = 'png';
  // 画像の読み込みは非同期なので、古い読み込みが新しい選択を上書きしないよう世代で管理する
  let generation = 0;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = message === '';
  }

  function currentRatio(): number | null {
    if (aspectSelect.value === 'custom') {
      return parseAspect(`${customW.value}:${customH.value}`);
    }
    return parseAspect(aspectSelect.value);
  }

  function updateNotes() {
    qualityWrap.hidden = format === 'png';
    jpegNote.hidden = !(format === 'jpeg' && transparentInput.checked);
  }

  /** 設定に合わせて、出力サイズの画像をプレビュー用canvasに描く */
  function render() {
    statusEl.textContent = '';
    if (!bitmap) return;
    const source = { width: bitmap.width, height: bitmap.height };
    const layout = computeLayout(
      source,
      currentRatio(),
      clampMargin(Number(marginInput.value)),
    );
    if (!isWithinLimit(layout.canvas)) {
      downloadButton.disabled = true;
      sizeEl.textContent = '';
      showError(d.errorOutputTooLarge ?? '');
      return;
    }
    showError('');
    canvas.width = layout.canvas.width;
    canvas.height = layout.canvas.height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return showError(d.errorExportFailed ?? '');
    if (!transparentInput.checked) {
      ctx.fillStyle = colorInput.value;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    ctx.drawImage(bitmap, layout.x, layout.y);
    sizeEl.textContent = (d.outputInfo ?? '')
      .replace('{srcWidth}', String(source.width))
      .replace('{srcHeight}', String(source.height))
      .replace('{width}', String(layout.canvas.width))
      .replace('{height}', String(layout.canvas.height));
    downloadButton.disabled = false;
  }

  async function loadFile(file: File) {
    const current = ++generation;
    showError('');
    statusEl.textContent = '';
    if (!file.type.startsWith('image/'))
      return showError(d.errorNotImage ?? '');
    let loaded: ImageBitmap;
    try {
      loaded = await createImageBitmap(file);
    } catch {
      if (current === generation) showError(d.errorLoadFailed ?? '');
      return;
    }
    if (current !== generation) return loaded.close();
    if (!isWithinLimit({ width: loaded.width, height: loaded.height })) {
      loaded.close();
      return showError(d.errorTooLarge ?? '');
    }
    bitmap?.close();
    bitmap = loaded;
    sourceName = file.name;
    workspace.hidden = false;
    render();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) void loadFile(file);
  });
  enableFileDrop(dropzone, fileInput);

  aspectSelect.addEventListener('change', () => {
    customWrap.hidden = aspectSelect.value !== 'custom';
    render();
  });
  for (const el of [customW, customH, marginInput, colorInput]) {
    el.addEventListener('input', render);
  }
  transparentInput.addEventListener('change', () => {
    colorInput.disabled = transparentInput.checked;
    updateNotes();
    render();
  });

  function applyFormat(next: OutputFormat) {
    format = next;
    for (const b of formatButtons) {
      b.setAttribute('aria-pressed', String(b.dataset.format === next));
    }
    updateNotes();
  }
  for (const b of formatButtons) {
    b.addEventListener('click', () =>
      applyFormat(b.dataset.format as OutputFormat),
    );
  }
  qualityInput.addEventListener('input', () => {
    qualityValue.textContent = qualityInput.value;
  });

  downloadButton.addEventListener('click', () => {
    if (!bitmap) return;
    const { width, height } = canvas;
    const { mime } = outputFormat(format);
    let target = canvas;
    if (format === 'jpeg' && transparentInput.checked) {
      // JPEGは透明を持てないので、白の上に重ねてから書き出す
      target = document.createElement('canvas');
      target.width = width;
      target.height = height;
      const ctx = target.getContext('2d');
      if (!ctx) return showError(d.errorExportFailed ?? '');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(canvas, 0, 0);
    }
    target.toBlob(
      (blob) => {
        // 非対応の形式はブラウザがPNGで返すため、種類が違えば失敗として扱う
        if (!blob || blob.type !== mime) {
          return showError(d.errorExportFailed ?? '');
        }
        showError('');
        downloadBlob(blob, paddedFileName(sourceName, format));
        statusEl.textContent = d.downloaded ?? '';
      },
      mime,
      format === 'png' ? undefined : Number(qualityInput.value) / 100,
    );
  });
</script>
