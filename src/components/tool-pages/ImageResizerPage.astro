---
import ToolShell from '../ToolShell.astro';
import { imageResizerContent } from '../../i18n/tools/image-resizer';
import { MIN_DIMENSION, MAX_DIMENSION } from '../../lib/tools/image-resizer';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = imageResizerContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="ir-file-input" class="ui-label">{t.dropLabel}</label>
    <div id="ir-dropzone" class="ui-dropzone">
      <input
        id="ir-file-input"
        type="file"
        multiple
        accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    </div>
    <p
      id="ir-file-count"
      data-selected-template={t.filesSelectedTemplate}
      class="mt-1 text-xs text-gray-500 dark:text-gray-400"
    ></p>
    <p
      id="ir-error"
      role="alert"
      hidden
      data-message={t.errorUnsupportedFile}
      data-too-many-template={t.errorTooManyFilesTemplate}
      data-too-large-template={t.errorFileTooLargeTemplate}
      class="mt-1 text-xs text-red-600 dark:text-red-400"
    ></p>
  </div>

  <div class="mt-4">
    <span class="ui-label">{t.resizeModeLabel}</span>
    <div
      id="ir-dimension-mode"
      class="ui-seg mb-3"
      role="group"
      aria-label={t.resizeModeLabel}
    >
      <button
        type="button"
        data-dimension-mode="px"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modePxLabel}
      </button>
      <button
        type="button"
        data-dimension-mode="percent"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modePercentLabel}
      </button>
    </div>

    <div id="ir-px-panel" class="flex flex-wrap items-end gap-3">
      <div>
        <label for="ir-width" class="ui-label">
          {t.widthLabel}
        </label>
        <input
          id="ir-width"
          type="number"
          min={MIN_DIMENSION}
          max={MAX_DIMENSION}
          class="h-11 w-28 rounded-lg border border-gray-300 px-3 text-sm dark:border-gray-700 dark:bg-gray-900"
        />
      </div>
      <span class="mb-2.5 text-gray-500 dark:text-gray-400">×</span>
      <div>
        <label for="ir-height" class="ui-label">
          {t.heightLabel}
        </label>
        <input
          id="ir-height"
          type="number"
          min={MIN_DIMENSION}
          max={MAX_DIMENSION}
          class="h-11 w-28 rounded-lg border border-gray-300 px-3 text-sm dark:border-gray-700 dark:bg-gray-900"
        />
      </div>
      <label class="mb-2.5 flex min-h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <input id="ir-aspect-lock" type="checkbox" checked class="h-4 w-4" />
        {t.aspectLockLabel}
      </label>
      <button
        id="ir-reset-button"
        type="button"
        disabled
        class="ui-btn mb-2.5 px-3 disabled:cursor-not-allowed disabled:opacity-50"
      >
        {t.resetButton}
      </button>
    </div>

    <div id="ir-percent-panel" hidden class="max-w-xs">
      <label for="ir-percent" class="ui-label">
        {t.percentLabel}
        <span
          id="ir-percent-value"
          data-value-template={t.percentValueTemplate}
        ></span>
      </label>
      <input
        id="ir-percent"
        type="range"
        min="1"
        max="500"
        value="50"
        class="h-11 w-full"
      />
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-end gap-6">
    <div>
      <span class="ui-label">{t.formatLabel}</span>
      <div
        id="ir-format"
        class="ui-seg"
        role="group"
        aria-label={t.formatLabel}
      >
        <button
          type="button"
          data-format="webp"
          aria-pressed="true"
          class="ui-seg-btn"
        >
          {t.formatWebp}
        </button>
        <button
          type="button"
          data-format="jpeg"
          aria-pressed="false"
          class="ui-seg-btn"
        >
          {t.formatJpeg}
        </button>
        <button
          type="button"
          data-format="png"
          aria-pressed="false"
          class="ui-seg-btn"
        >
          {t.formatPng}
        </button>
      </div>
    </div>

    <div class="min-w-48 flex-1">
      <label for="ir-quality" class="ui-label">
        {t.qualityLabel}
        <span
          id="ir-quality-value"
          data-value-template={t.qualityValueTemplate}
        ></span>
      </label>
      <input
        id="ir-quality"
        type="range"
        min="1"
        max="100"
        value="80"
        class="h-11 w-full"
      />
      <p
        id="ir-quality-note"
        hidden
        class="mt-1 text-xs text-gray-500 dark:text-gray-400"
      >
        {t.qualityPngNote}
      </p>
    </div>

    <button
      id="ir-clear-button"
      type="button"
      disabled
      class="ui-btn disabled:cursor-not-allowed disabled:opacity-50"
    >
      {t.clearButton}
    </button>
  </div>

  <div
    id="ir-results-section"
    hidden
    class="mt-6"
    data-original-label={t.originalSizeLabel}
    data-converted-label={t.convertedSizeLabel}
    data-dimensions-size-template={t.dimensionsSizeTemplate}
    data-reduction-increased-template={t.reductionIncreasedTemplate}
    data-reduction-decreased-template={t.reductionDecreasedTemplate}
    data-download-label={t.downloadButton}
    data-remove-label={t.removeButton}
    data-error-conversion-failed={t.errorConversionFailed}
  >
    <h2 class="mb-2 text-lg font-bold">{t.resultsHeading}</h2>
    <ul id="ir-results-list" class="space-y-3"></ul>
  </div>

  <template id="ir-result-template">
    <li class="flex flex-wrap items-center gap-3 rounded-lg border border-gray-300 p-3 dark:border-gray-700">
      <img
        data-thumb
        alt=""
        class="h-14 w-14 flex-shrink-0 rounded bg-gray-100 object-cover dark:bg-gray-800"
      />
      <div class="min-w-0 flex-1">
        <p
          data-filename
          class="truncate text-sm font-medium text-gray-800 dark:text-gray-200"
        ></p>
        <p data-size class="text-xs text-gray-500 dark:text-gray-400"></p>
        <p data-error hidden class="text-xs text-red-600 dark:text-red-400"></p>
      </div>
      <a
        data-download
        download
        class="inline-flex min-h-11 items-center rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 aria-disabled:pointer-events-none aria-disabled:bg-gray-300 aria-disabled:text-gray-500 dark:aria-disabled:bg-gray-700 dark:aria-disabled:text-gray-400"
      ></a>
      <button data-remove type="button" class="ui-btn px-3"></button>
    </li>
  </template>
</ToolShell>

<script>
  import { enableFileDrop } from '../../lib/file-drop';
  import {
    buildOutputFileName,
    calculateReductionPercent,
    clampDimensionValue,
    computeTargetDimensions,
    formatFileSize,
    getOutputFormatOption,
    isAcceptedImageFile,
    type Dimensions,
    type OutputFormat,
    type ResizeTarget,
  } from '../../lib/tools/image-resizer';

  const MAX_FILES = 30;
  const MAX_FILE_SIZE = 25 * 1024 * 1024;

  interface ImageItem {
    id: number;
    file: File;
    bitmap: ImageBitmap;
    originalDims: Dimensions;
    convertedUrl: string | null;
    error: boolean;
  }

  const dropzone = document.getElementById('ir-dropzone')!;
  const fileInput = document.getElementById(
    'ir-file-input',
  ) as HTMLInputElement;
  const fileCountEl = document.getElementById('ir-file-count')!;
  const errorEl = document.getElementById('ir-error')!;

  const dimensionModeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#ir-dimension-mode [data-dimension-mode]',
  );
  const pxPanel = document.getElementById('ir-px-panel')!;
  const percentPanel = document.getElementById('ir-percent-panel')!;
  const widthInput = document.getElementById('ir-width') as HTMLInputElement;
  const heightInput = document.getElementById('ir-height') as HTMLInputElement;
  const aspectLockInput = document.getElementById(
    'ir-aspect-lock',
  ) as HTMLInputElement;
  const resetButton = document.getElementById(
    'ir-reset-button',
  ) as HTMLButtonElement;
  const percentInput = document.getElementById(
    'ir-percent',
  ) as HTMLInputElement;
  const percentValueEl = document.getElementById('ir-percent-value')!;

  const formatButtons = document.querySelectorAll<HTMLButtonElement>(
    '#ir-format [data-format]',
  );
  const qualityInput = document.getElementById(
    'ir-quality',
  ) as HTMLInputElement;
  const qualityValueEl = document.getElementById('ir-quality-value')!;
  const qualityNoteEl = document.getElementById('ir-quality-note')!;
  const clearButton = document.getElementById(
    'ir-clear-button',
  ) as HTMLButtonElement;
  const resultsSection = document.getElementById('ir-results-section')!;
  const resultsList = document.getElementById('ir-results-list')!;
  const resultTemplate = document.getElementById(
    'ir-result-template',
  ) as HTMLTemplateElement;

  const selectedTemplate = fileCountEl.dataset.selectedTemplate ?? '';
  const qualityValueTemplate = qualityValueEl.dataset.valueTemplate ?? '';
  const percentValueTemplate = percentValueEl.dataset.valueTemplate ?? '';
  const originalLabel = resultsSection.dataset.originalLabel ?? '';
  const convertedLabel = resultsSection.dataset.convertedLabel ?? '';
  const dimensionsSizeTemplate =
    resultsSection.dataset.dimensionsSizeTemplate ?? '';
  const reductionIncreasedTemplate =
    resultsSection.dataset.reductionIncreasedTemplate ?? '';
  const reductionDecreasedTemplate =
    resultsSection.dataset.reductionDecreasedTemplate ?? '';
  const downloadLabel = resultsSection.dataset.downloadLabel ?? '';
  const removeLabel = resultsSection.dataset.removeLabel ?? '';
  const errorConversionFailed =
    resultsSection.dataset.errorConversionFailed ?? '';
  const errorUnsupportedFile = errorEl.dataset.message ?? '';

  let items: ImageItem[] = [];
  let nextId = 0;
  let format: OutputFormat = 'webp';
  let dimensionMode: 'px' | 'percent' = 'px';
  let pxDrivingField: 'width' | 'height' = 'width';

  function formatDimensionsSize(dims: Dimensions, sizeText: string): string {
    return dimensionsSizeTemplate
      .replace('{width}', String(dims.width))
      .replace('{height}', String(dims.height))
      .replace('{size}', sizeText);
  }

  function updateQualityUi() {
    qualityValueEl.textContent = qualityValueTemplate.replace(
      '{value}',
      qualityInput.value,
    );
    const supportsQuality = getOutputFormatOption(format).supportsQuality;
    qualityInput.disabled = !supportsQuality;
    qualityNoteEl.hidden = supportsQuality;
  }

  function updatePercentUi() {
    percentValueEl.textContent = percentValueTemplate.replace(
      '{value}',
      percentInput.value,
    );
  }

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function clearErrorBanner() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function readWidthValue(): number {
    return clampDimensionValue(Number(widthInput.value));
  }

  function readHeightValue(): number {
    return clampDimensionValue(Number(heightInput.value));
  }

  function buildResizeTarget(): ResizeTarget {
    if (dimensionMode === 'percent') {
      return { mode: 'percent', percent: Number(percentInput.value) };
    }
    if (aspectLockInput.checked) {
      return pxDrivingField === 'width'
        ? { mode: 'width', width: readWidthValue() }
        : { mode: 'height', height: readHeightValue() };
    }
    return { mode: 'both', width: readWidthValue(), height: readHeightValue() };
  }

  function referenceDimensions(): Dimensions | null {
    return items.length > 0 ? items[0].originalDims : null;
  }

  /** 縦横比固定時、参照画像（先頭の画像）を基準にもう一辺の入力欄の表示値を更新する */
  function syncPairedField() {
    if (!aspectLockInput.checked) return;
    const reference = referenceDimensions();
    if (!reference) return;
    if (pxDrivingField === 'width') {
      heightInput.value = String(
        computeTargetDimensions(reference, {
          mode: 'width',
          width: readWidthValue(),
        }).height,
      );
    } else {
      widthInput.value = String(
        computeTargetDimensions(reference, {
          mode: 'height',
          height: readHeightValue(),
        }).width,
      );
    }
  }

  async function addFiles(fileList: FileList) {
    clearErrorBanner();
    const incoming = Array.from(fileList);

    if (items.length + incoming.length > MAX_FILES) {
      showError(
        (errorEl.dataset.tooManyTemplate ?? '').replace(
          '{max}',
          String(MAX_FILES),
        ),
      );
      return;
    }

    const hadNoItems = items.length === 0;

    for (const file of incoming) {
      if (!isAcceptedImageFile(file)) {
        showError(errorUnsupportedFile);
        continue;
      }
      if (file.size > MAX_FILE_SIZE) {
        showError(
          (errorEl.dataset.tooLargeTemplate ?? '').replace(
            '{max}',
            formatFileSize(MAX_FILE_SIZE),
          ),
        );
        continue;
      }
      try {
        const bitmap = await createImageBitmap(file);
        items.push({
          id: nextId++,
          file,
          bitmap,
          originalDims: { width: bitmap.width, height: bitmap.height },
          convertedUrl: null,
          error: false,
        });
      } catch {
        showError(errorConversionFailed);
      }
    }

    if (hadNoItems && items.length > 0) {
      const reference = items[0].originalDims;
      widthInput.value = String(reference.width);
      heightInput.value = String(reference.height);
    }

    fileCountEl.textContent =
      items.length === 0
        ? ''
        : selectedTemplate.replace('{count}', String(items.length));
    clearButton.disabled = items.length === 0;
    resetButton.disabled = items.length === 0;
    resultsSection.hidden = items.length === 0;

    await renderResults();
  }

  function convertItem(
    item: ImageItem,
    quality: number,
    target: ResizeTarget,
  ): Promise<{ blob: Blob; dims: Dimensions } | null> {
    return new Promise((resolve) => {
      try {
        const dims = computeTargetDimensions(item.originalDims, target);
        const option = getOutputFormatOption(format);
        const canvas = document.createElement('canvas');
        canvas.width = dims.width;
        canvas.height = dims.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          resolve(null);
          return;
        }
        if (format === 'jpeg') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
        ctx.drawImage(item.bitmap, 0, 0, dims.width, dims.height);
        const qualityArg = option.supportsQuality ? quality / 100 : undefined;
        canvas.toBlob(
          (blob) => {
            if (blob && blob.type === option.mimeType) {
              resolve({ blob, dims });
            } else {
              resolve(null);
            }
          },
          option.mimeType,
          qualityArg,
        );
      } catch {
        resolve(null);
      }
    });
  }

  // 複数の呼び出しが並行して走った場合に、後から来た呼び出しの結果だけを反映させるための世代番号
  let renderGeneration = 0;

  async function renderResults() {
    const generation = ++renderGeneration;
    const quality = Number(qualityInput.value);
    const target = buildResizeTarget();
    resultsList.innerHTML = '';

    for (const item of items) {
      if (item.convertedUrl) {
        URL.revokeObjectURL(item.convertedUrl);
        item.convertedUrl = null;
      }

      const result = await convertItem(item, quality, target);
      if (generation !== renderGeneration) return;

      const li = resultTemplate.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLElement;
      const thumb = li.querySelector('[data-thumb]') as HTMLImageElement;
      const filenameEl = li.querySelector('[data-filename]')!;
      const sizeEl = li.querySelector('[data-size]')!;
      const errorLineEl = li.querySelector('[data-error]') as HTMLElement;
      const downloadEl = li.querySelector(
        '[data-download]',
      ) as HTMLAnchorElement;
      const removeEl = li.querySelector('[data-remove]') as HTMLButtonElement;

      filenameEl.textContent = item.file.name;
      downloadEl.textContent = downloadLabel;
      removeEl.textContent = removeLabel;
      removeEl.addEventListener('click', () => {
        if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
        items = items.filter((i) => i.id !== item.id);
        // 削除した画像が基準画像（先頭）だった場合に備え、幅/高さ入力欄の表示を新しい基準画像に合わせ直す
        syncPairedField();
        fileCountEl.textContent =
          items.length === 0
            ? ''
            : selectedTemplate.replace('{count}', String(items.length));
        clearButton.disabled = items.length === 0;
        resetButton.disabled = items.length === 0;
        resultsSection.hidden = items.length === 0;
        void renderResults();
      });

      if (!result) {
        item.error = true;
        errorLineEl.textContent = errorConversionFailed;
        errorLineEl.hidden = false;
        sizeEl.textContent = '';
        downloadEl.setAttribute('aria-disabled', 'true');
        downloadEl.removeAttribute('href');
        thumb.remove();
        resultsList.appendChild(li);
        continue;
      }

      item.error = false;
      const { blob, dims } = result;
      const url = URL.createObjectURL(blob);
      item.convertedUrl = url;
      thumb.src = url;
      downloadEl.href = url;
      downloadEl.download = buildOutputFileName(item.file.name, format);
      downloadEl.removeAttribute('aria-disabled');

      const reduction = calculateReductionPercent(item.file.size, blob.size);
      const reductionText =
        reduction >= 0
          ? reductionDecreasedTemplate.replace('{percent}', String(reduction))
          : reductionIncreasedTemplate.replace(
              '{percent}',
              String(Math.abs(reduction)),
            );
      const originalText = formatDimensionsSize(
        item.originalDims,
        formatFileSize(item.file.size),
      );
      const convertedText = formatDimensionsSize(
        dims,
        formatFileSize(blob.size),
      );
      sizeEl.textContent = `${originalLabel}: ${originalText} → ${convertedLabel}: ${convertedText}（${reductionText}）`;

      resultsList.appendChild(li);
    }
  }

  fileInput.addEventListener('change', () => {
    if (!fileInput.files || fileInput.files.length === 0) return;
    void addFiles(fileInput.files);
    fileInput.value = '';
  });

  enableFileDrop(dropzone, fileInput);

  dimensionModeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      dimensionMode = button.dataset.dimensionMode as 'px' | 'percent';
      dimensionModeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      pxPanel.hidden = dimensionMode !== 'px';
      percentPanel.hidden = dimensionMode !== 'percent';
      void renderResults();
    });
  });

  let widthDebounce: ReturnType<typeof setTimeout> | undefined;
  widthInput.addEventListener('input', () => {
    pxDrivingField = 'width';
    syncPairedField();
    clearTimeout(widthDebounce);
    widthDebounce = setTimeout(() => void renderResults(), 200);
  });

  let heightDebounce: ReturnType<typeof setTimeout> | undefined;
  heightInput.addEventListener('input', () => {
    pxDrivingField = 'height';
    syncPairedField();
    clearTimeout(heightDebounce);
    heightDebounce = setTimeout(() => void renderResults(), 200);
  });

  aspectLockInput.addEventListener('change', () => {
    syncPairedField();
    void renderResults();
  });

  resetButton.addEventListener('click', () => {
    const reference = referenceDimensions();
    if (!reference) return;
    widthInput.value = String(reference.width);
    heightInput.value = String(reference.height);
    void renderResults();
  });

  let percentDebounce: ReturnType<typeof setTimeout> | undefined;
  percentInput.addEventListener('input', () => {
    updatePercentUi();
    clearTimeout(percentDebounce);
    percentDebounce = setTimeout(() => void renderResults(), 200);
  });

  formatButtons.forEach((button) => {
    button.addEventListener('click', () => {
      format = button.dataset.format as OutputFormat;
      formatButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      updateQualityUi();
      void renderResults();
    });
  });

  let qualityDebounce: ReturnType<typeof setTimeout> | undefined;
  qualityInput.addEventListener('input', () => {
    updateQualityUi();
    clearTimeout(qualityDebounce);
    qualityDebounce = setTimeout(() => void renderResults(), 200);
  });

  clearButton.addEventListener('click', () => {
    items.forEach((item) => {
      if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
    });
    items = [];
    fileCountEl.textContent = '';
    clearButton.disabled = true;
    resetButton.disabled = true;
    resultsSection.hidden = true;
    resultsList.innerHTML = '';
    clearErrorBanner();
  });

  updateQualityUi();
  updatePercentUi();
</script>
