---
import ToolShell from '../ToolShell.astro';
import { imageToBase64Content } from '../../i18n/tools/image-to-base64';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = imageToBase64Content[locale];
---

<ToolShell t={t}>
  <div id="itb-mode" class="ui-seg mb-6" role="group" aria-label={t.modeLabel}>
    <button
      type="button"
      data-mode="encode"
      aria-pressed="true"
      class="ui-seg-btn flex-1"
    >
      {t.modeEncode}
    </button>
    <button
      type="button"
      data-mode="decode"
      aria-pressed="false"
      class="ui-seg-btn flex-1"
    >
      {t.modeDecode}
    </button>
  </div>

  <section id="itb-encode-section">
    <label for="itb-file-input" class="ui-label">{t.encodeDropLabel}</label>
    <div id="itb-dropzone" class="ui-dropzone">
      <input id="itb-file-input" type="file" accept="image/*" class="ui-file" />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        {t.encodeDropHint}
      </p>
    </div>
    <p
      id="itb-encode-error"
      role="alert"
      hidden
      data-message={t.errorUnsupportedFile}
      data-too-large-template={t.errorFileTooLargeTemplate}
      data-read-failed={t.errorReadFailed}
      class="mt-1 text-xs text-red-600 dark:text-red-400"
    ></p>

    <div
      id="itb-encode-result"
      hidden
      class="mt-4"
      data-file-info-template={t.encodeFileInfoTemplate}
    >
      <div class="flex flex-wrap items-center gap-3">
        <img
          id="itb-encode-preview"
          alt=""
          class="h-16 w-16 flex-shrink-0 rounded border border-gray-300 bg-gray-100 object-contain dark:border-gray-700 dark:bg-gray-800"
        />
        <p
          id="itb-encode-file-info"
          class="text-sm text-gray-600 dark:text-gray-400"
        ></p>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
          {t.encodeOutputStyleLabel}
        </span>
        <div
          id="itb-output-style"
          class="ui-seg"
          role="group"
          aria-label={t.encodeOutputStyleLabel}
        >
          <button
            type="button"
            data-style="data-url"
            aria-pressed="true"
            class="ui-seg-btn"
          >
            {t.encodeOutputStyleDataUrl}
          </button>
          <button
            type="button"
            data-style="base64-only"
            aria-pressed="false"
            class="ui-seg-btn"
          >
            {t.encodeOutputStyleBase64Only}
          </button>
        </div>
      </div>

      <label for="itb-output" class="ui-label mt-4">
        {t.encodeOutputLabel}
      </label>
      <textarea
        id="itb-output"
        readonly
        class="ui-input h-48 w-full bg-gray-50 p-4 font-mono break-all dark:bg-gray-900"
      ></textarea>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button
          id="itb-copy-button"
          type="button"
          data-copied={t.copiedMessage}
          data-copy-failed={t.copyFailedMessage}
          class="ui-btn"
        >
          {t.copyButton}
        </button>
        <a
          id="itb-download-link"
          download
          class="ui-btn inline-flex items-center"
        >
          {t.downloadButton}
        </a>
        <button id="itb-clear-button" type="button" class="ui-btn">
          {t.clearButton}
        </button>
        <span
          id="itb-copy-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>

  <section id="itb-decode-section" hidden>
    <label for="itb-decode-input" class="ui-label">
      {t.decodeInputLabel}
    </label>
    <textarea
      id="itb-decode-input"
      class="ui-input h-48 w-full p-4 font-mono break-all dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.decodeInputPlaceholder}
      spellcheck="false"
    ></textarea>

    <p
      id="itb-decode-error"
      role="alert"
      hidden
      data-message={t.decodeErrorMessage}
      class="ui-error mt-2 max-w-2xl"
    ></p>

    <div
      id="itb-decode-result"
      hidden
      class="mt-4"
      data-info-template={t.decodeInfoTemplate}
    >
      <span class="ui-label">{t.decodePreviewLabel}</span>
      <div class="flex flex-wrap items-center gap-3">
        <img
          id="itb-decode-preview"
          alt=""
          class="h-24 w-24 flex-shrink-0 rounded border border-gray-300 bg-gray-100 object-contain dark:border-gray-700 dark:bg-gray-800"
        />
        <div>
          <p
            id="itb-decode-info"
            class="mb-2 text-sm text-gray-600 dark:text-gray-400"
          ></p>
          <a
            id="itb-decode-download-link"
            download
            class="inline-flex min-h-11 items-center rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700"
          >
            {t.decodeDownloadButton}
          </a>
        </div>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { enableFileDrop } from '../../lib/file-drop';
  import { copyText } from '../../lib/clipboard';
  import {
    decodeBase64Image,
    formatEncodedOutput,
    formatFileSize,
    getExtensionForMimeType,
    isImageFile,
    MAX_FILE_SIZE,
    type OutputStyle,
  } from '../../lib/tools/image-to-base64';

  type Mode = 'encode' | 'decode';

  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#itb-mode [data-mode]',
  );
  const encodeSection = document.getElementById('itb-encode-section')!;
  const decodeSection = document.getElementById('itb-decode-section')!;

  let mode: Mode = 'encode';

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      encodeSection.hidden = mode !== 'encode';
      decodeSection.hidden = mode !== 'decode';
    });
  });

  // --- 画像→Base64 ---

  const dropzone = document.getElementById('itb-dropzone')!;
  const fileInput = document.getElementById(
    'itb-file-input',
  ) as HTMLInputElement;
  const encodeErrorEl = document.getElementById('itb-encode-error')!;
  const encodeResultEl = document.getElementById('itb-encode-result')!;
  const encodePreview = document.getElementById(
    'itb-encode-preview',
  ) as HTMLImageElement;
  const encodeFileInfoEl = document.getElementById('itb-encode-file-info')!;
  const outputStyleButtons = document.querySelectorAll<HTMLButtonElement>(
    '#itb-output-style [data-style]',
  );
  const output = document.getElementById('itb-output') as HTMLTextAreaElement;
  const copyButton = document.getElementById(
    'itb-copy-button',
  ) as HTMLButtonElement;
  const copyStatusEl = document.getElementById('itb-copy-status')!;
  const downloadLink = document.getElementById(
    'itb-download-link',
  ) as HTMLAnchorElement;
  const clearButton = document.getElementById(
    'itb-clear-button',
  ) as HTMLButtonElement;

  const fileInfoTemplate = encodeResultEl.dataset.fileInfoTemplate ?? '';

  let currentDataUrl: string | null = null;
  let currentFile: File | null = null;
  let outputStyle: OutputStyle = 'data-url';
  let downloadObjectUrl: string | null = null;

  function showEncodeError(message: string) {
    encodeErrorEl.textContent = message;
    encodeErrorEl.hidden = false;
  }

  function clearEncodeError() {
    encodeErrorEl.hidden = true;
    encodeErrorEl.textContent = '';
  }

  function revokeDownloadObjectUrl() {
    if (downloadObjectUrl) {
      URL.revokeObjectURL(downloadObjectUrl);
      downloadObjectUrl = null;
    }
  }

  function updateOutput() {
    if (!currentDataUrl || !currentFile) return;
    const text = formatEncodedOutput(currentDataUrl, outputStyle);
    output.value = text;

    revokeDownloadObjectUrl();
    const blob = new Blob([text], { type: 'text/plain' });
    downloadObjectUrl = URL.createObjectURL(blob);
    downloadLink.href = downloadObjectUrl;
    downloadLink.download = `${currentFile.name}-base64.txt`;
  }

  function resetEncodeState() {
    currentDataUrl = null;
    currentFile = null;
    revokeDownloadObjectUrl();
    output.value = '';
    encodeResultEl.hidden = true;
    encodePreview.removeAttribute('src');
    copyStatusEl.textContent = '';
  }

  async function handleFile(file: File) {
    clearEncodeError();
    if (!isImageFile(file)) {
      showEncodeError(encodeErrorEl.dataset.message ?? '');
      return;
    }
    if (file.size > MAX_FILE_SIZE) {
      showEncodeError(
        (encodeErrorEl.dataset.tooLargeTemplate ?? '').replace(
          '{max}',
          formatFileSize(MAX_FILE_SIZE),
        ),
      );
      return;
    }

    const dataUrl = await new Promise<string | null>((resolve) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = () => resolve(null);
      reader.readAsDataURL(file);
    });

    if (!dataUrl) {
      showEncodeError(encodeErrorEl.dataset.readFailed ?? '');
      return;
    }

    currentDataUrl = dataUrl;
    currentFile = file;
    encodePreview.src = dataUrl;
    encodeFileInfoEl.textContent = fileInfoTemplate
      .replace('{name}', file.name)
      .replace('{type}', file.type || '?')
      .replace('{size}', formatFileSize(file.size));
    encodeResultEl.hidden = false;
    copyStatusEl.textContent = '';
    updateOutput();
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (file) void handleFile(file);
  });

  enableFileDrop(dropzone, fileInput);

  outputStyleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      outputStyle = button.dataset.style as OutputStyle;
      outputStyleButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      updateOutput();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    copyStatusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  clearButton.addEventListener('click', () => {
    resetEncodeState();
    clearEncodeError();
  });

  // --- Base64→画像 ---

  const decodeInput = document.getElementById(
    'itb-decode-input',
  ) as HTMLTextAreaElement;
  const decodeErrorEl = document.getElementById('itb-decode-error')!;
  const decodeResultEl = document.getElementById('itb-decode-result')!;
  const decodePreview = document.getElementById(
    'itb-decode-preview',
  ) as HTMLImageElement;
  const decodeInfoEl = document.getElementById('itb-decode-info')!;
  const decodeDownloadLink = document.getElementById(
    'itb-decode-download-link',
  ) as HTMLAnchorElement;

  const decodeInfoTemplate = decodeResultEl.dataset.infoTemplate ?? '';

  function resetDecodeResult() {
    decodeResultEl.hidden = true;
    decodeErrorEl.hidden = true;
    decodePreview.removeAttribute('src');
  }

  function runDecode() {
    const value = decodeInput.value;
    if (value.trim() === '') {
      resetDecodeResult();
      return;
    }

    const result = decodeBase64Image(value);
    if (!result.success) {
      decodeResultEl.hidden = true;
      decodeErrorEl.textContent = decodeErrorEl.dataset.message ?? '';
      decodeErrorEl.hidden = false;
      return;
    }

    decodeErrorEl.hidden = true;
    decodePreview.src = result.dataUrl;
    decodeInfoEl.textContent = decodeInfoTemplate
      .replace('{type}', result.mimeType)
      .replace('{size}', formatFileSize(result.byteLength));
    decodeDownloadLink.href = result.dataUrl;
    decodeDownloadLink.download = `image.${getExtensionForMimeType(result.mimeType)}`;
    decodeResultEl.hidden = false;
  }

  let decodeDebounce: ReturnType<typeof setTimeout> | undefined;
  decodeInput.addEventListener('input', () => {
    clearTimeout(decodeDebounce);
    decodeDebounce = setTimeout(runDecode, 200);
  });
</script>
