  let currentFinalBalance: number | null = null;

  function render() {
    errorEl.textContent = '';
    resultsEl.classList.add('hidden');
    currentFinalBalance = null;
    renderTrendChart([]);
    renderWithdrawal();

    if (rateInput.value.trim() === '') return;
    const annualRate = Number(rateInput.value);
    const mode = getMode();

    let result: ReturnType<typeof simulateAccumulation> = null;
    let primaryText = '';
    let initialInvestmentUsed = 0;

    if (mode === 'futureValue') {
      if (
        initialInput.value.trim() === '' ||
        monthlyInput.value.trim() === '' ||
        yearsInput.value.trim() === ''
      )
        return;
      const initialInvestment = Number(stripCommas(initialInput.value));
      const monthlyContribution = Number(stripCommas(monthlyInput.value));
      const totalMonths = Number(yearsInput.value) * 12;
      initialInvestmentUsed = initialInvestment;
      result = simulateAccumulation({
        initialInvestment,
        monthlyContribution,
        annualRate,
        totalMonths,
      });
      if (result) primaryText = yen.format(result.finalBalance);
    } else if (mode === 'monthlyContribution') {
      if (
        initialInput.value.trim() === '' ||
        targetInput.value.trim() === '' ||
        yearsInput.value.trim() === ''
      )
        return;
      const initialInvestment = Number(stripCommas(initialInput.value));
      const targetFutureValue = Number(stripCommas(targetInput.value));
      const totalMonths = Number(yearsInput.value) * 12;
      const monthlyContribution = solveMonthlyContribution({
        initialInvestment,
        targetFutureValue,
        annualRate,
        totalMonths,
      });
      if (monthlyContribution !== null) {
        initialInvestmentUsed = initialInvestment;
        result = simulateAccumulation({
          initialInvestment,
          monthlyContribution,
          annualRate,
          totalMonths,
        });
        if (result) primaryText = yen.format(monthlyContribution);
      }
    } else if (mode === 'months') {
      if (
        initialInput.value.trim() === '' ||
        monthlyInput.value.trim() === '' ||
        targetInput.value.trim() === ''
      )
        return;
      const initialInvestment = Number(stripCommas(initialInput.value));
      const monthlyContribution = Number(stripCommas(monthlyInput.value));
      const targetFutureValue = Number(stripCommas(targetInput.value));
      const totalMonths = solveMonthsToReachTarget({
        initialInvestment,
        monthlyContribution,
        targetFutureValue,
        annualRate,
      });
      if (totalMonths !== null) {
        initialInvestmentUsed = initialInvestment;
        result = simulateAccumulation({
          initialInvestment,
          monthlyContribution,
          annualRate,
          totalMonths,
        });
        if (result) primaryText = formatMonths(totalMonths);
      }
    } else {
      if (
        monthlyInput.value.trim() === '' ||
        targetInput.value.trim() === '' ||
        yearsInput.value.trim() === ''
      )
        return;
      const monthlyContribution = Number(stripCommas(monthlyInput.value));
      const targetFutureValue = Number(stripCommas(targetInput.value));
      const totalMonths = Number(yearsInput.value) * 12;
      const initialInvestment = solveInitialInvestment({
        monthlyContribution,
        targetFutureValue,
        annualRate,
        totalMonths,
      });
      if (initialInvestment !== null) {
        initialInvestmentUsed = initialInvestment;
        result = simulateAccumulation({
          initialInvestment,
          monthlyContribution,
          annualRate,
          totalMonths,
        });
        if (result) primaryText = yen.format(initialInvestment);
      }
    }

    if (!result) {
      errorEl.textContent = errorMessage;
      return;
    }

    primaryLabelEl.textContent = primaryLabels[mode];
    primaryValueEl.textContent = primaryText;

    finalBalanceEl.textContent = yen.format(result.finalBalance);
    totalPrincipalEl.textContent = yen.format(result.totalPrincipal);
    totalGainEl.textContent = yen.format(result.totalGain);

    const principalPct = (result.totalPrincipal / result.finalBalance) * 100;
    const gainPct = 100 - principalPct;
    chartPrincipalEl.style.width = `${principalPct}%`;
    chartGainEl.style.width = `${gainPct}%`;
    chartEl.setAttribute(
      'aria-label',
      chartAriaLabelTemplate
        .replace('{principal}', yen.format(result.totalPrincipal))
        .replace('{gain}', yen.format(result.totalGain)),
    );
    legendPrincipalEl.textContent = `${yen.format(result.totalPrincipal)} (${principalPct.toFixed(1)}%)`;
    legendGainEl.textContent = `${yen.format(result.totalGain)} (${gainPct.toFixed(1)}%)`;

    tableBodyEl.replaceChildren(
      ...result.yearly.map((snapshot) => {
        const row = document.createElement('tr');
        row.className = 'border-t border-gray-200 dark:border-gray-700';
        const cells = [
          formatMonths(snapshot.months),
          yen.format(snapshot.principal),
          yen.format(snapshot.gain),
          yen.format(snapshot.balance),
        ];
        for (const text of cells) {
          const cell = document.createElement('td');
          cell.className = 'p-2';
          cell.textContent = text;
          row.appendChild(cell);
        }
        return row;
      }),
    );

    renderTrendChart([
      {
        months: 0,
        principal: initialInvestmentUsed,
        gain: 0,
        balance: initialInvestmentUsed,
      },
      ...result.yearly.map((snapshot) => ({
        months: snapshot.months,
        principal: snapshot.principal,
        gain: snapshot.gain,
        balance: snapshot.balance,
      })),
    ]);

    resultsEl.classList.remove('hidden');
    currentFinalBalance = result.finalBalance;
    renderWithdrawal();
  }

  function renderWithdrawal() {
    withdrawalErrorEl.textContent = '';
    withdrawalResultsEl.classList.add('hidden');
    renderWithdrawalChart([]);

    if (currentFinalBalance === null) return;

    const mode = getWithdrawalMode();
    const annualRate = Number(rateInput.value);
    let yearly: WithdrawalYearlySnapshot[];
    let primaryText: string;
    let totalWithdrawn: number;

    if (mode === 'byYears') {
      if (withdrawalYearsInput.value.trim() === '') return;
      const result = calculateWithdrawal({
        principal: currentFinalBalance,
        annualRate,
        withdrawalYears: Number(withdrawalYearsInput.value),
      });
      if (!result) {
        withdrawalErrorEl.textContent = withdrawalErrorMessage;
        return;
      }
      primaryText = yen.format(result.monthlyWithdrawal);
      totalWithdrawn = result.totalWithdrawn;
      yearly = result.yearly;
    } else if (mode === 'byAmount') {
      if (withdrawalAmountInput.value.trim() === '') return;
      const result = simulateFixedAmountWithdrawal({
        principal: currentFinalBalance,
        annualRate,
        monthlyWithdrawal: Number(stripCommas(withdrawalAmountInput.value)),
      });
      if (!result) {
        withdrawalErrorEl.textContent = withdrawalAmountErrorMessage;
        return;
      }
      primaryText =
        result.depletionMonths !== null
          ? formatMonths(result.depletionMonths)
          : withdrawalNotDepletedText;
      totalWithdrawn = result.totalWithdrawn;
      yearly = result.yearly;
    } else {
      if (
        withdrawalRateInput.value.trim() === '' ||
        withdrawalYearsInput.value.trim() === ''
      )
        return;
      const result = simulateFixedRateWithdrawal({
        principal: currentFinalBalance,
        annualRate,
        withdrawalRate: Number(withdrawalRateInput.value),
        withdrawalYears: Number(withdrawalYearsInput.value),
      });
      if (!result) {
        withdrawalErrorEl.textContent = withdrawalRateErrorMessage;
        return;
      }
      primaryText = yen.format(result.firstMonthWithdrawal);
      totalWithdrawn = result.totalWithdrawn;
      yearly = result.yearly;
    }

    withdrawalPrimaryLabelEl.textContent = withdrawalPrimaryLabels[mode];
    withdrawalPrimaryValueEl.textContent = primaryText;
    withdrawalTotalEl.textContent = yen.format(totalWithdrawn);

    withdrawalTableBodyEl.replaceChildren(
      ...yearly.map((snapshot) => {
        const row = document.createElement('tr');
        row.className = 'border-t border-gray-200 dark:border-gray-700';
        const cells = [
          formatMonths(snapshot.months),
          yen.format(snapshot.remainingBalance),
        ];
        for (const text of cells) {
          const cell = document.createElement('td');
          cell.className = 'p-2';
          cell.textContent = text;
          row.appendChild(cell);
        }
        return row;
      }),
    );

    renderWithdrawalChart([
      { months: 0, remainingBalance: currentFinalBalance },
      ...yearly.map((snapshot) => ({
        months: snapshot.months,
        remainingBalance: snapshot.remainingBalance,
      })),
    ]);

    withdrawalResultsEl.classList.remove('hidden');
  }

  modeInputs.forEach((el) =>
    el.addEventListener('change', () => {
      updateFieldVisibility();
      render();
    }),
  );
  rateInput.addEventListener('input', render);
  initialInput.addEventListener('input', render);
  monthlyInput.addEventListener('input', render);
  yearsInput.addEventListener('input', render);
  targetInput.addEventListener('input', render);
  withdrawalModeInputs.forEach((el) =>
    el.addEventListener('change', () => {
      updateWithdrawalFieldVisibility();
      renderWithdrawal();
    }),
  );
  withdrawalYearsInput.addEventListener('input', renderWithdrawal);
  withdrawalAmountInput.addEventListener('input', renderWithdrawal);
  withdrawalRateInput.addEventListener('input', renderWithdrawal);

  rateInput.value = '5';
  initialInput.value = formatNumberWithCommas('1000000');
  monthlyInput.value = formatNumberWithCommas('30000');
  yearsInput.value = '20';
  targetInput.value = formatNumberWithCommas('20000000');
  withdrawalYearsInput.value = '30';
  withdrawalAmountInput.value = formatNumberWithCommas('100000');
  withdrawalRateInput.value = '4';

  updateFieldVisibility();
  updateWithdrawalFieldVisibility();
  render();
</script>
