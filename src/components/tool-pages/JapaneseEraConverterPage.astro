---
import ToolShell from '../ToolShell.astro';
import { ERAS } from '../../lib/tools/japanese-era-converter';
import { japaneseEraConverterContent } from '../../i18n/tools/japanese-era-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = japaneseEraConverterContent[locale];
const reversedEras = ERAS.slice().reverse();
---

<ToolShell t={t}>
  <section
    class="mb-8 rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-locale={locale}
    data-result-format={JSON.stringify(t.resultFormat)}
    data-error-w2j={t.errorW2J}
  >
    <h2 class="mb-3 text-lg font-bold">{t.westernToJapaneseHeading}</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span id="era-w2j-label" class="ui-label">
          {t.westernDateLabel}
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="era-w2j-label"
        >
          <input
            id="era-w2j-year"
            type="number"
            inputmode="numeric"
            min="1"
            max="9999"
            placeholder={t.yearPlaceholder}
            aria-label={t.westernYearAriaLabel}
            class="ui-input h-11 w-24 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {t.yearUnit}
          </span>
          <input
            id="era-w2j-month"
            type="number"
            inputmode="numeric"
            min="1"
            max="12"
            placeholder={t.monthPlaceholder}
            aria-label={t.westernMonthAriaLabel}
            class="ui-input h-11 w-16 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {t.monthUnit}
          </span>
          <input
            id="era-w2j-day"
            type="number"
            inputmode="numeric"
            min="1"
            max="31"
            placeholder={t.dayPlaceholder}
            aria-label={t.westernDayAriaLabel}
            class="ui-input h-11 w-16 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
          />
          {t.dayUnit && (
            <span class="text-sm text-gray-600 dark:text-gray-400">
              {t.dayUnit}
            </span>
          )}
        </div>
      </div>
    </div>
    <p
      id="era-w2j-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-w2j-result"
      aria-live="polite"
    ></p>
  </section>

  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-error-j2w={t.errorJ2W}
  >
    <h2 class="mb-3 text-lg font-bold">{t.japaneseToWesternHeading}</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="era-j2w-era" class="ui-label">
          {t.eraLabel}
        </label>
        <select
          id="era-j2w-era"
          class="ui-input h-11 bg-white px-3 dark:bg-gray-900"
        >
          {reversedEras.map((era) => (
            <option value={era.name}>
              {locale === 'ja' ? era.name : era.romaji}
            </option>
          ))}
        </select>
      </div>
      <div class="w-24">
        <label for="era-j2w-year" class="ui-label">
          {t.j2wYearLabel}
        </label>
        <input
          id="era-j2w-year"
          type="number"
          min="1"
          max="99"
          inputmode="numeric"
          placeholder={t.j2wYearPlaceholder}
          class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label for="era-j2w-month" class="ui-label">
          {t.j2wMonthLabel}
        </label>
        <input
          id="era-j2w-month"
          type="number"
          min="1"
          max="12"
          inputmode="numeric"
          placeholder={t.monthPlaceholder}
          class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label for="era-j2w-day" class="ui-label">
          {t.j2wDayLabel}
        </label>
        <input
          id="era-j2w-day"
          type="number"
          min="1"
          max="31"
          inputmode="numeric"
          placeholder={t.dayPlaceholder}
          class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
    </div>
    <p
      id="era-j2w-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-j2w-result"
      aria-live="polite"
    ></p>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.tableHeading}</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-left dark:border-gray-700">
          <th class="py-2 pr-4">{t.tableColEra}</th>
          <th class="py-2 pr-4">{t.tableColStartDate}</th>
          <th class="py-2">{t.tableColYear1}</th>
        </tr>
      </thead>
      <tbody>
        {reversedEras.map((era) => (
          <tr class="border-b border-gray-100 dark:border-gray-800">
            <td class="py-2 pr-4 font-medium">
              {locale === 'ja' ? era.name : era.romaji}
            </td>
            <td class="py-2 pr-4">
              {locale === 'ja' ? (
                <>
                  {era.start.year}年{era.start.month}月{era.start.day}日
                </>
              ) : (
                <>
                  {era.start.year}-{String(era.start.month).padStart(2, '0')}-
                  {String(era.start.day).padStart(2, '0')}
                </>
              )}
            </td>
            <td class="py-2">
              {locale === 'ja' ? `${era.start.year}年` : era.start.year}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ToolShell>

<script>
  import {
    warekiToWestern,
    westernToWareki,
  } from '../../lib/tools/japanese-era-converter';
  import { fill } from '../../lib/format-template';
  import type { EraResultFormat } from '../../i18n/tools/japanese-era-converter';

  const w2jSection = document.querySelector<HTMLElement>(
    'section[data-locale]',
  )!;
  const format: EraResultFormat = JSON.parse(
    w2jSection.dataset.resultFormat ?? '{}',
  );
  const errorW2J = w2jSection.dataset.errorW2j ?? '';

  const w2jYearInput = document.getElementById(
    'era-w2j-year',
  ) as HTMLInputElement;
  const w2jMonthInput = document.getElementById(
    'era-w2j-month',
  ) as HTMLInputElement;
  const w2jDayInput = document.getElementById(
    'era-w2j-day',
  ) as HTMLInputElement;
  const w2jErrorEl = document.getElementById('era-w2j-error')!;
  const w2jResultEl = document.getElementById('era-w2j-result')!;

  function renderWesternToWareki() {
    w2jErrorEl.textContent = '';
    w2jResultEl.textContent = '';

    if (
      w2jYearInput.value === '' ||
      w2jMonthInput.value === '' ||
      w2jDayInput.value === ''
    ) {
      return;
    }

    const result = westernToWareki(
      Number(w2jYearInput.value),
      Number(w2jMonthInput.value),
      Number(w2jDayInput.value),
    );
    if (!result) {
      w2jErrorEl.textContent = errorW2J;
      return;
    }

    w2jResultEl.textContent = fill(format.wareki, {
      era: format.romajiEraName ? result.era.romaji : result.era.name,
      year:
        result.eraYear === 1
          ? format.eraYearFirst
          : fill(format.eraYear, { n: String(result.eraYear) }),
    });
  }

  w2jYearInput.addEventListener('input', renderWesternToWareki);
  w2jMonthInput.addEventListener('input', renderWesternToWareki);
  w2jDayInput.addEventListener('input', renderWesternToWareki);

  const j2wSection = document.querySelector<HTMLElement>(
    'section[data-error-j2w]',
  )!;
  const errorJ2W = j2wSection.dataset.errorJ2w ?? '';

  const j2wEraSelect = document.getElementById(
    'era-j2w-era',
  ) as HTMLSelectElement;
  const j2wYearInput = document.getElementById(
    'era-j2w-year',
  ) as HTMLInputElement;
  const j2wMonthInput = document.getElementById(
    'era-j2w-month',
  ) as HTMLInputElement;
  const j2wDayInput = document.getElementById(
    'era-j2w-day',
  ) as HTMLInputElement;
  const j2wErrorEl = document.getElementById('era-j2w-error')!;
  const j2wResultEl = document.getElementById('era-j2w-result')!;

  function renderWarekiToWestern() {
    j2wErrorEl.textContent = '';
    j2wResultEl.textContent = '';

    if (
      j2wYearInput.value === '' ||
      j2wMonthInput.value === '' ||
      j2wDayInput.value === ''
    ) {
      return;
    }

    const year = warekiToWestern(
      j2wEraSelect.value,
      Number(j2wYearInput.value),
      Number(j2wMonthInput.value),
      Number(j2wDayInput.value),
    );
    if (year === null) {
      j2wErrorEl.textContent = errorJ2W;
      return;
    }

    j2wResultEl.textContent = fill(format.western, {
      y: String(year),
      m: j2wMonthInput.value,
      d: j2wDayInput.value,
      mm: j2wMonthInput.value.padStart(2, '0'),
      dd: j2wDayInput.value.padStart(2, '0'),
    });
  }

  j2wEraSelect.addEventListener('change', renderWarekiToWestern);
  j2wYearInput.addEventListener('input', renderWarekiToWestern);
  j2wMonthInput.addEventListener('input', renderWarekiToWestern);
  j2wDayInput.addEventListener('input', renderWarekiToWestern);

  const today = new Date();
  w2jYearInput.value = String(today.getFullYear());
  w2jMonthInput.value = String(today.getMonth() + 1);
  w2jDayInput.value = String(today.getDate());
  renderWesternToWareki();

  const todayWareki = westernToWareki(
    today.getFullYear(),
    today.getMonth() + 1,
    today.getDate(),
  );
  if (todayWareki) {
    j2wEraSelect.value = todayWareki.era.name;
    j2wYearInput.value = String(todayWareki.eraYear);
    j2wMonthInput.value = String(today.getMonth() + 1);
    j2wDayInput.value = String(today.getDate());
  }
  renderWarekiToWestern();
</script>
