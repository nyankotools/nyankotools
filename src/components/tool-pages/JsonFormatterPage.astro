---
import ToolShell from '../ToolShell.astro';
import { jsonFormatterContent } from '../../i18n/tools/json-formatter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = jsonFormatterContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <label
      for="json-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.indentLabel}
    </label>
    <select
      id="json-formatter-indent"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.indentOptions.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
    <button id="json-formatter-minify-button" type="button" class="ui-btn">
      {t.minify}
    </button>
    <button
      id="json-formatter-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="json-formatter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="json-formatter-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="json-formatter-input"
        class="ui-input h-80 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={'{"key": "value"}'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="json-formatter-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="json-formatter-output"
        readonly
        class="ui-input h-80 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <p
    id="json-formatter-error"
    hidden
    data-error-template={t.errorTemplate}
    data-error-explanations={JSON.stringify(t.errorExplanations)}
    data-error-fallback={t.errorExplanationFallback}
    class="ui-error mt-4 max-w-2xl whitespace-pre-line"
  ></p>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { formatJson, minifyJson } from '../../lib/tools/json-formatter';

  const input = document.getElementById(
    'json-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'json-formatter-output',
  ) as HTMLTextAreaElement;
  const indentSelect = document.getElementById(
    'json-formatter-indent',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('json-formatter-minify-button')!;
  const copyButton = document.getElementById(
    'json-formatter-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('json-formatter-status')!;
  const errorEl = document.getElementById('json-formatter-error')!;

  const errorTemplate = errorEl.dataset.errorTemplate ?? '{message}';
  const errorExplanations: { pattern: string; explanation: string }[] =
    JSON.parse(errorEl.dataset.errorExplanations ?? '[]');
  const errorExplanationFallback = errorEl.dataset.errorFallback ?? '';

  function getIndent(): number | string {
    return indentSelect.value === 'tab' ? '\t' : Number(indentSelect.value);
  }

  function explainJsonError(message: string): string {
    for (const entry of errorExplanations) {
      if (new RegExp(entry.pattern).test(message)) {
        return entry.explanation;
      }
    }
    return errorExplanationFallback;
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = errorTemplate
      .replace('{message}', message)
      .replace('{explanation}', explainJsonError(message));
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function format() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = formatJson(input.value, getIndent());
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  function minify() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = minifyJson(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  input.addEventListener('input', format);
  indentSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  format();
</script>
