---
import ToolShell from '../ToolShell.astro';
import { kanaConverterContent } from '../../i18n/tools/kana-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = kanaConverterContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <div
      id="kana-converter-mode"
      class="ui-seg"
      role="group"
      aria-label={t.directionLabel}
    >
      <button
        type="button"
        data-mode="toKatakana"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modeToKatakana}
      </button>
      <button
        type="button"
        data-mode="toHiragana"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeToHiragana}
      </button>
    </div>
    <button
      id="kana-converter-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="kana-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="kana-converter-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="kana-converter-input"
        data-query-target="text"
        class="ui-input h-64 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="kana-converter-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="kana-converter-output"
        readonly
        class="ui-input h-64 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    convertKana,
    type KanaDirection,
  } from '../../lib/tools/kana-converter';

  const input = document.getElementById(
    'kana-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'kana-converter-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#kana-converter-mode [data-mode]',
  );
  const copyButton = document.getElementById(
    'kana-converter-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('kana-converter-status')!;

  let direction: KanaDirection = 'toKatakana';

  function convert() {
    statusEl.textContent = '';
    output.value = convertKana(input.value, direction);
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      direction = button.dataset.mode as KanaDirection;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  convert();
</script>
