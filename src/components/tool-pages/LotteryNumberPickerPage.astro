---
import ToolShell from '../ToolShell.astro';
import { lotteryNumberPickerContent } from '../../i18n/tools/lottery-number-picker';
import {
  GAMES,
  MAX_SETS,
  MIN_SETS,
} from '../../lib/tools/lottery-number-picker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = lotteryNumberPickerContent[locale];
---

<ToolShell t={t}>
  <section
    id="lnp-root"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-count-error={t.countError.replace('{max}', String(MAX_SETS))}
    data-result-title={t.resultTitle}
    data-ticket-label={t.ticketLabel}
  >
    <p class="mb-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100">
      {t.disclaimer}
    </p>

    <span class="ui-label">{t.gameLabel}</span>
    <div
      id="lnp-game"
      class="ui-seg w-fit max-w-full flex-wrap"
      role="group"
      aria-label={t.gameLabel}
    >
      {GAMES.map((game, i) => (
        <button
          type="button"
          data-game={game.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="ui-seg-btn"
        >
          {t.games[game.id].label}
        </button>
      ))}
    </div>
    <p
      id="lnp-rule"
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
      data-rules={JSON.stringify(
        Object.fromEntries(GAMES.map((g) => [g.id, t.games[g.id].rule])),
      )}
    >
      {t.games[GAMES[0].id].rule}
    </p>

    <div class="mt-4">
      <label for="lnp-count" class="ui-label">
        {t.countLabel}
      </label>
      <input
        id="lnp-count"
        type="number"
        min={MIN_SETS}
        max={MAX_SETS}
        step="1"
        value="1"
        inputmode="numeric"
        class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
      />
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
        {t.countHint.replace('{max}', String(MAX_SETS))}
      </p>
    </div>

    <div class="mt-4">
      <button id="lnp-generate-button" type="button" class="ui-btn-primary">
        {t.generate}
      </button>
    </div>

    <div id="lnp-error" class="ui-error empty:hidden mt-4" role="alert"></div>

    <div id="lnp-result" class="mt-4" aria-live="polite" hidden>
      <p
        id="lnp-result-title"
        class="text-lg font-bold text-gray-900 dark:text-gray-100"
      ></p>
      <ol id="lnp-result-list" class="mt-2 space-y-2"></ol>
      <div class="mt-3 flex items-center gap-3">
        <button id="lnp-copy-button" type="button" class="ui-btn">
          {t.copy}
        </button>
        <span
          id="lnp-status"
          class="text-sm text-green-700 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    MAX_SETS,
    formatTicket,
    formatTickets,
    generateTickets,
    getGame,
    isValidSetCount,
  } from '../../lib/tools/lottery-number-picker';

  const root = document.getElementById('lnp-root')!;
  const msg = root.dataset as Record<string, string | undefined>;
  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const gameButtons = document.querySelectorAll<HTMLButtonElement>(
    '#lnp-game [data-game]',
  );
  const ruleEl = $('lnp-rule');
  const rules = JSON.parse(ruleEl.dataset.rules ?? '{}') as Record<
    string,
    string
  >;
  const countInput = $<HTMLInputElement>('lnp-count');
  const generateButton = $<HTMLButtonElement>('lnp-generate-button');
  const errorEl = $('lnp-error');
  const resultEl = $('lnp-result');
  const resultTitle = $('lnp-result-title');
  const resultList = $('lnp-result-list');
  const copyButton = $<HTMLButtonElement>('lnp-copy-button');
  const statusEl = $('lnp-status');

  let gameId = 'loto6';
  let lastText = '';

  function clearResult() {
    resultEl.hidden = true;
    resultTitle.textContent = '';
    resultList.replaceChildren();
    statusEl.textContent = '';
    errorEl.textContent = '';
    lastText = '';
  }

  gameButtons.forEach((button) => {
    button.addEventListener('click', () => {
      gameId = button.dataset.game ?? 'loto6';
      gameButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      ruleEl.textContent = rules[gameId] ?? '';
      clearResult();
    });
  });

  generateButton.addEventListener('click', () => {
    clearResult();
    const game = getGame(gameId);
    if (!game) return;
    const count = countInput.value === '' ? NaN : Number(countInput.value);
    if (!isValidSetCount(count)) {
      errorEl.textContent = (msg.countError ?? '').replace(
        '{max}',
        String(MAX_SETS),
      );
      return;
    }
    const tickets = generateTickets(game, count);
    tickets.forEach((ticket, i) => {
      const li = document.createElement('li');
      li.className = 'flex flex-wrap items-center gap-2';
      const label = document.createElement('span');
      label.className = 'w-16 text-sm text-gray-600 dark:text-gray-400';
      label.textContent = (msg.ticketLabel ?? '').replace('{n}', String(i + 1));
      li.append(label);
      ticket.forEach((n) => {
        const ball = document.createElement('span');
        ball.className =
          'inline-flex h-10 min-w-10 items-center justify-center rounded-full border-2 border-blue-700 px-1 text-lg font-bold text-blue-900 dark:border-blue-400 dark:text-blue-100';
        ball.textContent =
          game.kind === 'numbers' ? String(n) : formatTicket(game, [n]);
        li.append(ball);
      });
      resultList.append(li);
    });
    resultTitle.textContent = (msg.resultTitle ?? '').replace(
      '{count}',
      String(tickets.length),
    );
    lastText = formatTickets(game, tickets);
    resultEl.hidden = false;
  });

  copyButton.addEventListener('click', async () => {
    if (!lastText) return;
    statusEl.textContent = (await copyText(lastText))
      ? (msg.copied ?? '')
      : (msg.copyFailed ?? '');
  });
</script>
