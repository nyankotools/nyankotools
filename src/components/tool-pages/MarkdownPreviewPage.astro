---
import ToolShell from '../ToolShell.astro';
import { markdownPreviewContent } from '../../i18n/tools/markdown-preview';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = markdownPreviewContent[locale];
---

<ToolShell t={t}>
  <div
    id="markdown-preview-controls"
    class="flex flex-wrap items-center gap-3"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-placeholder-md-to-html={t.inputPlaceholderMdToHtml}
    data-placeholder-html-to-md={t.inputPlaceholderHtmlToMd}
    data-view-preview={t.viewPreview}
    data-view-html-source={t.viewHtmlSource}
    data-result-heading={t.resultHeading}
    data-error-template={t.errorTemplate}
  >
    <div
      id="markdown-preview-mode"
      class="ui-seg"
      role="group"
      aria-label={t.modeAriaLabel}
    >
      <button
        type="button"
        data-mode="mdToHtml"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modeMdToHtml}
      </button>
      <button
        type="button"
        data-mode="htmlToMd"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeHtmlToMd}
      </button>
    </div>
    <div
      id="markdown-preview-view"
      class="ui-seg"
      role="group"
      aria-label={t.viewAriaLabel}
    >
      <button
        type="button"
        data-view="preview"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.viewPreview}
      </button>
      <button
        type="button"
        data-view="html"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.viewHtmlSource}
      </button>
    </div>
    <button id="markdown-preview-copy-button" type="button" class="ui-btn">
      {t.copyButton}
    </button>
    <span
      id="markdown-preview-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div
    id="markdown-preview-html-options"
    hidden
    class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-3"
  >
    <div class="flex items-center gap-2">
      <label
        for="markdown-preview-heading"
        class="text-sm text-gray-700 dark:text-gray-300"
      >
        {t.headingLabel}
      </label>
      <select
        id="markdown-preview-heading"
        class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
      >
        <option value="atx">{t.headingAtx}</option>
        <option value="setext">{t.headingSetext}</option>
      </select>
    </div>
    <div class="flex items-center gap-2">
      <label
        for="markdown-preview-bullet"
        class="text-sm text-gray-700 dark:text-gray-300"
      >
        {t.bulletLabel}
      </label>
      <select
        id="markdown-preview-bullet"
        class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
      >
        <option value="-">-</option>
        <option value="*">*</option>
        <option value="+">+</option>
      </select>
    </div>
    <div class="flex items-center gap-2">
      <label
        for="markdown-preview-code"
        class="text-sm text-gray-700 dark:text-gray-300"
      >
        {t.codeLabel}
      </label>
      <select
        id="markdown-preview-code"
        class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
      >
        <option value="fenced">{t.codeFenced}</option>
        <option value="indented">{t.codeIndented}</option>
      </select>
    </div>
    <label class="ui-check">
      <input type="checkbox" id="markdown-preview-remove-images" />
      {t.removeImagesLabel}
    </label>
    <label class="ui-check">
      <input type="checkbox" id="markdown-preview-remove-links" />
      {t.removeLinksLabel}
    </label>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="markdown-preview-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="markdown-preview-input"
        class="ui-input h-80 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholderMdToHtml}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <span id="markdown-preview-output-heading" class="ui-label">
        {t.viewPreview}
      </span>
      <div
        id="markdown-preview-render"
        class="h-80 w-full overflow-auto rounded-lg border border-gray-300 bg-white p-4 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></div>
      <textarea
        id="markdown-preview-output"
        aria-labelledby="markdown-preview-output-heading"
        readonly
        hidden
        class="ui-input h-80 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <p
    id="markdown-preview-error"
    hidden
    class="ui-error mt-4 max-w-2xl whitespace-pre-line"
  ></p>

  <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
    {t.sanitizeNoteBeforeCode}
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">
      &lt;script&gt;
    </code>
    {t.sanitizeNoteAfterCode}
  </p>
</ToolShell>

<style>
  #markdown-preview-render :global(h1),
  #markdown-preview-render :global(h2),
  #markdown-preview-render :global(h3),
  #markdown-preview-render :global(h4) {
    font-weight: 700;
    line-height: 1.3;
    margin-block: 1.25em 0.5em;
  }
  #markdown-preview-render :global(h1) {
    font-size: 1.5em;
  }
  #markdown-preview-render :global(h2) {
    font-size: 1.3em;
  }
  #markdown-preview-render :global(h3) {
    font-size: 1.15em;
  }
  #markdown-preview-render :global(p) {
    line-height: 1.7;
    margin-block: 0.75em;
  }
  #markdown-preview-render :global(ul),
  #markdown-preview-render :global(ol) {
    margin-block: 0.75em;
    padding-inline-start: 1.5em;
  }
  #markdown-preview-render :global(ul) {
    list-style: disc;
  }
  #markdown-preview-render :global(ol) {
    list-style: decimal;
  }
  #markdown-preview-render :global(li) {
    margin-block: 0.25em;
  }
  #markdown-preview-render :global(a) {
    color: #1d4ed8;
    text-decoration: underline;
  }
  :global(.dark) #markdown-preview-render :global(a) {
    color: #60a5fa;
  }
  #markdown-preview-render :global(code) {
    background: rgba(125, 125, 125, 0.15);
    border-radius: 0.25em;
    padding: 0.1em 0.35em;
    font-size: 0.9em;
  }
  #markdown-preview-render :global(pre) {
    background: rgba(125, 125, 125, 0.15);
    border-radius: 0.5em;
    padding: 0.75em 1em;
    overflow-x: auto;
    margin-block: 0.75em;
  }
  #markdown-preview-render :global(pre code) {
    background: none;
    padding: 0;
  }
  #markdown-preview-render :global(blockquote) {
    border-inline-start: 3px solid rgba(125, 125, 125, 0.4);
    padding-inline-start: 1em;
    margin-block: 0.75em;
    color: rgb(107, 114, 128);
  }
  #markdown-preview-render :global(hr) {
    border: none;
    border-top: 1px solid rgba(125, 125, 125, 0.3);
    margin-block: 1.5em;
  }
  #markdown-preview-render :global(table) {
    border-collapse: collapse;
    margin-block: 0.75em;
    width: 100%;
  }
  #markdown-preview-render :global(th),
  #markdown-preview-render :global(td) {
    border: 1px solid rgba(125, 125, 125, 0.3);
    padding: 0.4em 0.6em;
    text-align: left;
  }
  #markdown-preview-render :global(img) {
    max-width: 100%;
  }
</style>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import DOMPurify from 'dompurify';
  import {
    htmlToMarkdown,
    markdownToHtml,
    type ConvertOutcome,
    type HtmlToMarkdownOptions,
  } from '../../lib/tools/markdown-preview';

  type Mode = 'mdToHtml' | 'htmlToMd';
  type View = 'preview' | 'html';

  const controls = document.getElementById('markdown-preview-controls')!;
  const copied = controls.dataset.copied ?? '';
  const copyFailed = controls.dataset.copyFailed ?? '';
  const viewPreviewLabel = controls.dataset.viewPreview ?? '';
  const viewHtmlSourceLabel = controls.dataset.viewHtmlSource ?? '';
  const resultHeadingLabel = controls.dataset.resultHeading ?? '';
  const errorTemplate = controls.dataset.errorTemplate ?? '';

  const input = document.getElementById(
    'markdown-preview-input',
  ) as HTMLTextAreaElement;
  const renderEl = document.getElementById('markdown-preview-render')!;
  const output = document.getElementById(
    'markdown-preview-output',
  ) as HTMLTextAreaElement;
  const outputHeading = document.getElementById(
    'markdown-preview-output-heading',
  )!;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#markdown-preview-mode [data-mode]',
  );
  const viewGroup = document.getElementById('markdown-preview-view')!;
  const viewButtons = document.querySelectorAll<HTMLButtonElement>(
    '#markdown-preview-view [data-view]',
  );
  const copyButton = document.getElementById('markdown-preview-copy-button')!;
  const statusEl = document.getElementById('markdown-preview-status')!;
  const errorEl = document.getElementById('markdown-preview-error')!;

  const htmlOptions = document.getElementById('markdown-preview-html-options')!;
  const optionControls = [
    'heading',
    'bullet',
    'code',
    'remove-images',
    'remove-links',
  ].map((id) => document.getElementById(`markdown-preview-${id}`)!);
  const [headingSelect, bulletSelect, codeSelect, removeImages, removeLinks] =
    optionControls as [
      HTMLSelectElement,
      HTMLSelectElement,
      HTMLSelectElement,
      HTMLInputElement,
      HTMLInputElement,
    ];

  let mode: Mode = 'mdToHtml';
  let view: View = 'preview';
  let latestOutput = '';

  const placeholders: Record<Mode, string> = {
    mdToHtml: controls.dataset.placeholderMdToHtml ?? '',
    htmlToMd: controls.dataset.placeholderHtmlToMd ?? '',
  };

  function updateVisibility() {
    const isMdToHtml = mode === 'mdToHtml';
    viewGroup.hidden = !isMdToHtml;
    htmlOptions.hidden = isMdToHtml;
    const showPreview = isMdToHtml && view === 'preview';
    renderEl.hidden = !showPreview;
    output.hidden = showPreview;
    outputHeading.textContent = !isMdToHtml
      ? resultHeadingLabel
      : view === 'preview'
        ? viewPreviewLabel
        : viewHtmlSourceLabel;
  }

  function showError(message: string) {
    latestOutput = '';
    renderEl.innerHTML = '';
    output.value = '';
    errorEl.textContent = errorTemplate.replace('{message}', () => message);
    errorEl.hidden = false;
  }

  function showOutput(result: Extract<ConvertOutcome, { success: true }>) {
    latestOutput = result.output;
    output.value = result.output;
    renderEl.innerHTML =
      mode === 'mdToHtml' ? DOMPurify.sanitize(result.output) : '';
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      latestOutput = '';
      renderEl.innerHTML = '';
      output.value = '';
      errorEl.hidden = true;
      return;
    }
    const result: ConvertOutcome =
      mode === 'mdToHtml'
        ? markdownToHtml(input.value)
        : htmlToMarkdown(input.value, {
            headingStyle:
              headingSelect.value as HtmlToMarkdownOptions['headingStyle'],
            bulletMarker:
              bulletSelect.value as HtmlToMarkdownOptions['bulletMarker'],
            codeBlockStyle:
              codeSelect.value as HtmlToMarkdownOptions['codeBlockStyle'],
            removeImages: removeImages.checked,
            removeLinks: removeLinks.checked,
          });
    if (result.success) {
      showOutput(result);
    } else {
      showError(result.message);
    }
  }

  onTextInput(input, convert);
  optionControls.forEach((c) => c.addEventListener('change', convert));

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      input.placeholder = placeholders[mode];
      updateVisibility();
      convert();
    });
  });

  viewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      view = button.dataset.view as View;
      viewButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      updateVisibility();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!latestOutput) return;
    statusEl.textContent = (await copyText(latestOutput)) ? copied : copyFailed;
  });

  updateVisibility();
  convert();
</script>
