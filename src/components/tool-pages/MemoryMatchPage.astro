---
import ToolShell from '../ToolShell.astro';
import { memoryMatchContent } from '../../i18n/tools/memory-match';
import { DIFFICULTIES } from '../../lib/tools/memory-match';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = memoryMatchContent[locale];
const difficultyNames = {
  easy: t.difficultyEasy,
  normal: t.difficultyNormal,
  hard: t.difficultyHard,
};
---

<ToolShell t={t}>
  <section
    id="mm-root"
    data-card-face-down={t.cardFaceDown}
    data-card-face-up={t.cardFaceUp}
    data-card-matched={t.cardMatched}
    data-pairs-value={t.pairsValue}
    data-best-none={t.bestNone}
    data-best-value={t.bestValue}
    data-records-cleared={t.recordsCleared}
    data-completed={t.completed}
    data-new-best-moves={t.newBestMoves}
    data-new-best-time={t.newBestTime}
  >
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span id="mm-difficulty-label" class="ui-label">
          {t.difficultyLabel}
        </span>
        <div class="ui-seg" role="group" aria-labelledby="mm-difficulty-label">
          {DIFFICULTIES.map((d) => (
            <button
              type="button"
              class="ui-seg-btn"
              data-difficulty={d}
              aria-pressed={d === 'normal' ? 'true' : 'false'}
            >
              {difficultyNames[d]}
            </button>
          ))}
        </div>
      </div>
      <button id="mm-new-button" type="button" class="ui-btn-primary">
        {t.newGame}
      </button>
    </div>

    <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-700 dark:text-gray-300">
      <div class="flex gap-2">
        <dt>{t.movesLabel}</dt>
        <dd id="mm-moves" class="font-semibold tabular-nums">
          0
        </dd>
      </div>
      <div class="flex gap-2">
        <dt>{t.timeLabel}</dt>
        <dd id="mm-time" class="font-semibold tabular-nums">
          0:00.0
        </dd>
      </div>
      <div class="flex gap-2">
        <dt>{t.pairsLabel}</dt>
        <dd id="mm-pairs" class="font-semibold tabular-nums"></dd>
      </div>
    </dl>

    <div
      id="mm-board"
      role="group"
      aria-label={t.boardLabel}
      class="mt-3 grid w-full max-w-xl gap-2 sm:gap-3"
    ></div>

    <p
      id="mm-status"
      role="status"
      class="mt-3 min-h-6 text-sm font-medium text-gray-800 dark:text-gray-200"
    ></p>

    <div class="mt-4 max-w-xl">
      <h2 class="text-base font-semibold">{t.bestHeading}</h2>
      <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300">
        {DIFFICULTIES.map((d) => (
          <li class="flex flex-wrap gap-x-3">
            <span class="font-medium">{difficultyNames[d]}</span>
            <span id={`mm-best-${d}`} class="tabular-nums" />
          </li>
        ))}
      </ul>
      <button id="mm-reset-button" type="button" class="ui-btn mt-3">
        {t.resetRecords}
      </button>
    </div>
  </section>
</ToolShell>

<script>
  import {
    BOARD_SIZES,
    DIFFICULTIES,
    MISMATCH_DELAY_MS,
    applyResult,
    createDeck,
    flipCard,
    formatTime,
    isComplete,
    isMismatchPending,
    matchedPairs,
    newGame,
    pairCount,
    parseRecords,
    resolveMismatch,
    serializeRecords,
    type BestRecords,
    type Difficulty,
    type GameState,
  } from '../../lib/tools/memory-match';

  const STORAGE_KEY = 'memory-match-best';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const root = $('mm-root');
  const msg = root.dataset;
  const boardEl = $('mm-board');
  const statusEl = $('mm-status');
  const movesEl = $('mm-moves');
  const timeEl = $('mm-time');
  const pairsEl = $('mm-pairs');
  const diffButtons = Array.from(
    root.querySelectorAll<HTMLButtonElement>('[data-difficulty]'),
  );

  function fill(template: string | undefined, values: Record<string, string>) {
    return (template ?? '').replace(/\{(\w+)\}/g, (match, key: string) =>
      Object.hasOwn(values, key) ? values[key] : match,
    );
  }

  let difficulty: Difficulty = 'normal';
  let state: GameState = newGame([]);
  let cards: HTMLButtonElement[] = [];
  let records: BestRecords = loadRecords();
  let startedAt: number | null = null;
  let elapsedMs = 0;
  let timerId: number | undefined;
  let mismatchTimerId: number | undefined;

  function loadRecords(): BestRecords {
    try {
      return parseRecords(localStorage.getItem(STORAGE_KEY));
    } catch {
      // localStorageが使えない環境では、このページを開いている間だけの記録にする
      return {};
    }
  }

  function saveRecords() {
    try {
      localStorage.setItem(STORAGE_KEY, serializeRecords(records));
    } catch {
      // 保存できない環境では今回の表示だけ反映する
    }
  }

  function setStatus(text: string) {
    statusEl.textContent = text;
  }

  function renderRecords() {
    for (const d of DIFFICULTIES) {
      const best = records[d];
      $(`mm-best-${d}`).textContent = best
        ? fill(msg.bestValue, {
            moves: String(best.moves),
            time: formatTime(best.timeMs),
          })
        : (msg.bestNone ?? '');
    }
  }

  function renderTime() {
    timeEl.textContent = formatTime(elapsedMs);
  }

  function render() {
    state.deck.forEach((value, i) => {
      const card = cards[i];
      const matched = state.matched[i];
      const up = matched || state.faceUp.includes(i);
      const base =
        'flex aspect-square min-w-0 items-center justify-center rounded-lg border-2 text-2xl leading-none select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 sm:text-4xl';
      let tone =
        'cursor-pointer border-blue-700 bg-blue-600 text-white hover:bg-blue-500 dark:border-blue-400 dark:bg-blue-700 dark:hover:bg-blue-600';
      if (matched) {
        tone =
          'border-green-600 bg-green-100 dark:border-green-500 dark:bg-green-950';
      } else if (up) {
        tone = 'border-gray-400 bg-white dark:border-gray-500 dark:bg-gray-800';
      }
      card.className = `${base} ${tone}`;
      card.textContent = up ? value : '?';
      card.setAttribute('aria-disabled', String(matched));
      const template = matched
        ? msg.cardMatched
        : up
          ? msg.cardFaceUp
          : msg.cardFaceDown;
      card.setAttribute(
        'aria-label',
        fill(template, { n: String(i + 1), value }),
      );
    });
    movesEl.textContent = String(state.moves);
    pairsEl.textContent = fill(msg.pairsValue, {
      matched: String(matchedPairs(state)),
      total: String(pairCount(difficulty)),
    });
    renderTime();
  }

  function stopTimer() {
    if (timerId !== undefined) {
      window.clearInterval(timerId);
      timerId = undefined;
    }
  }

  function clearMismatchTimer() {
    if (mismatchTimerId !== undefined) {
      window.clearTimeout(mismatchTimerId);
      mismatchTimerId = undefined;
    }
  }

  function startTimer() {
    startedAt = performance.now();
    elapsedMs = 0;
    timerId = window.setInterval(() => {
      elapsedMs = performance.now() - (startedAt ?? performance.now());
      renderTime();
    }, 100);
  }

  function buildBoard() {
    const { cols } = BOARD_SIZES[difficulty];
    boardEl.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`;
    boardEl.replaceChildren();
    cards = state.deck.map((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.index = String(i);
      boardEl.append(b);
      return b;
    });
  }

  function startGame() {
    stopTimer();
    clearMismatchTimer();
    startedAt = null;
    elapsedMs = 0;
    state = newGame(createDeck(difficulty));
    setStatus('');
    buildBoard();
    render();
  }

  function finish() {
    stopTimer();
    elapsedMs = performance.now() - (startedAt ?? performance.now());
    const update = applyResult(records, difficulty, state.moves, elapsedMs);
    records = update.records;
    saveRecords();
    renderRecords();
    const parts = [
      fill(msg.completed, {
        moves: String(state.moves),
        time: formatTime(elapsedMs),
      }),
    ];
    if (update.newBestMoves) parts.push(msg.newBestMoves ?? '');
    if (update.newBestTime) parts.push(msg.newBestTime ?? '');
    setStatus(parts.join(' '));
    render();
  }

  function flip(index: number) {
    if (isComplete(state)) return;
    const next = flipCard(state, index);
    if (next === state) return;
    clearMismatchTimer();
    state = next;
    if (startedAt === null) startTimer();
    if (isComplete(state)) {
      finish();
      return;
    }
    render();
    if (isMismatchPending(state)) {
      mismatchTimerId = window.setTimeout(() => {
        mismatchTimerId = undefined;
        state = resolveMismatch(state);
        render();
      }, MISMATCH_DELAY_MS);
    }
  }

  boardEl.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>(
      '[data-index]',
    );
    if (target) flip(Number(target.dataset.index));
  });

  $('mm-new-button').addEventListener('click', startGame);
  $('mm-reset-button').addEventListener('click', () => {
    records = {};
    saveRecords();
    renderRecords();
    setStatus(msg.recordsCleared ?? '');
  });
  diffButtons.forEach((b) =>
    b.addEventListener('click', () => {
      difficulty = b.dataset.difficulty as Difficulty;
      diffButtons.forEach((x) =>
        x.setAttribute('aria-pressed', String(x === b)),
      );
      startGame();
    }),
  );

  renderRecords();
  startGame();
</script>
