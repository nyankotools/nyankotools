---
import ToolShell from '../ToolShell.astro';
import { mortgageCalculatorContent } from '../../i18n/tools/mortgage-calculator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = mortgageCalculatorContent[locale];
---

<ToolShell t={t}>
  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-number-locale={t.numberLocale}
    data-years-months-format={t.yearsMonthsFormat}
    data-error={t.error}
  >
    <h2 class="mb-3 text-lg font-bold">{t.sectionHeading}</h2>

    <div class="mb-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="mortgage-calc-balance" class="ui-label">
          {t.balanceLabel}
        </label>
        <input
          id="mortgage-calc-balance"
          type="text"
          inputmode="decimal"
          placeholder={t.balancePlaceholder}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <label for="mortgage-calc-rate" class="ui-label">
          {t.rateLabel}
        </label>
        <input
          id="mortgage-calc-rate"
          type="number"
          inputmode="decimal"
          min="0"
          step="0.01"
          placeholder={t.ratePlaceholder}
          class="ui-input h-11 w-24 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <span id="mortgage-calc-term-label" class="ui-label">
          {t.termLabel}
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="mortgage-calc-term-label"
        >
          <input
            id="mortgage-calc-term-years"
            type="number"
            inputmode="numeric"
            min="0"
            max="50"
            placeholder={t.yearPlaceholder}
            aria-label={t.yearAriaLabel}
            class="ui-input h-11 w-16 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {t.yearUnit}
          </span>
          <input
            id="mortgage-calc-term-months"
            type="number"
            inputmode="numeric"
            min="0"
            max="11"
            placeholder={t.monthPlaceholder}
            aria-label={t.monthAriaLabel}
            class="ui-input h-11 w-16 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">
            {t.monthUnit}
          </span>
        </div>
      </div>
      <div>
        <label for="mortgage-calc-prepayment" class="ui-label">
          {t.prepaymentAmountLabel}
        </label>
        <input
          id="mortgage-calc-prepayment"
          type="text"
          inputmode="decimal"
          placeholder={t.prepaymentAmountPlaceholder}
          class="ui-input h-11 w-40 px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
    </div>

    <div class="mb-3">
      <span id="mortgage-calc-type-label" class="ui-label">
        {t.prepaymentTypeLegend}
      </span>
      <div
        class="flex flex-col gap-2"
        role="radiogroup"
        aria-labelledby="mortgage-calc-type-label"
      >
        <label class="flex items-center gap-1 text-sm">
          <input
            type="radio"
            name="mortgage-calc-type"
            value="shortenTerm"
            checked
          />
          {t.prepaymentTypeShorten}
        </label>
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="mortgage-calc-type" value="reducePayment" />
          {t.prepaymentTypeReduce}
        </label>
      </div>
    </div>

    <p
      id="mortgage-calc-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div id="mortgage-calc-results" class="mt-4 hidden" aria-live="polite">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <h3 class="mb-2 text-sm font-bold text-gray-700 dark:text-gray-300">
            {t.beforeHeading}
          </h3>
          <dl class="space-y-2">
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultMonthlyPaymentLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-before-monthly"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultRemainingTermLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-before-term"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultTotalPaymentLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-before-total"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultTotalInterestLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-before-interest"
              ></dd>
            </div>
          </dl>
        </div>
        <div class="rounded-lg bg-blue-50 p-3 dark:bg-blue-950">
          <h3 class="mb-2 text-sm font-bold text-gray-700 dark:text-gray-300">
            {t.afterHeading}
          </h3>
          <dl class="space-y-2">
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultMonthlyPaymentLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-after-monthly"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultRemainingTermLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-after-term"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultTotalPaymentLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-after-total"
              ></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-600 dark:text-gray-400">
                {t.resultTotalInterestLabel}
              </dt>
              <dd
                class="text-lg font-semibold"
                id="mortgage-calc-after-interest"
              ></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-gray-200 p-3 dark:border-gray-700">
        <h3 class="mb-2 text-sm font-bold text-gray-700 dark:text-gray-300">
          {t.summaryHeading}
        </h3>
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div>
            <dt class="text-sm text-gray-600 dark:text-gray-400">
              {t.resultInterestSavedLabel}
            </dt>
            <dd
              class="text-lg font-semibold text-blue-700 dark:text-blue-400"
              id="mortgage-calc-interest-saved"
            ></dd>
          </div>
          <div id="mortgage-calc-months-shortened-row">
            <dt class="text-sm text-gray-600 dark:text-gray-400">
              {t.resultMonthsShortenedLabel}
            </dt>
            <dd
              class="text-lg font-semibold"
              id="mortgage-calc-months-shortened"
            ></dd>
          </div>
          <div id="mortgage-calc-payment-reduced-row">
            <dt class="text-sm text-gray-600 dark:text-gray-400">
              {t.resultMonthlyPaymentReducedLabel}
            </dt>
            <dd
              class="text-lg font-semibold"
              id="mortgage-calc-payment-reduced"
            ></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import {
    calculateMortgagePrepayment,
    type PrepaymentType,
  } from '../../lib/tools/mortgage-calculator';
  import {
    attachCommaFormatting,
    formatNumberWithCommas,
    stripCommas,
  } from '../../lib/comma-number-input';
  import { fill } from '../../lib/format-template';

  const configEl = document.querySelector<HTMLElement>(
    'section[data-number-locale]',
  )!;
  const numberLocale = configEl.dataset.numberLocale ?? 'en-US';
  const errorMessage = configEl.dataset.error ?? '';
  const yearsMonthsFormat = configEl.dataset.yearsMonthsFormat ?? '';

  const yen = new Intl.NumberFormat(numberLocale, {
    style: 'currency',
    currency: 'JPY',
    maximumFractionDigits: 0,
  });

  const balanceInput = document.getElementById(
    'mortgage-calc-balance',
  ) as HTMLInputElement;
  const rateInput = document.getElementById(
    'mortgage-calc-rate',
  ) as HTMLInputElement;
  const termYearsInput = document.getElementById(
    'mortgage-calc-term-years',
  ) as HTMLInputElement;
  const termMonthsInput = document.getElementById(
    'mortgage-calc-term-months',
  ) as HTMLInputElement;
  const prepaymentInput = document.getElementById(
    'mortgage-calc-prepayment',
  ) as HTMLInputElement;
  const typeInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="mortgage-calc-type"]',
  );

  const errorEl = document.getElementById('mortgage-calc-error')!;
  const resultsEl = document.getElementById('mortgage-calc-results')!;
  const beforeMonthlyEl = document.getElementById(
    'mortgage-calc-before-monthly',
  )!;
  const beforeTermEl = document.getElementById('mortgage-calc-before-term')!;
  const beforeTotalEl = document.getElementById('mortgage-calc-before-total')!;
  const beforeInterestEl = document.getElementById(
    'mortgage-calc-before-interest',
  )!;
  const afterMonthlyEl = document.getElementById(
    'mortgage-calc-after-monthly',
  )!;
  const afterTermEl = document.getElementById('mortgage-calc-after-term')!;
  const afterTotalEl = document.getElementById('mortgage-calc-after-total')!;
  const afterInterestEl = document.getElementById(
    'mortgage-calc-after-interest',
  )!;
  const interestSavedEl = document.getElementById(
    'mortgage-calc-interest-saved',
  )!;
  const monthsShortenedRowEl = document.getElementById(
    'mortgage-calc-months-shortened-row',
  )!;
  const monthsShortenedEl = document.getElementById(
    'mortgage-calc-months-shortened',
  )!;
  const paymentReducedRowEl = document.getElementById(
    'mortgage-calc-payment-reduced-row',
  )!;
  const paymentReducedEl = document.getElementById(
    'mortgage-calc-payment-reduced',
  )!;

  attachCommaFormatting(balanceInput);
  attachCommaFormatting(prepaymentInput);

  function formatTerm(months: number): string {
    const years = Math.floor(months / 12);
    const remainder = months % 12;
    return fill(yearsMonthsFormat, {
      y: String(years),
      m: String(remainder),
    });
  }

  function selectedPrepaymentType(): PrepaymentType {
    return (
      (Array.from(typeInputs).find((el) => el.checked)
        ?.value as PrepaymentType) || 'shortenTerm'
    );
  }

  function render() {
    errorEl.textContent = '';
    resultsEl.classList.add('hidden');

    if (
      balanceInput.value.trim() === '' ||
      rateInput.value.trim() === '' ||
      termYearsInput.value.trim() === '' ||
      termMonthsInput.value.trim() === '' ||
      prepaymentInput.value.trim() === ''
    )
      return;

    const remainingMonths =
      Number(termYearsInput.value) * 12 + Number(termMonthsInput.value);
    const prepaymentType = selectedPrepaymentType();

    const result = calculateMortgagePrepayment({
      remainingBalance: Number(stripCommas(balanceInput.value)),
      annualInterestRate: Number(rateInput.value),
      remainingMonths,
      prepaymentAmount: Number(stripCommas(prepaymentInput.value)),
      prepaymentType,
    });

    if (result === null) {
      errorEl.textContent = errorMessage;
      return;
    }

    beforeMonthlyEl.textContent = yen.format(result.monthlyPaymentBefore);
    beforeTermEl.textContent = formatTerm(remainingMonths);
    beforeTotalEl.textContent = yen.format(result.totalPaymentBefore);
    beforeInterestEl.textContent = yen.format(result.totalInterestBefore);

    afterMonthlyEl.textContent = yen.format(result.monthlyPaymentAfter);
    afterTermEl.textContent = formatTerm(result.remainingMonthsAfter);
    afterTotalEl.textContent = yen.format(result.totalPaymentAfter);
    afterInterestEl.textContent = yen.format(result.totalInterestAfter);

    interestSavedEl.textContent = yen.format(result.interestSaved);

    const isShorten = prepaymentType === 'shortenTerm';
    monthsShortenedRowEl.classList.toggle('hidden', !isShorten);
    paymentReducedRowEl.classList.toggle('hidden', isShorten);
    monthsShortenedEl.textContent = formatTerm(result.monthsShortened);
    paymentReducedEl.textContent = yen.format(result.monthlyPaymentReduced);

    resultsEl.classList.remove('hidden');
  }

  balanceInput.addEventListener('input', render);
  rateInput.addEventListener('input', render);
  termYearsInput.addEventListener('input', render);
  termMonthsInput.addEventListener('input', render);
  prepaymentInput.addEventListener('input', render);
  typeInputs.forEach((el) => el.addEventListener('change', render));

  balanceInput.value = formatNumberWithCommas('30000000');
  rateInput.value = '1.0';
  termYearsInput.value = '25';
  termMonthsInput.value = '0';
  prepaymentInput.value = formatNumberWithCommas('2000000');
  render();
</script>
