---
import ToolShell from '../ToolShell.astro';
import { noteFrequencyConverterContent } from '../../i18n/tools/note-frequency-converter';
import {
  A4_PRESETS,
  DEFAULT_A4,
  MAX_A4,
  MAX_FREQUENCY,
  MAX_MIDI,
  MIN_A4,
  MIN_FREQUENCY,
  MIN_MIDI,
  formatFrequency,
  frequencyTable,
} from '../../lib/tools/note-frequency-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = noteFrequencyConverterContent[locale];

const rows = frequencyTable(DEFAULT_A4, 'sharp');

const selectClass =
  'min-h-11 w-full rounded-lg border border-gray-300 bg-white px-3 text-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100';
const cellClass =
  'min-h-11 w-full min-w-16 rounded-md px-2 py-2 text-right font-mono text-xs tabular-nums hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-blue-600 dark:hover:bg-gray-800';
const thClass =
  'border-b border-gray-300 px-2 py-2 text-right text-xs font-bold text-gray-700 dark:border-gray-700 dark:text-gray-300';
---

<ToolShell t={t}>
  <div
    id="nfc-root"
    data-copy-cell={t.copyCellLabel}
    data-copied={t.copiedMessage}
    data-copy-failed={t.copyFailedMessage}
    data-result-format={t.resultFormat}
    data-invalid-note={t.invalidNote}
    data-invalid-midi={t.invalidMidi}
    data-invalid-frequency={t.invalidFrequency}
  >
    <div class="grid max-w-xl gap-4 sm:grid-cols-2">
      <div>
        <label for="nfc-a4" class="ui-label">
          {t.a4Label}
        </label>
        <input
          id="nfc-a4"
          type="number"
          inputmode="decimal"
          min={MIN_A4}
          max={MAX_A4}
          step="any"
          value={DEFAULT_A4}
          class="ui-input h-11 min-w-0 px-3"
        />
      </div>
      <div>
        <label for="nfc-accidental" class="ui-label">
          {t.accidentalLabel}
        </label>
        <select id="nfc-accidental" class={selectClass}>
          <option value="sharp" selected>
            {t.accidentalSharp}
          </option>
          <option value="flat">{t.accidentalFlat}</option>
        </select>
      </div>
    </div>
    <div
      class="mt-3 flex max-w-xl flex-wrap items-center gap-2"
      role="group"
      aria-label={t.a4PresetsLabel}
    >
      {A4_PRESETS.map((hz) => (
        <button
          type="button"
          class="ui-btn h-11 px-3"
          data-a4-preset={hz}
          aria-label={`${t.a4PresetsLabel}: ${hz} Hz`}
        >
          {hz}
        </button>
      ))}
    </div>

    <div class="mt-6 grid max-w-xl gap-4 sm:grid-cols-3">
      <div>
        <label for="nfc-note" class="ui-label">
          {t.noteLabel}
        </label>
        <input
          id="nfc-note"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          value="A4"
          class="ui-input h-11 min-w-0 px-3 font-mono"
        />
      </div>
      <div>
        <label for="nfc-midi" class="ui-label">
          {t.midiLabel}
        </label>
        <input
          id="nfc-midi"
          type="number"
          inputmode="decimal"
          min={MIN_MIDI}
          max={MAX_MIDI}
          step="any"
          value="69"
          class="ui-input h-11 min-w-0 px-3 font-mono"
        />
      </div>
      <div>
        <label for="nfc-frequency" class="ui-label">
          {t.frequencyLabel}
        </label>
        <input
          id="nfc-frequency"
          type="number"
          inputmode="decimal"
          min={MIN_FREQUENCY}
          max={MAX_FREQUENCY}
          step="any"
          value="440"
          class="ui-input h-11 min-w-0 px-3 font-mono"
        />
      </div>
    </div>
    <p class="mt-2 max-w-xl text-sm text-gray-600 dark:text-gray-400">
      {t.noteHint}
    </p>
    <p id="nfc-error" role="alert" class="ui-error mt-2 max-w-xl" hidden></p>

    <h2 class="mt-6 mb-2 text-lg font-bold">{t.resultHeading}</h2>
    <p
      id="nfc-result"
      role="status"
      class="max-w-xl text-sm font-medium break-words text-gray-800 dark:text-gray-200"
    ></p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button
        id="nfc-copy-button"
        type="button"
        class="ui-btn ui-btn-primary h-11"
      >
        {t.copyFrequencyLabel}
      </button>
      <span
        id="nfc-copy-status"
        role="status"
        class="text-sm text-gray-600 dark:text-gray-400"
      ></span>
    </div>

    <h2 class="mt-8 mb-2 text-lg font-bold">{t.tableHeading}</h2>
    <p class="mb-3 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
      {t.tableHint}
    </p>
    <div
      class="max-w-full overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label={t.tableScrollLabel}
    >
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr>
            <th scope="col" class={`${thClass} text-left`}>
              {t.tableOctaveColumn}
            </th>
            {rows[0].cells.map((c, i) => (
              <th scope="col" class={thClass} data-pc={i}>
                {c.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-gray-200 dark:border-gray-800">
              <th
                scope="row"
                class="px-2 py-1 text-left text-xs font-medium text-gray-800 dark:text-gray-200"
              >
                {row.octave}
              </th>
              {row.cells.map((c) => (
                <td class="p-0">
                  <button
                    type="button"
                    class={cellClass}
                    data-midi={c.midi}
                    data-octave={row.octave}
                    aria-label={t.copyCellLabel
                      .replace('{label}', `${c.name}${row.octave}`)
                      .replace('{value}', formatFrequency(c.frequency))}
                  >
                    {formatFrequency(c.frequency)}
                  </button>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button id="nfc-copy-table" type="button" class="ui-btn h-11">
        {t.copyTableLabel}
      </button>
      <span
        id="nfc-table-status"
        role="status"
        class="text-sm text-gray-600 dark:text-gray-400"
      ></span>
    </div>
  </div>
</ToolShell>

<script>
  import {
    analyzeFrequency,
    clampA4,
    formatCents,
    formatFrequency,
    frequencyTable,
    frequencyToMidi,
    midiToFrequency,
    noteLabel,
    parseNoteName,
    tableToTsv,
    DEFAULT_A4,
    MAX_MIDI,
    MIN_MIDI,
    type Accidental,
  } from '../../lib/tools/note-frequency-converter';
  import { copyText } from '../../lib/clipboard';
  import { fill } from '../../lib/format-template';

  const root = document.getElementById('nfc-root')!;
  const d = root.dataset;
  const a4Input = document.getElementById('nfc-a4') as HTMLInputElement;
  const accSelect = document.getElementById(
    'nfc-accidental',
  ) as HTMLSelectElement;
  const noteInput = document.getElementById('nfc-note') as HTMLInputElement;
  const midiInput = document.getElementById('nfc-midi') as HTMLInputElement;
  const freqInput = document.getElementById(
    'nfc-frequency',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('nfc-error')!;
  const resultEl = document.getElementById('nfc-result')!;
  const copyButton = document.getElementById('nfc-copy-button')!;
  const copyStatus = document.getElementById('nfc-copy-status')!;
  const copyTable = document.getElementById('nfc-copy-table')!;
  const tableStatus = document.getElementById('nfc-table-status')!;
  const headers = Array.from(root.querySelectorAll<HTMLElement>('th[data-pc]'));
  const cells = Array.from(
    root.querySelectorAll<HTMLButtonElement>('button[data-midi]'),
  );

  /** 直近に編集した欄が周波数なら周波数を、そうでなければMIDI値を固定して再計算する */
  let source: 'midi' | 'frequency' = 'midi';
  let midi = 69;
  let frequency = 440;
  const timers = new Map<HTMLElement, number>();

  function a4(): number {
    return a4Input.value === '' ? DEFAULT_A4 : clampA4(Number(a4Input.value));
  }
  function accidental(): Accidental {
    return accSelect.value === 'flat' ? 'flat' : 'sharp';
  }
  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = message === '';
  }
  function roundMidi(value: number): string {
    return String(Math.round(value * 100) / 100);
  }

  function renderTable() {
    const rows = frequencyTable(a4(), accidental());
    for (const th of headers) {
      th.textContent = rows[0].cells[Number(th.dataset.pc)].name;
    }
    for (const cell of cells) {
      const m = Number(cell.dataset.midi);
      const octave = Number(cell.dataset.octave);
      const c = rows[octave].cells[m - (octave + 1) * 12];
      const value = formatFrequency(c.frequency);
      cell.textContent = value;
      cell.dataset.value = value;
      cell.setAttribute(
        'aria-label',
        fill(d.copyCell!, { label: `${c.name}${octave}`, value }),
      );
    }
  }

  function renderResult() {
    const info = analyzeFrequency(frequency, a4(), accidental());
    if (!info) {
      resultEl.textContent = '';
      return;
    }
    resultEl.textContent = fill(d.resultFormat!, {
      note: `${info.name}${info.octave}`,
      cents: formatCents(info.cents),
      nearest: formatFrequency(info.nearestFrequency),
    });
  }

  /** 状態から、編集中でない欄を書き戻す */
  function writeFields(skip: 'note' | 'midi' | 'frequency' | null) {
    if (skip !== 'note') noteInput.value = noteLabel(midi, accidental());
    if (skip !== 'midi') midiInput.value = roundMidi(midi);
    if (skip !== 'frequency') freqInput.value = formatFrequency(frequency);
  }

  function refresh(skip: 'note' | 'midi' | 'frequency' | null) {
    writeFields(skip);
    renderResult();
    renderTable();
  }

  function setMidi(value: number, skip: 'note' | 'midi' | null) {
    source = 'midi';
    midi = value;
    frequency = midiToFrequency(midi, a4());
    refresh(skip);
  }

  noteInput.addEventListener('input', () => {
    if (noteInput.value.trim() === '') return showError('');
    const parsed = parseNoteName(noteInput.value);
    if (parsed === null) return showError(d.invalidNote!);
    showError('');
    setMidi(parsed, 'note');
  });
  midiInput.addEventListener('input', () => {
    if (midiInput.value.trim() === '') return showError('');
    const value = Number(midiInput.value);
    if (!Number.isFinite(value) || value < MIN_MIDI || value > MAX_MIDI) {
      return showError(d.invalidMidi!);
    }
    showError('');
    setMidi(value, 'midi');
  });
  freqInput.addEventListener('input', () => {
    if (freqInput.value.trim() === '') return showError('');
    const value = Number(freqInput.value);
    if (analyzeFrequency(value) === null) return showError(d.invalidFrequency!);
    showError('');
    source = 'frequency';
    frequency = value;
    midi = frequencyToMidi(value, a4());
    refresh('frequency');
  });
  a4Input.addEventListener('input', () => {
    if (source === 'frequency') {
      midi = frequencyToMidi(frequency, a4());
    } else {
      frequency = midiToFrequency(midi, a4());
    }
    refresh(null);
  });
  a4Input.addEventListener('change', () => {
    a4Input.value = String(a4());
  });
  accSelect.addEventListener('change', () => refresh(null));
  for (const button of root.querySelectorAll<HTMLButtonElement>(
    '[data-a4-preset]',
  )) {
    button.addEventListener('click', () => {
      a4Input.value = button.dataset.a4Preset!;
      a4Input.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }

  function flash(el: HTMLElement, message: string) {
    el.textContent = message;
    window.clearTimeout(timers.get(el));
    timers.set(
      el,
      window.setTimeout(() => {
        el.textContent = '';
      }, 2000),
    );
  }
  async function copy(text: string, status: HTMLElement) {
    flash(status, (await copyText(text)) ? d.copied! : d.copyFailed!);
  }

  copyButton.addEventListener('click', () => {
    void copy(formatFrequency(frequency), copyStatus);
  });
  copyTable.addEventListener('click', () => {
    void copy(tableToTsv(frequencyTable(a4(), accidental())), tableStatus);
  });
  root.addEventListener('click', (event) => {
    const cell = (event.target as HTMLElement).closest<HTMLButtonElement>(
      'button[data-midi]',
    );
    if (cell) void copy(cell.dataset.value ?? '', tableStatus);
  });

  refresh(null);
</script>
