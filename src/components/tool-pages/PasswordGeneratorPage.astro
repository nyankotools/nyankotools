---
import Glossary from '../Glossary.astro';
import Notes from '../Notes.astro';
import Layout from '../../layouts/Layout.astro';
import { passwordGeneratorContent } from '../../i18n/tools/password-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = passwordGeneratorContent[locale];
---

<Layout title={t.title} description={t.description}>
  <h1 class="mb-2 text-2xl font-bold">{t.h1}</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400" set:html={t.introHtml} />

  <div
    id="password-generator-controls"
    class="flex flex-wrap items-end gap-4"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-strength-template={t.strengthTemplate}
    data-strength-weak={t.strengthWeak}
    data-strength-fair={t.strengthFair}
    data-strength-strong={t.strengthStrong}
    data-strength-very-strong={t.strengthVeryStrong}
    data-error-missing-char-type={t.errorMissingCharType}
  >
    <div>
      <label
        for="password-generator-length"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.lengthLabel}
      </label>
      <input
        id="password-generator-length"
        type="number"
        min="4"
        max="128"
        value="16"
        class="h-11 w-28 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      />
    </div>

    <div>
      <label
        for="password-generator-count"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.countLabel}
      </label>
      <input
        id="password-generator-count"
        type="number"
        min="1"
        max="100"
        value="1"
        class="h-11 w-28 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      />
    </div>

    <button
      id="password-generator-generate-button"
      type="button"
      class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700"
    >
      {t.generateButton}
    </button>

    <button
      id="password-generator-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      {t.copyButton}
    </button>
    <span
      id="password-generator-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input
        id="password-generator-lowercase"
        type="checkbox"
        class="h-4 w-4"
        checked
      />
      {t.lowercaseLabel}
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input
        id="password-generator-uppercase"
        type="checkbox"
        class="h-4 w-4"
        checked
      />
      {t.uppercaseLabel}
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input
        id="password-generator-numbers"
        type="checkbox"
        class="h-4 w-4"
        checked
      />
      {t.numbersLabel}
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input id="password-generator-symbols" type="checkbox" class="h-4 w-4" />
      {t.symbolsLabel}
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input
        id="password-generator-exclude-similar"
        type="checkbox"
        class="h-4 w-4"
      />
      {t.excludeSimilarLabel}
    </label>
  </div>

  <div class="mt-4">
    <label
      for="password-generator-output"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      {t.outputLabel}
    </label>
    <textarea
      id="password-generator-output"
      readonly
      class="h-40 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    ></textarea>
    <p
      id="password-generator-strength"
      class="mt-2 text-sm text-gray-600 dark:text-gray-400"
    ></p>
    <p
      id="password-generator-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.tipsHeading}</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    {t.tips.map((tip) => (
      <li>{tip}</li>
    ))}
  </ul>

  <Notes heading={t.notesHeading} items={t.notes} />

  <Glossary terms={t.glossaryTerms} heading={t.glossaryHeading} />
</Layout>

<script>
  import {
    clampPasswordCount,
    clampPasswordLength,
    EmptyCharPoolError,
    evaluatePasswordStrength,
    generatePasswords,
  } from '../../lib/tools/password-generator';

  const controls = document.getElementById('password-generator-controls')!;
  const copied = controls.dataset.copied ?? '';
  const copyFailed = controls.dataset.copyFailed ?? '';
  const strengthTemplate = controls.dataset.strengthTemplate ?? '';
  const errorMissingCharType = controls.dataset.errorMissingCharType ?? '';
  const STRENGTH_LABELS = {
    weak: controls.dataset.strengthWeak ?? '',
    fair: controls.dataset.strengthFair ?? '',
    strong: controls.dataset.strengthStrong ?? '',
    'very-strong': controls.dataset.strengthVeryStrong ?? '',
  } as const;

  const lengthInput = document.getElementById(
    'password-generator-length',
  ) as HTMLInputElement;
  const countInput = document.getElementById(
    'password-generator-count',
  ) as HTMLInputElement;
  const lowercaseCheckbox = document.getElementById(
    'password-generator-lowercase',
  ) as HTMLInputElement;
  const uppercaseCheckbox = document.getElementById(
    'password-generator-uppercase',
  ) as HTMLInputElement;
  const numbersCheckbox = document.getElementById(
    'password-generator-numbers',
  ) as HTMLInputElement;
  const symbolsCheckbox = document.getElementById(
    'password-generator-symbols',
  ) as HTMLInputElement;
  const excludeSimilarCheckbox = document.getElementById(
    'password-generator-exclude-similar',
  ) as HTMLInputElement;
  const generateButton = document.getElementById(
    'password-generator-generate-button',
  )!;
  const copyButton = document.getElementById('password-generator-copy-button')!;
  const statusEl = document.getElementById('password-generator-status')!;
  const errorEl = document.getElementById('password-generator-error')!;
  const strengthEl = document.getElementById('password-generator-strength')!;
  const output = document.getElementById(
    'password-generator-output',
  ) as HTMLTextAreaElement;

  function generate() {
    statusEl.textContent = '';
    errorEl.textContent = '';
    const options = {
      length: Number(lengthInput.value),
      lowercase: lowercaseCheckbox.checked,
      uppercase: uppercaseCheckbox.checked,
      numbers: numbersCheckbox.checked,
      symbols: symbolsCheckbox.checked,
      excludeSimilar: excludeSimilarCheckbox.checked,
    };
    try {
      const passwords = generatePasswords({
        ...options,
        count: Number(countInput.value),
      });
      output.value = passwords.join('\n');
      const { entropyBits, strength } = evaluatePasswordStrength(options);
      strengthEl.textContent = strengthTemplate
        .replace('{strength}', STRENGTH_LABELS[strength])
        .replace('{entropyBits}', String(Math.round(entropyBits)));
    } catch (error) {
      if (error instanceof EmptyCharPoolError) {
        output.value = '';
        strengthEl.textContent = '';
        errorEl.textContent = errorMissingCharType;
      } else {
        throw error;
      }
    }
  }

  function clampLengthInput() {
    lengthInput.value = String(clampPasswordLength(Number(lengthInput.value)));
  }

  function clampCountInput() {
    countInput.value = String(clampPasswordCount(Number(countInput.value)));
  }

  generateButton.addEventListener('click', generate);
  lengthInput.addEventListener('change', () => {
    clampLengthInput();
    generate();
  });
  countInput.addEventListener('change', () => {
    clampCountInput();
    generate();
  });
  for (const checkbox of [
    lowercaseCheckbox,
    uppercaseCheckbox,
    numbersCheckbox,
    symbolsCheckbox,
    excludeSimilarCheckbox,
  ]) {
    checkbox.addEventListener('change', generate);
  }

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = copied;
    } catch {
      statusEl.textContent = copyFailed;
    }
  });

  generate();
</script>
