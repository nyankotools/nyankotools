---
import ToolShell from '../ToolShell.astro';
import { passwordStrengthCheckerContent } from '../../i18n/tools/password-strength-checker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = passwordStrengthCheckerContent[locale];

const checks = [
  { id: 'length', label: t.checkLength },
  { id: 'lower', label: t.checkLowercase },
  { id: 'upper', label: t.checkUppercase },
  { id: 'number', label: t.checkNumber },
  { id: 'symbol', label: t.checkSymbol },
];
const issueIds = Object.keys(t.issues) as (keyof typeof t.issues)[];
---

<ToolShell t={t}>
  <div
    id="psc-root"
    data-levels={JSON.stringify(t.levels)}
    data-empty-level={t.emptyLevel}
    data-summary={t.summaryTemplate}
    data-units={JSON.stringify(t.units)}
  >
    <label for="psc-input" class="ui-label">
      {t.inputLabel}
    </label>
    <input
      id="psc-input"
      type="password"
      class="ui-input h-11 w-full px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      autocomplete="off"
      spellcheck="false"
      data-no-persist
    />
    <label class="ui-check mt-2">
      <input id="psc-show" type="checkbox" class="h-4 w-4" data-no-persist />
      {t.showLabel}
    </label>

    <div class="mt-6">
      <div class="flex items-baseline justify-between gap-3">
        <span class="ui-label">{t.levelLabel}</span>
        <span
          id="psc-level"
          class="text-sm font-semibold text-gray-900 dark:text-gray-100"
          aria-live="polite"
        >
          {t.emptyLevel}
        </span>
      </div>
      <div class="mt-1 grid grid-cols-5 gap-1" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => (
          <div
            data-psc-segment={i}
            class="h-2 rounded bg-gray-200 dark:bg-gray-700"
          />
        ))}
      </div>
      <p
        id="psc-summary"
        class="mt-2 text-sm text-gray-600 dark:text-gray-400"
      ></p>
    </div>

    <div id="psc-details" hidden>
      <h2 class="mt-6 text-sm font-semibold text-gray-900 dark:text-gray-100">
        {t.crackHeading}
      </h2>
      <dl class="mt-2 grid gap-2 text-sm sm:grid-cols-2">
        <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
          <dt class="text-gray-600 dark:text-gray-400">{t.onlineLabel}</dt>
          <dd
            id="psc-online"
            class="mt-1 font-semibold text-gray-900 dark:text-gray-100"
          ></dd>
        </div>
        <div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
          <dt class="text-gray-600 dark:text-gray-400">{t.offlineLabel}</dt>
          <dd
            id="psc-offline"
            class="mt-1 font-semibold text-gray-900 dark:text-gray-100"
          ></dd>
        </div>
      </dl>

      <h2 class="mt-6 text-sm font-semibold text-gray-900 dark:text-gray-100">
        {t.checklistHeading}
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        {checks.map((c) => (
          <li data-psc-check={c.id} class="flex gap-2">
            <span
              data-mark
              class="w-4 shrink-0 text-center"
              aria-hidden="true"
            />
            <span>{c.label}</span>
          </li>
        ))}
      </ul>

      <h2 class="mt-6 text-sm font-semibold text-gray-900 dark:text-gray-100">
        {t.issuesHeading}
      </h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        {issueIds.map((id) => (
          <li data-psc-issue={id} hidden>
            {t.issues[id]}
          </li>
        ))}
      </ul>
      <p
        id="psc-no-issues"
        hidden
        class="mt-2 text-sm text-green-700 dark:text-green-400"
      >
        {t.noIssues}
      </p>
    </div>
  </div>
</ToolShell>

<script>
  import {
    OFFLINE_GUESSES_PER_SECOND,
    ONLINE_GUESSES_PER_SECOND,
    checkPassword,
    describeDuration,
    estimateCrackSeconds,
    type DurationUnit,
  } from '../../lib/tools/password-strength-checker';

  const root = document.getElementById('psc-root')!;
  const input = document.getElementById('psc-input') as HTMLInputElement;
  const show = document.getElementById('psc-show') as HTMLInputElement;
  const levelEl = document.getElementById('psc-level')!;
  const summaryEl = document.getElementById('psc-summary')!;
  const detailsEl = document.getElementById('psc-details')!;
  const onlineEl = document.getElementById('psc-online')!;
  const offlineEl = document.getElementById('psc-offline')!;
  const noIssuesEl = document.getElementById('psc-no-issues')!;
  const segments = Array.from(
    document.querySelectorAll<HTMLElement>('[data-psc-segment]'),
  );
  const checkItems = document.querySelectorAll<HTMLElement>('[data-psc-check]');
  const issueItems = document.querySelectorAll<HTMLElement>('[data-psc-issue]');

  const levels: string[] = JSON.parse(root.dataset.levels ?? '[]');
  const units: Record<DurationUnit, string> = JSON.parse(
    root.dataset.units ?? '{}',
  );
  const emptyLevel = root.dataset.emptyLevel ?? '';
  const summaryTemplate = root.dataset.summary ?? '';

  const SEGMENT_BASE = 'h-2 rounded ';
  const SEGMENT_OFF = 'bg-gray-200 dark:bg-gray-700';
  const SEGMENT_ON = [
    'bg-red-500',
    'bg-orange-500',
    'bg-yellow-500',
    'bg-lime-500',
    'bg-green-600',
  ];

  function formatDuration(seconds: number): string {
    const { unit, value } = describeDuration(seconds);
    return units[unit].replace('{n}', value.toLocaleString());
  }

  /** score が null のときはメーターを空にする */
  function renderMeter(score: number | null) {
    segments.forEach((seg, i) => {
      seg.className =
        SEGMENT_BASE +
        (score !== null && i <= score ? SEGMENT_ON[score] : SEGMENT_OFF);
    });
  }

  function update() {
    const password = input.value;
    if (password === '') {
      levelEl.textContent = emptyLevel;
      summaryEl.textContent = '';
      detailsEl.hidden = true;
      renderMeter(null);
      return;
    }

    const result = checkPassword(password);
    levelEl.textContent = levels[result.score] ?? '';
    summaryEl.textContent = summaryTemplate
      .replace('{length}', String(result.length))
      .replace('{bits}', String(Math.round(result.bits)));
    onlineEl.textContent = formatDuration(
      estimateCrackSeconds(result.bits, ONLINE_GUESSES_PER_SECOND),
    );
    offlineEl.textContent = formatDuration(
      estimateCrackSeconds(result.bits, OFFLINE_GUESSES_PER_SECOND),
    );

    const flags: Record<string, boolean> = {
      length: result.length >= 8,
      lower: result.hasLowercase,
      upper: result.hasUppercase,
      number: result.hasNumber,
      symbol: result.hasSymbol,
    };
    checkItems.forEach((li) => {
      const ok = flags[li.dataset.pscCheck ?? ''];
      const mark = li.querySelector<HTMLElement>('[data-mark]')!;
      mark.textContent = ok ? '✓' : '–';
      li.className =
        'flex gap-2 ' +
        (ok
          ? 'text-green-700 dark:text-green-400'
          : 'text-gray-500 dark:text-gray-400');
    });

    const issues = new Set<string>(result.issues);
    issueItems.forEach((li) => {
      li.hidden = !issues.has(li.dataset.pscIssue ?? '');
    });
    noIssuesEl.hidden = issues.size > 0;

    detailsEl.hidden = false;
    renderMeter(result.score);
  }

  input.addEventListener('input', update);
  show.addEventListener('change', () => {
    input.type = show.checked ? 'text' : 'password';
  });

  update();
</script>
