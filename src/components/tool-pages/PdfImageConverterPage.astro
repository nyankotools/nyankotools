---
import ToolShell from '../ToolShell.astro';
import { pdfImageConverterContent } from '../../i18n/tools/pdf-image-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pdfImageConverterContent[locale];
const modes = [
  { value: 'toImage', label: t.modeToImage },
  { value: 'toPdf', label: t.modeToPdf },
];
const buttonClass = 'ui-btn';
const smallButtonClass =
  'min-h-9 rounded-lg border border-gray-300 px-2 text-xs text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800';
const selectClass =
  'min-h-11 rounded-lg border border-gray-300 px-2 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100';
---

<ToolShell t={t}>
  <fieldset class="mb-4">
    <legend class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.modeLabel}
    </legend>
    <div class="flex flex-wrap gap-4 text-sm text-gray-700 dark:text-gray-300">
      {modes.map((m) => (
        <label class="flex min-h-11 items-center gap-2">
          <input
            type="radio"
            name="conv-mode"
            value={m.value}
            checked={m.value === 'toImage'}
            class="h-4 w-4"
          />
          {m.label}
        </label>
      ))}
    </div>
  </fieldset>

  <div id="conv-pdf-input">
    <label for="conv-pdf-file" class="ui-label">
      {t.pdfFileLabel}
    </label>
    <div id="conv-pdf-drop" class="ui-dropzone">
      <input
        id="conv-pdf-file"
        type="file"
        accept=".pdf,application/pdf"
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        {t.pdfDropHint}
      </p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        {t.pdfFileHint}
      </p>
    </div>
    <p
      id="conv-pdf-info"
      hidden
      data-template={t.pagesTemplate}
      class="mt-2 text-sm text-gray-700 dark:text-gray-300"
    ></p>
  </div>

  <div id="conv-image-input" hidden>
    <label for="conv-image-file" class="ui-label">
      {t.imageFileLabel}
    </label>
    <div id="conv-image-drop" class="ui-dropzone">
      <input
        id="conv-image-file"
        type="file"
        accept="image/*"
        multiple
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        {t.imageDropHint}
      </p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        {t.imageFileHint}
      </p>
    </div>
    <ul
      id="conv-image-list"
      class="mt-4 flex max-w-2xl flex-col gap-2"
      data-up={t.moveUp}
      data-down={t.moveDown}
      data-remove={t.remove}
      data-button-class={smallButtonClass}
    ></ul>
  </div>

  <div id="conv-opt-image" class="mt-4 flex max-w-2xl flex-col gap-4">
    <div class="flex flex-wrap gap-4">
      <label class="flex flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
        {t.formatLabel}
        <select id="conv-format" class={selectClass}>
          <option value="png">PNG</option>
          <option value="jpeg">JPEG</option>
        </select>
      </label>
      <label class="flex flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
        {t.scaleLabel}
        <select id="conv-scale" class={selectClass}>
          <option value="1">{t.scale1}</option>
          <option value="2" selected>
            {t.scale2}
          </option>
          <option value="3">{t.scale3}</option>
        </select>
      </label>
      <label
        id="conv-quality-wrap"
        hidden
        class="flex flex-col gap-1 text-sm text-gray-700 dark:text-gray-300"
      >
        {t.qualityLabel}: <span id="conv-quality-value">90</span>%
        <input
          id="conv-quality"
          type="range"
          min="10"
          max="100"
          step="5"
          value="90"
          class="min-h-11 w-40"
        />
      </label>
    </div>
    <div class="max-w-xl">
      <label for="conv-range" class="ui-label">
        {t.rangeLabel}
      </label>
      <input
        id="conv-range"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={t.rangePlaceholder}
        class="ui-input min-h-11 w-full px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      />
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{t.rangeHint}</p>
    </div>
  </div>

  <div id="conv-opt-pdf" hidden class="mt-4">
    <label class="flex max-w-xs flex-col gap-1 text-sm text-gray-700 dark:text-gray-300">
      {t.pageSizeLabel}
      <select id="conv-page-size" class={selectClass}>
        <option value="fit">{t.pageSizeFit}</option>
        <option value="a4">{t.pageSizeA4}</option>
      </select>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      id="conv-run"
      type="button"
      data-run={t.run}
      data-processing={t.processing}
      class="ui-btn-primary"
    >
      {t.run}
    </button>
    <button id="conv-clear" type="button" class={buttonClass}>
      {t.clear}
    </button>
  </div>

  <p
    id="conv-error"
    role="alert"
    hidden
    data-no-file={t.errorNoFile}
    data-not-pdf={t.errorNotPdf}
    data-not-image={t.errorNotImage}
    data-invalid={t.errorInvalid}
    data-encrypted={t.errorEncrypted}
    data-empty-range={t.errorEmptyRange}
    data-bad-range={t.errorBadRange}
    data-out-of-range={t.errorOutOfRange}
    data-bad-image={t.errorBadImage}
    data-failed={t.errorFailed}
    class="ui-error mt-4 max-w-2xl"
  ></p>

  <section
    id="conv-result"
    hidden
    class="mt-6"
    data-download={t.downloadTemplate}
  >
    <h2 class="mb-2 text-lg font-semibold">{t.resultHeading}</h2>
    <ul id="conv-result-list" class="flex flex-col gap-3"></ul>
  </section>
</ToolShell>

<script>
  import { paren } from '../../lib/paren';
  import * as pdfjs from 'pdfjs-dist/legacy/build/pdf.mjs';
  import workerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';
  import {
    getPageCount,
    parsePageRange,
    PdfToolError,
  } from '../../lib/tools/pdf-merge-split';
  import {
    clampScale,
    ImageToPdfError,
    imageFileName,
    imagesToPdf,
    outputSize,
    type PdfImageInput,
  } from '../../lib/tools/pdf-image-converter';

  import { enableFileDrop } from '../../lib/file-drop';

  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

  interface ImageItem {
    name: string;
    bytes: Uint8Array;
    type: PdfImageInput['type'];
  }

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const modeRadios = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="conv-mode"]'),
  );
  const pdfInputBox = $('conv-pdf-input');
  const imageInputBox = $('conv-image-input');
  const pdfFile = $<HTMLInputElement>('conv-pdf-file');
  const pdfInfo = $('conv-pdf-info');
  const imageFile = $<HTMLInputElement>('conv-image-file');
  const imageList = $('conv-image-list');
  const optImage = $('conv-opt-image');
  const optPdf = $('conv-opt-pdf');
  const formatSelect = $<HTMLSelectElement>('conv-format');
  const scaleSelect = $<HTMLSelectElement>('conv-scale');
  const qualityWrap = $('conv-quality-wrap');
  const qualityInput = $<HTMLInputElement>('conv-quality');
  const qualityValue = $('conv-quality-value');
  const rangeInput = $<HTMLInputElement>('conv-range');
  const pageSizeSelect = $<HTMLSelectElement>('conv-page-size');
  const runButton = $<HTMLButtonElement>('conv-run');
  const clearButton = $<HTMLButtonElement>('conv-clear');
  const errorEl = $('conv-error');
  const resultEl = $('conv-result');
  const resultList = $('conv-result-list');

  enableFileDrop($('conv-pdf-drop'), pdfFile);
  enableFileDrop($('conv-image-drop'), imageFile);

  let pdfBytes: Uint8Array | null = null;
  let pdfName = '';
  let pdfPages = 0;
  let images: ImageItem[] = [];
  let urls: string[] = [];

  const mode = () =>
    (modeRadios.find((r) => r.checked)?.value ?? 'toImage') as
      'toImage' | 'toPdf';
  const baseName = (name: string) => name.replace(/\.[^.]+$/, '');

  function showError(key: string, pages?: number) {
    hideResult();
    errorEl.textContent = (errorEl.dataset[key] ?? '').replace(
      '{pages}',
      String(pages ?? ''),
    );
    errorEl.hidden = false;
  }

  function hideError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function hideResult() {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    resultList.replaceChildren();
    resultEl.hidden = true;
  }

  function formatBytes(bytes: number): string {
    return bytes < 1024
      ? `${bytes} B`
      : bytes < 1048576
        ? `${(bytes / 1024).toFixed(1)} KB`
        : `${(bytes / 1048576).toFixed(2)} MB`;
  }

  /** pdf.js の例外を tool のエラーキーに変換する */
  function pdfErrorKey(e: unknown): string {
    const name = (e as { name?: string } | null)?.name ?? '';
    const message = (e as { message?: string } | null)?.message ?? '';
    // PasswordException は code 1（要パスワード）/ 2（パスワード不一致）を持つ
    if (name === 'PasswordException' || /password/i.test(message))
      return 'encrypted';
    if (name === 'InvalidPDFException' || name === 'FormatError')
      return 'invalid';
    console.error(e);
    return 'failed';
  }

  async function openPdf(bytes: Uint8Array) {
    // pdf.js は渡したバッファを worker に転送（detach）するためコピーを渡す
    const task = pdfjs.getDocument({ data: bytes.slice() });
    try {
      return { doc: await task.promise, task };
    } catch (e) {
      void task.destroy();
      if (pdfErrorKey(e) !== 'failed') throw e;
      // 一部の暗号化PDFは pdf.js が UnknownErrorException で失敗するため、pdf-lib の判定で原因を補う
      try {
        await getPageCount(bytes);
      } catch (fallback) {
        if (fallback instanceof PdfToolError) throw fallback;
      }
      throw e;
    }
  }

  function renderImageList() {
    imageList.replaceChildren();
    const buttonClass = imageList.dataset.buttonClass ?? '';
    images.forEach((item, i) => {
      const li = document.createElement('li');
      li.className =
        'flex flex-wrap items-center gap-2 rounded-lg border border-gray-300 p-2 text-sm dark:border-gray-700';
      const label = document.createElement('span');
      label.className = 'min-w-0 flex-1 break-all';
      label.textContent = `${i + 1}. ${item.name}`;
      li.append(label);
      const addButton = (
        text: string,
        onClick: () => void,
        disabled = false,
      ) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = buttonClass;
        b.textContent = text;
        b.disabled = disabled;
        b.addEventListener('click', onClick);
        li.append(b);
      };
      addButton(imageList.dataset.up ?? '', () => move(i, -1), i === 0);
      addButton(
        imageList.dataset.down ?? '',
        () => move(i, 1),
        i === images.length - 1,
      );
      addButton(imageList.dataset.remove ?? '', () => {
        images.splice(i, 1);
        hideResult();
        renderImageList();
      });
      imageList.append(li);
    });
  }

  function move(i: number, delta: number) {
    const j = i + delta;
    if (j < 0 || j >= images.length) return;
    [images[i], images[j]] = [images[j], images[i]];
    hideResult();
    renderImageList();
  }

  function applyMode() {
    const toImage = mode() === 'toImage';
    pdfInputBox.hidden = !toImage;
    optImage.hidden = !toImage;
    imageInputBox.hidden = toImage;
    optPdf.hidden = toImage;
    hideResult();
    hideError();
  }

  function applyFormat() {
    qualityWrap.hidden = formatSelect.value !== 'jpeg';
  }

  modeRadios.forEach((r) => r.addEventListener('change', applyMode));
  formatSelect.addEventListener('change', () => {
    applyFormat();
    hideResult();
  });
  qualityInput.addEventListener('input', () => {
    qualityValue.textContent = qualityInput.value;
  });

  pdfFile.addEventListener('change', async () => {
    const file = pdfFile.files?.[0];
    pdfFile.value = '';
    if (!file) return;
    hideResult();
    hideError();
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      showError('notPdf');
      return;
    }
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const { doc, task } = await openPdf(bytes);
      pdfPages = doc.numPages;
      void task.destroy();
      pdfBytes = bytes;
      pdfName = file.name;
      pdfInfo.textContent = `${file.name}${paren((pdfInfo.dataset.template ?? '').replace('{pages}', String(pdfPages)))}`;
      pdfInfo.hidden = false;
    } catch (e) {
      pdfBytes = null;
      pdfInfo.hidden = true;
      showError(e instanceof PdfToolError ? e.code : pdfErrorKey(e));
    }
  });

  /** PNG/JPEG以外（WebP・GIFなど）は Canvas 経由でPNGにする */
  async function toPdfImage(file: File): Promise<ImageItem> {
    const raw = new Uint8Array(await file.arrayBuffer());
    if (file.type === 'image/png' || file.type === 'image/jpeg') {
      return { name: file.name, bytes: raw, type: file.type };
    }
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0);
    bitmap.close();
    const blob = await new Promise<Blob | null>((resolve) =>
      canvas.toBlob(resolve, 'image/png'),
    );
    if (!blob) throw new ImageToPdfError('badImage');
    return {
      name: file.name,
      bytes: new Uint8Array(await blob.arrayBuffer()),
      type: 'image/png',
    };
  }

  imageFile.addEventListener('change', async () => {
    const files = Array.from(imageFile.files ?? []);
    imageFile.value = '';
    if (files.length === 0) return;
    hideResult();
    hideError();
    if (files.some((f) => !f.type.startsWith('image/'))) {
      showError('notImage');
      return;
    }
    try {
      const added: ImageItem[] = [];
      for (const f of files) added.push(await toPdfImage(f));
      images = [...images, ...added];
      renderImageList();
    } catch {
      showError('badImage');
    }
  });

  function addResult(
    name: string,
    blob: Blob,
    options: { preview?: boolean } = {},
  ) {
    const url = URL.createObjectURL(blob);
    urls.push(url);
    const li = document.createElement('li');
    li.className = 'flex flex-wrap items-center gap-3';
    if (options.preview) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = name;
      img.className =
        'h-24 w-auto max-w-[8rem] rounded border border-gray-300 bg-white object-contain dark:border-gray-700';
      li.append(img);
    }
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.className =
      'inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-4 text-sm font-medium text-blue-700 hover:bg-gray-100 dark:border-gray-700 dark:text-blue-400 dark:hover:bg-gray-800';
    a.textContent = `${(resultEl.dataset.download ?? '').replace('{name}', () => name)}${paren(formatBytes(blob.size))}`;
    li.append(a);
    resultList.append(li);
  }

  async function convertToImages() {
    if (!pdfBytes) return showError('noFile');
    const indices = rangeInput.value.trim()
      ? parsePageRange(rangeInput.value, pdfPages)
      : Array.from({ length: pdfPages }, (_, i) => i);
    const isJpeg = formatSelect.value === 'jpeg';
    const mime = isJpeg ? 'image/jpeg' : 'image/png';
    const scale = Number(scaleSelect.value);
    const quality = Number(qualityInput.value) / 100;
    const { doc, task } = await openPdf(pdfBytes);
    try {
      for (const index of indices) {
        const page = await doc.getPage(index + 1);
        try {
          const base = page.getViewport({ scale: 1 });
          const viewport = page.getViewport({
            scale: clampScale(base.width, base.height, scale),
          });
          const { width, height } = outputSize(
            viewport.width,
            viewport.height,
            1,
          );
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d')!;
          // JPEG は透過を持てず黒くなるため、PNG でも見やすいよう白で下地を塗る
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, width, height);
          await page.render({ canvas, canvasContext: ctx, viewport }).promise;
          const blob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(resolve, mime, isJpeg ? quality : undefined),
          );
          canvas.width = canvas.height = 0;
          if (!blob) throw new Error('toBlob failed');
          addResult(
            imageFileName(
              baseName(pdfName),
              index + 1,
              pdfPages,
              isJpeg ? 'jpg' : 'png',
            ),
            blob,
            { preview: true },
          );
        } finally {
          page.cleanup();
        }
      }
    } finally {
      void task.destroy();
    }
  }

  async function convertToPdf() {
    if (images.length === 0) return showError('noFile');
    const bytes = await imagesToPdf(
      images,
      pageSizeSelect.value as 'fit' | 'a4',
    );
    addResult(
      'images.pdf',
      new Blob([bytes as BlobPart], { type: 'application/pdf' }),
    );
  }

  runButton.addEventListener('click', async () => {
    hideError();
    hideResult();
    runButton.disabled = true;
    clearButton.disabled = true;
    runButton.textContent = runButton.dataset.processing ?? '';
    try {
      if (mode() === 'toImage') await convertToImages();
      else await convertToPdf();
      if (resultList.childElementCount > 0) resultEl.hidden = false;
    } catch (e) {
      if (e instanceof PdfToolError) showError(e.code, pdfPages);
      else if (e instanceof ImageToPdfError) showError(e.code);
      else showError(pdfErrorKey(e));
    } finally {
      runButton.disabled = false;
      clearButton.disabled = false;
      runButton.textContent = runButton.dataset.run ?? '';
    }
  });

  clearButton.addEventListener('click', () => {
    pdfBytes = null;
    pdfPages = 0;
    pdfInfo.hidden = true;
    images = [];
    rangeInput.value = '';
    hideError();
    hideResult();
    renderImageList();
  });

  applyMode();
  applyFormat();
</script>
