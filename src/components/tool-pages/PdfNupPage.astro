---
import ToolShell from '../ToolShell.astro';
import { pdfNupContent } from '../../i18n/tools/pdf-nup';
import { PER_SHEET_OPTIONS, SHEET_SIZE_IDS } from '../../lib/tools/pdf-nup';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pdfNupContent[locale];
const inputClass = 'ui-input min-h-11 w-full px-3 dark:bg-gray-900';
const orientationIds = ['auto', 'portrait', 'landscape'] as const;
const orderIds = ['row', 'column'] as const;
---

<ToolShell t={t}>
  <label for="nu-file" class="ui-label">
    {t.fileLabel}
  </label>
  <div id="nu-drop" class="ui-dropzone">
    <input
      id="nu-file"
      type="file"
      accept=".pdf,application/pdf"
      class="ui-file"
    />
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{t.fileHint}</p>
  </div>
  <p
    id="nu-info"
    hidden
    data-template={t.infoTemplate}
    class="mt-2 text-sm text-gray-700 dark:text-gray-300"
  ></p>

  <div class="mt-6 grid max-w-2xl gap-4 sm:grid-cols-2">
    <div>
      <label for="nu-per-sheet" class="ui-label">
        {t.perSheetLabel}
      </label>
      <select id="nu-per-sheet" class={inputClass}>
        {PER_SHEET_OPTIONS.map((n) => (
          <option value={n} selected={n === 4}>
            {t.perSheetOptions[n]}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label for="nu-size" class="ui-label">
        {t.sheetSizeLabel}
      </label>
      <select id="nu-size" class={inputClass}>
        {SHEET_SIZE_IDS.map((s) => (
          <option value={s}>{t.sheetSizes[s]}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="nu-orientation" class="ui-label">
        {t.orientationLabel}
      </label>
      <select id="nu-orientation" class={inputClass}>
        {orientationIds.map((o) => (
          <option value={o}>{t.orientations[o]}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="nu-order" class="ui-label">
        {t.orderLabel}
      </label>
      <select id="nu-order" class={inputClass}>
        {orderIds.map((o) => (
          <option value={o}>{t.orders[o]}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="nu-margin" class="ui-label">
        {t.marginLabel}
      </label>
      <input
        id="nu-margin"
        type="number"
        value="20"
        min="0"
        max="100"
        step="1"
        inputmode="numeric"
        class={inputClass}
      />
    </div>
    <div>
      <label for="nu-gap" class="ui-label">
        {t.gapLabel}
      </label>
      <input
        id="nu-gap"
        type="number"
        value="10"
        min="0"
        max="100"
        step="1"
        inputmode="numeric"
        class={inputClass}
      />
    </div>
  </div>
  <label class="ui-check mt-2 h-auto min-h-11">
    <input id="nu-border" type="checkbox" checked class="h-4 w-4" />
    {t.borderLabel}
  </label>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      id="nu-run"
      type="button"
      data-run={t.run}
      data-processing={t.processing}
      class="ui-btn-primary"
    >
      {t.run}
    </button>
    <button id="nu-clear" type="button" class="ui-btn">
      {t.clear}
    </button>
  </div>

  <p
    id="nu-error"
    role="alert"
    hidden
    data-no-file={t.errorNoFile}
    data-not-pdf={t.errorNotPdf}
    data-invalid={t.errorInvalid}
    data-encrypted={t.errorEncrypted}
    data-bad-option={t.errorBadOption}
    data-failed={t.errorFailed}
    class="ui-error mt-4 max-w-2xl"
  ></p>

  <section
    id="nu-result"
    hidden
    class="mt-6"
    data-download={t.downloadTemplate}
    data-summary={t.resultSummary}
  >
    <h2 class="mb-2 text-lg font-semibold">{t.resultHeading}</h2>
    <p
      id="nu-summary"
      class="mb-2 text-sm text-gray-700 dark:text-gray-300"
    ></p>
    <ul id="nu-result-list" class="flex flex-col gap-2"></ul>
  </section>
</ToolShell>

<script>
  import { paren } from '../../lib/paren';
  import { getPageCount, PdfToolError } from '../../lib/tools/pdf-merge-split';
  import {
    nupFileName,
    nupPdf,
    sheetCount,
    type NupOrder,
    type NupOrientation,
    type PerSheet,
    type SheetSize,
  } from '../../lib/tools/pdf-nup';
  import { enableFileDrop } from '../../lib/file-drop';
  import { preloadPdfLibs } from '../../lib/pdf-preload';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('nu-file');
  const info = $('nu-info');
  const perSheet = $<HTMLSelectElement>('nu-per-sheet');
  const size = $<HTMLSelectElement>('nu-size');
  const orientation = $<HTMLSelectElement>('nu-orientation');
  const order = $<HTMLSelectElement>('nu-order');
  const margin = $<HTMLInputElement>('nu-margin');
  const gap = $<HTMLInputElement>('nu-gap');
  const border = $<HTMLInputElement>('nu-border');
  const runButton = $<HTMLButtonElement>('nu-run');
  const clearButton = $<HTMLButtonElement>('nu-clear');
  const errorEl = $('nu-error');
  const resultEl = $('nu-result');
  const summary = $('nu-summary');
  const resultList = $('nu-result-list');

  enableFileDrop($('nu-drop'), fileInput, () =>
    preloadPdfLibs({ pdfLib: true }),
  );

  let pdfBytes: Uint8Array | null = null;
  let pdfName = '';
  let pdfPages = 0;
  let urls: string[] = [];

  function showError(key: string) {
    hideResult();
    errorEl.textContent = errorEl.dataset[key] ?? '';
    errorEl.hidden = false;
  }

  function hideError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function hideResult() {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    resultList.replaceChildren();
    summary.textContent = '';
    resultEl.hidden = true;
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    pdfBytes = null;
    info.hidden = true;
    hideResult();
    hideError();
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      showError('notPdf');
      return;
    }
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const pages = await getPageCount(bytes);
      pdfBytes = bytes;
      pdfName = file.name;
      pdfPages = pages;
      info.textContent = `${file.name}${paren((info.dataset.template ?? '').replace('{pages}', String(pages)))}`;
      info.hidden = false;
    } catch (e) {
      showError(e instanceof PdfToolError ? e.code : 'failed');
    }
  });

  runButton.addEventListener('click', async () => {
    hideError();
    hideResult();
    if (!pdfBytes) return showError('noFile');
    runButton.disabled = true;
    clearButton.disabled = true;
    fileInput.disabled = true;
    runButton.textContent = runButton.dataset.processing ?? '';
    try {
      const n = Number(perSheet.value) as PerSheet;
      const out = await nupPdf(pdfBytes, {
        perSheet: n,
        sheetSize: size.value as SheetSize,
        orientation: orientation.value as NupOrientation,
        order: order.value as NupOrder,
        margin: Number(margin.value),
        gap: Number(gap.value),
        border: border.checked,
      });
      const url = URL.createObjectURL(
        new Blob([out as BlobPart], { type: 'application/pdf' }),
      );
      urls.push(url);
      const name = nupFileName(pdfName);
      summary.textContent = (resultEl.dataset.summary ?? '')
        .replace('{pages}', () => String(pdfPages))
        .replace('{sheets}', () => String(sheetCount(pdfPages, n)));
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.className =
        'inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-4 text-sm font-medium text-blue-700 hover:bg-gray-100 dark:border-gray-700 dark:text-blue-400 dark:hover:bg-gray-800';
      a.textContent = (resultEl.dataset.download ?? '').replace(
        '{name}',
        () => name,
      );
      li.append(a);
      resultList.append(li);
      resultEl.hidden = false;
    } catch (e) {
      if (e instanceof PdfToolError) showError(e.code);
      else {
        console.error(e);
        showError('failed');
      }
    } finally {
      runButton.disabled = false;
      clearButton.disabled = false;
      fileInput.disabled = false;
      runButton.textContent = runButton.dataset.run ?? '';
    }
  });

  clearButton.addEventListener('click', () => {
    pdfBytes = null;
    info.hidden = true;
    fileInput.value = '';
    hideError();
    hideResult();
  });
</script>
