---
import ToolShell from '../ToolShell.astro';
import { pdfPasswordProtectorContent } from '../../i18n/tools/pdf-password-protector';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pdfPasswordProtectorContent[locale];
const buttonClass = 'ui-btn';
const inputClass =
  'min-h-11 w-full rounded-lg border border-gray-300 px-3 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100';
---

<ToolShell t={t}>
  <div>
    <label for="pp-file" class="ui-label">
      {t.fileLabel}
    </label>
    <div id="pp-drop" class="ui-dropzone">
      <input
        id="pp-file"
        type="file"
        accept=".pdf,application/pdf"
        class="ui-file"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{t.dropHint}</p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{t.fileHint}</p>
    </div>
    <p
      id="pp-info"
      hidden
      data-template={t.pagesTemplate}
      class="mt-2 text-sm text-gray-700 dark:text-gray-300"
    ></p>
  </div>

  <div class="mt-4 max-w-md">
    <label for="pp-user" class="ui-label">
      {t.userPasswordLabel}
    </label>
    <input
      id="pp-user"
      type="password"
      autocomplete="new-password"
      class={inputClass}
    />
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      {t.userPasswordHint}
    </p>
  </div>

  <fieldset class="mt-4 max-w-2xl">
    <legend class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.restrictHeading}
    </legend>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">
      {t.restrictHint}
    </p>
    <div class="flex flex-col gap-2 text-sm text-gray-700 dark:text-gray-300">
      <label class="flex min-h-11 items-center gap-2">
        <input id="pp-print" type="checkbox" checked class="h-4 w-4" />
        {t.allowPrint}
      </label>
      <label class="flex min-h-11 items-center gap-2">
        <input id="pp-copy" type="checkbox" checked class="h-4 w-4" />
        {t.allowCopy}
      </label>
      <label class="flex min-h-11 items-center gap-2">
        <input id="pp-modify" type="checkbox" checked class="h-4 w-4" />
        {t.allowModify}
      </label>
    </div>
  </fieldset>

  <div class="mt-4 max-w-md">
    <label for="pp-owner" class="ui-label">
      {t.ownerPasswordLabel}
    </label>
    <input
      id="pp-owner"
      type="password"
      autocomplete="new-password"
      class={inputClass}
    />
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      {t.ownerPasswordHint}
    </p>
  </div>

  <label class="mt-3 flex min-h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
    <input id="pp-show" type="checkbox" class="h-4 w-4" />
    {t.showPasswords}
  </label>

  <div class="mt-4 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
    <p class="mb-1 font-medium">{t.noteHeading}</p>
    <ul class="list-disc pl-5">
      {t.notes.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      id="pp-run"
      type="button"
      data-run={t.run}
      data-processing={t.processing}
      class="ui-btn-primary"
    >
      {t.run}
    </button>
    <button id="pp-clear" type="button" class={buttonClass}>
      {t.clear}
    </button>
  </div>

  <p
    id="pp-error"
    role="alert"
    hidden
    data-no-file={t.errorNoFile}
    data-not-pdf={t.errorNotPdf}
    data-no-password={t.errorNoPassword}
    data-invalid={t.errorInvalid}
    data-encrypted={t.errorEncrypted}
    data-failed={t.errorFailed}
    class="ui-error mt-4 max-w-2xl"
  ></p>

  <section
    id="pp-result"
    hidden
    class="mt-6"
    data-download={t.downloadTemplate}
  >
    <h2 class="mb-2 text-lg font-semibold">{t.resultHeading}</h2>
    <ul id="pp-result-list" class="flex flex-col gap-3"></ul>
  </section>
</ToolShell>

<script>
  import { paren } from '../../lib/paren';
  import createModule from '@neslinesli93/qpdf-wasm';
  import wasmUrl from '@neslinesli93/qpdf-wasm/dist/qpdf.wasm?url';
  import { getPageCount, PdfToolError } from '../../lib/tools/pdf-merge-split';
  import {
    encryptPdf,
    protectedFileName,
    type QpdfRunner,
  } from '../../lib/tools/pdf-password-protector';
  import { enableFileDrop } from '../../lib/file-drop';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('pp-file');
  const info = $('pp-info');
  const userInput = $<HTMLInputElement>('pp-user');
  const ownerInput = $<HTMLInputElement>('pp-owner');
  const printBox = $<HTMLInputElement>('pp-print');
  const copyBox = $<HTMLInputElement>('pp-copy');
  const modifyBox = $<HTMLInputElement>('pp-modify');
  const showBox = $<HTMLInputElement>('pp-show');
  const runButton = $<HTMLButtonElement>('pp-run');
  const clearButton = $<HTMLButtonElement>('pp-clear');
  const errorEl = $('pp-error');
  const resultEl = $('pp-result');
  const resultList = $('pp-result-list');

  enableFileDrop($('pp-drop'), fileInput);

  let pdfBytes: Uint8Array | null = null;
  let pdfName = '';
  let urls: string[] = [];

  function showError(key: string) {
    hideResult();
    errorEl.textContent = errorEl.dataset[key] ?? '';
    errorEl.hidden = false;
  }

  function hideError() {
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function hideResult() {
    urls.forEach((u) => URL.revokeObjectURL(u));
    urls = [];
    resultList.replaceChildren();
    resultEl.hidden = true;
  }

  showBox.addEventListener('change', () => {
    const type = showBox.checked ? 'text' : 'password';
    userInput.type = type;
    ownerInput.type = type;
  });

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    pdfBytes = null;
    info.hidden = true;
    hideResult();
    hideError();
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      showError('notPdf');
      return;
    }
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const pages = await getPageCount(bytes);
      pdfBytes = bytes;
      pdfName = file.name;
      info.textContent = `${file.name}${paren((info.dataset.template ?? '').replace('{pages}', String(pages)))}`;
      info.hidden = false;
    } catch (e) {
      showError(e instanceof PdfToolError ? e.code : 'failed');
    }
  });

  runButton.addEventListener('click', async () => {
    hideError();
    hideResult();
    if (!pdfBytes) return showError('noFile');
    if (userInput.value === '') return showError('noPassword');
    runButton.disabled = true;
    clearButton.disabled = true;
    fileInput.disabled = true;
    runButton.textContent = runButton.dataset.processing ?? '';
    try {
      // 実行のたびに新しいインスタンスを使う（callMain 後の状態を持ち越さない）
      const qpdf = (await createModule({
        locateFile: () => wasmUrl,
        noInitialRun: true,
      } as never)) as unknown as QpdfRunner;
      const out = await encryptPdf(
        pdfBytes,
        {
          userPassword: userInput.value,
          ownerPassword: ownerInput.value,
          allowPrint: printBox.checked,
          allowCopy: copyBox.checked,
          allowModify: modifyBox.checked,
        },
        qpdf,
      );
      const url = URL.createObjectURL(
        new Blob([out as BlobPart], { type: 'application/pdf' }),
      );
      urls.push(url);
      const name = protectedFileName(pdfName);
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.className =
        'inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-4 text-sm font-medium text-blue-700 hover:bg-gray-100 dark:border-gray-700 dark:text-blue-400 dark:hover:bg-gray-800';
      a.textContent = (resultEl.dataset.download ?? '').replace(
        '{name}',
        () => name,
      );
      li.append(a);
      resultList.append(li);
      resultEl.hidden = false;
    } catch (e) {
      if (e instanceof PdfToolError) showError(e.code);
      else {
        console.error(e);
        showError('failed');
      }
    } finally {
      runButton.disabled = false;
      clearButton.disabled = false;
      fileInput.disabled = false;
      runButton.textContent = runButton.dataset.run ?? '';
    }
  });

  clearButton.addEventListener('click', () => {
    pdfBytes = null;
    info.hidden = true;
    userInput.value = '';
    ownerInput.value = '';
    hideError();
    hideResult();
  });
</script>
