---
import ToolShell from '../ToolShell.astro';
import { pxRemConverterContent } from '../../i18n/tools/px-rem-converter';
import { DEFAULT_BASE_FONT_SIZE } from '../../lib/tools/px-rem-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = pxRemConverterContent[locale];
---

<ToolShell t={t}>
  <div class="mb-4">
    <label for="px-rem-base-input" class="ui-label">
      {t.baseFontSizeLabel}
    </label>
    <input
      id="px-rem-base-input"
      type="text"
      inputmode="decimal"
      spellcheck="false"
      value={DEFAULT_BASE_FONT_SIZE}
      class="ui-input h-11 w-full max-w-40 px-3 font-mono dark:bg-gray-900"
    />
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      {t.baseFontSizeHint}
    </p>
  </div>

  <div
    class="grid grid-cols-1 gap-4 sm:grid-cols-2"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <div>
      <label for="px-rem-px-input" class="ui-label">
        {t.pxLabel}
      </label>
      <div class="flex gap-2">
        <input
          id="px-rem-px-input"
          type="text"
          inputmode="decimal"
          placeholder={t.pxPlaceholder}
          spellcheck="false"
          class="ui-input h-11 w-full min-w-0 px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <button
          type="button"
          data-copy-target="px-rem-px-input"
          class="ui-btn shrink-0"
        >
          {t.copyButton}
        </button>
      </div>
    </div>
    <div>
      <label for="px-rem-rem-input" class="ui-label">
        {t.remLabel}
      </label>
      <div class="flex gap-2">
        <input
          id="px-rem-rem-input"
          type="text"
          inputmode="decimal"
          placeholder={t.remPlaceholder}
          spellcheck="false"
          class="ui-input h-11 w-full min-w-0 px-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <button
          type="button"
          data-copy-target="px-rem-rem-input"
          class="ui-btn shrink-0"
        >
          {t.copyButton}
        </button>
      </div>
    </div>
  </div>

  <p
    id="px-rem-error"
    data-error-invalid-px={t.errorInvalidPx}
    data-error-invalid-rem={t.errorInvalidRem}
    data-error-invalid-base={t.errorInvalidBaseFontSize}
    class="mt-2 text-sm text-red-600 dark:text-red-400"
    aria-live="polite"
  ></p>
  <span
    id="px-rem-status"
    class="mt-2 block text-sm text-green-600 dark:text-green-400"
    aria-live="polite"
  ></span>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    DEFAULT_BASE_FONT_SIZE,
    formatNumber,
    parseBaseFontSize,
    parseNumber,
    pxToRem,
    remToPx,
  } from '../../lib/tools/px-rem-converter';

  const baseInput = document.getElementById(
    'px-rem-base-input',
  ) as HTMLInputElement;
  const pxInput = document.getElementById(
    'px-rem-px-input',
  ) as HTMLInputElement;
  const remInput = document.getElementById(
    'px-rem-rem-input',
  ) as HTMLInputElement;

  const errorEl = document.getElementById('px-rem-error')!;
  const statusEl = document.getElementById('px-rem-status')!;
  const copyContainer = pxInput.closest('[data-copied]') as HTMLElement;

  const copied = copyContainer.dataset.copied ?? '';
  const copyFailed = copyContainer.dataset.copyFailed ?? '';
  const errorInvalidPx = errorEl.dataset.errorInvalidPx ?? '';
  const errorInvalidRem = errorEl.dataset.errorInvalidRem ?? '';
  const errorInvalidBase = errorEl.dataset.errorInvalidBase ?? '';

  function currentBaseFontSize(): number | null {
    return parseBaseFontSize(baseInput.value);
  }

  function convertFromPx() {
    statusEl.textContent = '';
    const raw = pxInput.value;
    if (raw.trim() === '') {
      errorEl.textContent = '';
      return;
    }
    const px = parseNumber(raw);
    if (px === null) {
      errorEl.textContent = errorInvalidPx;
      return;
    }
    const base = currentBaseFontSize();
    if (base === null) {
      errorEl.textContent = errorInvalidBase;
      return;
    }
    errorEl.textContent = '';
    remInput.value = formatNumber(pxToRem(px, base));
  }

  function convertFromRem() {
    statusEl.textContent = '';
    const raw = remInput.value;
    if (raw.trim() === '') {
      errorEl.textContent = '';
      return;
    }
    const rem = parseNumber(raw);
    if (rem === null) {
      errorEl.textContent = errorInvalidRem;
      return;
    }
    const base = currentBaseFontSize();
    if (base === null) {
      errorEl.textContent = errorInvalidBase;
      return;
    }
    errorEl.textContent = '';
    pxInput.value = formatNumber(remToPx(rem, base));
  }

  pxInput.addEventListener('input', convertFromPx);
  remInput.addEventListener('input', convertFromRem);

  baseInput.addEventListener('input', () => {
    statusEl.textContent = '';
    const base = currentBaseFontSize();
    if (base === null) {
      errorEl.textContent = errorInvalidBase;
      return;
    }
    if (pxInput.value.trim() !== '') {
      convertFromPx();
    } else if (remInput.value.trim() !== '') {
      convertFromRem();
    } else {
      errorEl.textContent = '';
    }
  });

  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');
  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      statusEl.textContent = (await copyText(target.value))
        ? copied
        : copyFailed;
    });
  });

  pxInput.value = String(DEFAULT_BASE_FONT_SIZE);
  convertFromPx();
</script>
