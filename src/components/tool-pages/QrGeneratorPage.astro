---
import Glossary from '../Glossary.astro';
import Layout from '../../layouts/Layout.astro';
import { qrGeneratorContent } from '../../i18n/tools/qr-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = qrGeneratorContent[locale];
---

<Layout title={t.title} description={t.description}>
  <h1 class="mb-2 text-2xl font-bold">{t.h1}</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400" set:html={t.introHtml} />

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label
        for="qr-generator-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.inputLabel}
      </label>
      <textarea
        id="qr-generator-input"
        class="h-40 w-full rounded-lg border border-gray-300 p-4 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>

      <div class="mt-4 flex flex-wrap gap-4">
        <div>
          <label
            for="qr-generator-level"
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            {t.levelLabel}
          </label>
          <select
            id="qr-generator-level"
            class="h-11 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
          >
            {t.levelOptions.map(({ value, label, selected }) => (
              <option value={value} selected={selected}>
                {label}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="qr-generator-size"
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            {t.sizeLabel}
          </label>
          <select
            id="qr-generator-size"
            class="h-11 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
          >
            {t.sizeOptions.map(({ value, label, selected }) => (
              <option value={value} selected={selected}>
                {label}
              </option>
            ))}
          </select>
        </div>
      </div>

      <p
        id="qr-generator-error"
        data-error-too-long={t.errorTooLong}
        class="mt-3 text-sm text-red-600 dark:text-red-400"
        aria-live="polite"
      ></p>
    </div>

    <div class="flex flex-col items-center gap-3">
      <canvas
        id="qr-generator-canvas"
        class="h-64 w-64 max-w-full rounded-lg border border-gray-300 bg-white dark:border-gray-700"
      ></canvas>
      <div class="flex items-center gap-3">
        <button
          id="qr-generator-download-button"
          type="button"
          disabled
          class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-gray-700 dark:disabled:text-gray-400"
        >
          {t.downloadButton}
        </button>
      </div>
      <span
        id="qr-generator-status"
        data-downloaded={t.downloaded}
        class="text-sm text-green-600 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.notesHeading}</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    {t.notes.map((note) => (
      <li>{note}</li>
    ))}
  </ul>

  <Glossary terms={t.glossaryTerms} heading={t.glossaryHeading} />
</Layout>

<script>
  import { generateQrMatrix } from '../../lib/tools/qr-generator';
  import type {
    ErrorCorrectionLevel,
    QrMatrix,
  } from '../../lib/tools/qr-generator';

  const QUIET_ZONE_MODULES = 4;

  const input = document.getElementById(
    'qr-generator-input',
  ) as HTMLTextAreaElement;
  const levelSelect = document.getElementById(
    'qr-generator-level',
  ) as HTMLSelectElement;
  const sizeSelect = document.getElementById(
    'qr-generator-size',
  ) as HTMLSelectElement;
  const canvas = document.getElementById(
    'qr-generator-canvas',
  ) as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const errorEl = document.getElementById('qr-generator-error')!;
  const statusEl = document.getElementById('qr-generator-status')!;
  const downloadButton = document.getElementById(
    'qr-generator-download-button',
  ) as HTMLButtonElement;

  const errorTooLong = errorEl.dataset.errorTooLong ?? '';
  const downloaded = statusEl.dataset.downloaded ?? '';

  function drawMatrix(matrix: QrMatrix, targetSize: number) {
    const cellSize = Math.max(
      1,
      Math.floor(targetSize / (matrix.moduleCount + QUIET_ZONE_MODULES * 2)),
    );
    const canvasSize = (matrix.moduleCount + QUIET_ZONE_MODULES * 2) * cellSize;

    canvas.width = canvasSize;
    canvas.height = canvasSize;

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvasSize, canvasSize);
    ctx.fillStyle = '#000000';
    for (let row = 0; row < matrix.moduleCount; row++) {
      for (let col = 0; col < matrix.moduleCount; col++) {
        if (matrix.isDark(row, col)) {
          ctx.fillRect(
            (col + QUIET_ZONE_MODULES) * cellSize,
            (row + QUIET_ZONE_MODULES) * cellSize,
            cellSize,
            cellSize,
          );
        }
      }
    }
  }

  function clearCanvas() {
    canvas.width = 256;
    canvas.height = 256;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }

  function generate() {
    statusEl.textContent = '';
    errorEl.textContent = '';

    const result = generateQrMatrix(
      input.value,
      levelSelect.value as ErrorCorrectionLevel,
    );

    if (!result.ok) {
      clearCanvas();
      downloadButton.disabled = true;
      if (input.value !== '') {
        errorEl.textContent = errorTooLong;
      }
      return;
    }

    drawMatrix(result.matrix, Number(sizeSelect.value));
    downloadButton.disabled = false;
  }

  input.addEventListener('input', generate);
  levelSelect.addEventListener('change', generate);
  sizeSelect.addEventListener('change', generate);

  downloadButton.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'qrcode.png';
      a.click();
      URL.revokeObjectURL(url);
      statusEl.textContent = downloaded;
    }, 'image/png');
  });

  clearCanvas();
  generate();
</script>
