---
import ToolShell from '../ToolShell.astro';
import { randomGeneratorContent } from '../../i18n/tools/random-generator';
import {
  MAX_COUNT,
  MAX_DECIMALS,
  MAX_STRING_LENGTH,
} from '../../lib/tools/random-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = randomGeneratorContent[locale];
const modes = [
  { id: 'string', label: t.modeString },
  { id: 'integer', label: t.modeInteger },
  { id: 'decimal', label: t.modeDecimal },
];
---

<ToolShell t={t}>
  <section
    id="rg-root"
    data-max-count={MAX_COUNT}
    data-max-length={MAX_STRING_LENGTH}
    data-max-decimals={MAX_DECIMALS}
    data-result-summary={t.resultSummary}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-err-empty-charset={t.emptyCharset}
    data-err-invalid-length={t.invalidLength}
    data-err-invalid-count={t.invalidCount}
    data-err-not-enough={t.notEnoughCombinations}
    data-err-invalid-range={t.invalidRange}
    data-err-range-too-large={t.rangeTooLarge}
    data-err-count-exceeds={t.countExceedsRange}
    data-err-invalid-decimals={t.invalidDecimals}
  >
    <div>
      <span class="ui-label">{t.modeLabel}</span>
      <div
        id="rg-mode"
        class="ui-seg flex-wrap"
        role="group"
        aria-label={t.modeLabel}
      >
        {modes.map((mode, i) => (
          <button
            type="button"
            data-mode={mode.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="ui-seg-btn"
          >
            {mode.label}
          </button>
        ))}
      </div>
    </div>

    <div id="rg-string-fields" class="mt-4">
      <span class="ui-label">{t.charsetLabel}</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <label class="ui-check">
          <input id="rg-lowercase" type="checkbox" class="h-4 w-4" checked />
          {t.lowercase}
        </label>
        <label class="ui-check">
          <input id="rg-uppercase" type="checkbox" class="h-4 w-4" checked />
          {t.uppercase}
        </label>
        <label class="ui-check">
          <input id="rg-digits" type="checkbox" class="h-4 w-4" checked />
          {t.digits}
        </label>
        <label class="ui-check">
          <input id="rg-symbols" type="checkbox" class="h-4 w-4" />
          {t.symbols}
        </label>
        <label class="ui-check">
          <input id="rg-exclude-similar" type="checkbox" class="h-4 w-4" />
          {t.excludeSimilar}
        </label>
      </div>
      <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
        <label class="ui-check">
          <input id="rg-hiragana" type="checkbox" class="h-4 w-4" />
          {t.hiragana}
        </label>
        <label class="ui-check">
          <input id="rg-katakana" type="checkbox" class="h-4 w-4" />
          {t.katakana}
        </label>
        <label class="ui-check">
          <input id="rg-kyoiku" type="checkbox" class="h-4 w-4" />
          {t.kyoikuKanji}
        </label>
        <label class="ui-check">
          <input id="rg-joyo" type="checkbox" class="h-4 w-4" />
          {t.joyoKanji}
        </label>
      </div>
      <div class="mt-3">
        <label for="rg-custom" class="ui-label">
          {t.customCharsLabel}
        </label>
        <input
          id="rg-custom"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder={t.customCharsPlaceholder}
          class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
      </div>
      <div class="mt-3">
        <label for="rg-length" class="ui-label">
          {t.lengthLabel}
        </label>
        <input
          id="rg-length"
          type="number"
          inputmode="numeric"
          min="1"
          max={MAX_STRING_LENGTH}
          step="1"
          value="16"
          class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
        />
      </div>
    </div>

    <div id="rg-number-fields" class="mt-4 flex flex-wrap gap-4" hidden>
      <div>
        <label for="rg-min" class="ui-label">
          {t.minLabel}
        </label>
        <input
          id="rg-min"
          type="number"
          inputmode="decimal"
          step="any"
          value="1"
          class="ui-input h-11 w-36 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="rg-max" class="ui-label">
          {t.maxLabel}
        </label>
        <input
          id="rg-max"
          type="number"
          inputmode="decimal"
          step="any"
          value="100"
          class="ui-input h-11 w-36 px-3 dark:bg-gray-900"
        />
      </div>
      <div id="rg-decimals-field" hidden>
        <label for="rg-decimals" class="ui-label">
          {t.decimalsLabel}
        </label>
        <input
          id="rg-decimals"
          type="number"
          inputmode="numeric"
          min="0"
          max={MAX_DECIMALS}
          step="1"
          value="2"
          class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
        />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-end gap-x-6 gap-y-3">
      <div>
        <label for="rg-count" class="ui-label">
          {t.countLabel}
        </label>
        <input
          id="rg-count"
          type="number"
          inputmode="numeric"
          min="1"
          max={MAX_COUNT}
          step="1"
          value="10"
          class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
        />
      </div>
      <label id="rg-unique-field" class="ui-check pb-2.5">
        <input id="rg-unique" type="checkbox" class="h-4 w-4" />
        {t.unique}
      </label>
      <label id="rg-sort-field" class="ui-check pb-2.5" hidden>
        <input id="rg-sort" type="checkbox" class="h-4 w-4" />
        {t.sort}
      </label>
    </div>

    <div class="mt-4">
      <button id="rg-generate-button" type="button" class="ui-btn-primary">
        {t.generate}
      </button>
    </div>

    <div id="rg-error" class="ui-error empty:hidden mt-4" role="alert"></div>

    <div id="rg-result" class="mt-4" hidden>
      <label for="rg-output" class="ui-label">
        {t.resultLabel}
      </label>
      <textarea
        id="rg-output"
        readonly
        spellcheck="false"
        data-no-count
        class="ui-input h-56 w-full p-3 font-mono dark:bg-gray-900"
      ></textarea>
      <p
        id="rg-summary"
        class="mt-1 text-sm text-gray-600 dark:text-gray-400"
        aria-live="polite"
      ></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="rg-copy-button" type="button" class="ui-btn">
          {t.copy}
        </button>
        <span
          id="rg-status"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    generateDecimals,
    generateIntegers,
    generateStrings,
    type GenerateError,
    type GenerateResult,
  } from '../../lib/tools/random-generator';

  type Mode = 'string' | 'integer' | 'decimal';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const msg = $('rg-root').dataset;
  const input = (id: string) => $<HTMLInputElement>(id);
  const stringFields = $('rg-string-fields');
  const numberFields = $('rg-number-fields');
  const decimalsField = $('rg-decimals-field');
  const uniqueField = $('rg-unique-field');
  const sortField = $('rg-sort-field');
  const errorEl = $('rg-error');
  const resultEl = $('rg-result');
  const outputEl = $<HTMLTextAreaElement>('rg-output');
  const summaryEl = $('rg-summary');
  const statusEl = $('rg-status');
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#rg-mode [data-mode]'),
  );

  let mode: Mode = 'string';

  function fill(template: string | undefined, values: Record<string, string>) {
    return (template ?? '').replace(/\{(\w+)\}/g, (match, key: string) =>
      Object.hasOwn(values, key) ? values[key] : match,
    );
  }

  function errorText(error: GenerateError): string {
    switch (error) {
      case 'emptyCharset':
        return msg.errEmptyCharset ?? '';
      case 'invalidLength':
        return fill(msg.errInvalidLength, { max: msg.maxLength ?? '' });
      case 'invalidCount':
        return fill(msg.errInvalidCount, { max: msg.maxCount ?? '' });
      case 'notEnoughCombinations':
        return msg.errNotEnough ?? '';
      case 'invalidRange':
        return msg.errInvalidRange ?? '';
      case 'rangeTooLarge':
        return msg.errRangeTooLarge ?? '';
      case 'countExceedsRange':
        return msg.errCountExceeds ?? '';
      case 'invalidDecimals':
        return fill(msg.errInvalidDecimals, { max: msg.maxDecimals ?? '' });
    }
  }

  /** 空欄は NaN にして、各生成関数のエラー判定に任せる */
  function num(id: string): number {
    const raw = input(id).value.trim();
    return raw === '' ? NaN : Number(raw);
  }

  function setMode(next: Mode) {
    mode = next;
    modeButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.mode === next)),
    );
    stringFields.hidden = next !== 'string';
    numberFields.hidden = next === 'string';
    decimalsField.hidden = next !== 'decimal';
    uniqueField.hidden = next === 'decimal';
    sortField.hidden = next === 'string';
    errorEl.textContent = '';
  }

  function generate(): GenerateResult {
    const count = num('rg-count');
    if (mode === 'string') {
      return generateStrings({
        lowercase: input('rg-lowercase').checked,
        uppercase: input('rg-uppercase').checked,
        digits: input('rg-digits').checked,
        symbols: input('rg-symbols').checked,
        hiragana: input('rg-hiragana').checked,
        katakana: input('rg-katakana').checked,
        kyoikuKanji: input('rg-kyoiku').checked,
        joyoKanji: input('rg-joyo').checked,
        customChars: input('rg-custom').value,
        excludeSimilar: input('rg-exclude-similar').checked,
        length: num('rg-length'),
        count,
        unique: input('rg-unique').checked,
      });
    }
    if (mode === 'integer') {
      return generateIntegers({
        min: num('rg-min'),
        max: num('rg-max'),
        count,
        unique: input('rg-unique').checked,
        sort: input('rg-sort').checked,
      });
    }
    return generateDecimals({
      min: num('rg-min'),
      max: num('rg-max'),
      decimals: num('rg-decimals'),
      count,
      sort: input('rg-sort').checked,
    });
  }

  function run() {
    errorEl.textContent = '';
    statusEl.textContent = '';
    const result = generate();
    if (!result.ok) {
      errorEl.textContent = errorText(result.error);
      resultEl.hidden = true;
      return;
    }
    outputEl.value = result.values.join('\n');
    summaryEl.textContent = fill(msg.resultSummary, {
      count: String(result.values.length),
    });
    resultEl.hidden = false;
  }

  modeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const id = b.dataset.mode;
      setMode(id === 'integer' || id === 'decimal' ? id : 'string');
    }),
  );
  $('rg-generate-button').addEventListener('click', run);
  $('rg-copy-button').addEventListener('click', async () => {
    if (!outputEl.value) return;
    statusEl.textContent = (await copyText(outputEl.value))
      ? (msg.copied ?? '')
      : (msg.copyFailed ?? '');
  });
</script>
