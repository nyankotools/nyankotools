---
import ToolShell from '../ToolShell.astro';
import { reactionTestContent } from '../../i18n/tools/reaction-test';
import { ROUNDS } from '../../lib/tools/reaction-test';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = reactionTestContent[locale];

const padClass =
  'flex min-h-56 w-full max-w-2xl cursor-pointer items-center justify-center rounded-xl border-2 border-transparent p-4 text-center text-lg font-bold text-white select-none touch-manipulation focus:outline-2 focus:outline-offset-2 focus:outline-blue-600 dark:focus:outline-blue-400 data-[state=idle]:bg-blue-700 data-[state=waiting]:bg-red-700 data-[state=go]:bg-green-700 data-[state=early]:bg-amber-800 data-[state=result]:bg-slate-700 data-[state=done]:bg-slate-700';

const stats = [
  ['round', t.roundLabel],
  ['last', t.lastLabel],
  ['average', t.averageLabel],
  ['best', t.bestLabel],
  ['worst', t.worstLabel],
  ['median', t.medianLabel],
  ['early', t.earlyCountLabel],
  ['rank', t.rankLabel],
];
---

<ToolShell t={t}>
  <div
    id="rt-root"
    data-rounds={ROUNDS}
    data-unit={t.unit}
    data-pad-idle={t.padIdle}
    data-pad-waiting={t.padWaiting}
    data-pad-go={t.padGo}
    data-pad-early={t.padEarly}
    data-pad-result={t.padResult}
    data-pad-done={t.padDone}
    data-ranks={JSON.stringify(t.ranks)}
  >
    <div
      id="rt-pad"
      tabindex="0"
      role="button"
      data-state="idle"
      class={padClass}
    >
      <span id="rt-pad-text" aria-live="polite">
        {t.padIdle}
      </span>
    </div>

    <div class="mt-4 overflow-x-auto">
      <table class="w-full max-w-2xl min-w-[280px] border-collapse text-sm">
        <tbody>
          {stats.map(([id, label]) => (
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-2 pr-4 text-gray-600 dark:text-gray-400">
                {label}
              </td>
              <td
                id={`rt-stat-${id}`}
                class="py-2 text-right text-gray-900 tabular-nums dark:text-gray-100"
              >
                -
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.historyLabel}
    </p>
    <ol
      id="rt-history"
      class="mt-1 flex max-w-2xl flex-wrap gap-2 text-sm tabular-nums"
    ></ol>

    <button id="rt-reset" type="button" class="ui-btn mt-4">
      {t.resetLabel}
    </button>
  </div>
</ToolShell>

<script>
  import {
    formatMs,
    generateWaitMs,
    rankOf,
    summarize,
  } from '../../lib/tools/reaction-test';
  import type { RankId } from '../../lib/tools/reaction-test';

  const root = document.getElementById('rt-root')!;
  const d = root.dataset;
  const rounds = Number(d.rounds);
  const ranks = JSON.parse(d.ranks!) as Record<RankId, string>;
  const pad = document.getElementById('rt-pad')!;
  const padText = document.getElementById('rt-pad-text')!;
  const history = document.getElementById('rt-history')!;
  const resetButton = document.getElementById('rt-reset')!;
  const stat = (id: string) => document.getElementById(`rt-stat-${id}`)!;

  type State = 'idle' | 'waiting' | 'go' | 'early' | 'result' | 'done';
  let state: State = 'idle';
  let times: number[] = [];
  let earlyCount = 0;
  let waitTimer = 0;
  let goFrame = 0;
  let goAt = 0;
  let finishedAt = 0;

  function setState(next: State, text: string) {
    state = next;
    pad.dataset.state = next;
    padText.textContent = text;
  }

  function render() {
    const s = summarize(times);
    const unit = d.unit!;
    const fmt = (v: number | undefined) =>
      v === undefined ? '-' : `${formatMs(v)} ${unit}`;
    stat('round').textContent =
      `${Math.min(times.length + 1, rounds)} / ${rounds}`;
    stat('last').textContent = fmt(times[times.length - 1]);
    stat('average').textContent = fmt(s?.average);
    stat('best').textContent = fmt(s?.best);
    stat('worst').textContent = fmt(s?.worst);
    stat('median').textContent = fmt(s?.median);
    stat('early').textContent = String(earlyCount);
    stat('rank').textContent =
      s && times.length >= rounds ? ranks[rankOf(s.average)] : '-';
    history.replaceChildren(
      ...times.map((ms, i) => {
        const li = document.createElement('li');
        li.className =
          'rounded-md border border-gray-300 px-2 py-1 dark:border-gray-700';
        li.textContent = `${i + 1}: ${formatMs(ms)} ${unit}`;
        return li;
      }),
    );
  }

  function clearTimers() {
    window.clearTimeout(waitTimer);
    window.cancelAnimationFrame(goFrame);
  }

  function startWaiting() {
    clearTimers();
    goAt = 0;
    setState('waiting', d.padWaiting!);
    waitTimer = window.setTimeout(() => {
      // 描画された後の時刻を基準にする
      setState('go', d.padGo!);
      goFrame = window.requestAnimationFrame(() => {
        goAt = performance.now();
      });
    }, generateWaitMs());
  }

  function reset() {
    clearTimers();
    times = [];
    earlyCount = 0;
    goAt = 0;
    setState('idle', d.padIdle!);
    render();
  }

  function press(timeStamp: number) {
    switch (state) {
      case 'idle':
        startWaiting();
        render();
        break;
      case 'waiting':
        clearTimers();
        earlyCount++;
        setState('early', d.padEarly!);
        render();
        break;
      case 'go': {
        // 基準時刻（rAF）が決まる前、または基準より前の入力は無視する（0ms の記録を防ぐ）
        if (!goAt || timeStamp < goAt) break;
        const ms = timeStamp - goAt;
        times.push(ms);
        render();
        if (times.length >= rounds) {
          finishedAt = performance.now();
          setState('done', `${formatMs(ms)} ${d.unit} / ${d.padDone}`);
        } else {
          setState('result', `${formatMs(ms)} ${d.padResult}`);
        }
        break;
      }
      case 'early':
        startWaiting();
        break;
      case 'result':
        startWaiting();
        render();
        break;
      case 'done':
        // 連打の勢いで、結果がすぐ消えないようにする
        if (performance.now() - finishedAt < 600) return;
        reset();
        startWaiting();
        render();
        break;
    }
  }

  pad.addEventListener('pointerdown', (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    pad.focus({ preventScroll: true });
    press(event.timeStamp);
  });
  pad.addEventListener('keydown', (event) => {
    if (event.code !== 'Space' && event.key !== 'Enter') return;
    event.preventDefault();
    if (event.repeat) return;
    press(event.timeStamp);
  });
  pad.addEventListener('contextmenu', (event) => event.preventDefault());
  resetButton.addEventListener('click', reset);

  render();
</script>
