---
import ToolShell from '../ToolShell.astro';
import { regexPatternLibraryContent } from '../../i18n/tools/regex-pattern-library';
import type { Locale } from '../../data/tools';
import {
  PATTERNS,
  PATTERN_CATEGORIES,
} from '../../lib/tools/regex-pattern-library';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = regexPatternLibraryContent[locale];

const rows = PATTERNS.map((p) => ({
  ...p,
  text: t.patterns[p.id],
}));

const show = (s: string) => (s === '' ? t.emptyExample : s);
---

<ToolShell t={t}>
  <section
    id="rpl"
    data-count-template={t.countTemplate}
    data-copied={t.copiedLabel}
    data-copy-failed={t.copyFailedLabel}
  >
    <label for="rpl-query" class="ui-label">
      {t.searchLabel}
    </label>
    <input
      id="rpl-query"
      type="search"
      class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.searchPlaceholder}
      autocomplete="off"
      spellcheck="false"
      data-query-target="text"
    />
    <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">{t.searchHint}</p>

    <div
      id="rpl-category"
      class="ui-seg mt-3 w-fit max-w-full flex-wrap"
      role="group"
      aria-label={t.categoryLabel}
    >
      <button
        type="button"
        data-category="all"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.allLabel}
      </button>
      {PATTERN_CATEGORIES.map((c) => (
        <button
          type="button"
          data-category={c}
          aria-pressed="false"
          class="ui-seg-btn"
        >
          {t.categories[c]}
        </button>
      ))}
    </div>

    <p
      id="rpl-count"
      class="mt-3 text-sm text-gray-600 dark:text-gray-400"
      aria-live="polite"
    ></p>
    <p
      id="rpl-empty"
      class="mt-3 hidden text-sm text-gray-700 dark:text-gray-300"
      role="status"
    >
      {t.noResults}
    </p>

    <ul id="rpl-list" class="mt-3 space-y-3">
      {rows.map((r) => (
        <li
          data-id={r.id}
          data-category={r.category}
          data-search={[
            r.text.name,
            r.text.description,
            r.pattern,
            r.id,
            t.categories[r.category],
          ].join(' ')}
          class="rounded-lg border border-gray-200 p-3 dark:border-gray-700"
        >
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-base font-semibold break-words">{r.text.name}</h2>
            <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-700 dark:bg-gray-800 dark:text-gray-300">
              {t.categories[r.category]}
            </span>
          </div>
          <p class="mt-1 text-sm">{r.text.description}</p>

          <code class="rpl-pattern mt-2 block rounded bg-gray-100 p-2 font-mono text-sm break-all whitespace-pre-wrap dark:bg-gray-800">
            {r.pattern}
          </code>
          <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
            {t.flagsLabel}:{' '}
            <span class="font-mono">
              {r.flags === '' ? t.noFlags : r.flags}
            </span>
          </p>

          <div class="mt-2 grid gap-2 sm:grid-cols-2">
            <div>
              <p class="text-xs font-medium text-green-800 dark:text-green-300">
                ✓ {t.matchLabel}
              </p>
              <ul class="mt-1 space-y-0.5">
                {r.matches.map((m) => (
                  <li class="font-mono text-xs break-all whitespace-pre-wrap">
                    {show(m)}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-xs font-medium text-red-800 dark:text-red-300">
                ✗ {t.nonMatchLabel}
              </p>
              <ul class="mt-1 space-y-0.5">
                {r.nonMatches.map((m) => (
                  <li class="font-mono text-xs break-all whitespace-pre-wrap">
                    {show(m)}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button
              type="button"
              class="ui-btn rpl-copy"
              data-pattern={r.pattern}
              aria-label={`${t.copyLabel}: ${r.text.name}`}
            >
              {t.copyLabel}
            </button>
            <a
              href={t.testerHref}
              class="ui-btn inline-flex items-center justify-center"
              aria-label={`${t.testerLabel}: ${r.text.name}`}
            >
              {t.testerLabel}
            </a>
            <span
              class="rpl-status text-xs text-gray-600 dark:text-gray-400"
              role="status"
            ></span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    matchesPattern,
    type CategoryFilter,
    type PatternCategory,
  } from '../../lib/tools/regex-pattern-library';

  const section = document.getElementById('rpl')!;
  const queryEl = document.getElementById('rpl-query') as HTMLInputElement;
  const countEl = document.getElementById('rpl-count')!;
  const emptyEl = document.getElementById('rpl-empty')!;
  const items = Array.from(
    document.querySelectorAll<HTMLLIElement>('#rpl-list > li'),
  );
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>(
    '#rpl-category [data-category]',
  );
  const countTemplate = section.dataset.countTemplate ?? '{shown} / {total}';

  let category: CategoryFilter = 'all';

  function render() {
    const query = queryEl.value;
    let shown = 0;
    for (const li of items) {
      const match = matchesPattern(
        li.dataset.category as PatternCategory,
        li.dataset.search ?? '',
        query,
        category,
      );
      li.classList.toggle('hidden', !match);
      if (match) shown++;
    }
    countEl.textContent = countTemplate
      .replace('{shown}', String(shown))
      .replace('{total}', String(items.length));
    emptyEl.classList.toggle('hidden', shown > 0);
  }

  queryEl.addEventListener('input', render);
  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      category = button.dataset.category as CategoryFilter;
      categoryButtons.forEach((b) =>
        b.setAttribute('aria-pressed', String(b === button)),
      );
      render();
    });
  });

  const timers = new WeakMap<Element, number>();
  document
    .querySelectorAll<HTMLButtonElement>('#rpl-list .rpl-copy')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const status = button
          .closest('li')!
          .querySelector<HTMLElement>('.rpl-status')!;
        const ok = await copyText(button.dataset.pattern ?? '');
        status.textContent =
          (ok ? section.dataset.copied : section.dataset.copyFailed) ?? '';
        window.clearTimeout(timers.get(status));
        timers.set(
          status,
          window.setTimeout(() => {
            status.textContent = '';
          }, 2000),
        );
      });
    });

  render();
</script>
