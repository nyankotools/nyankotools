---
import ToolShell from '../ToolShell.astro';
import { regexTesterContent } from '../../i18n/tools/regex-tester';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = regexTesterContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="regex-pattern-input" class="ui-label">
      {t.patternLabel}
    </label>
    <div class="flex items-center gap-1 font-mono text-sm">
      <span class="text-gray-500 dark:text-gray-400">/</span>
      <input
        id="regex-pattern-input"
        type="text"
        class="w-full rounded-lg border border-gray-300 p-3 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={t.patternPlaceholder}
        spellcheck="false"
        autocomplete="off"
      />
      <span id="regex-flags-label" class="text-gray-500 dark:text-gray-400">
        /g
      </span>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-i" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.flagILabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-m" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.flagMLabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-s" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.flagSLabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-u" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.flagULabel}</span>
    </label>
  </div>
  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{t.globalNote}</p>

  <div class="mt-4">
    <label for="regex-test-input" class="ui-label">
      {t.testInputLabel}
    </label>
    <textarea
      id="regex-test-input"
      class="ui-input h-40 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.testInputPlaceholder}
      spellcheck="false"
    ></textarea>
  </div>

  <div
    class="mt-4 flex flex-wrap items-center gap-3"
    data-error-template={t.errorInvalidPatternTemplate}
    data-timeout-message={t.errorTimeout}
    data-match-singular-template={t.statusMatchSingularTemplate}
    data-match-plural-template={t.statusMatchPluralTemplate}
    data-no-groups={t.noGroups}
    data-no-value={t.noValue}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <span
      id="regex-status"
      class="text-sm font-medium text-gray-700 dark:text-gray-300"
      aria-live="polite"
    ></span>
  </div>

  <div
    id="regex-error"
    class="mt-2 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300"
    role="alert"
  ></div>

  <div class="mt-2">
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.highlightHeading}
    </p>
    <div
      id="regex-highlight"
      class="min-h-24 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm break-words whitespace-pre-wrap dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    ></div>
  </div>

  <div id="regex-matches-wrapper" class="mt-4 hidden">
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      {t.matchListHeading}
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
      <table class="w-full min-w-[520px] text-left text-sm">
        <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <tr>
            <th class="px-3 py-2 font-medium">{t.columnIndexNumber}</th>
            <th class="px-3 py-2 font-medium">{t.columnPosition}</th>
            <th class="px-3 py-2 font-medium">{t.columnMatchedText}</th>
            <th class="px-3 py-2 font-medium">{t.columnCaptureGroups}</th>
          </tr>
        </thead>
        <tbody
          id="regex-matches-body"
          class="divide-y divide-gray-200 dark:divide-gray-800"
        ></tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <label for="regex-replacement-input" class="ui-label">
      {t.replacementLabel}
    </label>
    <input
      id="regex-replacement-input"
      type="text"
      class="ui-input w-full p-3 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.replacementPlaceholder}
      spellcheck="false"
      autocomplete="off"
    />
  </div>

  <div id="regex-replace-wrapper" class="mt-2 hidden">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
        {t.replacementPreviewHeading}
      </p>
      <div class="flex items-center gap-3">
        <button id="regex-replace-copy-button" type="button" class="ui-btn">
          {t.copyButton}
        </button>
        <span
          id="regex-replace-copy-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
    <textarea
      id="regex-replace-result"
      class="mt-2 h-32 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      readonly
    ></textarea>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import { escapeHtml } from '../../lib/tools/html-escape';
  import type { RegexMatchResult } from '../../lib/tools/regex-tester';
  import {
    createRegexRunner,
    type RegexWorkerLike,
  } from '../../lib/regex-runner';
  import regexWorkerUrl from '../../lib/tools/regex-tester.worker.ts?worker&url';

  const patternInput = document.getElementById(
    'regex-pattern-input',
  ) as HTMLInputElement;
  const flagsLabel = document.getElementById('regex-flags-label')!;
  const flagI = document.getElementById('regex-flag-i') as HTMLInputElement;
  const flagM = document.getElementById('regex-flag-m') as HTMLInputElement;
  const flagS = document.getElementById('regex-flag-s') as HTMLInputElement;
  const flagU = document.getElementById('regex-flag-u') as HTMLInputElement;
  const testInput = document.getElementById(
    'regex-test-input',
  ) as HTMLTextAreaElement;
  const statusEl = document.getElementById('regex-status')!;
  const statusContainer = statusEl.closest(
    '[data-error-template]',
  ) as HTMLElement;
  const errorEl = document.getElementById('regex-error')!;
  const highlightEl = document.getElementById('regex-highlight')!;
  const matchesWrapper = document.getElementById('regex-matches-wrapper')!;
  const matchesBody = document.getElementById('regex-matches-body')!;
  const replacementInput = document.getElementById(
    'regex-replacement-input',
  ) as HTMLInputElement;
  const replaceWrapper = document.getElementById('regex-replace-wrapper')!;
  const replaceResult = document.getElementById(
    'regex-replace-result',
  ) as HTMLTextAreaElement;
  const replaceCopyButton = document.getElementById(
    'regex-replace-copy-button',
  ) as HTMLButtonElement;
  const replaceCopyStatus = document.getElementById(
    'regex-replace-copy-status',
  )!;

  const errorTemplate = statusContainer.dataset.errorTemplate ?? '';
  const timeoutMessage = statusContainer.dataset.timeoutMessage ?? '';

  // 利用者の正規表現は Worker で実行し、破滅的バックトラッキングでタブが固まらないようにする
  const runner = createRegexRunner(
    () =>
      new Worker(regexWorkerUrl, {
        type: 'module',
      }) as unknown as RegexWorkerLike,
  );
  let renderSeq = 0;
  const matchSingularTemplate =
    statusContainer.dataset.matchSingularTemplate ?? '';
  const matchPluralTemplate = statusContainer.dataset.matchPluralTemplate ?? '';
  const noGroups = statusContainer.dataset.noGroups ?? '';
  const noValue = statusContainer.dataset.noValue ?? '';
  const copied = statusContainer.dataset.copied ?? '';
  const copyFailed = statusContainer.dataset.copyFailed ?? '';

  function currentFlags(): string {
    let flags = 'g';
    if (flagI.checked) flags += 'i';
    if (flagM.checked) flags += 'm';
    if (flagS.checked) flags += 's';
    if (flagU.checked) flags += 'u';
    return flags;
  }

  function formatGroups(match: RegexMatchResult): string {
    if (match.groups.length === 0) return noGroups;
    return match.groups
      .map((g, i) => {
        const label = g.name ?? String(i + 1);
        const value = g.value === undefined ? noValue : g.value;
        return `${label}: ${value}`;
      })
      .join(', ');
  }

  async function render() {
    flagsLabel.textContent = `/${currentFlags()}`;
    replaceCopyStatus.textContent = '';

    const pattern = patternInput.value;
    const flags = currentFlags();
    const text = testInput.value;
    const replacement = replacementInput.value;

    const seq = ++renderSeq;
    const outcome = await runner.run({ pattern, flags, text, replacement });
    // 後から入力が変わっていたら、古い結果は捨てる
    if (seq !== renderSeq || outcome.status === 'superseded') return;

    if (outcome.status === 'timeout') {
      errorEl.textContent = timeoutMessage;
      errorEl.classList.remove('hidden');
      statusEl.textContent = '';
      highlightEl.textContent = text;
      matchesWrapper.classList.add('hidden');
      replaceWrapper.classList.add('hidden');
      return;
    }
    const result = outcome.response.test;

    if (!result.isValid) {
      errorEl.textContent = errorTemplate.replace(
        '{message}',
        result.error ?? '',
      );
      errorEl.classList.remove('hidden');
      statusEl.textContent = '';
      highlightEl.textContent = text;
      matchesWrapper.classList.add('hidden');
      replaceWrapper.classList.add('hidden');
      return;
    }
    errorEl.classList.add('hidden');

    if (pattern === '') {
      statusEl.textContent = '';
      highlightEl.textContent = text;
      matchesWrapper.classList.add('hidden');
      replaceWrapper.classList.add('hidden');
      return;
    }

    const count = result.matches.length;
    const template = count === 1 ? matchSingularTemplate : matchPluralTemplate;
    statusEl.textContent = template.replace('{count}', String(count));

    let html = '';
    let lastIndex = 0;
    for (const match of result.matches) {
      html += escapeHtml(text.slice(lastIndex, match.index));
      html += `<mark class="rounded bg-yellow-200 px-0.5 dark:bg-yellow-600 dark:text-gray-900">${escapeHtml(
        match.match,
      )}</mark>`;
      lastIndex = match.index + match.match.length;
    }
    html += escapeHtml(text.slice(lastIndex));
    highlightEl.innerHTML = html || '&nbsp;';

    if (result.matches.length === 0) {
      matchesWrapper.classList.add('hidden');
    } else {
      matchesBody.innerHTML = result.matches
        .map(
          (match, i) => `<tr>
            <td class="px-3 py-2">${i + 1}</td>
            <td class="px-3 py-2">${match.index}</td>
            <td class="px-3 py-2 font-mono">${escapeHtml(match.match)}</td>
            <td class="px-3 py-2 font-mono text-xs">${escapeHtml(formatGroups(match))}</td>
          </tr>`,
        )
        .join('');
      matchesWrapper.classList.remove('hidden');
    }

    const replaced = outcome.response.replace;
    if (replacement === '' || replaced === null) {
      replaceWrapper.classList.add('hidden');
    } else {
      replaceResult.value = replaced.error ? text : replaced.result;
      replaceWrapper.classList.remove('hidden');
    }
  }

  onTextInput(patternInput, render, { watch: [testInput] });
  onTextInput(testInput, render, { watch: [patternInput] });
  onTextInput(replacementInput, render);
  for (const flag of [flagI, flagM, flagS, flagU]) {
    flag.addEventListener('change', render);
  }

  replaceCopyButton.addEventListener('click', async () => {
    if (!replaceResult.value) return;
    replaceCopyStatus.textContent = (await copyText(replaceResult.value))
      ? copied
      : copyFailed;
  });

  render();
</script>
