---
import ToolShell from '../ToolShell.astro';
import { resumeMakerContent } from '../../i18n/tools/resume-maker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = resumeMakerContent[locale];
---

<ToolShell t={t}>
  <section
    id="rm"
    class="space-y-6"
    data-label-education={t.sheetEducation}
    data-label-work={t.sheetWork}
    data-label-end={t.sheetEnd}
    data-date-template={t.sheetDate}
    data-age-template={t.sheetAge}
    data-saved={t.savedMessage}
    data-saved-fail={t.savedFailMessage}
    data-cleared={t.clearedMessage}
    data-loaded={t.loadedMessage}
    data-photo-error={t.photoErrorFile}
    data-issue-entry-date={t.issueEntryDate}
    data-issue-history={t.issueHistory}
    data-issue-licenses={t.issueLicenses}
    data-issue-motivation={t.issueMotivation}
    data-issue-wishes={t.issueWishes}
  >
    <div class="space-y-6 print:hidden">
      <p class="rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100">
        {t.privacyNote}
      </p>

      <fieldset class="space-y-3">
        <legend class="mb-2 text-base font-semibold">{t.basicHeading}</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="rm-era" class="ui-label">
              {t.eraLabel}
            </label>
            <select
              id="rm-era"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            >
              <option value="wareki">{t.eraWareki}</option>
              <option value="seireki">{t.eraSeireki}</option>
            </select>
          </div>
          <div>
            <label for="rm-date" class="ui-label">
              {t.dateLabel}
            </label>
            <input
              id="rm-date"
              type="date"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-name-kana" class="ui-label">
              {t.nameKanaLabel}
            </label>
            <input
              id="rm-name-kana"
              type="text"
              autocomplete="off"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-name" class="ui-label">
              {t.nameLabel}
            </label>
            <input
              id="rm-name"
              type="text"
              autocomplete="name"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-birth" class="ui-label">
              {t.birthLabel}
            </label>
            <input
              id="rm-birth"
              type="date"
              autocomplete="bday"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-gender" class="ui-label">
              {t.genderLabel}
            </label>
            <select
              id="rm-gender"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            >
              <option value="">{t.genderNone}</option>
              <option value="male">{t.genderMale}</option>
              <option value="female">{t.genderFemale}</option>
            </select>
          </div>
          <div>
            <label for="rm-postal" class="ui-label">
              {t.postalLabel}
            </label>
            <input
              id="rm-postal"
              type="text"
              inputmode="numeric"
              autocomplete="postal-code"
              maxlength="12"
              placeholder="100-0001"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-address-kana" class="ui-label">
              {t.addressKanaLabel}
            </label>
            <input
              id="rm-address-kana"
              type="text"
              autocomplete="off"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div class="sm:col-span-2">
            <label for="rm-address" class="ui-label">
              {t.addressLabel}
            </label>
            <input
              id="rm-address"
              type="text"
              autocomplete="street-address"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-phone" class="ui-label">
              {t.phoneLabel}
            </label>
            <input
              id="rm-phone"
              type="tel"
              autocomplete="tel"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
          <div>
            <label for="rm-email" class="ui-label">
              {t.emailLabel}
            </label>
            <input
              id="rm-email"
              type="email"
              autocomplete="email"
              data-no-persist
              class="ui-input h-11 w-full px-3 dark:bg-gray-900"
            />
          </div>
        </div>
      </fieldset>

      <div>
        <label for="rm-photo-file" class="ui-label">
          {t.photoHeading}
        </label>
        <div id="rm-dropzone" class="ui-dropzone max-w-2xl">
          <input
            id="rm-photo-file"
            type="file"
            accept="image/*"
            class="ui-file"
            data-no-persist
          />
          <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            {t.photoHint}
          </p>
        </div>
        <p id="rm-photo-error" hidden role="alert" class="ui-error mt-3"></p>
        <button id="rm-photo-remove" type="button" hidden class="ui-btn mt-3">
          {t.photoRemoveButton}
        </button>
      </div>

      <fieldset class="space-y-3">
        <legend class="mb-1 text-base font-semibold">{t.historyHeading}</legend>
        <p class="text-sm text-gray-600 dark:text-gray-400">{t.historyHint}</p>
        <div>
          <label for="rm-education" class="ui-label">
            {t.educationLabel}
          </label>
          <textarea
            id="rm-education"
            rows="5"
            autocomplete="off"
            data-no-persist
            class="ui-input w-full px-3 py-2 dark:bg-gray-900"
          ></textarea>
        </div>
        <div>
          <label for="rm-work" class="ui-label">
            {t.workLabel}
          </label>
          <textarea
            id="rm-work"
            rows="5"
            autocomplete="off"
            data-no-persist
            class="ui-input w-full px-3 py-2 dark:bg-gray-900"
          ></textarea>
        </div>
        <div>
          <label for="rm-licenses" class="ui-label">
            {t.licensesLabel}
          </label>
          <textarea
            id="rm-licenses"
            rows="3"
            autocomplete="off"
            placeholder={t.licensesHint}
            data-no-persist
            class="ui-input w-full px-3 py-2 dark:bg-gray-900"
          ></textarea>
        </div>
        <div>
          <label for="rm-motivation" class="ui-label">
            {t.motivationLabel}
          </label>
          <textarea
            id="rm-motivation"
            rows="5"
            autocomplete="off"
            data-no-persist
            class="ui-input w-full px-3 py-2 dark:bg-gray-900"
          ></textarea>
        </div>
        <div>
          <label for="rm-wishes" class="ui-label">
            {t.wishesLabel}
          </label>
          <textarea
            id="rm-wishes"
            rows="3"
            autocomplete="off"
            data-no-persist
            class="ui-input w-full px-3 py-2 dark:bg-gray-900"
          ></textarea>
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="mb-1 text-base font-semibold">{t.saveHeading}</legend>
        <p class="text-sm text-gray-600 dark:text-gray-400">{t.saveHint}</p>
        <div class="flex flex-wrap gap-3">
          <button id="rm-save-button" type="button" class="ui-btn">
            {t.saveButton}
          </button>
          <button id="rm-clear-button" type="button" class="ui-btn">
            {t.clearButton}
          </button>
        </div>
        <p
          id="rm-save-status"
          class="text-sm text-gray-700 empty:hidden dark:text-gray-300"
          aria-live="polite"
        ></p>
      </fieldset>

      <div class="flex flex-wrap gap-3">
        <button
          id="rm-print-button"
          type="button"
          class="ui-btn ui-btn-primary"
        >
          {t.printButton}
        </button>
      </div>
      <div
        id="rm-error"
        class="ui-error space-y-1 empty:hidden"
        aria-live="polite"
      ></div>
      <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
        {t.previewLabel}
      </p>
    </div>

    <div
      role="region"
      aria-label={t.previewLabel}
      tabindex="0"
      class="max-w-full overflow-x-auto print:overflow-visible"
    >
      <div class="rm-sheet">
        <div class="rm-page">
          <div class="rm-head">
            <span class="rm-title">{t.sheetTitle}</span>
            <span id="rm-p-date" class="rm-date"></span>
          </div>
          <div class="rm-top">
            <div class="rm-info">
              <div class="rm-cell rm-r-kana">
                <span class="rm-lab">{t.sheetKana}</span>
                <span id="rm-p-name-kana"></span>
              </div>
              <div class="rm-cell rm-r-name">
                <span class="rm-lab">{t.sheetName}</span>
                <span id="rm-p-name" class="rm-name"></span>
              </div>
              <div class="rm-cell rm-r-birth">
                <span class="rm-lab">{t.sheetBirth}</span>
                <span id="rm-p-birth"></span>
              </div>
              <div class="rm-cell rm-r-akana">
                <span class="rm-lab">{t.sheetAddressKana}</span>
                <span id="rm-p-address-kana"></span>
              </div>
              <div class="rm-cell rm-r-addr">
                <span class="rm-lab">{t.sheetAddress}</span>
                <span class="rm-addr-body">
                  <span id="rm-p-postal"></span>
                  <span id="rm-p-address"></span>
                </span>
              </div>
              <div class="rm-cell rm-r-contact">
                <span class="rm-lab">{t.sheetPhone}</span>
                <span id="rm-p-phone"></span>
                <span class="rm-lab">{t.sheetEmail}</span>
                <span id="rm-p-email"></span>
              </div>
            </div>
            <div class="rm-photo">
              <img id="rm-p-photo" hidden alt="" />
              <span id="rm-p-photo-empty" class="rm-photo-empty">
                {t.sheetPhoto}
              </span>
            </div>
          </div>
          <div class="rm-row rm-row-head">
            <span class="rm-c">{t.sheetYear}</span>
            <span class="rm-c">{t.sheetMonth}</span>
            <span class="rm-c">{t.sheetHistory}</span>
          </div>
          <div id="rm-p-history"></div>
        </div>

        <div class="rm-page">
          <div class="rm-row rm-row-head">
            <span class="rm-c">{t.sheetYear}</span>
            <span class="rm-c">{t.sheetMonth}</span>
            <span class="rm-c">{t.sheetLicenses}</span>
          </div>
          <div id="rm-p-licenses"></div>
          <div class="rm-box rm-box-motivation">
            <div class="rm-boxlab">{t.sheetMotivation}</div>
            <div id="rm-p-motivation"></div>
          </div>
          <div class="rm-box rm-box-wishes">
            <div class="rm-boxlab rm-boxlab-long">{t.sheetWishes}</div>
            <div id="rm-p-wishes"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</ToolShell>

<style is:global>
  .rm-sheet {
    color: #000;
    font-family: 'Hiragino Mincho ProN', 'Yu Mincho', 'MS Mincho', serif;
    font-size: 4mm;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    width: max-content;
  }
  .rm-sheet .rm-page {
    box-sizing: border-box;
    position: relative;
    width: 190mm;
    height: 274mm;
    overflow: hidden;
    background: #fff;
    border: 1px solid #9ca3af;
    margin-bottom: 6mm;
  }
  .rm-sheet .rm-page:last-child {
    margin-bottom: 0;
  }
  .rm-sheet .rm-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 12mm;
    padding-bottom: 1mm;
  }
  .rm-sheet .rm-title {
    font-size: 7mm;
    font-weight: 700;
    letter-spacing: 2mm;
    line-height: 1;
  }
  .rm-sheet .rm-date {
    font-size: 3.6mm;
  }
  .rm-sheet .rm-top {
    display: flex;
    height: 74mm;
  }
  .rm-sheet .rm-info {
    box-sizing: border-box;
    width: 140mm;
    border: 0.3mm solid #000;
    border-bottom: 0;
  }
  .rm-sheet .rm-cell {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 3mm;
    padding: 0 2mm;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 0.3mm solid #000;
  }
  .rm-sheet .rm-lab {
    flex: none;
    font-size: 3mm;
  }
  .rm-sheet .rm-r-kana,
  .rm-sheet .rm-r-akana {
    height: 8mm;
    border-bottom-style: dotted;
  }
  .rm-sheet .rm-r-name {
    height: 18mm;
  }
  .rm-sheet .rm-name {
    font-size: 6.5mm;
  }
  .rm-sheet .rm-r-birth {
    height: 10mm;
  }
  .rm-sheet .rm-r-addr {
    height: 20mm;
  }
  .rm-sheet .rm-addr-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .rm-sheet .rm-r-contact {
    height: 10mm;
    font-size: 3.4mm;
  }
  .rm-sheet .rm-photo {
    box-sizing: border-box;
    position: relative;
    flex: none;
    width: 30mm;
    height: 40mm;
    margin-left: auto;
    border: 0.3mm solid #000;
    overflow: hidden;
  }
  .rm-sheet .rm-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rm-sheet .rm-photo-empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1mm;
    font-size: 2.6mm;
    line-height: 1.5;
    text-align: center;
    white-space: pre-line;
    color: #4b5563;
  }
  .rm-sheet .rm-photo img:not([hidden]) + .rm-photo-empty {
    display: none;
  }
  .rm-sheet .rm-row {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 24mm 12mm 1fr;
    height: 8mm;
    border: 0.3mm solid #000;
    border-top: 0;
    line-height: 8mm;
  }
  .rm-sheet .rm-row-head {
    border-top: 0.3mm solid #000;
    text-align: center;
  }
  .rm-sheet .rm-c {
    box-sizing: border-box;
    padding: 0 1.5mm;
    overflow: hidden;
    white-space: nowrap;
    border-right: 0.2mm solid #000;
  }
  .rm-sheet .rm-c:last-child {
    border-right: 0;
  }
  .rm-sheet .rm-row .rm-c:nth-child(1),
  .rm-sheet .rm-row .rm-c:nth-child(2) {
    text-align: center;
  }
  .rm-sheet .rm-heading .rm-c:last-child {
    text-align: center;
    letter-spacing: 3mm;
  }
  .rm-sheet .rm-end .rm-c:last-child {
    text-align: right;
  }
  .rm-sheet .rm-box {
    box-sizing: border-box;
    margin-top: 6mm;
    border: 0.3mm solid #000;
    overflow: hidden;
  }
  .rm-sheet .rm-box-motivation {
    height: 78mm;
  }
  .rm-sheet .rm-box-wishes {
    height: 60mm;
  }
  .rm-sheet .rm-boxlab {
    box-sizing: border-box;
    height: 6mm;
    padding: 0 2mm;
    font-size: 3mm;
    line-height: 6mm;
    white-space: nowrap;
    overflow: hidden;
  }
  .rm-sheet .rm-boxlab-long {
    height: 10mm;
    white-space: normal;
    line-height: 5mm;
  }
  .rm-sheet .rm-line {
    height: 6mm;
    padding: 0 3mm;
    line-height: 6mm;
    white-space: pre;
    overflow: hidden;
  }
  @media print {
    @page {
      size: A4;
      margin: 10mm;
    }
    /* 印刷は書類だけにする（見出し・説明文・使い方・注意事項・FAQなどは出さない） */
    [data-tool-page] > :not(#rm) {
      display: none;
    }
    .rm-sheet .rm-page {
      border: 0;
      margin: 0;
      height: 273mm;
      break-after: page;
    }
    .rm-sheet .rm-page:last-child {
      break-after: auto;
    }
  }
</style>

<script>
  import {
    HISTORY_ROWS,
    LICENSE_ROWS,
    MOTIVATION_LINES,
    WISHES_LINES,
    layoutResume,
    normalizePostal,
    parseStoredResume,
    serializeResume,
    todayIso,
    type EraStyle,
    type Gender,
    type HistoryRow,
    type IssueCode,
    type ResumeData,
    type ResumeIssue,
  } from '../../lib/tools/resume-maker';
  import { enableFileDrop } from '../../lib/file-drop';
  import { fill } from '../../lib/format-template';

  const STORAGE_KEY = 'nyankotools:resume-maker';

  const root = document.getElementById('rm')!;
  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  const f = (id: string) => $<Field>(`rm-${id}`);
  const fields = {
    era: f('era'),
    date: f('date'),
    nameKana: f('name-kana'),
    name: f('name'),
    birth: f('birth'),
    gender: f('gender'),
    postal: f('postal'),
    addressKana: f('address-kana'),
    address: f('address'),
    phone: f('phone'),
    email: f('email'),
    education: f('education'),
    work: f('work'),
    licenses: f('licenses'),
    motivation: f('motivation'),
    wishes: f('wishes'),
  } as const;
  const printButton = $<HTMLButtonElement>('rm-print-button');
  const errorEl = $('rm-error');
  const saveStatus = $('rm-save-status');
  const photoInput = $<HTMLInputElement>('rm-photo-file');
  const photoError = $('rm-photo-error');
  const photoRemove = $<HTMLButtonElement>('rm-photo-remove');
  const photoImg = $<HTMLImageElement>('rm-p-photo');

  function readData(): ResumeData {
    return {
      era: fields.era.value as EraStyle,
      date: fields.date.value,
      nameKana: fields.nameKana.value,
      name: fields.name.value,
      birth: fields.birth.value,
      gender: fields.gender.value as Gender,
      postal: fields.postal.value,
      addressKana: fields.addressKana.value,
      address: fields.address.value,
      phone: fields.phone.value,
      email: fields.email.value,
      education: fields.education.value,
      work: fields.work.value,
      licenses: fields.licenses.value,
      motivation: fields.motivation.value,
      wishes: fields.wishes.value,
    };
  }

  function applyData(d: ResumeData) {
    (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) => {
      fields[k].value = d[k];
    });
  }

  function setText(id: string, text: string) {
    $(id).textContent = text;
  }

  function div(className: string, text = ''): HTMLElement {
    const el = document.createElement('div');
    el.className = className;
    el.textContent = text;
    return el;
  }

  function rowEl(row: HistoryRow | null): HTMLElement {
    const el = div(
      `rm-row${row?.kind === 'heading' ? ' rm-heading' : ''}${row?.kind === 'end' ? ' rm-end' : ''}`,
    );
    for (const text of [row?.year ?? '', row?.month ?? '', row?.text ?? '']) {
      const c = document.createElement('span');
      c.className = 'rm-c';
      c.textContent = text;
      el.append(c);
    }
    return el;
  }

  function renderRows(id: string, rows: HistoryRow[], size: number) {
    const nodes: HTMLElement[] = [];
    for (let i = 0; i < size; i++) nodes.push(rowEl(rows[i] ?? null));
    $(id).replaceChildren(...nodes);
  }

  function renderLines(id: string, lines: string[], size: number) {
    const nodes: HTMLElement[] = [];
    for (let i = 0; i < size; i++) nodes.push(div('rm-line', lines[i] ?? ''));
    $(id).replaceChildren(...nodes);
  }

  const issueKeys: Record<IssueCode, string> = {
    entryDate: 'issueEntryDate',
    history: 'issueHistory',
    licenses: 'issueLicenses',
    motivation: 'issueMotivation',
    wishes: 'issueWishes',
  };

  function issueText(issue: ResumeIssue): string {
    const template = root.dataset[issueKeys[issue.code]] ?? '';
    return fill(template, {
      line: issue.line ?? '',
      limit: String(issue.limit ?? ''),
      actual: String(issue.actual ?? ''),
    });
  }

  function render() {
    const data = readData();
    const layout = layoutResume(data, {
      education: root.dataset.labelEducation ?? '',
      work: root.dataset.labelWork ?? '',
      end: root.dataset.labelEnd ?? '',
    });

    setText(
      'rm-p-date',
      layout.dateText === ''
        ? ''
        : fill(root.dataset.dateTemplate ?? '', { date: layout.dateText }),
    );
    setText('rm-p-name-kana', data.nameKana);
    setText('rm-p-name', data.name);
    const genderText =
      data.gender === ''
        ? ''
        : (fields.gender as HTMLSelectElement).selectedOptions[0]?.textContent;
    const ageText =
      layout.age === null
        ? ''
        : fill(root.dataset.ageTemplate ?? '', { age: String(layout.age) });
    setText(
      'rm-p-birth',
      [layout.birthText, ageText, genderText]
        .filter(Boolean)
        .join(String.fromCharCode(0x3000)),
    );
    setText('rm-p-address-kana', data.addressKana);
    const postal = normalizePostal(data.postal) ?? data.postal.trim();
    setText('rm-p-postal', postal === '' ? '' : `〒${postal}`);
    setText('rm-p-address', data.address);
    setText('rm-p-phone', data.phone);
    setText('rm-p-email', data.email);

    renderRows('rm-p-history', layout.history, HISTORY_ROWS);
    renderRows('rm-p-licenses', layout.licenses, LICENSE_ROWS);
    renderLines('rm-p-motivation', layout.motivation, MOTIVATION_LINES);
    renderLines('rm-p-wishes', layout.wishes, WISHES_LINES);

    errorEl.replaceChildren(
      ...layout.issues.map((issue) => div('', issueText(issue))),
    );
    printButton.disabled = layout.issues.length > 0;
  }

  (Object.values(fields) as Field[]).forEach((el) => {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  // --- 証明写真（保存しない・外部に送らない） ---
  let photoUrl: string | null = null;

  function setPhoto(url: string | null) {
    if (photoUrl) URL.revokeObjectURL(photoUrl);
    photoUrl = url;
    if (url) {
      photoImg.src = url;
      photoImg.hidden = false;
    } else {
      photoImg.removeAttribute('src');
      photoImg.hidden = true;
    }
    photoRemove.hidden = url === null;
  }

  enableFileDrop($('rm-dropzone'), photoInput);
  photoInput.addEventListener('change', async () => {
    const file = photoInput.files?.[0];
    photoInput.value = '';
    if (!file) return;
    photoError.hidden = true;
    try {
      const bitmap = await createImageBitmap(file);
      bitmap.close();
    } catch {
      photoError.textContent = root.dataset.photoError ?? '';
      photoError.hidden = false;
      return;
    }
    setPhoto(URL.createObjectURL(file));
  });
  photoRemove.addEventListener('click', () => {
    setPhoto(null);
    photoError.hidden = true;
  });

  // --- ブラウザへの保存（ボタンを押したときだけ書き込む） ---
  $('rm-save-button').addEventListener('click', () => {
    try {
      localStorage.setItem(STORAGE_KEY, serializeResume(readData()));
      saveStatus.textContent = root.dataset.saved ?? '';
    } catch {
      saveStatus.textContent = root.dataset.savedFail ?? '';
    }
  });
  $('rm-clear-button').addEventListener('click', () => {
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // 保存領域が使えない場合は何もしない
    }
    saveStatus.textContent = root.dataset.cleared ?? '';
  });

  printButton.addEventListener('click', () => window.print());

  // 初期値: 保存データがあれば読み込み、なければ提出日を今日にする
  function loadStored(): ResumeData | null {
    try {
      return parseStoredResume(localStorage.getItem(STORAGE_KEY));
    } catch {
      return null;
    }
  }
  const stored = loadStored();
  if (stored) {
    applyData(stored);
    saveStatus.textContent = root.dataset.loaded ?? '';
  } else {
    fields.date.value = todayIso();
  }
  render();
</script>
