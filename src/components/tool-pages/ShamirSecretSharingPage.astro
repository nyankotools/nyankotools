---
import ToolShell from '../ToolShell.astro';
import { shamirSecretSharingContent } from '../../i18n/tools/shamir-secret-sharing';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = shamirSecretSharingContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <div id="shamir-mode" class="ui-seg" role="group" aria-label={t.modeLabel}>
      <button
        type="button"
        data-mode="split"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modeSplit}
      </button>
      <button
        type="button"
        data-mode="combine"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeCombine}
      </button>
    </div>
  </div>

  <div id="shamir-split-panel" class="mt-4">
    <label for="shamir-secret" class="ui-label">
      {t.secretLabel}
    </label>
    <textarea
      id="shamir-secret"
      class="ui-input h-32 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.secretPlaceholder}
      autocomplete="off"
      spellcheck="false"
    ></textarea>
    <div class="mt-4 flex flex-wrap gap-4">
      <div>
        <label for="shamir-count" class="ui-label">
          {t.countLabel}
        </label>
        <input
          id="shamir-count"
          type="number"
          inputmode="numeric"
          min="2"
          max="255"
          step="1"
          value="5"
          class="ui-input h-11 w-24 px-3 dark:bg-gray-900"
        />
      </div>
      <div>
        <label for="shamir-threshold" class="ui-label">
          {t.thresholdLabel}
        </label>
        <input
          id="shamir-threshold"
          type="number"
          inputmode="numeric"
          min="2"
          max="255"
          step="1"
          value="3"
          class="ui-input h-11 w-24 px-3 dark:bg-gray-900"
        />
      </div>
    </div>
  </div>

  <div id="shamir-combine-panel" class="mt-4" hidden>
    <label for="shamir-shares-input" class="ui-label">
      {t.sharesInputLabel}
    </label>
    <textarea
      id="shamir-shares-input"
      class="ui-input h-40 w-full p-4 font-mono text-sm dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.sharesInputPlaceholder}
      autocomplete="off"
      spellcheck="false"
      wrap="off"
    ></textarea>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      id="shamir-run-button"
      type="button"
      data-label-split={t.runSplit}
      data-label-combine={t.runCombine}
      class="ui-btn ui-btn-primary"
    >
      {t.runSplit}
    </button>
  </div>

  <p
    id="shamir-error"
    hidden
    data-empty-secret={t.errEmptySecret}
    data-count={t.errCount}
    data-threshold={t.errThreshold}
    data-threshold-exceeds={t.errThresholdExceeds}
    data-no-shares={t.errNoShares}
    data-format={t.errFormat}
    data-length={t.errLength}
    data-duplicate={t.errDuplicate}
    data-threshold-mismatch={t.errThresholdMismatch}
    data-not-enough={t.errNotEnough}
    data-corrupted={t.errCorrupted}
    class="ui-error mt-4 max-w-2xl"
    role="alert"
  ></p>

  <div class="mt-4">
    <label
      for="shamir-output"
      id="shamir-output-label"
      class="ui-label"
      data-label-split={t.outputLabelSplit}
      data-label-combine={t.outputLabelCombine}
    >
      {t.outputLabelSplit}
    </label>
    <textarea
      id="shamir-output"
      readonly
      wrap="off"
      class="ui-input h-40 w-full bg-gray-50 p-4 font-mono text-sm dark:bg-gray-900"
    ></textarea>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <button
        id="shamir-copy-button"
        type="button"
        data-copied={t.copied}
        data-copy-failed={t.copyFailed}
        class="ui-btn"
      >
        {t.copy}
      </button>
      <span
        id="shamir-status"
        class="text-sm text-green-700 dark:text-green-400"
        aria-live="polite"
        data-split-done={t.splitDone}
        data-combine-done={t.combineDone}
      ></span>
    </div>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    combineShares,
    splitSecret,
    splitShareLines,
  } from '../../lib/tools/shamir-secret-sharing';

  type Mode = 'split' | 'combine';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(`shamir-${id}`) as T;
  const secret = $<HTMLTextAreaElement>('secret');
  const count = $<HTMLInputElement>('count');
  const threshold = $<HTMLInputElement>('threshold');
  const sharesInput = $<HTMLTextAreaElement>('shares-input');
  const splitPanel = $<HTMLElement>('split-panel');
  const combinePanel = $<HTMLElement>('combine-panel');
  const runButton = $<HTMLButtonElement>('run-button');
  const output = $<HTMLTextAreaElement>('output');
  const outputLabel = $<HTMLElement>('output-label');
  const errorEl = $<HTMLElement>('error');
  const statusEl = $<HTMLElement>('status');
  const copyButton = $<HTMLButtonElement>('copy-button');
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#shamir-mode [data-mode]',
  );

  let mode: Mode = 'split';

  function showError(key: string, index?: number) {
    output.value = '';
    errorEl.textContent = (errorEl.dataset[key] ?? '').replace(
      '{n}',
      String((index ?? 0) + 1),
    );
    errorEl.hidden = false;
  }

  function resetResult() {
    output.value = '';
    errorEl.hidden = true;
    statusEl.textContent = '';
  }

  function applyMode(next: Mode) {
    mode = next;
    modeButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.mode === next)),
    );
    splitPanel.hidden = next !== 'split';
    combinePanel.hidden = next !== 'combine';
    runButton.textContent =
      (next === 'split'
        ? runButton.dataset.labelSplit
        : runButton.dataset.labelCombine) ?? '';
    outputLabel.textContent =
      (next === 'split'
        ? outputLabel.dataset.labelSplit
        : outputLabel.dataset.labelCombine) ?? '';
    resetResult();
  }

  modeButtons.forEach((button) => {
    button.addEventListener('click', () =>
      applyMode(button.dataset.mode as Mode),
    );
  });

  const splitErrors = {
    'empty-secret': 'emptySecret',
    'invalid-count': 'count',
    'invalid-threshold': 'threshold',
    'threshold-exceeds-count': 'thresholdExceeds',
  } as const;

  const combineErrors = {
    'no-shares': 'noShares',
    'invalid-format': 'format',
    'length-mismatch': 'length',
    'duplicate-x': 'duplicate',
    'threshold-mismatch': 'thresholdMismatch',
    'not-enough-shares': 'notEnough',
    corrupted: 'corrupted',
  } as const;

  runButton.addEventListener('click', () => {
    resetResult();
    if (mode === 'split') {
      const result = splitSecret(
        secret.value,
        count.value.trim() === '' ? NaN : Number(count.value),
        threshold.value.trim() === '' ? NaN : Number(threshold.value),
      );
      if (result.success) {
        output.value = result.shares.join('\n');
        statusEl.textContent = statusEl.dataset.splitDone ?? '';
      } else {
        showError(splitErrors[result.error]);
      }
    } else {
      const result = combineShares(splitShareLines(sharesInput.value));
      if (result.success) {
        output.value = result.secret;
        statusEl.textContent = statusEl.dataset.combineDone ?? '';
      } else {
        showError(combineErrors[result.error], result.index);
      }
    }
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });
</script>
