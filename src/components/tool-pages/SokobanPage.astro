---
import ToolShell from '../ToolShell.astro';
import { sokobanContent } from '../../i18n/tools/sokoban';
import { LEVELS } from '../../lib/tools/sokoban';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = sokobanContent[locale];
const levelNumbers = LEVELS.map((_, i) => i + 1);
---

<ToolShell t={t}>
  <section
    id="sk-root"
    data-level-option={t.levelOption}
    data-level-option-cleared={t.levelOptionCleared}
    data-best-none={t.bestNone}
    data-board-label={t.boardLabel}
    data-board-summary={t.boardSummary}
    data-status-playing={t.statusPlaying}
    data-status-cleared={t.statusCleared}
    data-status-new-best={t.statusNewBest}
    data-status-best-kept={t.statusBestKept}
    data-status-last-cleared={t.statusLastCleared}
  >
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="sk-level" class="ui-label">
          {t.levelLabel}
        </label>
        <select
          id="sk-level"
          class="ui-input h-11 w-auto bg-white px-3 dark:bg-gray-900"
        >
          {levelNumbers.map((n, i) => (
            <option value={String(i)}>
              {t.levelOption.replace('{n}', String(n))}
            </option>
          ))}
        </select>
      </div>
      <button id="sk-prev-button" type="button" class="ui-btn">
        {t.prevButton}
      </button>
      <button id="sk-next-button" type="button" class="ui-btn">
        {t.nextButton}
      </button>
    </div>

    <dl class="mt-3 grid max-w-md grid-cols-2 gap-x-4 gap-y-1 text-sm text-gray-700 sm:grid-cols-4 dark:text-gray-300">
      <div>
        <dt>{t.movesLabel}</dt>
        <dd id="sk-moves" class="text-lg font-bold tabular-nums">
          0
        </dd>
      </div>
      <div>
        <dt>{t.pushesLabel}</dt>
        <dd id="sk-pushes" class="text-lg font-bold tabular-nums">
          0
        </dd>
      </div>
      <div>
        <dt>{t.boxesLabel}</dt>
        <dd id="sk-boxes" class="text-lg font-bold tabular-nums">
          0
        </dd>
      </div>
      <div>
        <dt>{t.bestLabel}</dt>
        <dd id="sk-best" class="text-lg font-bold tabular-nums">
          {t.bestNone}
        </dd>
      </div>
    </dl>

    <div
      id="sk-board"
      role="img"
      aria-label={t.boardLabel}
      class="mt-3 grid w-full max-w-md touch-none select-none"
    ></div>

    <div
      class="mt-3 grid w-40 grid-cols-3 gap-1"
      role="group"
      aria-label={t.dpadLabel}
    >
      <span></span>
      <button
        type="button"
        class="ui-btn h-12 justify-center"
        data-dir="up"
        aria-label={t.dpadUp}
      >
        ↑
      </button>
      <span></span>
      <button
        type="button"
        class="ui-btn h-12 justify-center"
        data-dir="left"
        aria-label={t.dpadLeft}
      >
        ←
      </button>
      <button
        type="button"
        class="ui-btn h-12 justify-center"
        data-dir="down"
        aria-label={t.dpadDown}
      >
        ↓
      </button>
      <button
        type="button"
        class="ui-btn h-12 justify-center"
        data-dir="right"
        aria-label={t.dpadRight}
      >
        →
      </button>
    </div>

    <div class="mt-3 flex flex-wrap gap-3">
      <button id="sk-undo-button" type="button" class="ui-btn" disabled>
        {t.undoButton}
      </button>
      <button id="sk-reset-button" type="button" class="ui-btn">
        {t.resetButton}
      </button>
    </div>

    <p
      id="sk-status"
      role="status"
      class="mt-3 min-h-6 text-sm font-medium text-gray-800 dark:text-gray-200"
    ></p>
  </section>
</ToolShell>

<script>
  import {
    LEVELS,
    boxesOnGoal,
    directionFromDelta,
    directionFromKey,
    isSolved,
    moveCount,
    newGame,
    parseLevel,
    parseRecords,
    pushCount,
    serializeRecords,
    step,
    undo,
    updateRecord,
    type Direction,
    type GameState,
    type ParsedLevel,
    type Records,
  } from '../../lib/tools/sokoban';

  const STORAGE_KEY = 'nyankotools:sokoban:records';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const root = $('sk-root');
  const msg = root.dataset;
  const boardEl = $('sk-board');
  const statusEl = $('sk-status');
  const levelSelect = $<HTMLSelectElement>('sk-level');
  const prevBtn = $<HTMLButtonElement>('sk-prev-button');
  const nextBtn = $<HTMLButtonElement>('sk-next-button');
  const undoBtn = $<HTMLButtonElement>('sk-undo-button');

  function fill(template: string | undefined, values: Record<string, string>) {
    return (template ?? '').replace(/\{(\w+)\}/g, (match, key: string) =>
      Object.hasOwn(values, key) ? values[key] : match,
    );
  }

  // localStorageが使えない環境では、このページを開いている間だけの記録にする
  let records: Records = (() => {
    try {
      return parseRecords(localStorage.getItem(STORAGE_KEY), LEVELS.length);
    } catch {
      return {};
    }
  })();

  function saveRecords() {
    try {
      localStorage.setItem(STORAGE_KEY, serializeRecords(records));
    } catch {
      // 保存できない環境では何もしない
    }
  }

  const parsedLevels: ParsedLevel[] = LEVELS.map((rows) => parseLevel(rows));
  let level = 0;
  let parsed: ParsedLevel = parsedLevels[0];
  let state: GameState = newGame(parsed);
  let cleared = false;
  let resultText = '';
  let cells: HTMLDivElement[] = [];

  const BASE =
    'flex aspect-square min-w-0 items-center justify-center text-sm font-bold sm:text-xl';
  const TONE_WALL = 'rounded-sm bg-gray-700 dark:bg-gray-500';
  const TONE_VOID = '';
  const TONE_FLOOR = 'bg-gray-100 dark:bg-gray-800';
  const TONE_GOAL =
    'bg-gray-100 text-green-800 dark:bg-gray-800 dark:text-green-300';
  const PIECE_BASE =
    'flex h-full w-full items-center justify-center rounded-md border-2';
  const PIECE_BOX = 'border-amber-700 bg-amber-400 text-amber-950';
  const PIECE_BOX_GOAL = 'border-green-800 bg-green-500 text-green-950';
  const PIECE_PLAYER =
    'rounded-full border-blue-950 bg-blue-700 text-white dark:border-blue-200';

  function updateOptions() {
    Array.from(levelSelect.options).forEach((opt, i) => {
      const template =
        records[i] !== undefined ? msg.levelOptionCleared : msg.levelOption;
      opt.textContent = fill(template, { n: String(i + 1) });
    });
  }

  function buildBoard() {
    const { puzzle } = parsed;
    boardEl.replaceChildren();
    boardEl.style.gridTemplateColumns = `repeat(${puzzle.width}, minmax(0, 1fr))`;
    cells = [];
    for (let i = 0; i < puzzle.width * puzzle.height; i++) {
      const cell = document.createElement('div');
      boardEl.append(cell);
      cells.push(cell);
    }
  }

  /** 壁は、床に隣接するものだけを描く（外側の余白は描かない） */
  function nearFloor(index: number): boolean {
    const { puzzle } = parsed;
    const r = Math.floor(index / puzzle.width);
    const c = index % puzzle.width;
    for (let dr = -1; dr <= 1; dr++) {
      for (let dc = -1; dc <= 1; dc++) {
        const nr = r + dr;
        const nc = c + dc;
        if (nr < 0 || nr >= puzzle.height || nc < 0 || nc >= puzzle.width)
          continue;
        if (!puzzle.walls[nr * puzzle.width + nc]) return true;
      }
    }
    return false;
  }

  function render() {
    const { puzzle } = parsed;
    cells.forEach((cell, i) => {
      let tone = TONE_FLOOR;
      let glyph = '';
      let piece = '';
      if (puzzle.walls[i]) {
        tone = nearFloor(i) ? TONE_WALL : TONE_VOID;
      } else if (i === state.player) {
        piece = `${PIECE_BASE} ${PIECE_PLAYER}`;
      } else if (state.boxes.includes(i)) {
        piece = `${PIECE_BASE} ${puzzle.goals[i] ? PIECE_BOX_GOAL : PIECE_BOX}`;
      } else if (puzzle.goals[i]) {
        tone = TONE_GOAL;
        glyph = '○';
      } else {
        tone = TONE_FLOOR;
      }
      cell.className = `${BASE} ${tone}`;
      if (piece) {
        const span = document.createElement('span');
        span.className = piece;
        cell.replaceChildren(span);
      } else {
        cell.textContent = glyph;
      }
    });

    const on = boxesOnGoal(puzzle, state);
    $('sk-moves').textContent = String(moveCount(state));
    $('sk-pushes').textContent = String(pushCount(state));
    $('sk-boxes').textContent = `${on}/${state.boxes.length}`;
    $('sk-best').textContent =
      records[level] !== undefined
        ? String(records[level])
        : (msg.bestNone ?? '');
    boardEl.setAttribute(
      'aria-label',
      `${msg.boardLabel ?? ''} ${fill(msg.boardSummary, {
        on: String(on),
        total: String(state.boxes.length),
      })}`,
    );
    undoBtn.disabled = state.history.length === 0;
    prevBtn.disabled = level <= 0;
    nextBtn.disabled = level >= LEVELS.length - 1;
    statusEl.textContent = cleared ? resultText : (msg.statusPlaying ?? '');
  }

  function loadLevel(index: number) {
    level = Math.min(Math.max(index, 0), LEVELS.length - 1);
    parsed = parsedLevels[level];
    state = newGame(parsed);
    cleared = false;
    resultText = '';
    levelSelect.value = String(level);
    buildBoard();
    render();
  }

  function onCleared() {
    const moves = moveCount(state);
    const result = updateRecord(records, level, moves);
    records = result.records;
    if (result.isNewBest) saveRecords();
    updateOptions();
    cleared = true;
    resultText = result.isNewBest
      ? fill(msg.statusNewBest, { moves: String(moves) })
      : fill(msg.statusBestKept, { best: String(records[level]) });
    if (level === LEVELS.length - 1) {
      resultText += ` ${msg.statusLastCleared ?? ''}`;
    }
  }

  function move(dir: Direction) {
    if (cleared) return;
    const next = step(parsed.puzzle, state, dir);
    if (next === state) return;
    state = next;
    if (isSolved(parsed.puzzle, state)) onCleared();
    render();
  }

  // キーボード
  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const target = e.target as HTMLElement | null;
    if (
      target &&
      (target.closest('input, textarea, select') || target.isContentEditable)
    ) {
      return;
    }
    const dir = directionFromKey(e.key);
    if (!dir) return;
    e.preventDefault();
    move(dir);
  });

  // スワイプ
  let swipeStart: { x: number; y: number } | null = null;
  boardEl.addEventListener('pointerdown', (e) => {
    swipeStart = { x: e.clientX, y: e.clientY };
  });
  boardEl.addEventListener('pointerup', (e) => {
    if (!swipeStart) return;
    const dir = directionFromDelta(
      e.clientX - swipeStart.x,
      e.clientY - swipeStart.y,
    );
    swipeStart = null;
    if (dir) move(dir);
  });
  boardEl.addEventListener('pointercancel', () => {
    swipeStart = null;
  });

  // 方向ボタン
  root
    .querySelectorAll<HTMLButtonElement>('[data-dir]')
    .forEach((b) =>
      b.addEventListener('click', () => move(b.dataset.dir as Direction)),
    );

  undoBtn.addEventListener('click', () => {
    state = undo(parsed.puzzle, state);
    cleared = false;
    resultText = '';
    render();
  });
  $('sk-reset-button').addEventListener('click', () => loadLevel(level));
  prevBtn.addEventListener('click', () => loadLevel(level - 1));
  nextBtn.addEventListener('click', () => loadLevel(level + 1));
  levelSelect.addEventListener('change', () =>
    loadLevel(Number(levelSelect.value)),
  );

  updateOptions();
  loadLevel(0);
</script>
