---
import ToolShell from '../ToolShell.astro';
import { sqlFormatterContent } from '../../i18n/tools/sql-formatter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = sqlFormatterContent[locale];
---

<ToolShell t={t}>
  <div
    id="sql-formatter-controls"
    class="flex flex-wrap items-center gap-3"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-error-template={t.errorTemplate}
  >
    <label
      for="sql-formatter-dialect"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.dialectLabel}
    </label>
    <select
      id="sql-formatter-dialect"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.dialectOptions.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>

    <label
      for="sql-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.indentLabel}
    </label>
    <select
      id="sql-formatter-indent"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.indentOptions.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>

    <label
      for="sql-formatter-keyword-case"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.keywordCaseLabel}
    </label>
    <select
      id="sql-formatter-keyword-case"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      {t.keywordCaseOptions.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>

    <button id="sql-formatter-minify-button" type="button" class="ui-btn">
      {t.minifyButton}
    </button>
    <button id="sql-formatter-copy-button" type="button" class="ui-btn">
      {t.copyButton}
    </button>
    <span
      id="sql-formatter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="sql-formatter-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="sql-formatter-input"
        class="ui-input h-80 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="sql-formatter-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="sql-formatter-output"
        readonly
        class="ui-input h-80 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <p
    id="sql-formatter-error"
    hidden
    class="ui-error mt-4 max-w-2xl whitespace-pre-line"
  ></p>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    formatSqlQuery,
    minifySqlQuery,
    type SqlDialect,
    type SqlKeywordCase,
  } from '../../lib/tools/sql-formatter';

  const controls = document.getElementById('sql-formatter-controls')!;
  const copied = controls.dataset.copied ?? '';
  const copyFailed = controls.dataset.copyFailed ?? '';
  const errorTemplate = controls.dataset.errorTemplate ?? '';

  const input = document.getElementById(
    'sql-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'sql-formatter-output',
  ) as HTMLTextAreaElement;
  const dialectSelect = document.getElementById(
    'sql-formatter-dialect',
  ) as HTMLSelectElement;
  const indentSelect = document.getElementById(
    'sql-formatter-indent',
  ) as HTMLSelectElement;
  const keywordCaseSelect = document.getElementById(
    'sql-formatter-keyword-case',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('sql-formatter-minify-button')!;
  const copyButton = document.getElementById('sql-formatter-copy-button')!;
  const statusEl = document.getElementById('sql-formatter-status')!;
  const errorEl = document.getElementById('sql-formatter-error')!;

  function getIndentOptions(): { tabWidth: number; useTabs: boolean } {
    if (indentSelect.value === 'tab') {
      return { tabWidth: 2, useTabs: true };
    }
    return { tabWidth: Number(indentSelect.value), useTabs: false };
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = errorTemplate.replace('{message}', message);
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function format() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const { tabWidth, useTabs } = getIndentOptions();
    const result = formatSqlQuery(input.value, {
      dialect: dialectSelect.value as SqlDialect,
      tabWidth,
      useTabs,
      keywordCase: keywordCaseSelect.value as SqlKeywordCase,
    });
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  function minify() {
    statusEl.textContent = '';
    showOutput(minifySqlQuery(input.value, dialectSelect.value as SqlDialect));
  }

  input.addEventListener('input', format);
  dialectSelect.addEventListener('change', format);
  indentSelect.addEventListener('change', format);
  keywordCaseSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value)) ? copied : copyFailed;
  });

  format();
</script>
