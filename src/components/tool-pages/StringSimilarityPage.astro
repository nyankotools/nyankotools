---
import ToolShell from '../ToolShell.astro';
import { stringSimilarityContent } from '../../i18n/tools/string-similarity';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringSimilarityContent[locale];
---

<ToolShell t={t}>
  <div
    id="ss-root"
    data-lengths-template={t.lengthsTemplate}
    data-ops-template={t.opsTemplate}
    data-truncated-template={t.truncatedTemplate}
    data-too-long-template={t.tooLongTemplate}
    data-op-equal={t.opEqual}
    data-op-insert={t.opInsert}
    data-op-delete={t.opDelete}
    data-op-replace={t.opReplace}
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="ss-input-a" class="ui-label">
          {t.inputALabel}
        </label>
        <textarea
          id="ss-input-a"
          class="ui-input h-40 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
          placeholder={t.inputPlaceholder}
          spellcheck="false"
          data-no-count
        ></textarea>
      </div>
      <div>
        <label for="ss-input-b" class="ui-label">
          {t.inputBLabel}
        </label>
        <textarea
          id="ss-input-b"
          class="ui-input h-40 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
          placeholder={t.inputPlaceholder}
          spellcheck="false"
          data-no-count
        ></textarea>
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <label class="flex min-h-11 items-center gap-2">
        <span class="text-gray-700 dark:text-gray-300">{t.unitLabel}</span>
        <select id="ss-unit" class="ui-input h-11 px-2 dark:bg-gray-900">
          <option value="codepoint">{t.unitCodepoint}</option>
          <option value="grapheme">{t.unitGrapheme}</option>
        </select>
      </label>
      <label class="flex min-h-11 items-center gap-2">
        <input id="ss-ignore-case" type="checkbox" class="h-4 w-4" />
        <span class="text-gray-700 dark:text-gray-300">{t.ignoreCase}</span>
      </label>
    </div>

    <p id="ss-message" class="ui-error mt-3 hidden" role="alert"></p>
    <p id="ss-empty" class="mt-4 text-sm text-gray-600 dark:text-gray-400">
      {t.emptyHint}
    </p>

    <div id="ss-result" class="hidden" aria-live="polite">
      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.statDistance}
          </dt>
          <dd id="ss-distance" class="text-2xl font-semibold"></dd>
        </div>
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.statSimilarity}
          </dt>
          <dd id="ss-similarity" class="text-2xl font-semibold"></dd>
        </div>
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.statDamerau}
          </dt>
          <dd id="ss-damerau" class="text-lg font-semibold"></dd>
        </div>
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.statJaroWinkler}
          </dt>
          <dd id="ss-jw" class="text-lg font-semibold"></dd>
        </div>
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">
            {t.statLengths}
          </dt>
          <dd id="ss-lengths" class="text-sm"></dd>
        </div>
        <div class="rounded-lg border border-gray-300 p-3 dark:border-gray-700">
          <dt class="text-sm text-gray-600 dark:text-gray-400">{t.statOps}</dt>
          <dd id="ss-breakdown" class="text-sm"></dd>
        </div>
      </dl>

      <h2 class="mt-6 text-lg font-semibold">{t.diffHeading}</h2>
      <p class="mt-1 flex flex-wrap gap-x-4 text-xs">
        <span class="bg-red-50 px-1 text-red-800 dark:bg-red-950 dark:text-red-300">
          {t.legendDelete}
        </span>
        <span class="bg-green-50 px-1 text-green-800 dark:bg-green-950 dark:text-green-300">
          {t.legendInsert}
        </span>
        <span class="bg-amber-50 px-1 text-amber-900 dark:bg-amber-950 dark:text-amber-200">
          {t.legendReplace}
        </span>
      </p>
      <div
        id="ss-diff"
        class="mt-2 rounded-lg border border-gray-300 p-3 font-mono text-sm break-all whitespace-pre-wrap dark:border-gray-700"
      ></div>

      <h2 class="mt-6 text-lg font-semibold">{t.opsHeading}</h2>
      <div class="mt-2 overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
        <table class="w-full min-w-[360px] text-left text-sm">
          <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <tr>
              <th class="px-3 py-2 font-medium">{t.columnOp}</th>
              <th class="px-3 py-2 font-medium">{t.columnFrom}</th>
              <th class="px-3 py-2 font-medium">{t.columnTo}</th>
            </tr>
          </thead>
          <tbody id="ss-ops-body" class="font-mono"></tbody>
        </table>
      </div>
      <p
        id="ss-truncated"
        class="mt-2 hidden text-sm text-gray-600 dark:text-gray-400"
      ></p>
    </div>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import {
    compareStrings,
    groupOps,
    type CompareUnit,
    type EditOpType,
  } from '../../lib/tools/string-similarity';

  const root = document.getElementById('ss-root')!;
  const inputA = document.getElementById('ss-input-a') as HTMLTextAreaElement;
  const inputB = document.getElementById('ss-input-b') as HTMLTextAreaElement;
  const unitEl = document.getElementById('ss-unit') as HTMLSelectElement;
  const ignoreCase = document.getElementById(
    'ss-ignore-case',
  ) as HTMLInputElement;
  const messageEl = document.getElementById('ss-message')!;
  const emptyEl = document.getElementById('ss-empty')!;
  const resultEl = document.getElementById('ss-result')!;
  const diffEl = document.getElementById('ss-diff')!;
  const bodyEl = document.getElementById('ss-ops-body')!;
  const truncatedEl = document.getElementById('ss-truncated')!;
  const ds = root.dataset;
  const MAX_ROWS = 200;

  const text = (id: string, value: string) => {
    document.getElementById(id)!.textContent = value;
  };
  const fill = (tpl: string | undefined, vars: Record<string, string>) =>
    Object.entries(vars).reduce(
      (s, [k, v]) => s.split(`{${k}}`).join(v),
      tpl ?? '',
    );
  const opLabel: Record<EditOpType, string | undefined> = {
    equal: ds.opEqual,
    insert: ds.opInsert,
    delete: ds.opDelete,
    replace: ds.opReplace,
  };
  const spanClass: Record<EditOpType, string> = {
    equal: '',
    insert: 'bg-green-50 text-green-800 dark:bg-green-950 dark:text-green-300',
    delete:
      'bg-red-50 text-red-800 line-through dark:bg-red-950 dark:text-red-300',
    replace: 'bg-amber-50 text-amber-900 dark:bg-amber-950 dark:text-amber-200',
  };

  function makeSpan(type: EditOpType, value: string): HTMLElement {
    const span = document.createElement('span');
    span.className = spanClass[type];
    span.textContent = value;
    return span;
  }

  function render() {
    const a = inputA.value;
    const b = inputB.value;
    messageEl.classList.add('hidden');
    if (a === '' && b === '') {
      emptyEl.classList.remove('hidden');
      resultEl.classList.add('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    const r = compareStrings(a, b, {
      unit: unitEl.value as CompareUnit,
      ignoreCase: ignoreCase.checked,
    });
    if (!r.ok) {
      resultEl.classList.add('hidden');
      messageEl.textContent = fill(ds.tooLongTemplate, {
        max: String(r.maxUnits),
        a: String(r.lengthA),
        b: String(r.lengthB),
      });
      messageEl.classList.remove('hidden');
      return;
    }
    resultEl.classList.remove('hidden');
    text('ss-distance', String(r.distance));
    text('ss-damerau', String(r.damerauDistance));
    text('ss-similarity', `${(r.similarity * 100).toFixed(1)}%`);
    text('ss-jw', `${(r.jaroWinkler * 100).toFixed(1)}%`);
    text(
      'ss-lengths',
      fill(ds.lengthsTemplate, {
        a: String(r.lengthA),
        b: String(r.lengthB),
      }),
    );
    text(
      'ss-breakdown',
      fill(ds.opsTemplate, {
        ins: String(r.insertions),
        del: String(r.deletions),
        sub: String(r.substitutions),
      }),
    );

    const runs = groupOps(r.ops);
    // インライン表示: 一致はそのまま、削除はA側、挿入はB側、置換は A→B の順
    diffEl.replaceChildren();
    for (const run of runs) {
      if (run.type === 'equal') {
        diffEl.append(document.createTextNode(run.b));
      } else if (run.type === 'replace') {
        diffEl.append(makeSpan('delete', run.a), makeSpan('insert', run.b));
      } else if (run.type === 'delete') {
        diffEl.append(makeSpan('delete', run.a));
      } else {
        diffEl.append(makeSpan('insert', run.b));
      }
    }

    // 一致以外の操作を表で一覧する
    bodyEl.replaceChildren();
    const changes = runs.filter((x) => x.type !== 'equal');
    for (const run of changes.slice(0, MAX_ROWS)) {
      const tr = document.createElement('tr');
      const cells = [`${opLabel[run.type] ?? ''} ×${run.count}`, run.a, run.b];
      for (const value of cells) {
        const td = document.createElement('td');
        td.className = 'px-3 py-1 whitespace-pre-wrap break-all';
        td.textContent = value;
        tr.append(td);
      }
      bodyEl.append(tr);
    }
    if (changes.length > MAX_ROWS) {
      truncatedEl.textContent = fill(ds.truncatedTemplate, {
        shown: String(MAX_ROWS),
        total: String(changes.length),
      });
      truncatedEl.classList.remove('hidden');
    } else {
      truncatedEl.classList.add('hidden');
    }
  }

  onTextInput(inputA, render, { watch: [inputB] });
  onTextInput(inputB, render, { watch: [inputA] });
  unitEl.addEventListener('change', render);
  ignoreCase.addEventListener('change', render);

  render();
</script>
