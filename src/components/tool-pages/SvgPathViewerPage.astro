---
import ToolShell from '../ToolShell.astro';
import { svgPathViewerContent } from '../../i18n/tools/svg-path-viewer';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = svgPathViewerContent[locale];
---

<ToolShell t={t}>
  <div
    id="pv-root"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-preview-label={t.previewLabel}
    data-relative={t.relativeBadge}
    data-select={t.selectButton}
    data-stats={t.optimizedStats}
    data-errors={JSON.stringify(t.errors)}
    data-command-names={JSON.stringify(t.commandNames)}
  >
    <div class="mb-6">
      <label for="pv-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="pv-input"
        rows="5"
        spellcheck="false"
        autocomplete="off"
        class="ui-input w-full min-w-0 resize-y p-3 font-mono text-sm break-all dark:bg-gray-900"
      ></textarea>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <button id="pv-sample-button" type="button" class="ui-btn">
          {t.sampleText}
        </button>
        <button id="pv-copy-button" type="button" class="ui-btn">
          {t.copyButton}
        </button>
        <label class="flex items-center gap-2 text-sm">
          <input id="pv-controls" type="checkbox" checked class="ui-check" />
          {t.controlsLabel}
        </label>
        <span
          id="pv-status"
          class="text-sm text-green-700 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
      <p id="pv-error" role="alert" hidden class="ui-error mt-3 max-w-2xl"></p>
    </div>

    <div id="pv-result">
      <h2 class="mb-2 text-lg font-bold">{t.previewHeading}</h2>
      <div
        id="pv-preview"
        class="mb-2 overflow-hidden rounded-lg border border-gray-300 bg-white p-2 dark:border-gray-700 [&>svg]:mx-auto [&>svg]:block [&>svg]:h-auto [&>svg]:max-h-96 [&>svg]:w-full"
      ></div>
      <ul class="mb-6 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full bg-green-700"></span>
          {t.legendStart}
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full bg-gray-900 dark:bg-gray-100"></span>
          {t.legendAnchor}
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full bg-orange-700"></span>
          {t.legendControl}
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 rounded-full border-2 border-orange-700"></span>
          {t.legendImplicit}
        </li>
      </ul>

      <h2 class="mb-1 text-lg font-bold">{t.optimizeHeading}</h2>
      <div class="mb-6 flex flex-wrap items-end gap-4">
        <label class="text-sm">
          <span class="mb-1 block">{t.precisionLabel}</span>
          <input
            id="pv-precision"
            type="number"
            min="0"
            max="8"
            step="1"
            value="2"
            class="ui-input h-11 w-24 px-3 dark:bg-gray-900"
          />
        </label>
        <label class="flex h-11 items-center gap-2 text-sm">
          <input id="pv-absolute" type="checkbox" class="ui-check" />
          {t.absoluteLabel}
        </label>
        <button
          id="pv-optimize-button"
          type="button"
          class="ui-btn ui-btn-primary"
        >
          {t.optimizeButton}
        </button>
        <p
          id="pv-optimize-stats"
          class="text-sm font-medium"
          aria-live="polite"
        ></p>
      </div>

      <h2 class="mb-1 text-lg font-bold">{t.segmentsHeading}</h2>
      <p class="mb-3 text-sm text-gray-600 dark:text-gray-400">
        {t.segmentsHint}
      </p>
      <ol id="pv-segments" class="space-y-2"></ol>
    </div>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    SAMPLE_PATH,
    argLabels,
    buildOverlaySvg,
    optimizePath,
    parsePath,
    updateSegmentArg,
    type PathSegment,
  } from '../../lib/tools/svg-path-viewer';

  const root = document.getElementById('pv-root')!;
  const input = document.getElementById('pv-input') as HTMLTextAreaElement;
  const controls = document.getElementById('pv-controls') as HTMLInputElement;
  const precision = document.getElementById('pv-precision') as HTMLInputElement;
  const absolute = document.getElementById('pv-absolute') as HTMLInputElement;
  const preview = document.getElementById('pv-preview')!;
  const result = document.getElementById('pv-result')!;
  const errorEl = document.getElementById('pv-error')!;
  const list = document.getElementById('pv-segments')!;
  const statsEl = document.getElementById('pv-optimize-stats')!;
  const statusEl = document.getElementById('pv-status')!;

  const errors = JSON.parse(root.dataset.errors!) as Record<string, string>;
  const names = JSON.parse(root.dataset.commandNames!) as Record<
    string,
    string
  >;

  let selected: number | null = null;
  let segments: PathSegment[] = [];
  let internalEdit = false;

  function drawPreview() {
    preview.innerHTML = buildOverlaySvg(segments, {
      selected,
      label: root.dataset.previewLabel!,
      showControls: controls.checked,
    });
  }

  function markSelected() {
    list.querySelectorAll<HTMLElement>('li').forEach((li) => {
      const on = Number(li.dataset.index) === selected;
      li.classList.toggle('border-red-600', on);
      li.classList.toggle('border-gray-300', !on);
      li.classList.toggle('dark:border-gray-700', !on);
    });
  }

  function select(index: number) {
    selected = index;
    markSelected();
    drawPreview();
  }

  function buildList() {
    list.textContent = '';
    for (const seg of segments) {
      const li = document.createElement('li');
      li.dataset.index = String(seg.index);
      li.className = 'rounded-lg border-2 p-3';

      const head = document.createElement('div');
      head.className = 'mb-2 flex flex-wrap items-center gap-2 text-sm';
      const idx = document.createElement('span');
      idx.className = 'font-mono text-gray-600 dark:text-gray-400';
      idx.textContent = `#${seg.index + 1}`;
      const cmd = document.createElement('code');
      cmd.className =
        'rounded bg-gray-100 px-1.5 py-0.5 font-mono font-bold dark:bg-gray-800';
      cmd.textContent = seg.command;
      const name = document.createElement('span');
      name.textContent = names[seg.type] ?? seg.type;
      head.append(idx, cmd, name);
      if (seg.relative) {
        const badge = document.createElement('span');
        badge.className =
          'rounded bg-blue-100 px-1.5 py-0.5 text-xs text-blue-900 dark:bg-blue-900 dark:text-blue-100';
        badge.textContent = root.dataset.relative!;
        head.append(badge);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ui-btn ml-auto min-h-9 px-3 py-1 text-sm';
      btn.textContent = root.dataset.select!;
      btn.addEventListener('click', () => select(seg.index));
      head.append(btn);
      li.append(head);

      const abs = document.createElement('p');
      abs.className =
        'pv-abs mb-2 font-mono text-xs text-gray-600 dark:text-gray-400';
      abs.textContent = coordText(seg);
      li.append(abs);

      const labels = argLabels(seg.type);
      if (labels.length > 0) {
        const grid = document.createElement('div');
        grid.className = 'flex flex-wrap gap-2';
        labels.forEach((label, argIndex) => {
          const wrap = document.createElement('label');
          wrap.className = 'text-xs text-gray-700 dark:text-gray-300';
          const cap = document.createElement('span');
          cap.className = 'mb-0.5 block';
          cap.textContent = label;
          const field = document.createElement('input');
          field.type = 'number';
          field.step = 'any';
          field.value = String(seg.args[argIndex]);
          field.setAttribute(
            'aria-label',
            `#${seg.index + 1} ${seg.command} ${label}`,
          );
          field.className =
            'ui-input h-9 w-24 px-2 font-mono text-sm dark:bg-gray-900';
          field.addEventListener('focus', () => select(seg.index));
          field.addEventListener('input', () => {
            if (field.value.trim() === '') return;
            const next = updateSegmentArg(
              input.value,
              seg.index,
              argIndex,
              Number(field.value),
            );
            if (next === null) return;
            internalEdit = true;
            input.value = next;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            internalEdit = false;
          });
          wrap.append(cap, field);
          grid.append(wrap);
        });
        li.append(grid);
      }
      list.append(li);
    }
    markSelected();
  }

  function fmt(n: number): string {
    return String(Math.round(n * 1000) / 1000);
  }

  function coordText(seg: PathSegment): string {
    return `(${fmt(seg.from.x)}, ${fmt(seg.from.y)}) → (${fmt(seg.to.x)}, ${fmt(seg.to.y)})`;
  }

  function render() {
    const r = parsePath(input.value);
    if (r.error) {
      const template = errors[r.error.code] ?? '';
      errorEl.textContent = template.replace(
        '{position}',
        String(r.error.position + 1),
      );
      errorEl.hidden = false;
      result.hidden = true;
      segments = [];
      return;
    }
    errorEl.hidden = true;
    result.hidden = false;
    segments = r.segments;
    if (selected !== null && selected >= segments.length) selected = null;
    if (!internalEdit) {
      buildList();
    } else {
      // 入力欄のフォーカスを保つため一覧は作り直さず、座標表示だけ更新する
      list.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const seg = segments[Number(li.dataset.index)];
        const abs = li.querySelector('.pv-abs');
        if (seg && abs) abs.textContent = coordText(seg);
      });
    }
    drawPreview();
  }

  let statusTimer: ReturnType<typeof setTimeout> | undefined;
  function showStatus(message: string) {
    statusEl.textContent = message;
    clearTimeout(statusTimer);
    statusTimer = setTimeout(() => (statusEl.textContent = ''), 2000);
  }

  input.addEventListener('input', () => {
    if (!internalEdit) statsEl.textContent = '';
    render();
  });
  controls.addEventListener('change', drawPreview);

  document.getElementById('pv-sample-button')!.addEventListener('click', () => {
    input.value = SAMPLE_PATH;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  });

  document
    .getElementById('pv-optimize-button')!
    .addEventListener('click', () => {
      const p = Math.min(Math.max(Math.round(Number(precision.value)), 0), 8);
      const res = optimizePath(input.value, {
        precision: Number.isFinite(p) ? p : 2,
        absolute: absolute.checked,
      });
      if (!res) return;
      input.value = res.d;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      const percent =
        res.before > 0
          ? Math.max(0, Math.round((1 - res.after / res.before) * 100))
          : 0;
      statsEl.textContent = root.dataset
        .stats!.replace('{before}', String(res.before))
        .replace('{after}', String(res.after))
        .replace('{percent}', String(percent));
    });

  document
    .getElementById('pv-copy-button')!
    .addEventListener('click', async () => {
      showStatus(
        (await copyText(input.value.trim()))
          ? root.dataset.copied!
          : root.dataset.copyFailed!,
      );
    });

  if (input.value === '') input.value = SAMPLE_PATH;
  render();
</script>
