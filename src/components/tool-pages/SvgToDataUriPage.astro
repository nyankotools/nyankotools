---
import ToolShell from '../ToolShell.astro';
import { svgToDataUriContent } from '../../i18n/tools/svg-to-data-uri';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = svgToDataUriContent[locale];
---

<ToolShell t={t}>
  <label for="svg-to-data-uri-input" class="ui-label">
    {t.inputLabel}
  </label>
  <textarea
    id="svg-to-data-uri-input"
    data-query-target="text"
    data-sample={t.sampleText}
    data-no-count
    class="ui-input h-56 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
    placeholder={t.inputPlaceholder}
    spellcheck="false"
  ></textarea>
  <p
    id="svg-to-data-uri-error"
    role="alert"
    hidden
    data-message={t.errorNotSvg}
    class="ui-error mt-2 max-w-2xl"
  ></p>

  <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
        {t.methodLabel}
      </span>
      <div
        id="svg-to-data-uri-method"
        class="ui-seg"
        role="group"
        aria-label={t.methodLabel}
      >
        <button
          type="button"
          data-method="url"
          aria-pressed="true"
          class="ui-seg-btn"
        >
          {t.methodUrl}
        </button>
        <button
          type="button"
          data-method="base64"
          aria-pressed="false"
          class="ui-seg-btn"
        >
          {t.methodBase64}
        </button>
      </div>
    </div>
    <label class="ui-check">
      <input type="checkbox" id="svg-to-data-uri-layout" />
      {t.layoutLabel}
    </label>
  </div>

  <div id="svg-to-data-uri-result" hidden class="mt-4">
    <p
      id="svg-to-data-uri-stats"
      class="text-sm text-gray-600 dark:text-gray-400"
      data-template={t.statsTemplate}
    ></p>

    <span class="ui-label mt-4">{t.previewHeading}</span>
    <div class="flex h-40 items-center justify-center overflow-hidden rounded-lg border border-gray-300 bg-white p-2 dark:border-gray-700">
      <img
        id="svg-to-data-uri-preview"
        alt=""
        class="max-h-full max-w-full object-contain"
      />
    </div>

    <label for="svg-to-data-uri-css" class="ui-label mt-4">
      {t.cssHeading}
    </label>
    <textarea
      id="svg-to-data-uri-css"
      readonly
      class="ui-input h-32 w-full bg-gray-50 p-4 font-mono break-all dark:bg-gray-900"
    ></textarea>

    <label for="svg-to-data-uri-uri" class="ui-label mt-4">
      {t.uriHeading}
    </label>
    <textarea
      id="svg-to-data-uri-uri"
      readonly
      class="ui-input h-32 w-full bg-gray-50 p-4 font-mono break-all dark:bg-gray-900"
    ></textarea>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button
        id="svg-to-data-uri-copy-button"
        type="button"
        data-copied={t.copied}
        data-copy-failed={t.copyFailed}
        class="ui-btn ui-btn-primary"
      >
        {t.copyCssButton}
      </button>
      <button id="svg-to-data-uri-copy-uri-button" type="button" class="ui-btn">
        {t.copyUriButton}
      </button>
      <span
        id="svg-to-data-uri-status"
        class="text-sm text-green-700 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import {
    convertSvg,
    type EncodeMethod,
  } from '../../lib/tools/svg-to-data-uri';

  const input = document.getElementById(
    'svg-to-data-uri-input',
  ) as HTMLTextAreaElement;
  const errorEl = document.getElementById('svg-to-data-uri-error')!;
  const resultEl = document.getElementById('svg-to-data-uri-result')!;
  const statsEl = document.getElementById('svg-to-data-uri-stats')!;
  const preview = document.getElementById(
    'svg-to-data-uri-preview',
  ) as HTMLImageElement;
  const cssOutput = document.getElementById(
    'svg-to-data-uri-css',
  ) as HTMLTextAreaElement;
  const uriOutput = document.getElementById(
    'svg-to-data-uri-uri',
  ) as HTMLTextAreaElement;
  const layoutCheck = document.getElementById(
    'svg-to-data-uri-layout',
  ) as HTMLInputElement;
  const methodButtons = document.querySelectorAll<HTMLButtonElement>(
    '#svg-to-data-uri-method [data-method]',
  );
  const copyButton = document.getElementById(
    'svg-to-data-uri-copy-button',
  ) as HTMLButtonElement;
  const copyUriButton = document.getElementById(
    'svg-to-data-uri-copy-uri-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('svg-to-data-uri-status')!;

  let method: EncodeMethod = 'url';

  function convert() {
    statusEl.textContent = '';
    const result = convertSvg(input.value, method, layoutCheck.checked);
    if (!result.ok) {
      resultEl.hidden = true;
      preview.removeAttribute('src');
      cssOutput.value = '';
      uriOutput.value = '';
      if (result.error === 'not-svg') {
        errorEl.textContent = errorEl.dataset.message ?? '';
        errorEl.hidden = false;
      } else {
        errorEl.hidden = true;
      }
      return;
    }
    errorEl.hidden = true;
    resultEl.hidden = false;
    preview.src = result.dataUri;
    cssOutput.value = result.css;
    uriOutput.value = result.dataUri;
    statsEl.textContent = (statsEl.dataset.template ?? '')
      .replace('{original}', String(result.originalBytes))
      .replace('{output}', String(result.outputLength))
      .replace('{ratio}', String(result.ratio));
  }

  onTextInput(input, convert);
  layoutCheck.addEventListener('change', convert);

  methodButtons.forEach((button) => {
    button.addEventListener('click', () => {
      method = button.dataset.method as EncodeMethod;
      methodButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  async function copyFrom(el: HTMLTextAreaElement) {
    if (!el.value) return;
    statusEl.textContent = (await copyText(el.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  }

  copyButton.addEventListener('click', () => void copyFrom(cssOutput));
  copyUriButton.addEventListener('click', () => void copyFrom(uriOutput));

  convert();
</script>
