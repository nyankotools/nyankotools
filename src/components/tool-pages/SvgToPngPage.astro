---
import ToolShell from '../ToolShell.astro';
import { svgToPngContent } from '../../i18n/tools/svg-to-png';
import { MAX_OUTPUT_DIMENSION } from '../../lib/tools/svg-to-png';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = svgToPngContent[locale];
---

<ToolShell t={t}>
  <div
    id="svgpng-root"
    data-size-info={t.sizeInfo}
    data-downloaded={t.downloaded}
    data-error-not-svg={t.errorNotSvg}
    data-error-no-size={t.errorNoSize}
    data-error-too-large={t.errorTooLarge.replace(
      '{max}',
      String(MAX_OUTPUT_DIMENSION),
    )}
    data-error-load-failed={t.errorLoadFailed}
    data-error-export-failed={t.errorExportFailed}
    data-error-file-read={t.errorFileRead}
  >
    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <label for="svgpng-file" class="ui-label">
          {t.dropLabel}
        </label>
        <div id="svgpng-dropzone" class="ui-dropzone">
          <input
            id="svgpng-file"
            type="file"
            accept=".svg,image/svg+xml"
            class="ui-file"
          />
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
            {t.dropHint}
          </p>
        </div>

        <label for="svgpng-input" class="ui-label mt-4">
          {t.inputLabel}
        </label>
        <textarea
          id="svgpng-input"
          rows="8"
          class="ui-input w-full p-3 font-mono text-sm dark:bg-gray-900 dark:placeholder-gray-500"
          placeholder={t.inputPlaceholder}
          spellcheck="false"
          autocomplete="off"
        ></textarea>

        <div class="mt-4 flex flex-wrap gap-4">
          <div>
            <label for="svgpng-scale" class="ui-label">
              {t.scaleLabel}
            </label>
            <select
              id="svgpng-scale"
              class="ui-input h-11 px-3 dark:bg-gray-900"
            >
              {t.scaleOptions.map(({ value, label, selected }) => (
                <option value={value} selected={selected}>
                  {label}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label for="svgpng-bg" class="ui-label">
              {t.backgroundLabel}
            </label>
            <select id="svgpng-bg" class="ui-input h-11 px-3 dark:bg-gray-900">
              {t.backgroundOptions.map(({ value, label, selected }) => (
                <option value={value} selected={selected}>
                  {label}
                </option>
              ))}
            </select>
          </div>

          <div id="svgpng-bg-color-wrap" hidden>
            <label for="svgpng-bg-color" class="ui-label">
              {t.backgroundColorLabel}
            </label>
            <input
              id="svgpng-bg-color"
              type="color"
              value="#ffffff"
              class="h-11 w-16 cursor-pointer rounded-lg border border-gray-300 bg-white p-1 dark:border-gray-700 dark:bg-gray-900"
            />
          </div>
        </div>

        <p
          id="svgpng-error"
          role="alert"
          hidden
          class="mt-3 text-sm text-red-600 dark:text-red-400"
        ></p>
      </div>

      <div class="flex flex-col items-center gap-3">
        <p class="ui-label self-start">{t.previewLabel}</p>
        <div
          class="flex min-h-40 w-full items-center justify-center rounded-lg border border-gray-300 p-2 dark:border-gray-700"
          style="background-image: conic-gradient(#e5e7eb 25%, #fff 0 50%, #e5e7eb 0 75%, #fff 0); background-size: 16px 16px;"
        >
          <canvas
            id="svgpng-canvas"
            role="img"
            aria-label={t.previewLabel}
            class="max-h-96 max-w-full object-contain"
          ></canvas>
        </div>
        <p
          id="svgpng-size"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></p>
        <button
          id="svgpng-download"
          type="button"
          disabled
          class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-gray-700 dark:disabled:text-gray-400"
        >
          {t.downloadButton}
        </button>
        <span
          id="svgpng-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </div>
</ToolShell>

<script>
  import { downloadBlob } from '../../lib/download';
  import { enableFileDrop } from '../../lib/file-drop';
  import { onTextInput } from '../../lib/input-scheduler';
  import {
    isWithinOutputLimit,
    parseSvgSize,
    pngFileName,
    prepareSvg,
    scaleSize,
  } from '../../lib/tools/svg-to-png';

  const root = document.getElementById('svgpng-root')!;
  const fileInput = document.getElementById('svgpng-file') as HTMLInputElement;
  const dropzone = document.getElementById('svgpng-dropzone')!;
  const input = document.getElementById('svgpng-input') as HTMLTextAreaElement;
  const scaleSelect = document.getElementById(
    'svgpng-scale',
  ) as HTMLSelectElement;
  const bgSelect = document.getElementById('svgpng-bg') as HTMLSelectElement;
  const bgColorWrap = document.getElementById('svgpng-bg-color-wrap')!;
  const bgColor = document.getElementById(
    'svgpng-bg-color',
  ) as HTMLInputElement;
  const canvas = document.getElementById('svgpng-canvas') as HTMLCanvasElement;
  const errorEl = document.getElementById('svgpng-error')!;
  const sizeEl = document.getElementById('svgpng-size')!;
  const statusEl = document.getElementById('svgpng-status')!;
  const downloadButton = document.getElementById(
    'svgpng-download',
  ) as HTMLButtonElement;

  const d = root.dataset;
  let sourceName: string | null = null;
  // 画像の読み込みは非同期なので、古い描画結果が新しい入力を上書きしないよう世代で管理する
  let generation = 0;

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.hidden = message === '';
  }

  function reset(message = '') {
    generation++;
    canvas.width = 0;
    canvas.height = 0;
    sizeEl.textContent = '';
    downloadButton.disabled = true;
    showError(message);
  }

  function render() {
    statusEl.textContent = '';
    bgColorWrap.hidden = bgSelect.value !== 'custom';
    const text = input.value;
    if (text.trim() === '') return reset();

    const size = parseSvgSize(text);
    if (!size) {
      const isSvg = prepareSvg(
        text,
        { width: 1, height: 1 },
        { width: 1, height: 1 },
      );
      return reset(isSvg ? (d.errorNoSize ?? '') : (d.errorNotSvg ?? ''));
    }
    const target = scaleSize(size, Number(scaleSelect.value) || 1);
    if (!isWithinOutputLimit(target)) return reset(d.errorTooLarge ?? '');

    const svg = prepareSvg(text, size, target);
    if (!svg) return reset(d.errorNotSvg ?? '');

    const current = ++generation;
    const url = URL.createObjectURL(
      new Blob([svg], { type: 'image/svg+xml;charset=utf-8' }),
    );
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      if (current !== generation) return;
      canvas.width = target.width;
      canvas.height = target.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return reset(d.errorExportFailed ?? '');
      if (bgSelect.value !== 'transparent') {
        ctx.fillStyle = bgSelect.value === 'white' ? '#ffffff' : bgColor.value;
        ctx.fillRect(0, 0, target.width, target.height);
      }
      ctx.drawImage(img, 0, 0, target.width, target.height);
      showError('');
      sizeEl.textContent = (d.sizeInfo ?? '')
        .replace('{width}', String(target.width))
        .replace('{height}', String(target.height));
      downloadButton.disabled = false;
    };
    img.onerror = () => {
      URL.revokeObjectURL(url);
      if (current === generation) reset(d.errorLoadFailed ?? '');
    };
    img.src = url;
  }

  onTextInput(input, () => {
    // 手入力に切り替わったら、元のファイル名は引き継がない
    sourceName = null;
    render();
  });
  scaleSelect.addEventListener('change', render);
  bgSelect.addEventListener('change', render);
  bgColor.addEventListener('input', render);

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    fileInput.value = '';
    if (!file) return;
    try {
      input.value = await file.text();
    } catch {
      return reset(d.errorFileRead ?? '');
    }
    sourceName = file.name;
    render();
  });
  enableFileDrop(dropzone, fileInput);

  downloadButton.addEventListener('click', () => {
    try {
      canvas.toBlob((blob) => {
        if (!blob) return showError(d.errorExportFailed ?? '');
        downloadBlob(blob, pngFileName(sourceName));
        statusEl.textContent = d.downloaded ?? '';
      }, 'image/png');
    } catch {
      // foreignObject等でcanvasが汚染されている場合は書き出しが例外になる
      showError(d.errorExportFailed ?? '');
    }
  });

  render();
</script>
