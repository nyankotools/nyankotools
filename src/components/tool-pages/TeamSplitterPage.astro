---
import ToolShell from '../ToolShell.astro';
import { teamSplitterContent } from '../../i18n/tools/team-splitter';
import { MAX_NAMES, MAX_TEAMS } from '../../lib/tools/team-splitter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = teamSplitterContent[locale];
const modes = [
  { id: 'teams', label: t.modeTeams },
  { id: 'size', label: t.modeSize },
];
---

<ToolShell t={t}>
  <section
    id="ts-root"
    data-max-names={MAX_NAMES}
    data-max-teams={MAX_TEAMS}
    data-names-info={t.namesInfo}
    data-team-label={t.teamLabel}
    data-result-summary={t.resultSummary}
    data-member-count={t.memberCount}
    data-too-few={t.tooFewNames}
    data-too-many={t.tooManyNames}
    data-teams-error={t.teamsValueError}
    data-size-error={t.sizeValueError}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <label for="ts-names" class="ui-label">
      {t.namesLabel}
    </label>
    <textarea
      id="ts-names"
      class="ui-input h-44 w-full p-3 dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.namesPlaceholder}
      spellcheck="false"
      data-no-count
    >{t.defaultNames}</textarea>
    <p
      id="ts-info"
      class="mt-1 text-sm text-gray-600 dark:text-gray-400"
      aria-live="polite"
    ></p>

    <div class="mt-4">
      <span class="ui-label">{t.modeLabel}</span>
      <div
        id="ts-mode"
        class="ui-seg flex-wrap"
        role="group"
        aria-label={t.modeLabel}
      >
        {modes.map((mode, i) => (
          <button
            type="button"
            data-mode={mode.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="ui-seg-btn"
          >
            {mode.label}
          </button>
        ))}
      </div>
    </div>

    <div class="mt-3">
      <div id="ts-teams-field">
        <label for="ts-teams" class="ui-label">
          {t.teamsValueLabel}
        </label>
        <input
          id="ts-teams"
          type="number"
          inputmode="numeric"
          min="2"
          step="1"
          value="3"
          class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
        />
      </div>
      <div id="ts-size-field" hidden>
        <label for="ts-size" class="ui-label">
          {t.sizeValueLabel}
        </label>
        <input
          id="ts-size"
          type="number"
          inputmode="numeric"
          min="1"
          step="1"
          value="3"
          class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
        />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <button id="ts-generate-button" type="button" class="ui-btn-primary">
        {t.split}
      </button>
      <button id="ts-reshuffle-button" type="button" class="ui-btn" hidden>
        {t.reshuffle}
      </button>
    </div>

    <div id="ts-error" class="ui-error empty:hidden mt-4" role="alert"></div>

    <div id="ts-result" class="mt-4" hidden>
      <p
        id="ts-summary"
        class="mb-3 text-sm text-gray-600 dark:text-gray-400"
        aria-live="polite"
      ></p>
      <div id="ts-teams-list" class="grid gap-3 sm:grid-cols-2"></div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="ts-copy-button" type="button" class="ui-btn">
          {t.copy}
        </button>
        <span
          id="ts-status"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    formatTeamsText,
    isSplitError,
    parseLines,
    planSplit,
    splitTeams,
    type SplitMode,
  } from '../../lib/tools/team-splitter';

  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const msg = $('ts-root').dataset;
  const namesInput = $<HTMLTextAreaElement>('ts-names');
  const infoEl = $('ts-info');
  const teamsField = $('ts-teams-field');
  const sizeField = $('ts-size-field');
  const teamsInput = $<HTMLInputElement>('ts-teams');
  const sizeInput = $<HTMLInputElement>('ts-size');
  const generateButton = $<HTMLButtonElement>('ts-generate-button');
  const reshuffleButton = $<HTMLButtonElement>('ts-reshuffle-button');
  const errorEl = $('ts-error');
  const resultEl = $('ts-result');
  const summaryEl = $('ts-summary');
  const listEl = $('ts-teams-list');
  const copyButton = $<HTMLButtonElement>('ts-copy-button');
  const statusEl = $('ts-status');
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#ts-mode [data-mode]'),
  );

  let mode: SplitMode = 'teams';
  let lastText = '';

  function fill(template: string | undefined, values: Record<string, string>) {
    return (template ?? '').replace(/\{(\w+)\}/g, (match, key: string) =>
      Object.hasOwn(values, key) ? values[key] : match,
    );
  }

  function updateInfo() {
    infoEl.textContent = fill(msg.namesInfo, {
      count: String(parseLines(namesInput.value).length),
    });
  }

  function setMode(next: SplitMode) {
    mode = next;
    modeButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.mode === next)),
    );
    teamsField.hidden = next !== 'teams';
    sizeField.hidden = next !== 'size';
  }

  function errorText(code: string, count: number) {
    if (code === 'tooFewNames') return msg.tooFew ?? '';
    if (code === 'tooManyNames') {
      return fill(msg.tooMany, { max: String(msg.maxNames) });
    }
    return mode === 'teams'
      ? fill(msg.teamsError, {
          min: '2',
          max: String(Math.min(count, Number(msg.maxTeams))),
        })
      : fill(msg.sizeError, { max: String(Math.max(1, count - 1)) });
  }

  function run() {
    errorEl.textContent = '';
    statusEl.textContent = '';
    const names = parseLines(namesInput.value);
    const value = Number(
      (mode === 'teams' ? teamsInput : sizeInput).value.trim() || NaN,
    );
    const plan = planSplit(names.length, mode, value);
    if (isSplitError(plan)) {
      errorEl.textContent = errorText(plan, names.length);
      resultEl.hidden = true;
      reshuffleButton.hidden = true;
      return;
    }
    const teams = splitTeams(names, plan);
    const labels = teams.map((_, i) =>
      fill(msg.teamLabel, { n: String(i + 1) }),
    );
    lastText = formatTeamsText(teams, labels);
    summaryEl.textContent = fill(msg.resultSummary, {
      count: String(names.length),
      teams: String(teams.length),
    });
    listEl.replaceChildren();
    teams.forEach((members, i) => {
      const card = document.createElement('section');
      card.className =
        'rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-900';
      card.dataset.team = String(i);
      const h = document.createElement('h2');
      h.className = 'mb-1 text-base font-bold text-gray-900 dark:text-gray-100';
      h.textContent = `${labels[i]} · ${fill(msg.memberCount, { count: String(members.length) })}`;
      const ul = document.createElement('ul');
      ul.className = 'space-y-0.5 text-gray-900 dark:text-gray-100';
      members.forEach((name) => {
        const li = document.createElement('li');
        li.className = 'break-all';
        li.textContent = name;
        ul.append(li);
      });
      card.append(h, ul);
      listEl.append(card);
    });
    resultEl.hidden = false;
    reshuffleButton.hidden = false;
  }

  modeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      setMode(b.dataset.mode === 'size' ? 'size' : 'teams');
      errorEl.textContent = '';
    }),
  );
  generateButton.addEventListener('click', run);
  reshuffleButton.addEventListener('click', run);
  copyButton.addEventListener('click', async () => {
    if (!lastText) return;
    statusEl.textContent = (await copyText(lastText))
      ? (msg.copied ?? '')
      : (msg.copyFailed ?? '');
  });
  namesInput.addEventListener('input', updateInfo);
  document.addEventListener('DOMContentLoaded', updateInfo);
  updateInfo();
</script>
