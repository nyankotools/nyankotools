---
import ToolShell from '../ToolShell.astro';
import { textDiffContent } from '../../i18n/tools/text-diff';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = textDiffContent[locale];
---

<ToolShell t={t}>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="diff-input-a" class="ui-label">
        {t.inputALabel}
      </label>
      <textarea
        id="diff-input-a"
        class="ui-input h-52 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="diff-input-b" class="ui-label">
        {t.inputBLabel}
      </label>
      <textarea
        id="diff-input-b"
        class="ui-input h-52 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <label class="flex min-h-11 items-center gap-2">
      <input id="diff-ignore-whitespace" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.ignoreWhitespace}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="diff-ignore-case" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.ignoreCase}</span>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <span
      id="diff-status"
      data-status-template={t.statusTemplate}
      class="text-sm font-medium text-gray-700 dark:text-gray-300"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-2 overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
    <table class="w-full min-w-[480px] text-left text-sm">
      <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
        <tr>
          <th class="w-12 px-2 py-2 text-right font-medium">
            {t.tableColumnA}
          </th>
          <th class="w-12 px-2 py-2 text-right font-medium">
            {t.tableColumnB}
          </th>
          <th class="px-3 py-2 font-medium">{t.tableColumnContent}</th>
        </tr>
      </thead>
      <tbody id="diff-body" class="font-mono"></tbody>
    </table>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { escapeHtml } from '../../lib/tools/html-escape';
  import {
    diffLines,
    getDiffStats,
    type DiffLine,
  } from '../../lib/tools/text-diff';

  const inputA = document.getElementById('diff-input-a') as HTMLTextAreaElement;
  const inputB = document.getElementById('diff-input-b') as HTMLTextAreaElement;
  const ignoreWhitespace = document.getElementById(
    'diff-ignore-whitespace',
  ) as HTMLInputElement;
  const ignoreCase = document.getElementById(
    'diff-ignore-case',
  ) as HTMLInputElement;
  const statusEl = document.getElementById('diff-status')!;
  const bodyEl = document.getElementById('diff-body')!;
  const statusTemplate = statusEl.dataset.statusTemplate ?? '';

  const rowClass: Record<DiffLine['type'], string> = {
    equal: '',
    added: 'bg-green-50 dark:bg-green-950 text-green-800 dark:text-green-300',
    removed: 'bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300',
  };
  const prefix: Record<DiffLine['type'], string> = {
    equal: ' ',
    added: '+',
    removed: '-',
  };

  function render() {
    const lines = diffLines(inputA.value, inputB.value, {
      ignoreWhitespace: ignoreWhitespace.checked,
      ignoreCase: ignoreCase.checked,
    });
    const stats = getDiffStats(lines);
    statusEl.textContent = statusTemplate
      .replace('{added}', String(stats.added))
      .replace('{removed}', String(stats.removed))
      .replace('{equal}', String(stats.equal));

    bodyEl.innerHTML = lines
      .map((line) => {
        const leftLabel = line.leftLine ?? '';
        const rightLabel = line.rightLine ?? '';
        const text = escapeHtml(line.text) || '&nbsp;';
        return `<tr class="${rowClass[line.type]}">
          <td class="w-12 px-2 py-0.5 text-right text-gray-400 dark:text-gray-600 select-none">${leftLabel}</td>
          <td class="w-12 px-2 py-0.5 text-right text-gray-400 dark:text-gray-600 select-none">${rightLabel}</td>
          <td class="px-3 py-0.5 whitespace-pre-wrap"><span class="mr-1 select-none">${prefix[line.type]}</span>${text}</td>
        </tr>`;
      })
      .join('');
  }

  onTextInput(inputA, render, { watch: [inputB] });
  onTextInput(inputB, render, { watch: [inputA] });
  ignoreWhitespace.addEventListener('change', render);
  ignoreCase.addEventListener('change', render);

  render();
</script>
