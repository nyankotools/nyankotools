---
import ToolShell from '../ToolShell.astro';
import { textListToolsContent } from '../../i18n/tools/text-list-tools';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = textListToolsContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="tlt-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="tlt-input"
      data-query-target="text"
      data-sample={t.sampleText}
      class="ui-input h-52 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
    ></textarea>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <label class="flex min-h-11 items-center gap-2">
      <input id="tlt-trim" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.trimLabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="tlt-remove-empty" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.removeEmptyLabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="tlt-dedupe" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">{t.dedupeLabel}</span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="tlt-case-insensitive" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        {t.caseInsensitiveLabel}
      </span>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap items-end gap-4">
    <div>
      <label for="tlt-sort-order" class="ui-label">
        {t.sortLabel}
      </label>
      <select id="tlt-sort-order" class="ui-input h-11 px-3 dark:bg-gray-900">
        <option value="none">{t.sortOptionNone}</option>
        <option value="asc">{t.sortOptionAsc}</option>
        <option value="desc">{t.sortOptionDesc}</option>
        <option value="numericAsc">{t.sortOptionNumericAsc}</option>
        <option value="numericDesc">{t.sortOptionNumericDesc}</option>
        <option value="shuffle">{t.sortOptionShuffle}</option>
      </select>
    </div>

    <button
      id="tlt-reshuffle-button"
      type="button"
      class="hidden min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700"
    >
      {t.reshuffleButton}
    </button>

    <button
      id="tlt-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="tlt-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4">
    <div class="mb-1 flex items-center justify-between">
      <label
        for="tlt-output"
        class="block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.outputLabel}
      </label>
      <span
        id="tlt-count"
        data-count-template={t.countTemplate}
        class="text-xs text-gray-500 dark:text-gray-400"
      ></span>
    </div>
    <textarea
      id="tlt-output"
      readonly
      class="ui-input h-52 w-full bg-gray-50 p-4 font-mono whitespace-pre-wrap dark:bg-gray-900"
    ></textarea>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import {
    processTextList,
    type SortOrder,
  } from '../../lib/tools/text-list-tools';

  const input = document.getElementById('tlt-input') as HTMLTextAreaElement;
  const trimCheckbox = document.getElementById('tlt-trim') as HTMLInputElement;
  const removeEmptyCheckbox = document.getElementById(
    'tlt-remove-empty',
  ) as HTMLInputElement;
  const dedupeCheckbox = document.getElementById(
    'tlt-dedupe',
  ) as HTMLInputElement;
  const caseInsensitiveCheckbox = document.getElementById(
    'tlt-case-insensitive',
  ) as HTMLInputElement;
  const sortOrderSelect = document.getElementById(
    'tlt-sort-order',
  ) as HTMLSelectElement;
  const reshuffleButton = document.getElementById(
    'tlt-reshuffle-button',
  ) as HTMLButtonElement;
  const copyButton = document.getElementById(
    'tlt-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('tlt-status')!;
  const countEl = document.getElementById('tlt-count')!;
  const output = document.getElementById('tlt-output') as HTMLTextAreaElement;

  const countTemplate = countEl.dataset.countTemplate ?? '{count}';

  function process() {
    statusEl.textContent = '';
    const sortOrder = sortOrderSelect.value as SortOrder;
    reshuffleButton.classList.toggle('hidden', sortOrder !== 'shuffle');

    const lines = processTextList(input.value, {
      trimLines: trimCheckbox.checked,
      removeEmptyLines: removeEmptyCheckbox.checked,
      dedupe: dedupeCheckbox.checked,
      caseInsensitive: caseInsensitiveCheckbox.checked,
      sortOrder,
    });

    output.value = lines.join('\n');
    countEl.textContent = countTemplate.replace(
      '{count}',
      String(lines.length),
    );
  }

  onTextInput(input, process);
  trimCheckbox.addEventListener('change', process);
  removeEmptyCheckbox.addEventListener('change', process);
  dedupeCheckbox.addEventListener('change', process);
  caseInsensitiveCheckbox.addEventListener('change', process);
  sortOrderSelect.addEventListener('change', process);
  reshuffleButton.addEventListener('click', process);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  process();
</script>
