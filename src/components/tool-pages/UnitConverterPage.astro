---
import ToolShell from '../ToolShell.astro';
import { unitConverterContent } from '../../i18n/tools/unit-converter';
import { unitCategories } from '../../lib/tools/unit-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = unitConverterContent[locale];
---

<ToolShell t={t}>
  <section
    class="rounded-lg border border-gray-200 p-4 dark:border-gray-700"
    data-number-locale={t.numberLocale}
    data-error={t.error}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-unit-names={JSON.stringify(t.unitNames)}
    id="unit-converter"
  >
    <div class="mb-4">
      <label for="unit-category-select" class="ui-label">
        {t.categoryLabel}
      </label>
      <select
        id="unit-category-select"
        class="ui-input h-11 w-full max-w-60 px-3 dark:bg-gray-900"
      >
        {unitCategories.map((category) => (
          <option value={category}>{t.categoryNames[category]}</option>
        ))}
      </select>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_auto_1fr] sm:items-end">
      <div>
        <label for="unit-value-input" class="ui-label">
          {t.valueLabel}
        </label>
        <input
          id="unit-value-input"
          type="number"
          inputmode="decimal"
          step="any"
          value="1"
          class="ui-input mb-2 h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        />
        <label for="unit-from-select" class="ui-label">
          {t.fromLabel}
        </label>
        <select
          id="unit-from-select"
          data-no-persist
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        ></select>
      </div>

      <button
        type="button"
        id="unit-swap-button"
        class="ui-btn h-11 sm:mb-0"
        aria-label={t.swapLabel}
        title={t.swapLabel}
      >
        ⇄
      </button>

      <div>
        <span class="ui-label">{t.resultLabel}</span>
        <output
          id="unit-result"
          class="mb-2 flex h-11 w-full items-center overflow-x-auto rounded-lg border border-gray-200 bg-gray-50 px-3 text-sm font-semibold break-all dark:border-gray-700 dark:bg-gray-900"
          aria-live="polite"
        ></output>
        <label for="unit-to-select" class="ui-label">
          {t.toLabel}
        </label>
        <select
          id="unit-to-select"
          data-no-persist
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        ></select>
      </div>
    </div>

    <p
      id="unit-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <div class="mt-3 flex items-center gap-3">
      <button type="button" id="unit-copy-button" class="ui-btn">
        {t.copyButton}
      </button>
      <span
        id="unit-copy-status"
        class="text-sm text-gray-600 dark:text-gray-400"
        aria-live="polite"
      ></span>
    </div>

    <div id="unit-all-wrapper" class="mt-6 hidden">
      <h2 class="mb-2 text-base font-semibold">{t.allUnitsHeading}</h2>
      <dl
        id="unit-all-list"
        class="grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2"
      ></dl>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    convert,
    convertAll,
    formatNumber,
    getUnits,
    type UnitCategory,
  } from '../../lib/tools/unit-converter';

  const section = document.getElementById('unit-converter')!;
  const numberLocale = section.dataset.numberLocale ?? 'en-US';
  const errorMessage = section.dataset.error ?? '';
  const copiedMessage = section.dataset.copied ?? '';
  const copyFailedMessage = section.dataset.copyFailed ?? '';
  const unitNames: Record<string, string> = JSON.parse(
    section.dataset.unitNames ?? '{}',
  );

  const defaults: Record<UnitCategory, [string, string]> = {
    length: ['m', 'ft'],
    mass: ['kg', 'lb'],
    area: ['m2', 'tsubo'],
    volume: ['l', 'ml'],
    temperature: ['c', 'f'],
    data: ['GB', 'GiB'],
  };

  const categorySelect = document.getElementById(
    'unit-category-select',
  ) as HTMLSelectElement;
  const valueInput = document.getElementById(
    'unit-value-input',
  ) as HTMLInputElement;
  const fromSelect = document.getElementById(
    'unit-from-select',
  ) as HTMLSelectElement;
  const toSelect = document.getElementById(
    'unit-to-select',
  ) as HTMLSelectElement;
  const swapButton = document.getElementById('unit-swap-button')!;
  const resultEl = document.getElementById('unit-result')!;
  const errorEl = document.getElementById('unit-error')!;
  const copyButton = document.getElementById('unit-copy-button')!;
  const copyStatus = document.getElementById('unit-copy-status')!;
  const allWrapper = document.getElementById('unit-all-wrapper')!;
  const allList = document.getElementById('unit-all-list')!;

  let lastResultText = '';

  function category(): UnitCategory {
    return categorySelect.value as UnitCategory;
  }

  function fillUnitSelect(select: HTMLSelectElement, units: string[]) {
    select.replaceChildren(
      ...units.map((unit) => {
        const option = document.createElement('option');
        option.value = unit;
        option.textContent = unitNames[unit] ?? unit;
        return option;
      }),
    );
  }

  function populateUnits() {
    const units = getUnits(category());
    fillUnitSelect(fromSelect, units);
    fillUnitSelect(toSelect, units);
    const [from, to] = defaults[category()];
    fromSelect.value = from;
    toSelect.value = to;
  }

  function render() {
    errorEl.textContent = '';
    copyStatus.textContent = '';
    resultEl.textContent = '';
    lastResultText = '';
    allWrapper.classList.add('hidden');
    allList.replaceChildren();

    if (valueInput.value.trim() === '') return;
    const value = Number(valueInput.value);
    const result = convert(category(), fromSelect.value, toSelect.value, value);
    if (result === null) {
      errorEl.textContent = errorMessage;
      return;
    }
    lastResultText = formatNumber(result, numberLocale);
    resultEl.textContent = lastResultText;

    for (const row of convertAll(category(), fromSelect.value, value)) {
      const dt = document.createElement('dt');
      dt.className = 'text-gray-600 dark:text-gray-400';
      dt.textContent = unitNames[row.unit] ?? row.unit;
      const dd = document.createElement('dd');
      dd.className = 'mb-1 font-semibold break-all';
      dd.textContent = formatNumber(row.value, numberLocale);
      const wrap = document.createElement('div');
      wrap.append(dt, dd);
      allList.append(wrap);
    }
    allWrapper.classList.remove('hidden');
  }

  categorySelect.addEventListener('change', () => {
    populateUnits();
    render();
  });
  valueInput.addEventListener('input', render);
  fromSelect.addEventListener('change', render);
  toSelect.addEventListener('change', render);

  swapButton.addEventListener('click', () => {
    const from = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = from;
    render();
  });

  copyButton.addEventListener('click', async () => {
    if (lastResultText === '') return;
    copyStatus.textContent = (await copyText(lastResultText))
      ? copiedMessage
      : copyFailedMessage;
  });

  populateUnits();
  render();
</script>
