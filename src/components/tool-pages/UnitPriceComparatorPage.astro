---
import ToolShell from '../ToolShell.astro';
import { unitPriceComparatorContent } from '../../i18n/tools/unit-price-comparator';
import { PRICE_UNITS, TAX_MODES } from '../../lib/tools/unit-price-comparator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = unitPriceComparatorContent[locale];

const rows = Array.from({ length: t.rowCount }, (_, i) => ({
  index: i,
  sample: t.sampleRows[i],
}));

const labels = {
  basis: t.basisLabels,
  defaultItemName: t.defaultItemName,
  cheapestBadge: t.cheapestBadge,
  diffText: t.diffText,
  summaryText: t.summaryText,
  summaryTieText: t.summaryTieText,
  tooFewText: t.tooFewText,
  invalidRowText: t.invalidRowText,
  mismatchRowText: t.mismatchRowText,
};
---

<ToolShell t={t}>
  <section
    id="upc"
    data-number-locale={t.numberLocale}
    data-currency={t.currency}
    data-labels={JSON.stringify(labels)}
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
  >
    <div class="space-y-3">
      {rows.map(({ index, sample }) => (
        <fieldset
          class="upc-row rounded-lg border border-gray-200 p-3 dark:border-gray-700"
          data-index={index}
        >
          <legend class="px-1 text-sm font-medium">
            {t.rowLegend.replace('{n}', String(index + 1))}
          </legend>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="col-span-2 sm:col-span-1">
              <label for={`upc-name-${index}`} class="ui-label">
                {t.nameLabel}
              </label>
              <input
                id={`upc-name-${index}`}
                type="text"
                value={sample?.name ?? ''}
                placeholder={t.namePlaceholder}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
              />
            </div>
            <div>
              <label for={`upc-price-${index}`} class="ui-label">
                {t.priceLabel}
              </label>
              <input
                id={`upc-price-${index}`}
                type="number"
                inputmode="decimal"
                min="0"
                step="any"
                value={sample?.price ?? ''}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
            <div>
              <label for={`upc-tax-${index}`} class="ui-label">
                {t.taxLabel}
              </label>
              <select
                id={`upc-tax-${index}`}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              >
                {TAX_MODES.map((mode) => (
                  <option
                    value={mode}
                    selected={(sample?.taxMode ?? 'included') === mode}
                  >
                    {t.taxModes[mode]}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label for={`upc-qty-${index}`} class="ui-label">
                {t.quantityLabel}
              </label>
              <input
                id={`upc-qty-${index}`}
                type="number"
                inputmode="decimal"
                min="0"
                step="any"
                value={sample?.quantity ?? ''}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              />
            </div>
            <div>
              <label for={`upc-unit-${index}`} class="ui-label">
                {t.unitLabel}
              </label>
              <select
                id={`upc-unit-${index}`}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900"
              >
                {PRICE_UNITS.map((unit) => (
                  <option
                    value={unit}
                    selected={(sample?.unit ?? 'g') === unit}
                  >
                    {t.units[unit]}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label for={`upc-count-${index}`} class="ui-label">
                {t.countLabel}
              </label>
              <input
                id={`upc-count-${index}`}
                type="number"
                inputmode="numeric"
                min="1"
                step="any"
                value={sample?.count ?? ''}
                placeholder={t.countPlaceholder}
                class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
              />
            </div>
          </div>
        </fieldset>
      ))}
    </div>

    <div class="mt-3">
      <button type="button" id="upc-clear-button" class="ui-btn">
        {t.clearButton}
      </button>
    </div>

    <ul
      id="upc-issues"
      class="mt-3 space-y-1 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></ul>

    <div id="upc-results" class="mt-4 hidden" aria-live="polite">
      <h2 class="mb-2 text-lg font-semibold">{t.resultHeading}</h2>
      <p id="upc-summary" class="mb-3 font-semibold"></p>
      <ul id="upc-list" class="space-y-2"></ul>
      <div class="mt-3 flex items-center gap-3">
        <button type="button" id="upc-copy-button" class="ui-btn">
          {t.copyButton}
        </button>
        <span
          id="upc-copy-status"
          class="text-sm text-gray-600 dark:text-gray-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
  </section>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    compareUnitPrices,
    type PriceUnit,
    type TaxMode,
    type UnitDimension,
  } from '../../lib/tools/unit-price-comparator';

  interface Labels {
    basis: Record<UnitDimension, string>;
    defaultItemName: string;
    cheapestBadge: string;
    diffText: string;
    summaryText: string;
    summaryTieText: string;
    tooFewText: string;
    invalidRowText: string;
    mismatchRowText: string;
  }

  const section = document.getElementById('upc')!;
  const numberLocale = section.dataset.numberLocale ?? 'en-US';
  const currency = section.dataset.currency ?? 'USD';
  const labels: Labels = JSON.parse(section.dataset.labels ?? '{}');
  const copiedMessage = section.dataset.copied ?? '';
  const copyFailedMessage = section.dataset.copyFailed ?? '';

  const money = new Intl.NumberFormat(numberLocale, {
    style: 'currency',
    currency,
    maximumFractionDigits: 2,
  });
  const percentFormat = new Intl.NumberFormat(numberLocale, {
    maximumFractionDigits: 1,
  });

  const rowEls = Array.from(section.querySelectorAll<HTMLElement>('.upc-row'));
  const field = (name: string, i: number) =>
    document.getElementById(`upc-${name}-${i}`) as
      HTMLInputElement | HTMLSelectElement;

  const issuesEl = document.getElementById('upc-issues')!;
  const resultsEl = document.getElementById('upc-results')!;
  const summaryEl = document.getElementById('upc-summary')!;
  const listEl = document.getElementById('upc-list')!;
  const copyButton = document.getElementById('upc-copy-button')!;
  const copyStatus = document.getElementById('upc-copy-status')!;
  const clearButton = document.getElementById('upc-clear-button')!;

  let copyValue = '';

  function itemName(name: string, index: number): string {
    return name !== ''
      ? name
      : labels.defaultItemName.replace('{n}', String(index + 1));
  }

  function render() {
    issuesEl.replaceChildren();
    listEl.replaceChildren();
    copyStatus.textContent = '';
    resultsEl.classList.add('hidden');
    copyValue = '';

    const result = compareUnitPrices(
      rowEls.map((_, i) => ({
        name: field('name', i).value,
        price: field('price', i).value,
        quantity: field('qty', i).value,
        count: field('count', i).value,
        unit: field('unit', i).value as PriceUnit,
        taxMode: field('tax', i).value as TaxMode,
      })),
    );

    for (const issue of result.issues) {
      const li = document.createElement('li');
      const template =
        issue.issue === 'invalid'
          ? labels.invalidRowText
          : labels.mismatchRowText;
      li.textContent = template.replace('{n}', String(issue.index + 1));
      issuesEl.append(li);
    }

    if ('error' in result) {
      // 何も入力されていない間はメッセージを出さない
      const anyInput = rowEls.some(
        (_, i) =>
          field('price', i).value.trim() !== '' ||
          field('qty', i).value.trim() !== '',
      );
      if (anyInput) {
        const li = document.createElement('li');
        li.textContent = labels.tooFewText;
        issuesEl.append(li);
      }
      return;
    }

    const basis = labels.basis[result.dimension];
    const lines: string[] = [];
    for (const item of result.items) {
      const name = itemName(item.name, item.index);
      const li = document.createElement('li');
      li.className = item.isCheapest
        ? 'rounded-lg border-2 border-green-700 p-3 dark:border-green-400'
        : 'rounded-lg border border-gray-200 p-3 dark:border-gray-700';

      const head = document.createElement('div');
      head.className = 'flex flex-wrap items-center gap-2';
      const nameEl = document.createElement('span');
      nameEl.className = 'font-semibold';
      nameEl.textContent = name;
      head.append(nameEl);
      if (item.isCheapest) {
        const badge = document.createElement('span');
        badge.className =
          'rounded bg-green-700 px-2 py-0.5 text-xs font-semibold text-white dark:bg-green-400 dark:text-gray-900';
        badge.textContent = labels.cheapestBadge;
        head.append(badge);
      }
      li.append(head);

      const price = document.createElement('div');
      price.className = 'text-lg font-semibold';
      price.textContent = `${basis} ${money.format(item.unitPrice)}`;
      li.append(price);

      let line = `${name}: ${basis} ${money.format(item.unitPrice)}`;
      if (!item.isCheapest) {
        const diff = labels.diffText.replace(
          '{percent}',
          percentFormat.format(item.diffPercent),
        );
        const diffEl = document.createElement('div');
        diffEl.className = 'text-sm text-gray-600 dark:text-gray-400';
        diffEl.textContent = diff;
        li.append(diffEl);
        line += ` (${diff})`;
      } else {
        line += ` (${labels.cheapestBadge})`;
      }
      lines.push(line);
      listEl.append(li);
    }

    const cheapest = result.items.filter((i) => i.isCheapest);
    const names = cheapest
      .map((i) => itemName(i.name, i.index))
      .join(numberLocale.startsWith('ja') ? '・' : ', ');
    const template =
      cheapest.length > 1 ? labels.summaryTieText : labels.summaryText;
    summaryEl.textContent = template
      .replace('{name}', names)
      .replace('{basis}', basis)
      .replace('{price}', money.format(cheapest[0].unitPrice));
    copyValue = [summaryEl.textContent, ...lines].join('\n');
    resultsEl.classList.remove('hidden');
  }

  section.addEventListener('input', render);
  section.addEventListener('change', render);

  clearButton.addEventListener('click', () => {
    rowEls.forEach((_, i) => {
      (field('name', i) as HTMLInputElement).value = '';
      (field('price', i) as HTMLInputElement).value = '';
      (field('qty', i) as HTMLInputElement).value = '';
      (field('count', i) as HTMLInputElement).value = '';
      (field('tax', i) as HTMLSelectElement).value = 'included';
    });
    render();
    (field('price', 0) as HTMLInputElement).focus();
  });

  copyButton.addEventListener('click', async () => {
    if (copyValue === '') return;
    copyStatus.textContent = (await copyText(copyValue))
      ? copiedMessage
      : copyFailedMessage;
  });

  render();
</script>
