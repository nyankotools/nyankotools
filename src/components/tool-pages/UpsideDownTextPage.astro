---
import ToolShell from '../ToolShell.astro';
import { upsideDownTextContent } from '../../i18n/tools/upside-down-text';
import { upsideDownModeIds } from '../../lib/tools/upside-down-text';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = upsideDownTextContent[locale];
---

<ToolShell t={t}>
  <section
    id="udt-root"
    data-copied={t.copied}
    data-copy-failed={t.copyFailed}
    data-preview={t.previewText}
    data-count-template={t.countTemplate}
    data-all-converted={t.allConverted}
  >
    <label for="udt-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="udt-input"
      data-query-target="text"
      data-sample={t.sampleText}
      class="ui-input h-28 w-full p-4 dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
    ></textarea>

    <div class="mt-4 flex items-center gap-3">
      <h2 class="ui-label !mb-0">{t.resultsLabel}</h2>
      <span
        id="udt-status"
        class="text-sm text-green-700 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>

    <ul class="mt-2 grid gap-2" id="udt-list">
      {upsideDownModeIds.map((id) => (
        <li
          class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 dark:border-gray-700"
          data-mode={id}
        >
          <div class="min-w-0 flex-1">
            <div class="text-xs text-gray-500 dark:text-gray-400">
              {t.modeNames[id]}
            </div>
            <div
              class="udt-output mt-0.5 text-lg break-all whitespace-pre-wrap"
              translate="no"
            />
            <div class="udt-count mt-1 text-xs text-gray-600 dark:text-gray-400" />
          </div>
          <button type="button" class="ui-btn udt-copy shrink-0">
            {t.copy}
          </button>
        </li>
      ))}
    </ul>
  </section>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import { transform } from '../../lib/tools/upside-down-text';
  import type { UpsideDownMode } from '../../lib/tools/upside-down-text';

  const root = document.getElementById('udt-root')!;
  const input = document.getElementById('udt-input') as HTMLTextAreaElement;
  const statusEl = document.getElementById('udt-status')!;
  const rows = document.querySelectorAll<HTMLElement>('#udt-list [data-mode]');

  function render() {
    statusEl.textContent = '';
    const empty = input.value === '';
    const text = empty ? (root.dataset.preview ?? '') : input.value;
    rows.forEach((row) => {
      const mode = row.dataset.mode as UpsideDownMode;
      const out = row.querySelector<HTMLElement>('.udt-output')!;
      const count = row.querySelector<HTMLElement>('.udt-count')!;
      const button = row.querySelector<HTMLButtonElement>('.udt-copy')!;
      const result = transform(text, mode);
      out.textContent = result.output;
      out.classList.toggle('text-gray-600', empty);
      out.classList.toggle('dark:text-gray-400', empty);
      button.disabled = empty;
      if (mode === 'reverse' || empty) {
        count.textContent = '';
      } else if (result.unconverted === 0) {
        count.textContent = root.dataset.allConverted ?? '';
      } else {
        count.textContent = (root.dataset.countTemplate ?? '')
          .replace('{converted}', String(result.converted))
          .replace('{unconverted}', String(result.unconverted));
      }
    });
  }

  onTextInput(input, render);

  rows.forEach((row) => {
    const button = row.querySelector<HTMLButtonElement>('.udt-copy')!;
    button.addEventListener('click', async () => {
      const value = row.querySelector<HTMLElement>('.udt-output')!.textContent;
      if (!value) return;
      statusEl.textContent = (await copyText(value))
        ? (root.dataset.copied ?? '')
        : (root.dataset.copyFailed ?? '');
    });
  });

  render();
</script>
