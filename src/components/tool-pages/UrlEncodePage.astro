---
import ToolShell from '../ToolShell.astro';
import { urlEncodeContent } from '../../i18n/tools/url-encode';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = urlEncodeContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <div
      id="url-encode-mode"
      class="ui-seg"
      role="group"
      aria-label={t.modeLabel}
    >
      <button
        type="button"
        data-mode="encode"
        aria-pressed="true"
        class="ui-seg-btn"
      >
        {t.modeEncode}
      </button>
      <button
        type="button"
        data-mode="decode"
        aria-pressed="false"
        class="ui-seg-btn"
      >
        {t.modeDecode}
      </button>
    </div>
    <button
      id="url-encode-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="url-encode-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="url-encode-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="url-encode-input"
        class="ui-input h-64 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="url-encode-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="url-encode-output"
        readonly
        class="ui-input h-64 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <p
    id="url-encode-error"
    hidden
    data-message={t.decodeError}
    class="ui-error mt-4 max-w-2xl"
  ></p>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import { decodeUrl, encodeUrl } from '../../lib/tools/url-encode';

  type Mode = 'encode' | 'decode';

  const input = document.getElementById(
    'url-encode-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'url-encode-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#url-encode-mode [data-mode]',
  );
  const copyButton = document.getElementById(
    'url-encode-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('url-encode-status')!;
  const errorEl = document.getElementById('url-encode-error')!;

  let mode: Mode = 'encode';

  function showError() {
    output.value = '';
    errorEl.textContent = errorEl.dataset.message ?? '';
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value === '') {
      showOutput('');
      return;
    }
    const result =
      mode === 'encode' ? encodeUrl(input.value) : decodeUrl(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError();
    }
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  convert();
</script>
