---
import ToolShell from '../ToolShell.astro';
import { uuidGeneratorContent } from '../../i18n/tools/uuid-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = uuidGeneratorContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-end gap-4">
    <div>
      <label for="uuid-generator-count" class="ui-label">
        {t.countLabel}
      </label>
      <input
        id="uuid-generator-count"
        type="number"
        min="1"
        max="100"
        value="5"
        class="ui-input h-11 w-28 px-3 dark:bg-gray-900"
      />
    </div>

    <label class="ui-check">
      <input
        id="uuid-generator-remove-hyphens"
        type="checkbox"
        class="h-4 w-4"
      />
      {t.removeHyphens}
    </label>

    <label class="ui-check">
      <input id="uuid-generator-uppercase" type="checkbox" class="h-4 w-4" />
      {t.uppercase}
    </label>

    <button
      id="uuid-generator-generate-button"
      type="button"
      class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700"
    >
      {t.generate}
    </button>

    <button
      id="uuid-generator-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="uuid-generator-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4">
    <label for="uuid-generator-output" class="ui-label">
      {t.outputLabel}
    </label>
    <textarea
      id="uuid-generator-output"
      readonly
      class="ui-input h-64 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
    ></textarea>
  </div>
</ToolShell>

<script>
  import { copyText } from '../../lib/clipboard';
  import {
    clampUuidCount,
    generateUuids,
  } from '../../lib/tools/uuid-generator';

  const countInput = document.getElementById(
    'uuid-generator-count',
  ) as HTMLInputElement;
  const removeHyphensCheckbox = document.getElementById(
    'uuid-generator-remove-hyphens',
  ) as HTMLInputElement;
  const uppercaseCheckbox = document.getElementById(
    'uuid-generator-uppercase',
  ) as HTMLInputElement;
  const generateButton = document.getElementById(
    'uuid-generator-generate-button',
  )!;
  const copyButton = document.getElementById(
    'uuid-generator-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('uuid-generator-status')!;
  const output = document.getElementById(
    'uuid-generator-output',
  ) as HTMLTextAreaElement;

  function generate() {
    statusEl.textContent = '';
    const uuids = generateUuids({
      count: Number(countInput.value),
      removeHyphens: removeHyphensCheckbox.checked,
      uppercase: uppercaseCheckbox.checked,
    });
    output.value = uuids.join('\n');
  }

  function clampCountInput() {
    countInput.value = String(clampUuidCount(Number(countInput.value)));
  }

  generateButton.addEventListener('click', generate);
  countInput.addEventListener('change', () => {
    clampCountInput();
    generate();
  });
  removeHyphensCheckbox.addEventListener('change', generate);
  uppercaseCheckbox.addEventListener('change', generate);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  generate();
</script>
