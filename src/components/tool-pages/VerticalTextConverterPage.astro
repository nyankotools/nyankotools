---
import ToolShell from '../ToolShell.astro';
import { verticalTextConverterContent } from '../../i18n/tools/vertical-text-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = verticalTextConverterContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="vtc-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="vtc-input"
      data-query-target="text"
      data-sample={t.sampleText}
      class="ui-input h-32 w-full p-4 dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
    ></textarea>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="vtc-layout" class="ui-label">
        {t.layoutLabel}
      </label>
      <select
        id="vtc-layout"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      >
        <option value="chars">{t.layoutChars}</option>
        <option value="columns">{t.layoutColumns}</option>
      </select>
    </div>
    <div>
      <label for="vtc-max" class="ui-label">
        {t.maxPerColumnLabel}
        <span class="font-normal text-gray-600 dark:text-gray-400">
          ({t.maxPerColumnHint})
        </span>
      </label>
      <input
        id="vtc-max"
        type="number"
        min="0"
        step="1"
        value="0"
        inputmode="numeric"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900"
      />
    </div>
  </div>

  <div class="mt-3 flex flex-col">
    <label class="ui-check">
      <input id="vtc-glyphs" type="checkbox" checked />
      {t.glyphsLabel}
    </label>
    <label class="ui-check">
      <input id="vtc-fullwidth" type="checkbox" checked />
      {t.fullWidthLabel}
    </label>
  </div>

  <div class="mt-4">
    <label for="vtc-output" class="ui-label">
      {t.outputLabel}
    </label>
    <textarea
      id="vtc-output"
      readonly
      data-no-count
      class="min-h-32 w-full rounded-lg border border-gray-300 bg-gray-50 p-3 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      placeholder={t.emptyHint}
    ></textarea>
  </div>

  <div class="mt-3 flex items-center gap-3">
    <button
      id="vtc-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn ui-btn-primary px-4"
    >
      {t.copy}
    </button>
    <span
      id="vtc-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-6">
    <h2 class="ui-label" id="vtc-preview-label">
      {t.previewLabel}
    </h2>
    <div
      id="vtc-preview"
      role="region"
      aria-labelledby="vtc-preview-label"
      tabindex="0"
      data-empty={t.previewEmpty}
      class="h-64 overflow-x-auto overflow-y-hidden rounded-lg border border-gray-300 bg-white p-4 text-lg leading-loose whitespace-pre-wrap text-gray-900 [writing-mode:vertical-rl] dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    ></div>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import {
    convertVertical,
    type VerticalLayout,
  } from '../../lib/tools/vertical-text-converter';

  const input = document.getElementById('vtc-input') as HTMLTextAreaElement;
  const output = document.getElementById('vtc-output') as HTMLTextAreaElement;
  const layout = document.getElementById('vtc-layout') as HTMLSelectElement;
  const maxPer = document.getElementById('vtc-max') as HTMLInputElement;
  const glyphs = document.getElementById('vtc-glyphs') as HTMLInputElement;
  const fullWidth = document.getElementById(
    'vtc-fullwidth',
  ) as HTMLInputElement;
  const preview = document.getElementById('vtc-preview') as HTMLElement;
  const copyButton = document.getElementById(
    'vtc-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('vtc-status')!;

  function update() {
    output.value = convertVertical(input.value, {
      layout: layout.value as VerticalLayout,
      maxPerColumn: Math.max(0, Math.floor(Number(maxPer.value) || 0)),
      glyphs: glyphs.checked,
      fullWidth: fullWidth.checked,
    });
    preview.textContent = input.value || (preview.dataset.empty ?? '');
    statusEl.textContent = '';
  }

  onTextInput(input, update);
  [layout, glyphs, fullWidth].forEach((el) =>
    el.addEventListener('change', update),
  );
  maxPer.addEventListener('input', update);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  update();
</script>
