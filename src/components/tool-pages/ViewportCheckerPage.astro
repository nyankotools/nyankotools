---
import Glossary from '../Glossary.astro';
import Layout from '../../layouts/Layout.astro';
import { TAILWIND_BREAKPOINTS } from '../../lib/tools/viewport-checker';
import { viewportCheckerContent } from '../../i18n/tools/viewport-checker';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = viewportCheckerContent[locale];

const breakpointRows: {
  id: string;
  label: string;
  minWidthLabel: string;
}[] = [
  {
    id: 'none',
    label: t.breakpointNoneRowLabel,
    minWidthLabel: t.minWidthNone,
  },
  ...TAILWIND_BREAKPOINTS.slice()
    .reverse()
    .map((bp) => ({
      id: bp.name,
      label: bp.name,
      minWidthLabel: t.minWidthSuffix.replace('{width}', String(bp.minWidth)),
    })),
];
---

<Layout title={t.title} description={t.description}>
  <h1 class="mb-2 text-2xl font-bold">{t.h1}</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400" set:html={t.introHtml} />

  <div class="overflow-x-auto">
    <table
      class="w-full min-w-[420px] border-collapse text-sm"
      data-orientation-landscape={t.orientationLandscape}
      data-orientation-portrait={t.orientationPortrait}
      data-breakpoint-none={t.breakpointNone}
      data-color-scheme-dark={t.colorSchemeDark}
      data-color-scheme-light={t.colorSchemeLight}
      data-touch-supported={t.touchSupported}
      data-touch-not-supported={t.touchNotSupported}
    >
      <tbody>
        {t.fieldRows.map(({ id, label }) => (
          <tr class="border-b border-gray-100 dark:border-gray-800">
            <td class="py-2 pr-4 text-gray-600 dark:text-gray-400">{label}</td>
            <td
              id={`viewport-${id}`}
              class="py-2 text-right font-mono text-gray-900 dark:text-gray-100"
            />
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.breakpointTableHeading}</h2>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[320px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-gray-200 dark:border-gray-800">
          <th class="py-2 pr-4 text-left text-gray-600 dark:text-gray-400">
            {t.columnName}
          </th>
          <th class="py-2 text-left text-gray-600 dark:text-gray-400">
            {t.columnMinWidth}
          </th>
        </tr>
      </thead>
      <tbody>
        {breakpointRows.map(({ id, label, minWidthLabel }) => (
          <tr
            id={`viewport-bp-row-${id}`}
            class="border-b border-gray-100 dark:border-gray-800"
          >
            <td class="py-2 pr-4 font-mono">{label}</td>
            <td class="py-2 font-mono">{minWidthLabel}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.whenHandyHeading}</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    {t.whenHandyItems.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <h2 class="mt-10 mb-2 text-lg font-bold">{t.notesHeading}</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    {t.notes.map((note) => (
      <li>{note}</li>
    ))}
  </ul>

  <Glossary terms={t.glossaryTerms} heading={t.glossaryHeading} />
</Layout>

<script>
  import {
    getActiveBreakpoint,
    getOrientation,
  } from '../../lib/tools/viewport-checker';

  type FieldId =
    | 'viewport'
    | 'window'
    | 'screen'
    | 'avail'
    | 'dpr'
    | 'orientation'
    | 'breakpoint'
    | 'color-scheme'
    | 'touch';

  function fieldEl(id: FieldId): HTMLElement {
    return document.getElementById(`viewport-${id}`)!;
  }

  const table = document.querySelector(
    'table[data-orientation-landscape]',
  ) as HTMLElement;
  const breakpointRowIds = ['none', 'sm', 'md', 'lg', 'xl', '2xl'] as const;

  function highlightBreakpoint(activeId: string) {
    for (const id of breakpointRowIds) {
      const row = document.getElementById(`viewport-bp-row-${id}`);
      row?.classList.toggle('bg-blue-50', id === activeId);
      row?.classList.toggle('dark:bg-blue-950/40', id === activeId);
      row?.classList.toggle('font-semibold', id === activeId);
    }
  }

  function render() {
    const width = window.innerWidth;
    const height = window.innerHeight;

    fieldEl('viewport').textContent = `${width} × ${height} px`;
    fieldEl('window').textContent =
      `${window.outerWidth} × ${window.outerHeight} px`;
    fieldEl('screen').textContent = `${screen.width} × ${screen.height} px`;
    fieldEl('avail').textContent =
      `${screen.availWidth} × ${screen.availHeight} px`;
    fieldEl('dpr').textContent = `${window.devicePixelRatio}x`;

    const orientation = getOrientation(width, height);
    fieldEl('orientation').textContent =
      orientation === 'landscape'
        ? (table.dataset.orientationLandscape ?? '')
        : (table.dataset.orientationPortrait ?? '');

    const breakpoint = getActiveBreakpoint(width);
    fieldEl('breakpoint').textContent =
      breakpoint ?? table.dataset.breakpointNone ?? '';
    highlightBreakpoint(breakpoint ?? 'none');

    fieldEl('color-scheme').textContent = window.matchMedia(
      '(prefers-color-scheme: dark)',
    ).matches
      ? (table.dataset.colorSchemeDark ?? '')
      : (table.dataset.colorSchemeLight ?? '');

    const hasTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    fieldEl('touch').textContent = hasTouch
      ? (table.dataset.touchSupported ?? '')
      : (table.dataset.touchNotSupported ?? '');
  }

  render();
  window.addEventListener('resize', render);
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', render);
</script>
