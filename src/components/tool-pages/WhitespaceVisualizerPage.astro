---
import ToolShell from '../ToolShell.astro';
import { whitespaceVisualizerContent } from '../../i18n/tools/whitespace-visualizer';
import { whitespaceCategories } from '../../lib/tools/whitespace-visualizer';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = whitespaceVisualizerContent[locale];
---

<ToolShell t={t}>
  <div>
    <label for="wv-input" class="ui-label">
      {t.inputLabel}
    </label>
    <textarea
      id="wv-input"
      data-query-target="text"
      data-sample={t.sampleText}
      class="ui-input h-48 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
      placeholder={t.inputPlaceholder}
      spellcheck="false"
    ></textarea>
  </div>

  <label class="mt-3 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
    <input id="wv-show-spaces" type="checkbox" checked class="h-4 w-4" />
    <span>{t.showSpacesLabel}</span>
  </label>

  <p
    id="wv-summary"
    class="mt-4 text-sm font-medium"
    aria-live="polite"
    data-found={t.summaryFound}
    data-none={t.summaryNone}
    data-trailing-found={t.trailingFound}
    data-trailing-none={t.trailingNone}
    data-names={JSON.stringify(t.charNames)}
    data-categories={JSON.stringify(
      Object.fromEntries(
        whitespaceCategories.map((c) => [c, t.categories[c].label]),
      ),
    )}
  ></p>
  <p id="wv-trailing" class="mt-1 text-sm text-gray-600 dark:text-gray-400"></p>

  <div class="mt-4">
    <h2 class="mb-1 text-sm font-medium">{t.countsLabel}</h2>
    <ul
      id="wv-counts"
      class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2 lg:grid-cols-4"
    >
      {whitespaceCategories.map((c) => (
        <li class="flex items-baseline justify-between gap-2 border-b border-gray-200 py-1 dark:border-gray-800">
          <span>
            {t.categories[c].label}
            <span class="ml-1 font-mono text-xs text-gray-500 dark:text-gray-400">
              {t.categories[c].symbol}
            </span>
          </span>
          <span data-count={c} class="font-medium tabular-nums">
            0
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-4">
    <div class="mb-1 flex flex-wrap items-center gap-3">
      <span id="wv-result-label" class="ui-label mb-0">
        {t.resultLabel}
      </span>
      <button
        id="wv-copy-button"
        type="button"
        data-copied={t.copied}
        data-copy-failed={t.copyFailed}
        class="ui-btn"
      >
        {t.copy}
      </button>
      <span
        id="wv-status"
        class="text-sm text-green-700 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
    <div
      id="wv-output"
      role="region"
      aria-labelledby="wv-result-label"
      tabindex="0"
      class="ui-input max-h-96 min-h-24 w-full overflow-auto bg-gray-50 p-4 font-mono text-sm break-all whitespace-pre-wrap dark:bg-gray-900"
    ></div>
  </div>

  <div id="wv-findings" class="mt-4 hidden">
    <h2 class="mb-1 text-sm font-medium">{t.findingsLabel}</h2>
    <div class="overflow-x-auto">
      <table class="w-full min-w-96 text-left text-sm">
        <thead>
          <tr class="border-b border-gray-300 dark:border-gray-700">
            <th class="py-2 pr-3 font-medium">{t.colSymbol}</th>
            <th class="py-2 pr-3 font-medium">{t.colCode}</th>
            <th class="py-2 pr-3 font-medium">{t.colName}</th>
            <th class="py-2 pr-3 font-medium">{t.colType}</th>
            <th class="py-2 text-right font-medium">{t.colCount}</th>
          </tr>
        </thead>
        <tbody id="wv-findings-body"></tbody>
      </table>
    </div>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import {
    findTrailingWhitespaceLines,
    visualizeWhitespace,
    whitespaceCategories,
  } from '../../lib/tools/whitespace-visualizer';

  const input = document.getElementById('wv-input') as HTMLTextAreaElement;
  const showSpaces = document.getElementById(
    'wv-show-spaces',
  ) as HTMLInputElement;
  const output = document.getElementById('wv-output')!;
  const summaryEl = document.getElementById('wv-summary')!;
  const trailingEl = document.getElementById('wv-trailing')!;
  const findingsEl = document.getElementById('wv-findings')!;
  const findingsBody = document.getElementById('wv-findings-body')!;
  const copyButton = document.getElementById(
    'wv-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('wv-status')!;

  const names = JSON.parse(summaryEl.dataset.names ?? '{}') as Record<
    string,
    string
  >;
  const categoryLabels = JSON.parse(
    summaryEl.dataset.categories ?? '{}',
  ) as Record<string, string>;

  const markClass =
    'rounded bg-amber-200 px-0.5 text-amber-900 dark:bg-amber-900 dark:text-amber-100';

  let lastText = '';

  function addCell(row: HTMLTableRowElement, text: string, className: string) {
    const td = row.insertCell();
    td.textContent = text;
    td.className = className;
  }

  function update() {
    statusEl.textContent = '';
    const value = input.value;
    const result = visualizeWhitespace(value, {
      showSpaces: showSpaces.checked,
    });
    lastText = result.text;

    output.replaceChildren(
      ...result.segments.map((seg) => {
        if (seg.category === null) return document.createTextNode(seg.text);
        const span = document.createElement('span');
        span.className = markClass;
        span.textContent = seg.text;
        return span;
      }),
    );

    summaryEl.textContent =
      result.total === 0
        ? (summaryEl.dataset.none ?? '')
        : (summaryEl.dataset.found ?? '').replace(
            '{total}',
            String(result.total),
          );

    const trailing = findTrailingWhitespaceLines(value);
    trailingEl.textContent =
      value === ''
        ? ''
        : trailing.length === 0
          ? (summaryEl.dataset.trailingNone ?? '')
          : (summaryEl.dataset.trailingFound ?? '').replace(
              '{lines}',
              trailing.join(', '),
            );

    for (const c of whitespaceCategories) {
      const el = document.querySelector(`[data-count="${c}"]`);
      if (el) el.textContent = String(result.counts[c]);
    }

    findingsBody.replaceChildren();
    findingsEl.classList.toggle('hidden', result.findings.length === 0);
    for (const f of result.findings) {
      const row = findingsBody.appendChild(document.createElement('tr'));
      row.className = 'border-b border-gray-200 dark:border-gray-800';
      addCell(row, f.symbol, 'py-2 pr-3 font-mono whitespace-nowrap');
      addCell(row, f.code, 'py-2 pr-3 font-mono whitespace-nowrap');
      addCell(
        row,
        names[f.code] ?? categoryLabels[f.category] ?? '',
        'py-2 pr-3',
      );
      addCell(row, categoryLabels[f.category] ?? '', 'py-2 pr-3');
      addCell(row, String(f.count), 'py-2 text-right tabular-nums');
    }
  }

  onTextInput(input, update);
  showSpaces.addEventListener('change', update);

  copyButton.addEventListener('click', async () => {
    if (!lastText) return;
    statusEl.textContent = (await copyText(lastText))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  update();
</script>
