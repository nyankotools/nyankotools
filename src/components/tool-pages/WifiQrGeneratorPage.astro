---
import ToolShell from '../ToolShell.astro';
import { wifiQrGeneratorContent } from '../../i18n/tools/wifi-qr-generator';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = wifiQrGeneratorContent[locale];
---

<ToolShell t={t}>
  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label for="wifi-qr-ssid" class="ui-label">
        {t.ssidLabel}
      </label>
      <input
        id="wifi-qr-ssid"
        type="text"
        data-no-persist
        autocomplete="off"
        spellcheck="false"
        class="ui-input h-11 w-full px-3 dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.ssidPlaceholder}
      />

      <div class="mt-4">
        <label for="wifi-qr-security" class="ui-label">
          {t.securityLabel}
        </label>
        <select
          id="wifi-qr-security"
          data-no-persist
          class="ui-input h-11 px-3 dark:bg-gray-900"
        >
          {t.securityOptions.map(({ value, label, selected }) => (
            <option value={value} selected={selected}>
              {label}
            </option>
          ))}
        </select>
      </div>

      <div id="wifi-qr-password-area" class="mt-4">
        <label for="wifi-qr-password" class="ui-label">
          {t.passwordLabel}
        </label>
        <input
          id="wifi-qr-password"
          type="password"
          data-no-persist
          autocomplete="off"
          spellcheck="false"
          class="ui-input h-11 w-full px-3 dark:bg-gray-900"
        />
        <label class="ui-check">
          <input type="checkbox" id="wifi-qr-show-password" data-no-persist />
          {t.showPasswordLabel}
        </label>
      </div>

      <label class="ui-check">
        <input type="checkbox" id="wifi-qr-hidden" data-no-persist />
        {t.hiddenLabel}
      </label>

      <div class="mt-2 flex flex-wrap gap-4">
        <div>
          <label for="wifi-qr-level" class="ui-label">
            {t.levelLabel}
          </label>
          <select
            id="wifi-qr-level"
            data-no-persist
            class="ui-input h-11 px-3 dark:bg-gray-900"
          >
            {t.levelOptions.map(({ value, label, selected }) => (
              <option value={value} selected={selected}>
                {label}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="wifi-qr-size" class="ui-label">
            {t.sizeLabel}
          </label>
          <select
            id="wifi-qr-size"
            data-no-persist
            class="ui-input h-11 px-3 dark:bg-gray-900"
          >
            {t.sizeOptions.map(({ value, label, selected }) => (
              <option value={value} selected={selected}>
                {label}
              </option>
            ))}
          </select>
        </div>
      </div>

      <p
        id="wifi-qr-message"
        data-ssid-empty={t.errorSsidEmpty}
        data-password-empty={t.errorPasswordEmpty}
        data-too-long={t.errorTooLong}
        data-password-short={t.warnPasswordShort}
        data-password-long={t.warnPasswordLong}
        class="mt-3 text-sm text-red-700 dark:text-red-400"
        aria-live="polite"
      ></p>
    </div>

    <div class="flex flex-col items-center gap-3">
      <canvas
        id="wifi-qr-canvas"
        class="h-64 w-64 max-w-full rounded-lg border border-gray-300 bg-white dark:border-gray-700"
      ></canvas>
      <button
        id="wifi-qr-download-button"
        type="button"
        disabled
        class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-gray-700 dark:disabled:text-gray-400"
      >
        {t.downloadButton}
      </button>
      <span
        id="wifi-qr-status"
        data-downloaded={t.downloaded}
        class="text-sm text-green-700 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>
</ToolShell>

<script>
  import { downloadBlob } from '../../lib/download';
  import { generateQrMatrix } from '../../lib/tools/qr-generator';
  import type {
    ErrorCorrectionLevel,
    QrMatrix,
  } from '../../lib/tools/qr-generator';
  import {
    buildWifiPayload,
    checkPasswordLength,
  } from '../../lib/tools/wifi-qr-generator';
  import type { WifiSecurity } from '../../lib/tools/wifi-qr-generator';

  const QUIET_ZONE_MODULES = 4;

  const ssidInput = document.getElementById('wifi-qr-ssid') as HTMLInputElement;
  const securitySelect = document.getElementById(
    'wifi-qr-security',
  ) as HTMLSelectElement;
  const passwordArea = document.getElementById('wifi-qr-password-area')!;
  const passwordInput = document.getElementById(
    'wifi-qr-password',
  ) as HTMLInputElement;
  const showPassword = document.getElementById(
    'wifi-qr-show-password',
  ) as HTMLInputElement;
  const hiddenCheck = document.getElementById(
    'wifi-qr-hidden',
  ) as HTMLInputElement;
  const levelSelect = document.getElementById(
    'wifi-qr-level',
  ) as HTMLSelectElement;
  const sizeSelect = document.getElementById(
    'wifi-qr-size',
  ) as HTMLSelectElement;
  const canvas = document.getElementById('wifi-qr-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const messageEl = document.getElementById('wifi-qr-message')!;
  const statusEl = document.getElementById('wifi-qr-status')!;
  const downloadButton = document.getElementById(
    'wifi-qr-download-button',
  ) as HTMLButtonElement;

  const downloaded = statusEl.dataset.downloaded ?? '';

  function drawMatrix(matrix: QrMatrix, targetSize: number) {
    const cellSize = Math.max(
      1,
      Math.floor(targetSize / (matrix.moduleCount + QUIET_ZONE_MODULES * 2)),
    );
    const canvasSize = (matrix.moduleCount + QUIET_ZONE_MODULES * 2) * cellSize;

    canvas.width = canvasSize;
    canvas.height = canvasSize;

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvasSize, canvasSize);
    ctx.fillStyle = '#000000';
    for (let row = 0; row < matrix.moduleCount; row++) {
      for (let col = 0; col < matrix.moduleCount; col++) {
        if (matrix.isDark(row, col)) {
          ctx.fillRect(
            (col + QUIET_ZONE_MODULES) * cellSize,
            (row + QUIET_ZONE_MODULES) * cellSize,
            cellSize,
            cellSize,
          );
        }
      }
    }
  }

  function clearCanvas() {
    canvas.width = 256;
    canvas.height = 256;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }

  function showMessage(text: string, isWarning = false) {
    messageEl.textContent = text;
    messageEl.classList.toggle('text-red-700', !isWarning);
    messageEl.classList.toggle('dark:text-red-400', !isWarning);
    messageEl.classList.toggle('text-amber-700', isWarning);
    messageEl.classList.toggle('dark:text-amber-400', isWarning);
  }

  function generate() {
    statusEl.textContent = '';
    showMessage('');

    const security = securitySelect.value as WifiSecurity;
    passwordArea.hidden = security === 'nopass';

    const result = buildWifiPayload({
      ssid: ssidInput.value,
      password: passwordInput.value,
      security,
      hidden: hiddenCheck.checked,
    });

    if (!result.ok) {
      clearCanvas();
      downloadButton.disabled = true;
      // 何も入力していない段階ではエラーを出さない
      const touched = ssidInput.value !== '' || passwordInput.value !== '';
      if (touched) {
        showMessage(
          (result.reason === 'ssid-empty'
            ? messageEl.dataset.ssidEmpty
            : messageEl.dataset.passwordEmpty) ?? '',
        );
      }
      return;
    }

    const qr = generateQrMatrix(
      result.payload,
      levelSelect.value as ErrorCorrectionLevel,
    );
    if (!qr.ok) {
      clearCanvas();
      downloadButton.disabled = true;
      showMessage(messageEl.dataset.tooLong ?? '');
      return;
    }

    drawMatrix(qr.matrix, Number(sizeSelect.value));
    downloadButton.disabled = false;

    const issue = checkPasswordLength(security, passwordInput.value);
    if (issue === 'too-short') {
      showMessage(messageEl.dataset.passwordShort ?? '', true);
    } else if (issue === 'too-long') {
      showMessage(messageEl.dataset.passwordLong ?? '', true);
    }
  }

  ssidInput.addEventListener('input', generate);
  passwordInput.addEventListener('input', generate);
  securitySelect.addEventListener('change', generate);
  hiddenCheck.addEventListener('change', generate);
  levelSelect.addEventListener('change', generate);
  sizeSelect.addEventListener('change', generate);
  showPassword.addEventListener('change', () => {
    passwordInput.type = showPassword.checked ? 'text' : 'password';
  });

  downloadButton.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      downloadBlob(blob, 'wifi-qrcode.png');
      statusEl.textContent = downloaded;
    }, 'image/png');
  });

  clearCanvas();
  generate();
</script>
