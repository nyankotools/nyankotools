---
import ToolShell from '../ToolShell.astro';
import { xmlFormatterContent } from '../../i18n/tools/xml-formatter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = xmlFormatterContent[locale];
---

<ToolShell t={t}>
  <div class="flex flex-wrap items-center gap-3">
    <label
      for="xml-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.indentLabel}
    </label>
    <select
      id="xml-formatter-indent"
      class="ui-input bg-white px-3 py-2 dark:bg-gray-900"
    >
      <option value="2">{t.indentOption2}</option>
      <option value="4">{t.indentOption4}</option>
      <option value="tab">{t.indentOptionTab}</option>
      <option value="min">{t.indentOptionMin}</option>
    </select>
    <label class="ui-check">
      <input type="checkbox" id="xml-formatter-break-attributes" />
      {t.breakAttributesLabel}
    </label>
    <label class="ui-check">
      <input type="checkbox" id="xml-formatter-remove-comments" />
      {t.removeCommentsLabel}
    </label>
    <button
      id="xml-formatter-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="ui-btn"
    >
      {t.copy}
    </button>
    <span
      id="xml-formatter-status"
      class="text-sm text-green-700 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label for="xml-formatter-input" class="ui-label">
        {t.inputLabel}
      </label>
      <textarea
        id="xml-formatter-input"
        data-query-target="text"
        class="ui-input h-80 w-full p-4 font-mono dark:bg-gray-900 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholder}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label for="xml-formatter-output" class="ui-label">
        {t.outputLabel}
      </label>
      <textarea
        id="xml-formatter-output"
        readonly
        wrap="off"
        class="ui-input h-80 w-full bg-gray-50 p-4 font-mono dark:bg-gray-900"
      ></textarea>
    </div>
  </div>

  <div
    id="xml-formatter-error"
    hidden
    data-error-prefix={t.syntaxErrorPrefix}
    data-location-template={t.errorLocationTemplate}
    data-excerpt-label={t.errorExcerptLabel}
    class="ui-error mt-4 max-w-2xl"
  >
    <p id="xml-formatter-error-message" class="break-words"></p>
    <pre
      id="xml-formatter-error-excerpt"
      hidden
      class="mt-2 overflow-x-auto font-mono text-xs whitespace-pre"
    ></pre>
  </div>
</ToolShell>

<script>
  import { onTextInput } from '../../lib/input-scheduler';
  import { copyText } from '../../lib/clipboard';
  import { formatXml, type XmlIndent } from '../../lib/tools/xml-formatter';

  const input = document.getElementById(
    'xml-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'xml-formatter-output',
  ) as HTMLTextAreaElement;
  const indentSelect = document.getElementById(
    'xml-formatter-indent',
  ) as HTMLSelectElement;
  const breakAttrsCheck = document.getElementById(
    'xml-formatter-break-attributes',
  ) as HTMLInputElement;
  const removeCommentsCheck = document.getElementById(
    'xml-formatter-remove-comments',
  ) as HTMLInputElement;
  const copyButton = document.getElementById(
    'xml-formatter-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('xml-formatter-status')!;
  const errorEl = document.getElementById('xml-formatter-error')!;
  const errorMessageEl = document.getElementById(
    'xml-formatter-error-message',
  )!;
  const excerptEl = document.getElementById('xml-formatter-error-excerpt')!;

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorMessageEl.textContent = '';
    excerptEl.hidden = true;
    excerptEl.textContent = '';
  }

  function showError(
    message: string,
    line: number | null,
    column: number | null,
  ) {
    output.value = '';
    let text = `${errorEl.dataset.errorPrefix ?? ''}: ${message}`;
    if (line !== null && column !== null) {
      const location = (errorEl.dataset.locationTemplate ?? '')
        .replace('{line}', String(line))
        .replace('{column}', String(column));
      text += ` (${location})`;
      const source = input.value.split(/\r\n|\r|\n/)[line - 1];
      if (source !== undefined) {
        // 長い行は該当列の周辺だけを切り出す
        const start = Math.max(0, column - 60);
        const clipped = source.slice(start, start + 120);
        const pointer = ' '.repeat(Math.max(0, column - 1 - start)) + '^';
        excerptEl.textContent = `${errorEl.dataset.excerptLabel ?? ''} ${line}:\n${clipped}\n${pointer}`;
        excerptEl.hidden = false;
      }
    } else {
      excerptEl.hidden = true;
      excerptEl.textContent = '';
    }
    errorMessageEl.textContent = text;
    errorEl.hidden = false;
  }

  function run() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = formatXml(input.value, {
      indent: indentSelect.value as XmlIndent,
      breakAttributes: breakAttrsCheck.checked,
      removeComments: removeCommentsCheck.checked,
    });
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message, result.line, result.column);
    }
  }

  function syncOptions() {
    breakAttrsCheck.disabled = indentSelect.value === 'min';
  }

  onTextInput(input, run);
  indentSelect.addEventListener('change', () => {
    syncOptions();
    run();
  });
  breakAttrsCheck.addEventListener('change', run);
  removeCommentsCheck.addEventListener('change', run);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    statusEl.textContent = (await copyText(output.value))
      ? (copyButton.dataset.copied ?? '')
      : (copyButton.dataset.copyFailed ?? '');
  });

  syncOptions();
  run();
</script>
