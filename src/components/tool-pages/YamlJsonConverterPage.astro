---
import Glossary from '../Glossary.astro';
import Layout from '../../layouts/Layout.astro';
import { yamlJsonConverterContent } from '../../i18n/tools/yaml-json-converter';
import type { Locale } from '../../data/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = yamlJsonConverterContent[locale];
---

<Layout title={t.title} description={t.description}>
  <h1 class="mb-2 text-2xl font-bold">{t.h1}</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400" set:html={t.introHtml} />

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="yaml-json-converter-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label={t.modeAriaLabel}
    >
      <button
        type="button"
        data-mode="yamlToJson"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        {t.modeYamlToJson}
      </button>
      <button
        type="button"
        data-mode="jsonToYaml"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        {t.modeJsonToYaml}
      </button>
    </div>
    <label
      for="yaml-json-converter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      {t.indentLabel}
    </label>
    <select
      id="yaml-json-converter-indent"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="2">{t.indentOption2}</option>
      <option value="4">{t.indentOption4}</option>
    </select>
    <button
      id="yaml-json-converter-copy-button"
      type="button"
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      {t.copy}
    </button>
    <span
      id="yaml-json-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="yaml-json-converter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.inputLabel}
      </label>
      <textarea
        id="yaml-json-converter-input"
        data-placeholder-yaml-to-json={t.inputPlaceholderYamlToJson}
        data-placeholder-json-to-yaml={t.inputPlaceholderJsonToYaml}
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={t.inputPlaceholderYamlToJson}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="yaml-json-converter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        {t.outputLabel}
      </label>
      <textarea
        id="yaml-json-converter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="yaml-json-converter-error"
    hidden
    data-error-prefix={t.syntaxErrorPrefix}
    class="mt-4 max-w-2xl whitespace-pre-line rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={t.glossaryTerms} heading={t.glossaryHeading} />
</Layout>

<script>
  import {
    yamlToJson,
    jsonToYaml,
    type ConvertOutcome,
  } from '../../lib/tools/yaml-json-converter';

  type Mode = 'yamlToJson' | 'jsonToYaml';

  const input = document.getElementById(
    'yaml-json-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'yaml-json-converter-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#yaml-json-converter-mode [data-mode]',
  );
  const indentSelect = document.getElementById(
    'yaml-json-converter-indent',
  ) as HTMLSelectElement;
  const copyButton = document.getElementById(
    'yaml-json-converter-copy-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('yaml-json-converter-status')!;
  const errorEl = document.getElementById('yaml-json-converter-error')!;

  let mode: Mode = 'yamlToJson';

  const placeholders: Record<Mode, string> = {
    yamlToJson: input.dataset.placeholderYamlToJson ?? '',
    jsonToYaml: input.dataset.placeholderJsonToYaml ?? '',
  };

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `${errorEl.dataset.errorPrefix ?? ''}: ${message}`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const indent = Number(indentSelect.value);
    const result: ConvertOutcome =
      mode === 'yamlToJson'
        ? yamlToJson(input.value, indent)
        : jsonToYaml(input.value, indent);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  input.addEventListener('input', convert);
  indentSelect.addEventListener('change', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      input.placeholder = placeholders[mode];
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = copyButton.dataset.copied ?? '';
    } catch {
      statusEl.textContent = copyButton.dataset.copyFailed ?? '';
    }
  });

  convert();
</script>
