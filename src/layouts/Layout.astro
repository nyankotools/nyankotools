---
import '../styles/global.css';
import { getLocalizedTools, type Locale } from '../data/tools';
import {
  useTranslations,
  languageNames,
  ogLocaleMap,
  getAlternatePath,
} from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://nyankotools.com/ogp.png',
  noindex = false,
} = Astro.props;

const lang: Locale = Astro.currentLocale === 'en' ? 'en' : 'ja';
const t = useTranslations(lang);
const localizedTools = getLocalizedTools(lang);

const pathname = Astro.url.pathname;
const alternatePath = getAlternatePath(pathname, lang);
const alternateLang: Locale = lang === 'ja' ? 'en' : 'ja';

const canonicalURL = new URL(pathname, Astro.site);
const jaURL = new URL(lang === 'ja' ? pathname : alternatePath, Astro.site);
const enURL = new URL(lang === 'en' ? pathname : alternatePath, Astro.site);

const siteName = t('site.name');
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="alternate" hreflang="ja" href={jaURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="x-default" href={jaURL} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    <meta property="og:locale:alternate" content={ogLocaleMap[alternateLang]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nyankotools" />
    <meta name="twitter:creator" content="@nyankotools" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <div class="flex min-h-screen flex-col md:flex-row">
      <header class="flex items-center justify-between border-b border-gray-200 bg-white p-4 md:hidden">
        <a href={lang === 'en' ? '/en/' : '/'} class="block">
          <img src="/logo.png" alt={siteName} class="h-8 w-auto" />
        </a>
        <button
          id="sidebar-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="sidebar"
          aria-label={t('nav.menu.open')}
          class="rounded p-2 text-gray-700 hover:bg-gray-100"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </header>

      <div
        id="sidebar-overlay"
        class="fixed inset-0 z-30 hidden bg-black/40 md:hidden"
      ></div>

      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-40 w-72 max-w-[80%] -translate-x-full overflow-y-auto border-r border-gray-200 bg-white p-4 transition-transform duration-200 ease-in-out md:static md:z-auto md:w-64 md:translate-x-0 md:border-r"
      >
        <a href={lang === 'en' ? '/en/' : '/'} class="mb-4 hidden md:block">
          <img
            src="/logo.png"
            alt={siteName}
            class="h-auto w-full"
            width="1376"
            height="280"
          />
        </a>
        <nav>
          <ul class="space-y-1">
            {localizedTools.map((tool) => {
              const href =
                lang === 'en'
                  ? `/en/tools/${tool.slug}/`
                  : `/tools/${tool.slug}/`;
              return (
                <li>
                  <a
                    href={href}
                    class="block rounded px-3 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-700 aria-[current=page]:bg-blue-50 aria-[current=page]:font-semibold aria-[current=page]:text-blue-700"
                    aria-current={pathname === href ? 'page' : undefined}
                  >
                    {tool.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        <div class="mt-4 border-t border-gray-200 pt-4">
          <span class="sr-only">{t('nav.language')}</span>
          <div
            class="flex gap-2 text-sm"
            role="group"
            aria-label={t('nav.language')}
          >
            <a
              href={jaURL.pathname}
              hreflang="ja"
              aria-current={lang === 'ja' ? 'true' : undefined}
              class="rounded px-2 py-1 text-gray-600 hover:bg-blue-50 hover:text-blue-700 aria-[current=true]:font-semibold aria-[current=true]:text-blue-700"
            >
              {languageNames.ja}
            </a>
            <span class="text-gray-300" aria-hidden="true">
              |
            </span>
            <a
              href={enURL.pathname}
              hreflang="en"
              aria-current={lang === 'en' ? 'true' : undefined}
              class="rounded px-2 py-1 text-gray-600 hover:bg-blue-50 hover:text-blue-700 aria-[current=true]:font-semibold aria-[current=true]:text-blue-700"
            >
              {languageNames.en}
            </a>
          </div>
        </div>
      </aside>
      <main class="flex min-w-0 flex-1 flex-col p-4 sm:p-6 md:p-10">
        <div class="flex-1">
          <slot />
        </div>
        <footer class="mt-10 border-t border-gray-200 pt-4 text-xs text-gray-500">
          <a
            href={lang === 'en' ? '/en/privacy-policy/' : '/privacy-policy/'}
            class="hover:text-blue-700 hover:underline"
          >
            {t('footer.privacy')}
          </a>
        </footer>
      </main>
    </div>

    <script>
      const toggle = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      const mql = window.matchMedia('(min-width: 768px)');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        sidebar?.classList.add('translate-x-0');
        overlay?.classList.remove('hidden');
        toggle?.setAttribute('aria-expanded', 'true');
        document.body.classList.add('overflow-hidden');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        sidebar?.classList.remove('translate-x-0');
        overlay?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
      }

      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeSidebar();
        } else {
          openSidebar();
        }
      });

      overlay?.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeSidebar();
        }
      });

      mql.addEventListener('change', (event) => {
        if (event.matches) {
          closeSidebar();
        }
      });
    </script>
  </body>
</html>
