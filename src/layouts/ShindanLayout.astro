---
// 診断セクション（/shindan/）の外枠。<head> は Layout が出し、ここではツール用サイドバーの代わりに専用ナビを置く。
// 日本語のみのため hreflang は出さず、言語切替は英語版トップへ向ける（設計書16.7）。
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { shindanUiJa as ui } from '../i18n/shindan/ui';

interface Props {
  title: string;
  description: string;
  structuredName?: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, structuredName, breadcrumbs } = Astro.props;
---

<Layout
  title={title}
  description={description}
  structuredName={structuredName}
  breadcrumbs={breadcrumbs}
  shell="minimal"
  alternates={false}
  adPage
>
  <header
    slot="nav"
    class="border-b border-gray-200 bg-white print:hidden dark:border-gray-800 dark:bg-gray-900"
  >
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-2 px-4 py-2">
      <a
        href="/shindan/"
        class="flex min-h-11 items-center text-lg font-bold text-[#4a2f63] dark:text-violet-200"
      >
        {ui.sectionName}
      </a>
      <div class="flex items-center gap-1 text-sm">
        <a
          href="/"
          class="flex min-h-11 items-center rounded px-2 text-gray-700 hover:bg-gray-100 hover:text-blue-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-blue-400"
        >
          {ui.toolsLink}
        </a>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          class="flex min-h-11 items-center rounded px-2 font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          EN
        </a>
        <ThemeToggle id="theme-toggle-shindan" />
      </div>
    </div>
  </header>
  <slot />
</Layout>
