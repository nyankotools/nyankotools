---
import Layout from '../../../layouts/Layout.astro';
import { CONTACT_EMAIL } from '../../../lib/contact-form';
---

<Layout
  title="Contact"
  description="Contact page for NyankoTools. Send bug reports or feature requests through your own mail client — no server ever sees your message."
>
  <h1 class="mb-2 text-2xl font-bold">Contact</h1>
  <p class="mb-6 max-w-2xl text-gray-600 dark:text-gray-400">
    Feel free to reach out with bug reports, feature requests, or questions
    about any tool.
  </p>

  <div class="mb-8 max-w-2xl rounded-lg bg-blue-50 p-4 text-sm text-gray-700 dark:bg-blue-950/30 dark:text-gray-300">
    This site is a fully static website with no server backend. Unlike a typical
    contact form, your message is never sent through a server we operate.
    Everything you type below stays in your browser, and clicking "Open in Mail
    App" simply launches your own email client with the message pre-filled. If
    you don't have a mail client configured, use "Copy Message" instead and
    paste it into your email service of choice.
  </div>

  <div id="contact-form" class="max-w-2xl space-y-4">
    <div>
      <label
        for="contact-category"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Category
      </label>
      <select
        id="contact-category"
        class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      >
        <option>Bug report</option>
        <option>Feature request</option>
        <option>Question about a tool</option>
        <option>Other</option>
      </select>
    </div>

    <div>
      <label
        for="contact-name"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Name (optional)
      </label>
      <input
        id="contact-name"
        type="text"
        class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="Jane Doe"
      />
    </div>

    <div>
      <label
        for="contact-message"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Message
      </label>
      <textarea
        id="contact-message"
        class="h-40 w-full rounded-lg border border-gray-300 p-2 text-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="Describe the bug or feature you'd like to see"
      ></textarea>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <button
        id="contact-mailto"
        type="button"
        class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Open in Mail App
      </button>
      <button
        id="contact-copy"
        type="button"
        class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-semibold hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800"
      >
        Copy Message
      </button>
      <span id="contact-status" class="text-sm" aria-live="polite"></span>
    </div>
  </div>

  <section class="mt-10 max-w-2xl border-t border-gray-200 pt-6 dark:border-gray-800">
    <h2 class="mb-2 text-lg font-semibold">No mail client configured?</h2>
    <p class="mb-2 text-gray-600 dark:text-gray-400">
      If your device doesn't have a mail client set up, send an email directly
      to the address below.
    </p>
    <div class="flex items-center gap-2">
      <code class="rounded bg-gray-100 px-2 py-1 text-sm dark:bg-gray-800">
        {CONTACT_EMAIL}
      </code>
      <button
        id="contact-email-copy"
        type="button"
        class="min-h-11 rounded-lg border border-gray-300 px-3 text-sm hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800"
      >
        Copy
      </button>
    </div>
  </section>
</Layout>

<script>
  import { copyText } from '../../../lib/clipboard';
  import {
    buildMailtoLink,
    formatMailBody,
    CONTACT_EMAIL,
  } from '../../../lib/contact-form';

  const categorySelect = document.getElementById(
    'contact-category',
  ) as HTMLSelectElement;
  const nameInput = document.getElementById('contact-name') as HTMLInputElement;
  const messageInput = document.getElementById(
    'contact-message',
  ) as HTMLTextAreaElement;
  const statusEl = document.getElementById('contact-status')!;
  const mailtoButton = document.getElementById(
    'contact-mailto',
  ) as HTMLButtonElement;
  const copyButton = document.getElementById(
    'contact-copy',
  ) as HTMLButtonElement;
  const emailCopyButton = document.getElementById(
    'contact-email-copy',
  ) as HTMLButtonElement;

  const labels = { categoryLabel: 'Category', nameLabel: 'Name' };
  const subjectPrefix = '[NyankoTools Contact] ';

  const SUCCESS_CLASS = 'text-sm text-green-600 dark:text-green-400';
  const ERROR_CLASS = 'text-sm text-red-600 dark:text-red-400';

  function setStatus(message: string, isError: boolean) {
    statusEl.textContent = message;
    statusEl.className = isError ? ERROR_CLASS : SUCCESS_CLASS;
  }

  function getValues() {
    return {
      category: categorySelect.value,
      name: nameInput.value,
      message: messageInput.value,
    };
  }

  function validate(): boolean {
    if (!messageInput.value.trim()) {
      setStatus('Please enter a message', true);
      messageInput.focus();
      return false;
    }
    return true;
  }

  mailtoButton.addEventListener('click', () => {
    if (!validate()) return;
    setStatus('', false);
    window.location.href = buildMailtoLink(getValues(), labels, subjectPrefix);
  });

  copyButton.addEventListener('click', async () => {
    if (!validate()) return;
    if (await copyText(formatMailBody(getValues(), labels))) {
      setStatus('Copied', false);
    } else {
      setStatus('Copy failed', true);
    }
  });

  emailCopyButton.addEventListener('click', async () => {
    if (await copyText(CONTACT_EMAIL)) {
      setStatus('Email address copied', false);
    } else {
      setStatus('Copy failed', true);
    }
  });
</script>
