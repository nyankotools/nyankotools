---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Kazoedoshi (traditional East Asian age)',
    description:
      "A traditional way of counting age used in Japan, where a person is 1 year old at birth and gains a year on every New Year's Day (January 1), regardless of their actual birthday. It is unrelated to whether the birthday has been reached yet, and still appears in some traditional ceremonies.",
  },
  {
    term: 'Age increment law (Japan)',
    description:
      'Under Japanese law, a person\'s age legally increases at the end of the day before their birthday, not on the birthday itself. Combined with the Japanese school year starting April 1, this is why children born on April 1 are grouped with the older school-year cohort ("early-born", or hayaumare). This tool\'s age uses the everyday convention of incrementing on the birthday itself, not this legal one-day offset.',
  },
  {
    term: 'Leap year',
    description:
      'A year with an extra day (February 29), occurring every 4 years — except years divisible by 100, which are not leap years unless also divisible by 400. For someone born on February 29, this tool treats February 28 as their birthday in non-leap years.',
  },
];
---

<Layout
  title="Age Calculator (Exact Age, Days Since Birth, Next Birthday)"
  description="A free tool to calculate your exact age, the traditional East Asian age, the number of days since birth, and the days remaining until your next birthday, just from your date of birth. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Age Calculator</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Enter a date of birth to instantly calculate the exact age, the traditional
    East Asian age (kazoedoshi), the number of days lived since birth, and the
    days remaining until the next birthday. The reference date defaults to
    today, but you can change it to check "how old will this person be on
    such-and-such date". Everything happens in your browser, and nothing you
    type is ever sent to a server. To calculate the difference between two
    arbitrary dates, check out the
    <a
      href="/en/tools/date-calculator/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Date Calculator
    </a>
    , or to convert a date to the Japanese era calendar, the
    <a
      href="/en/tools/japanese-era-converter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Japanese Era Converter
    </a>
    .
  </p>

  <section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span
          id="age-calc-birth-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Date of birth
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="age-calc-birth-label"
        >
          <input
            id="age-calc-birth-year"
            type="number"
            inputmode="numeric"
            min="1"
            max="9999"
            placeholder="1990"
            aria-label="Birth year"
            class="h-11 w-24 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="age-calc-birth-month"
            type="number"
            inputmode="numeric"
            min="1"
            max="12"
            placeholder="6"
            aria-label="Birth month"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="age-calc-birth-day"
            type="number"
            inputmode="numeric"
            min="1"
            max="31"
            placeholder="15"
            aria-label="Birth day"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
        </div>
      </div>
      <div>
        <span
          id="age-calc-reference-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Reference date
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="age-calc-reference-label"
        >
          <input
            id="age-calc-reference-year"
            type="number"
            inputmode="numeric"
            min="1"
            max="9999"
            placeholder="2024"
            aria-label="Reference year"
            class="h-11 w-24 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="age-calc-reference-month"
            type="number"
            inputmode="numeric"
            min="1"
            max="12"
            placeholder="6"
            aria-label="Reference month"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="age-calc-reference-day"
            type="number"
            inputmode="numeric"
            min="1"
            max="31"
            placeholder="15"
            aria-label="Reference day"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
        </div>
      </div>
    </div>
    <p
      id="age-calc-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <dl id="age-calc-results" class="mt-4 hidden space-y-3" aria-live="polite">
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">Exact age</dt>
        <dd class="text-2xl font-bold" id="age-calc-full-age"></dd>
        <dd
          class="text-sm text-gray-600 dark:text-gray-400"
          id="age-calc-precise-age"
        ></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Kazoedoshi (traditional age)
        </dt>
        <dd class="text-lg font-semibold" id="age-calc-kazoedoshi"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">Days lived</dt>
        <dd class="text-lg font-semibold" id="age-calc-days-lived"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">
          Day of the week born
        </dt>
        <dd class="text-lg font-semibold" id="age-calc-weekday"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">Next birthday</dt>
        <dd class="text-lg font-semibold" id="age-calc-next-birthday"></dd>
      </div>
    </dl>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      The exact age uses the common convention of incrementing on the birthday
      itself, not Japan's legal age-increment rule (see the "Age increment law"
      glossary entry for details).
    </li>
    <li>This tool assumes the Gregorian calendar throughout.</li>
    <li>The supported date range is year 0001 through 9999.</li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    calculateDaysLived,
    calculateFullAge,
    calculateKazoedoshi,
    calculateNextBirthday,
    calculatePreciseAge,
  } from '../../../../lib/tools/age-calculator';
  import {
    getWeekday,
    type DateParts,
  } from '../../../../lib/tools/date-calculator';

  const WEEKDAY_LABELS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  function readDateInputs(
    yearInput: HTMLInputElement,
    monthInput: HTMLInputElement,
    dayInput: HTMLInputElement,
  ): DateParts | null {
    if (
      yearInput.value.trim() === '' ||
      monthInput.value.trim() === '' ||
      dayInput.value.trim() === ''
    ) {
      return null;
    }
    return {
      year: Number(yearInput.value),
      month: Number(monthInput.value),
      day: Number(dayInput.value),
    };
  }

  const birthYearInput = document.getElementById(
    'age-calc-birth-year',
  ) as HTMLInputElement;
  const birthMonthInput = document.getElementById(
    'age-calc-birth-month',
  ) as HTMLInputElement;
  const birthDayInput = document.getElementById(
    'age-calc-birth-day',
  ) as HTMLInputElement;
  const referenceYearInput = document.getElementById(
    'age-calc-reference-year',
  ) as HTMLInputElement;
  const referenceMonthInput = document.getElementById(
    'age-calc-reference-month',
  ) as HTMLInputElement;
  const referenceDayInput = document.getElementById(
    'age-calc-reference-day',
  ) as HTMLInputElement;

  const errorEl = document.getElementById('age-calc-error')!;
  const resultsEl = document.getElementById('age-calc-results')!;
  const fullAgeEl = document.getElementById('age-calc-full-age')!;
  const preciseAgeEl = document.getElementById('age-calc-precise-age')!;
  const kazoedoshiEl = document.getElementById('age-calc-kazoedoshi')!;
  const daysLivedEl = document.getElementById('age-calc-days-lived')!;
  const weekdayEl = document.getElementById('age-calc-weekday')!;
  const nextBirthdayEl = document.getElementById('age-calc-next-birthday')!;

  function pluralize(count: number, unit: string): string {
    return `${count} ${unit}${count === 1 ? '' : 's'}`;
  }

  function render() {
    errorEl.textContent = '';
    resultsEl.classList.add('hidden');

    const birth = readDateInputs(
      birthYearInput,
      birthMonthInput,
      birthDayInput,
    );
    const reference = readDateInputs(
      referenceYearInput,
      referenceMonthInput,
      referenceDayInput,
    );
    if (!birth || !reference) return;

    const fullAge = calculateFullAge(birth, reference);
    if (fullAge === null) {
      errorEl.textContent =
        'Could not calculate (please enter a date of birth that actually exists and is on or before the reference date)';
      return;
    }

    const precise = calculatePreciseAge(birth, reference)!;
    const kazoedoshi = calculateKazoedoshi(birth, reference)!;
    const daysLived = calculateDaysLived(birth, reference)!;
    const weekday = getWeekday(birth.year, birth.month, birth.day)!;
    const next = calculateNextBirthday(birth, reference)!;

    fullAgeEl.textContent = pluralize(fullAge, 'year old');
    preciseAgeEl.textContent = `(${pluralize(precise.years, 'year')}, ${pluralize(
      precise.months,
      'month',
    )}, ${pluralize(precise.days, 'day')})`;
    kazoedoshiEl.textContent = pluralize(kazoedoshi, 'year old');
    daysLivedEl.textContent = `${daysLived.toLocaleString('en-US')} days`;
    weekdayEl.textContent = WEEKDAY_LABELS[weekday];

    if (next.daysUntil === 0) {
      nextBirthdayEl.textContent = `Today is the birthday — turning ${next.ageAtNextBirthday}!`;
    } else {
      nextBirthdayEl.textContent = `${next.date.year}-${String(next.date.month).padStart(2, '0')}-${String(
        next.date.day,
      ).padStart(
        2,
        '0',
      )} (in ${pluralize(next.daysUntil, 'day')}, turning ${next.ageAtNextBirthday})`;
    }

    resultsEl.classList.remove('hidden');
  }

  birthYearInput.addEventListener('input', render);
  birthMonthInput.addEventListener('input', render);
  birthDayInput.addEventListener('input', render);
  referenceYearInput.addEventListener('input', render);
  referenceMonthInput.addEventListener('input', render);
  referenceDayInput.addEventListener('input', render);

  birthYearInput.value = '2000';
  birthMonthInput.value = '1';
  birthDayInput.value = '1';

  const today = new Date();
  referenceYearInput.value = String(today.getFullYear());
  referenceMonthInput.value = String(today.getMonth() + 1);
  referenceDayInput.value = String(today.getDate());
  render();
</script>
