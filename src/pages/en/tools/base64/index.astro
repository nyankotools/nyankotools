---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Base64',
    description:
      'An encoding scheme that converts binary data into a string using only letters, digits, and a few symbols (A-Z, a-z, 0-9, +, /, =). Commonly used to embed binary data, such as images, in text-only formats like email or JSON.',
  },
  {
    term: 'Encode / Decode',
    description:
      'Encoding converts data into another format; decoding reverses that conversion. Base64 encoding is not encryption — anyone can decode it back to the original data, so it does not protect sensitive information.',
  },
];
---

<Layout
  title="Base64 Encoder/Decoder"
  description="A free tool that encodes text to Base64 or decodes Base64 back to the original text, with full support for multibyte characters. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Base64 Encoder / Decoder</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Type or paste text below to automatically encode it to Base64. Switch to
    "Decode" to convert a Base64 string back to text. Need to format JSON
    instead? Try the
    <a
      href="/en/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON Formatter
    </a>
    . For converting query parameters, check out the
    <a
      href="/en/tools/url-encode/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      URL Encoder/Decoder
    </a>
    .
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="base64-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label="Mode"
    >
      <button
        type="button"
        data-mode="encode"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        Encode
      </button>
      <button
        type="button"
        data-mode="decode"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        Decode
      </button>
    </div>
    <button
      id="base64-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="base64-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="base64-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="base64-input"
        class="h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="Enter text to convert"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="base64-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="base64-output"
        readonly
        class="h-64 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="base64-error"
    hidden
    class="mt-4 max-w-2xl rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import { decodeBase64, encodeBase64 } from '../../../../lib/tools/base64';

  type Mode = 'encode' | 'decode';

  const input = document.getElementById('base64-input') as HTMLTextAreaElement;
  const output = document.getElementById(
    'base64-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#base64-mode [data-mode]',
  );
  const copyButton = document.getElementById('base64-copy-button')!;
  const statusEl = document.getElementById('base64-status')!;
  const errorEl = document.getElementById('base64-error')!;

  let mode: Mode = 'encode';

  function showError() {
    output.value = '';
    errorEl.textContent =
      'Could not decode this string as Base64. Please check the format.';
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value === '') {
      showOutput('');
      return;
    }
    const result =
      mode === 'encode' ? encodeBase64(input.value) : decodeBase64(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError();
    }
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  convert();
</script>
