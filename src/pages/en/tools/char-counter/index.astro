---
import Layout from '../../../../layouts/Layout.astro';
---

<Layout
  title="Character Counter"
  description="A free tool that counts the characters, words, and lines of your text in real time. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Character Counter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Type or paste text below to automatically see its character, word, and line
    counts.
  </p>

  <textarea
    id="char-counter-input"
    class="h-64 w-full max-w-2xl rounded-lg border border-gray-300 p-4 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
    placeholder="Type or paste your text here"
  ></textarea>

  <dl class="mt-4 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-lg bg-white p-4 shadow-sm dark:bg-gray-900">
      <dt class="text-xs text-gray-500 dark:text-gray-400">Characters</dt>
      <dd id="char-counter-characters" class="text-xl font-semibold">
        0
      </dd>
    </div>
    <div class="rounded-lg bg-white p-4 shadow-sm dark:bg-gray-900">
      <dt class="text-xs text-gray-500 dark:text-gray-400">
        Characters (no spaces)
      </dt>
      <dd id="char-counter-characters-no-spaces" class="text-xl font-semibold">
        0
      </dd>
    </div>
    <div class="rounded-lg bg-white p-4 shadow-sm dark:bg-gray-900">
      <dt class="text-xs text-gray-500 dark:text-gray-400">Words</dt>
      <dd id="char-counter-words" class="text-xl font-semibold">
        0
      </dd>
    </div>
    <div class="rounded-lg bg-white p-4 shadow-sm dark:bg-gray-900">
      <dt class="text-xs text-gray-500 dark:text-gray-400">Lines</dt>
      <dd id="char-counter-lines" class="text-xl font-semibold">
        0
      </dd>
    </div>
  </dl>

  <h2 class="mt-10 mb-2 text-lg font-bold">Related tools</h2>
  <p class="mb-2 text-sm text-gray-600 dark:text-gray-400">
    If you want to further edit or convert the text you just counted, try one of
    these tools too.
  </p>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      <a
        href="/en/tools/zenkaku-hankaku/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Full-width / Half-width Converter
      </a>
      — normalize the width of alphanumerics, symbols, and katakana
    </li>
    <li>
      <a
        href="/en/tools/line-ending-converter/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Line Ending Converter
      </a>
      — unify LF/CRLF/CR line endings
    </li>
    <li>
      <a
        href="/en/tools/text-list-tools/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Text List Deduplicate, Sort & Shuffle
      </a>
      — clean up a newline-separated list
    </li>
    <li>
      <a
        href="/en/tools/json-formatter/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        JSON Formatter
      </a>
      — format and minify JSON data
    </li>
    <li>
      <a
        href="/en/tools/markdown-preview/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Markdown to HTML Converter
      </a>
      — convert between Markdown and HTML
    </li>
    <li>
      <a
        href="/en/tools/lorem-ipsum/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Dummy Text Generator
      </a>
      — generate Lorem ipsum or Japanese placeholder text
    </li>
    <li>
      <a
        href="/en/tools/qr-generator/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        QR Code Generator
      </a>
      — generate a QR code from text
    </li>
    <li>
      <a
        href="/en/tools/unix-timestamp/"
        class="text-blue-700 underline hover:no-underline dark:text-blue-400"
      >
        Unix Timestamp Converter
      </a>
      — convert between a Unix timestamp and a date
    </li>
  </ul>
</Layout>

<script>
  import { countText } from '../../../../lib/tools/char-counter';

  const input = document.getElementById(
    'char-counter-input',
  ) as HTMLTextAreaElement;
  const charactersEl = document.getElementById('char-counter-characters')!;
  const charactersNoSpacesEl = document.getElementById(
    'char-counter-characters-no-spaces',
  )!;
  const wordsEl = document.getElementById('char-counter-words')!;
  const linesEl = document.getElementById('char-counter-lines')!;

  function update() {
    const result = countText(input.value);
    charactersEl.textContent = String(result.characters);
    charactersNoSpacesEl.textContent = String(result.charactersNoSpaces);
    wordsEl.textContent = String(result.words);
    linesEl.textContent = String(result.lines);
  }

  input.addEventListener('input', update);
  update();
</script>
