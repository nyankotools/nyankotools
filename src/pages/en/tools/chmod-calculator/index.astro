---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Permissions (file access mode)',
    description:
      'On Linux/Unix and macOS filesystems, permissions control who can read (r), write (w), and execute (x) a file. They can be set independently for the owner, the group, and everyone else (other).',
  },
  {
    term: 'Octal notation (e.g. 755)',
    description:
      'Read = 4, write = 2, execute = 1 — add these up for the owner, group, and other, and you get three digits (0-7 each), as used in commands like "chmod 755".',
  },
  {
    term: 'Symbolic notation (e.g. rwxr-xr-x)',
    description:
      'A 9-character format spelling out r (read), w (write), and x (execute), with "-" where a permission is missing — the same format shown by the "ls -l" command.',
  },
  {
    term: 'setuid, setgid, and the sticky bit (special permissions)',
    description:
      "These special bits sit alongside the usual r/w/x. setuid makes a program run with the file owner's privileges, and setgid makes it run with the group's privileges (on a directory, it also makes new files inherit that group). The sticky bit, set on a directory, prevents anyone but the owner from deleting files inside it. In octal this is a 4th leading digit (e.g. 4755); in symbolic notation it shows up as s/S or t in the execute position.",
  },
];
---

<Layout
  title="Chmod Permission Calculator (Octal & Symbolic Notation)"
  description="Convert file permissions for the chmod command between checkboxes, octal notation (e.g. 755), and symbolic notation (e.g. rwxr-xr-x) — free and works from any of the three. Supports setuid/setgid/sticky bit. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Chmod Permission Calculator</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Check the read/write/execute boxes for the owner, group, and other, and this
    tool shows the octal notation (e.g. 755), the symbolic notation (e.g.
    rwxr-xr-x), and a ready-to-use chmod command in real time. You can also type
    an octal or symbolic value directly and the other fields update to match,
    including special permissions like setuid, setgid, and the sticky bit.
    Everything happens in your browser, and nothing you type is ever sent to a
    server. If you work with file paths using regular expressions, try the
    <a
      href="/en/tools/regex-tester/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Regex Tester
    </a>
    as well.
  </p>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[420px] border-collapse text-sm">
      <thead>
        <tr class="border-b border-gray-200 dark:border-gray-700">
          <th class="py-2 text-left font-medium text-gray-700 dark:text-gray-300">
            Subject
          </th>
          <th class="py-2 text-center font-medium text-gray-700 dark:text-gray-300">
            Read (r)
          </th>
          <th class="py-2 text-center font-medium text-gray-700 dark:text-gray-300">
            Write (w)
          </th>
          <th class="py-2 text-center font-medium text-gray-700 dark:text-gray-300">
            Execute (x)
          </th>
        </tr>
      </thead>
      <tbody>
        {[
          { subject: 'owner', label: 'Owner (u)' },
          { subject: 'group', label: 'Group (g)' },
          { subject: 'other', label: 'Other (o)' },
        ].map(({ subject, label }) => (
          <tr class="border-b border-gray-100 dark:border-gray-800">
            <td class="py-2 text-gray-700 dark:text-gray-300">{label}</td>
            {['read', 'write', 'execute'].map((kind) => (
              <td class="py-2 text-center">
                <label class="flex h-11 items-center justify-center">
                  <input
                    id={`chmod-${subject}-${kind}`}
                    type="checkbox"
                    class="h-5 w-5"
                    aria-label={`${label} ${kind}`}
                  />
                </label>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input id="chmod-setuid" type="checkbox" class="h-4 w-4" />
      setuid (run as owner)
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input id="chmod-setgid" type="checkbox" class="h-4 w-4" />
      setgid (run as group)
    </label>
    <label class="flex h-11 items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
      <input id="chmod-sticky" type="checkbox" class="h-4 w-4" />
      Sticky bit
    </label>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label
        for="chmod-octal-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Octal notation
      </label>
      <div class="flex gap-2">
        <input
          id="chmod-octal-input"
          type="text"
          placeholder="755"
          spellcheck="false"
          class="h-11 w-full min-w-0 rounded-lg border border-gray-300 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
        <button
          type="button"
          data-copy-target="chmod-octal-input"
          class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Copy
        </button>
      </div>
    </div>
    <div>
      <label
        for="chmod-symbolic-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Symbolic notation
      </label>
      <div class="flex gap-2">
        <input
          id="chmod-symbolic-input"
          type="text"
          placeholder="rwxr-xr-x"
          spellcheck="false"
          class="h-11 w-full min-w-0 rounded-lg border border-gray-300 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
        <button
          type="button"
          data-copy-target="chmod-symbolic-input"
          class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Copy
        </button>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <label
      for="chmod-command-output"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      chmod command
    </label>
    <div class="flex gap-2">
      <input
        id="chmod-command-output"
        type="text"
        readonly
        class="h-11 w-full min-w-0 rounded-lg border border-gray-300 bg-gray-50 px-3 font-mono text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      />
      <button
        type="button"
        data-copy-target="chmod-command-output"
        class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
      >
        Copy
      </button>
    </div>
  </div>

  <p
    id="chmod-error"
    class="mt-2 text-sm text-red-600 dark:text-red-400"
    aria-live="polite"
  ></p>
  <span
    id="chmod-status"
    class="mt-2 block text-sm text-green-600 dark:text-green-400"
    aria-live="polite"
  ></span>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      Octal notation can be entered as 3 digits (e.g. 755) or 4 digits (e.g.
      4755). With 3 digits, setuid/setgid/sticky are all off; with 4 digits, the
      leading digit sets these special permissions.
    </li>
    <li>
      Symbolic notation accepts the 9-character "rwxr-xr-x" form, or the raw "ls
      -l" output "-rwxr-xr-x" (10 characters, with a leading file-type
      character).
    </li>
    <li>
      When setuid or setgid is set without the matching execute permission, the
      symbolic notation shows an uppercase S in that position (and uppercase T
      for the sticky bit) — this is the standard convention.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    type ChmodPermissions,
    octalToPermissions,
    permissionsToChmodCommand,
    permissionsToOctal,
    permissionsToSymbolic,
    symbolicToPermissions,
  } from '../../../../lib/tools/chmod-calculator';

  const subjects = ['owner', 'group', 'other'] as const;
  const kinds = ['read', 'write', 'execute'] as const;

  function checkbox(subject: string, kind: string): HTMLInputElement {
    return document.getElementById(
      `chmod-${subject}-${kind}`,
    ) as HTMLInputElement;
  }

  const setuidCheckbox = document.getElementById(
    'chmod-setuid',
  ) as HTMLInputElement;
  const setgidCheckbox = document.getElementById(
    'chmod-setgid',
  ) as HTMLInputElement;
  const stickyCheckbox = document.getElementById(
    'chmod-sticky',
  ) as HTMLInputElement;

  const octalInput = document.getElementById(
    'chmod-octal-input',
  ) as HTMLInputElement;
  const symbolicInput = document.getElementById(
    'chmod-symbolic-input',
  ) as HTMLInputElement;
  const commandOutput = document.getElementById(
    'chmod-command-output',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('chmod-error')!;
  const statusEl = document.getElementById('chmod-status')!;

  function readPermissionsFromCheckboxes(): ChmodPermissions {
    return {
      owner: {
        read: checkbox('owner', 'read').checked,
        write: checkbox('owner', 'write').checked,
        execute: checkbox('owner', 'execute').checked,
      },
      group: {
        read: checkbox('group', 'read').checked,
        write: checkbox('group', 'write').checked,
        execute: checkbox('group', 'execute').checked,
      },
      other: {
        read: checkbox('other', 'read').checked,
        write: checkbox('other', 'write').checked,
        execute: checkbox('other', 'execute').checked,
      },
      setuid: setuidCheckbox.checked,
      setgid: setgidCheckbox.checked,
      sticky: stickyCheckbox.checked,
    };
  }

  function applyPermissionsToCheckboxes(permissions: ChmodPermissions) {
    for (const subject of subjects) {
      for (const kind of kinds) {
        checkbox(subject, kind).checked = permissions[subject][kind];
      }
    }
    setuidCheckbox.checked = permissions.setuid;
    setgidCheckbox.checked = permissions.setgid;
    stickyCheckbox.checked = permissions.sticky;
  }

  type Source = 'checkbox' | 'octal' | 'symbolic' | 'init';

  function render(permissions: ChmodPermissions, source: Source) {
    errorEl.textContent = '';
    if (source !== 'octal') octalInput.value = permissionsToOctal(permissions);
    if (source !== 'symbolic')
      symbolicInput.value = permissionsToSymbolic(permissions);
    if (source !== 'checkbox') applyPermissionsToCheckboxes(permissions);
    commandOutput.value = permissionsToChmodCommand(permissions, 'file');
  }

  for (const subject of subjects) {
    for (const kind of kinds) {
      checkbox(subject, kind).addEventListener('change', () => {
        statusEl.textContent = '';
        render(readPermissionsFromCheckboxes(), 'checkbox');
      });
    }
  }
  for (const el of [setuidCheckbox, setgidCheckbox, stickyCheckbox]) {
    el.addEventListener('change', () => {
      statusEl.textContent = '';
      render(readPermissionsFromCheckboxes(), 'checkbox');
    });
  }

  octalInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (octalInput.value.trim() === '') {
      errorEl.textContent = '';
      return;
    }
    const permissions = octalToPermissions(octalInput.value);
    if (!permissions) {
      errorEl.textContent =
        'Invalid octal format (e.g. 755, or 4755 with special permissions)';
      return;
    }
    render(permissions, 'octal');
  });

  symbolicInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (symbolicInput.value.trim() === '') {
      errorEl.textContent = '';
      return;
    }
    const permissions = symbolicToPermissions(symbolicInput.value);
    if (!permissions) {
      errorEl.textContent = 'Invalid symbolic format (e.g. rwxr-xr-x)';
      return;
    }
    render(permissions, 'symbolic');
  });

  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');
  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      try {
        await navigator.clipboard.writeText(target.value);
        statusEl.textContent = 'Copied';
      } catch {
        statusEl.textContent = 'Copy failed';
      }
    });
  });

  render(octalToPermissions('755')!, 'init');
</script>
