---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Formatting',
    description:
      'Rewriting code with consistent indentation and line breaks so it is easier for humans to read. This tool uses Prettier internally.',
  },
  {
    term: 'Minify',
    description:
      "Stripping line breaks, indentation, and comments that are not needed at runtime to reduce a file's size, typically before shipping it to production.",
  },
];
---

<Layout
  title="CSS/JS/HTML Minifier & Formatter"
  description="Free online tool to format and minify CSS, JavaScript, and HTML code right in your browser, with a selectable indent width. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">CSS/JS/HTML Minifier & Formatter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Paste CSS, JavaScript, or HTML code to have it automatically formatted for
    readability. Click "Minify" to shrink it for production. To work with JSON,
    try the
    <a
      href="/en/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON Formatter
    </a>
    as well.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <label
      for="code-minifier-language"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      Language
    </label>
    <select
      id="code-minifier-language"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="css">CSS</option>
      <option value="javascript">JavaScript</option>
      <option value="html">HTML</option>
    </select>

    <label
      for="code-minifier-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      Indent
    </label>
    <select
      id="code-minifier-indent"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="2">2 spaces</option>
      <option value="4">4 spaces</option>
      <option value="tab">Tab</option>
    </select>

    <button
      id="code-minifier-minify-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Minify
    </button>
    <button
      id="code-minifier-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="code-minifier-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="code-minifier-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="code-minifier-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={'.a{color:red;margin:0}'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="code-minifier-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="code-minifier-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="code-minifier-error"
    hidden
    class="mt-4 max-w-2xl whitespace-pre-line rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">
    Note: minifying CSS does not throw on invalid syntax — it may silently skip
    the affected part instead. If the result looks unexpected, check the
    formatted output first to confirm the syntax is valid. Minifying HTML only
    strips comments and collapses whitespace between tags — the contents of
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">
      &lt;style&gt;
    </code>
    and
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">
      &lt;script&gt;
    </code>{' '}
    tags are kept as-is (switch to the CSS or JavaScript language to minify
    those separately).
  </p>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    formatCode,
    minifyCode,
    type CodeLanguage,
  } from '../../../../lib/tools/code-minifier';

  const input = document.getElementById(
    'code-minifier-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'code-minifier-output',
  ) as HTMLTextAreaElement;
  const languageSelect = document.getElementById(
    'code-minifier-language',
  ) as HTMLSelectElement;
  const indentSelect = document.getElementById(
    'code-minifier-indent',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('code-minifier-minify-button')!;
  const copyButton = document.getElementById('code-minifier-copy-button')!;
  const statusEl = document.getElementById('code-minifier-status')!;
  const errorEl = document.getElementById('code-minifier-error')!;

  // Each run gets a token so a slow, stale async result can't overwrite
  // the output produced by a newer keystroke.
  let requestToken = 0;

  function getIndentOptions(): { tabWidth: number; useTabs: boolean } {
    if (indentSelect.value === 'tab') {
      return { tabWidth: 2, useTabs: true };
    }
    return { tabWidth: Number(indentSelect.value), useTabs: false };
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `Syntax error: ${message}\n(Check that parentheses and quotes are balanced, and that the selected language matches your code.)`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  async function format() {
    const token = ++requestToken;
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const { tabWidth, useTabs } = getIndentOptions();
    try {
      const result = await formatCode(
        input.value,
        languageSelect.value as CodeLanguage,
        { tabWidth, useTabs },
      );
      if (token !== requestToken) return;
      showOutput(result);
    } catch (error) {
      if (token !== requestToken) return;
      const message = error instanceof Error ? error.message : String(error);
      showError(message.split('\n')[0]);
    }
  }

  async function minify() {
    const token = ++requestToken;
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    try {
      const result = await minifyCode(
        input.value,
        languageSelect.value as CodeLanguage,
      );
      if (token !== requestToken) return;
      showOutput(result);
    } catch (error) {
      if (token !== requestToken) return;
      const message = error instanceof Error ? error.message : String(error);
      showError(message.split('\n')[0]);
    }
  }

  input.addEventListener('input', format);
  languageSelect.addEventListener('change', format);
  indentSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  format();
</script>
