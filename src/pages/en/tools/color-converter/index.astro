---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'HEX (hexadecimal color code)',
    description:
      'A format like "#3b82f6" that represents a color as # followed by 6 (or 3) hexadecimal digits. It is the most common format in CSS and design tools.',
  },
  {
    term: 'RGB',
    description:
      'A format that expresses a color as amounts of Red, Green, and Blue light, each on a scale of 0 to 255.',
  },
  {
    term: 'HSL',
    description:
      'A format that expresses a color as Hue (0-360 degrees), Saturation (0-100%), and Lightness (0-100%). It makes adjustments like "keep the same hue but change the brightness" easy.',
  },
];
---

<Layout
  title="Color Converter (HEX/RGB/HSL)"
  description="A free tool to convert color codes between HEX, RGB, and HSL. You can also pick a color intuitively with the color picker. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Color Converter (HEX/RGB/HSL)</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Converts HEX, RGB, and HSL color codes to each other in real time. Enter a
    value in any field, or pick a color with the color picker, and the other
    formats update automatically. Everything happens in your browser, and
    nothing you type is ever sent to a server. Need a color for a QR code? Check
    out the
    <a
      href="/en/tools/qr-generator/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      QR Code Generator
    </a>
    as well.
  </p>

  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <div class="flex flex-col items-center gap-2">
      <input
        id="color-converter-picker"
        type="color"
        value="#3b82f6"
        aria-label="Color picker"
        class="h-24 w-24 cursor-pointer rounded-lg border border-gray-300 bg-transparent p-1 dark:border-gray-700"
      />
    </div>

    <div class="flex-1 space-y-4">
      {[
        { id: 'hex', label: 'HEX', placeholder: '#3b82f6' },
        { id: 'rgb', label: 'RGB', placeholder: 'rgb(59, 130, 246)' },
        { id: 'hsl', label: 'HSL', placeholder: 'hsl(217, 91%, 60%)' },
      ].map((field) => (
        <div>
          <label
            for={`color-converter-${field.id}`}
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            {field.label}
          </label>
          <div class="flex gap-2">
            <input
              id={`color-converter-${field.id}`}
              type="text"
              placeholder={field.placeholder}
              spellcheck="false"
              class="h-11 w-full min-w-0 rounded-lg border border-gray-300 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
            />
            <button
              type="button"
              data-copy-target={`color-converter-${field.id}`}
              class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
            >
              Copy
            </button>
          </div>
        </div>
      ))}
      <p
        id="color-converter-error"
        class="text-sm text-red-600 dark:text-red-400"
        aria-live="polite"
      ></p>
      <span
        id="color-converter-status"
        class="block text-sm text-green-600 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      RGB and HSL accept formats like "rgb(255, 0, 0)" and "hsl(0, 100%, 50%)",
      as well as plain comma-separated numbers like "255, 0, 0".
    </li>
    <li>
      If a value is not a valid format, the other fields are left unchanged and
      an error message is shown instead.
    </li>
    <li>
      Transparency (alpha) is not supported. If you enter an rgba() or hsla()
      value, the alpha component is ignored during conversion.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    formatHsl,
    formatRgb,
    hexToRgb,
    hslToRgb,
    parseHslString,
    parseRgbString,
    rgbToHex,
    rgbToHsl,
    type RgbColor,
  } from '../../../../lib/tools/color-converter';

  const picker = document.getElementById(
    'color-converter-picker',
  ) as HTMLInputElement;
  const hexInput = document.getElementById(
    'color-converter-hex',
  ) as HTMLInputElement;
  const rgbInput = document.getElementById(
    'color-converter-rgb',
  ) as HTMLInputElement;
  const hslInput = document.getElementById(
    'color-converter-hsl',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('color-converter-error')!;
  const statusEl = document.getElementById('color-converter-status')!;
  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');

  type Source = 'hex' | 'rgb' | 'hsl' | 'picker' | 'init';

  function applyRgb(rgb: RgbColor, source: Source) {
    errorEl.textContent = '';
    const hex = rgbToHex(rgb);
    if (source !== 'hex') hexInput.value = hex;
    if (source !== 'rgb') rgbInput.value = formatRgb(rgb);
    if (source !== 'hsl') hslInput.value = formatHsl(rgbToHsl(rgb));
    if (source !== 'picker') picker.value = hex;
  }

  hexInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (hexInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const rgb = hexToRgb(hexInput.value);
    if (!rgb) {
      errorEl.textContent = 'Invalid HEX format (e.g. #3b82f6)';
      return;
    }
    applyRgb(rgb, 'hex');
  });

  rgbInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (rgbInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const rgb = parseRgbString(rgbInput.value);
    if (!rgb) {
      errorEl.textContent = 'Invalid RGB format (e.g. rgb(59, 130, 246))';
      return;
    }
    applyRgb(rgb, 'rgb');
  });

  hslInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (hslInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const hsl = parseHslString(hslInput.value);
    if (!hsl) {
      errorEl.textContent = 'Invalid HSL format (e.g. hsl(217, 91%, 60%))';
      return;
    }
    applyRgb(hslToRgb(hsl), 'hsl');
  });

  picker.addEventListener('input', () => {
    statusEl.textContent = '';
    const rgb = hexToRgb(picker.value);
    if (!rgb) return;
    applyRgb(rgb, 'picker');
  });

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      try {
        await navigator.clipboard.writeText(target.value);
        statusEl.textContent = 'Copied';
      } catch {
        statusEl.textContent = 'Copy failed';
      }
    });
  });

  applyRgb(hexToRgb(picker.value)!, 'init');
</script>
