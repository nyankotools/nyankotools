---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'CSV',
    description:
      'Short for Comma-Separated Values, a text format that separates columns with a comma (or another delimiter). Widely used as the export format for spreadsheets like Excel.',
  },
  {
    term: 'JSON',
    description:
      'Short for JavaScript Object Notation, a text format for representing data as key-value pairs. It is widely used for APIs and configuration files.',
  },
  {
    term: 'Header row',
    description:
      "The first row of a CSV file, containing the name of each column. This tool uses the header row's values as the JSON keys.",
  },
  {
    term: 'Quoting',
    description:
      'When a CSV field contains a comma or a newline, the whole field is wrapped in double quotes ("). A double quote inside the value is escaped by doubling it ("").',
  },
];
---

<Layout
  title="CSV to JSON Converter"
  description="Free online tool to convert between CSV and JSON, handy for turning a spreadsheet export into JSON for an API. Supports comma/tab delimiters and quoted fields. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">CSV ⇔ JSON Converter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Paste CSV to convert it to a JSON array, or paste a JSON array to convert it
    to CSV. The header row is used as the JSON keys, which is handy when you
    want to turn a spreadsheet export straight into JSON for an API. To further
    format or validate the resulting JSON, try the
    <a
      href="/en/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON Formatter
    </a>
    as well.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="csv-json-converter-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label="Direction"
    >
      <button
        type="button"
        data-mode="csvToJson"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        CSV→JSON
      </button>
      <button
        type="button"
        data-mode="jsonToCsv"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        JSON→CSV
      </button>
    </div>
    <label
      for="csv-json-converter-delimiter"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      Delimiter
    </label>
    <select
      id="csv-json-converter-delimiter"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value=",">Comma ( , )</option>
      <option value="tab">Tab</option>
    </select>
    <button
      id="csv-json-converter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="csv-json-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="csv-json-converter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="csv-json-converter-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={'name,age\nTaro,30\nHanako,25'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="csv-json-converter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="csv-json-converter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="csv-json-converter-error"
    hidden
    class="mt-4 max-w-2xl whitespace-pre-line rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    csvToJson,
    jsonToCsv,
    type ConvertOutcome,
  } from '../../../../lib/tools/csv-json-converter';

  type Mode = 'csvToJson' | 'jsonToCsv';

  const input = document.getElementById(
    'csv-json-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'csv-json-converter-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#csv-json-converter-mode [data-mode]',
  );
  const delimiterSelect = document.getElementById(
    'csv-json-converter-delimiter',
  ) as HTMLSelectElement;
  const copyButton = document.getElementById('csv-json-converter-copy-button')!;
  const statusEl = document.getElementById('csv-json-converter-status')!;
  const errorEl = document.getElementById('csv-json-converter-error')!;

  let mode: Mode = 'csvToJson';

  const placeholders: Record<Mode, string> = {
    csvToJson: 'name,age\nTaro,30\nHanako,25',
    jsonToCsv: '[{"name": "Taro", "age": 30}, {"name": "Hanako", "age": 25}]',
  };

  function resolveDelimiter(): string {
    return delimiterSelect.value === 'tab' ? '\t' : ',';
  }

  function describeError(result: Extract<ConvertOutcome, { success: false }>) {
    switch (result.reason) {
      case 'unterminated-quote':
        return 'An opening double quote (") is never closed.';
      case 'column-mismatch':
        return `Line ${result.line}: column count doesn't match the header (header: ${result.expectedColumns}, data: ${result.actualColumns}).`;
      case 'not-array':
        return 'The JSON must be an array (e.g. [{"a": 1}]).';
      case 'not-object':
        return `Item ${result.index + 1}: each array element must be an object (e.g. {"a": 1}).`;
      case 'invalid-json':
        return result.message;
    }
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `Error: ${message}`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function convert() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const delimiter = resolveDelimiter();
    const result: ConvertOutcome =
      mode === 'csvToJson'
        ? csvToJson(input.value, delimiter)
        : jsonToCsv(input.value, delimiter);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(describeError(result));
    }
  }

  input.addEventListener('input', convert);
  delimiterSelect.addEventListener('change', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as Mode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      input.placeholder = placeholders[mode];
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  convert();
</script>
