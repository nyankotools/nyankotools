---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'HTML escaping',
    description:
      'Converting characters that have special meaning in HTML ("&", "<", ">", \'"\', and "\'") into character references (such as &amp; or &lt;) so they display as literal text. It is also a common defense against XSS (cross-site scripting) when embedding user input into HTML.',
  },
  {
    term: 'JavaScript string escaping',
    description:
      'Converting characters such as newlines, quotes, and backslashes into backslash-prefixed sequences (like \\n or \\") so they can safely appear inside a JavaScript string literal (\'...\' or "...").',
  },
];
---

<Layout
  title="HTML/JS String Escape & Unescape"
  description="A free tool that escapes or unescapes HTML special characters (& < > &quot; ') and JavaScript string escape sequences such as newlines and quotes. Handy for XSS prevention and building strings in generated code. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">
    HTML / JavaScript String Escape &amp; Unescape
  </h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Escape your text as HTML special characters (&amp; &lt; &gt; &quot; ') or
    convert character references back to the original text. Choose "JS String
    Escape" to embed the text inside a JavaScript string literal instead. Need
    to convert a string for use in a URL? Try the
    <a
      href="/en/tools/url-encode/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      URL Encoder/Decoder
    </a>
    .
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="html-escape-mode"
      class="flex flex-wrap gap-1 rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label="Mode"
    >
      <button
        type="button"
        data-mode="html-escape"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        HTML Escape
      </button>
      <button
        type="button"
        data-mode="html-unescape"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        HTML Unescape
      </button>
      <button
        type="button"
        data-mode="js-escape"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        JS String Escape
      </button>
      <button
        type="button"
        data-mode="js-unescape"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        JS String Unescape
      </button>
    </div>
    <button
      id="html-escape-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="html-escape-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="html-escape-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="html-escape-input"
        class="h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="Enter text to convert"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="html-escape-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="html-escape-output"
        readonly
        class="h-64 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    convertEscape,
    type EscapeMode,
  } from '../../../../lib/tools/html-escape';

  const input = document.getElementById(
    'html-escape-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'html-escape-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#html-escape-mode [data-mode]',
  );
  const copyButton = document.getElementById('html-escape-copy-button')!;
  const statusEl = document.getElementById('html-escape-status')!;

  let mode: EscapeMode = 'html-escape';

  function convert() {
    statusEl.textContent = '';
    output.value = input.value === '' ? '' : convertEscape(input.value, mode);
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      mode = button.dataset.mode as EscapeMode;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  convert();
</script>
