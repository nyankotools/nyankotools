---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';
import { ERAS } from '../../../../lib/tools/japanese-era-converter';

const glossaryTerms = [
  {
    term: 'Gengo (Japanese era name)',
    description:
      'A Japanese calendar era, traditionally set at the start of an emperor\'s reign. The current era is "Reiwa," which began on May 1, 2019.',
  },
  {
    term: 'Wareki (Japanese calendar year)',
    description:
      'A way of expressing a year using the era name and era year (e.g. "Reiwa 6"), used alongside the Western (Gregorian) year.',
  },
  {
    term: 'Gannen (first year of an era)',
    description:
      'The first year of an era. Rather than being written as "year 1," it is written as "gannen" (e.g. "Reiwa gannen").',
  },
];
---

<Layout
  title="Japanese Era Converter (Wareki ⇔ Western Year)"
  description="A free tool to convert between the Japanese era calendar (Reiwa, Heisei, Showa, Taisho, Meiji) and the Western (Gregorian) year, including dates around an era transition. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Japanese Era Converter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Converts between the Japanese era calendar (Meiji, Taisho, Showa, Heisei,
    Reiwa) and the Western year in real time, correctly handling dates around an
    era transition (e.g. Showa 64 / January 7 &rarr; Heisei 1 / January 8).
    Everything happens in your browser, and nothing you type is ever sent to a
    server. If you need to calculate an age from a date of birth, check out the
    <a
      href="/en/tools/unix-timestamp/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Unix Timestamp Converter
    </a>
    as well.
  </p>

  <section class="mb-8 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">Western year &rarr; Japanese era</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span
          id="era-w2j-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Western date
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="era-w2j-label"
        >
          <input
            id="era-w2j-year"
            type="number"
            inputmode="numeric"
            min="1"
            max="9999"
            placeholder="2024"
            aria-label="Western year"
            class="h-11 w-24 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="era-w2j-month"
            type="number"
            inputmode="numeric"
            min="1"
            max="12"
            placeholder="6"
            aria-label="Western month"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">-</span>
          <input
            id="era-w2j-day"
            type="number"
            inputmode="numeric"
            min="1"
            max="31"
            placeholder="15"
            aria-label="Western day"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
        </div>
      </div>
    </div>
    <p
      id="era-w2j-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-w2j-result"
      aria-live="polite"
    ></p>
  </section>

  <section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">Japanese era &rarr; Western year</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label
          for="era-j2w-era"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Era
        </label>
        <select
          id="era-j2w-era"
          class="h-11 rounded-lg border border-gray-300 bg-white px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        >
          {ERAS.slice()
            .reverse()
            .map((era) => (
              <option value={era.name}>{era.romaji}</option>
            ))}
        </select>
      </div>
      <div class="w-24">
        <label
          for="era-j2w-year"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Year
        </label>
        <input
          id="era-j2w-year"
          type="number"
          min="1"
          max="99"
          inputmode="numeric"
          placeholder="6"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label
          for="era-j2w-month"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Month
        </label>
        <input
          id="era-j2w-month"
          type="number"
          min="1"
          max="12"
          inputmode="numeric"
          placeholder="6"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label
          for="era-j2w-day"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Day
        </label>
        <input
          id="era-j2w-day"
          type="number"
          min="1"
          max="31"
          inputmode="numeric"
          placeholder="15"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
    </div>
    <p
      id="era-j2w-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-j2w-result"
      aria-live="polite"
    ></p>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">Era reference table</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-left dark:border-gray-700">
          <th class="py-2 pr-4">Era</th>
          <th class="py-2 pr-4">Start date</th>
          <th class="py-2">Year 1 (Western)</th>
        </tr>
      </thead>
      <tbody>
        {ERAS.slice()
          .reverse()
          .map((era) => (
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-2 pr-4 font-medium">{era.romaji}</td>
              <td class="py-2 pr-4">
                {era.start.year}-{String(era.start.month).padStart(2, '0')}-
                {String(era.start.day).padStart(2, '0')}
              </td>
              <td class="py-2">{era.start.year}</td>
            </tr>
          ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      Supported range starts at Meiji 1 (January 25, 1868). Dates before that
      cannot be converted.
    </li>
    <li>
      Dates right around an era transition (e.g. Showa 64 / January 7 vs. Heisei
      1 / January 8) are especially easy to get wrong, so conversion is
      determined at the day level.
    </li>
    <li>
      The first year of an era is displayed as "gannen" on the Japanese version
      of this tool (e.g. Reiwa gannen = Reiwa 1).
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    warekiToWestern,
    westernToWareki,
  } from '../../../../lib/tools/japanese-era-converter';

  const w2jYearInput = document.getElementById(
    'era-w2j-year',
  ) as HTMLInputElement;
  const w2jMonthInput = document.getElementById(
    'era-w2j-month',
  ) as HTMLInputElement;
  const w2jDayInput = document.getElementById(
    'era-w2j-day',
  ) as HTMLInputElement;
  const w2jErrorEl = document.getElementById('era-w2j-error')!;
  const w2jResultEl = document.getElementById('era-w2j-result')!;

  function renderWesternToWareki() {
    w2jErrorEl.textContent = '';
    w2jResultEl.textContent = '';

    if (
      w2jYearInput.value === '' ||
      w2jMonthInput.value === '' ||
      w2jDayInput.value === ''
    ) {
      return;
    }

    const result = westernToWareki(
      Number(w2jYearInput.value),
      Number(w2jMonthInput.value),
      Number(w2jDayInput.value),
    );
    if (!result) {
      w2jErrorEl.textContent =
        'Could not convert (please enter a date on or after Meiji 1 / January 25, 1868)';
      return;
    }

    const yearLabel =
      result.eraYear === 1 ? '1 (gannen)' : String(result.eraYear);
    w2jResultEl.textContent = `${result.era.romaji} ${yearLabel}`;
  }

  w2jYearInput.addEventListener('input', renderWesternToWareki);
  w2jMonthInput.addEventListener('input', renderWesternToWareki);
  w2jDayInput.addEventListener('input', renderWesternToWareki);

  const j2wEraSelect = document.getElementById(
    'era-j2w-era',
  ) as HTMLSelectElement;
  const j2wYearInput = document.getElementById(
    'era-j2w-year',
  ) as HTMLInputElement;
  const j2wMonthInput = document.getElementById(
    'era-j2w-month',
  ) as HTMLInputElement;
  const j2wDayInput = document.getElementById(
    'era-j2w-day',
  ) as HTMLInputElement;
  const j2wErrorEl = document.getElementById('era-j2w-error')!;
  const j2wResultEl = document.getElementById('era-j2w-result')!;

  function renderWarekiToWestern() {
    j2wErrorEl.textContent = '';
    j2wResultEl.textContent = '';

    if (
      j2wYearInput.value === '' ||
      j2wMonthInput.value === '' ||
      j2wDayInput.value === ''
    ) {
      return;
    }

    const year = warekiToWestern(
      j2wEraSelect.value,
      Number(j2wYearInput.value),
      Number(j2wMonthInput.value),
      Number(j2wDayInput.value),
    );
    if (year === null) {
      j2wErrorEl.textContent =
        'Could not convert (the date does not exist, or falls outside that era)';
      return;
    }

    j2wResultEl.textContent = `${year}-${j2wMonthInput.value.padStart(2, '0')}-${j2wDayInput.value.padStart(2, '0')}`;
  }

  j2wEraSelect.addEventListener('change', renderWarekiToWestern);
  j2wYearInput.addEventListener('input', renderWarekiToWestern);
  j2wMonthInput.addEventListener('input', renderWarekiToWestern);
  j2wDayInput.addEventListener('input', renderWarekiToWestern);

  const today = new Date();
  w2jYearInput.value = String(today.getFullYear());
  w2jMonthInput.value = String(today.getMonth() + 1);
  w2jDayInput.value = String(today.getDate());
  renderWesternToWareki();

  const todayWareki = westernToWareki(
    today.getFullYear(),
    today.getMonth() + 1,
    today.getDate(),
  );
  if (todayWareki) {
    j2wEraSelect.value = todayWareki.era.name;
    j2wYearInput.value = String(todayWareki.eraYear);
    j2wMonthInput.value = String(today.getMonth() + 1);
    j2wDayInput.value = String(today.getDate());
  }
  renderWarekiToWestern();
</script>
