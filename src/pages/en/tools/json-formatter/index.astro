---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'JSON',
    description:
      'Short for JavaScript Object Notation, a text format for representing data as key-value pairs. It is widely used for APIs and configuration files.',
  },
  {
    term: 'Syntax error',
    description:
      "An error that occurs when JSON's rules (matching brackets, commas, quotes, etc.) are violated. It's usually caused by a missing closing bracket or a trailing comma.",
  },
];
---

<Layout
  title="JSON Formatter"
  description="A free tool that formats, minifies, and validates JSON data in your browser, with clear syntax error messages. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">JSON Formatter &amp; Validator</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Paste JSON below to automatically format it. Any syntax error is shown with
    a clear message. Need to count characters in text instead? Try the
    <a
      href="/en/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Character Counter
    </a>
    .
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <label
      for="json-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      Indent
    </label>
    <select
      id="json-formatter-indent"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="2">2 spaces</option>
      <option value="4">4 spaces</option>
      <option value="tab">Tab</option>
    </select>
    <button
      id="json-formatter-minify-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Minify
    </button>
    <button
      id="json-formatter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="json-formatter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="json-formatter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="json-formatter-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={'{"key": "value"}'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="json-formatter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="json-formatter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="json-formatter-error"
    hidden
    class="mt-4 max-w-2xl rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import { formatJson, minifyJson } from '../../../../lib/tools/json-formatter';

  const input = document.getElementById(
    'json-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'json-formatter-output',
  ) as HTMLTextAreaElement;
  const indentSelect = document.getElementById(
    'json-formatter-indent',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('json-formatter-minify-button')!;
  const copyButton = document.getElementById('json-formatter-copy-button')!;
  const statusEl = document.getElementById('json-formatter-status')!;
  const errorEl = document.getElementById('json-formatter-error')!;

  function getIndent(): number | string {
    return indentSelect.value === 'tab' ? '\t' : Number(indentSelect.value);
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `Syntax error: ${message}`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function format() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = formatJson(input.value, getIndent());
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  function minify() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = minifyJson(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  input.addEventListener('input', format);
  indentSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  format();
</script>
