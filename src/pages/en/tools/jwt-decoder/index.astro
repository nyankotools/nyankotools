---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'JWT (JSON Web Token)',
    description:
      'A token format that represents "claims" such as user info or permissions as JSON and attaches a digital signature. Commonly used as an authentication token after login or as an API access token. It is three parts — header, payload, and signature — joined by dots, each Base64URL-encoded.',
  },
  {
    term: 'Header',
    description:
      'JSON describing the signing algorithm in use (`alg`, e.g. HS256, RS256) and the token type (`typ`, usually "JWT").',
  },
  {
    term: 'Payload',
    description:
      'The JSON containing the actual data (claims) being carried. `sub` (subject), `iat` (issued at), `exp` (expiration), and `nbf` (not before) are "registered claims" with a defined meaning in the spec, but applications can also include their own custom claims.',
  },
  {
    term: 'Signature',
    description:
      'A value used to verify that the header and payload have not been tampered with. It is computed using a secret or private key, so a third party without that key cannot produce a valid signature. This tool does not verify the signature — it only decodes the contents.',
  },
  {
    term: 'Base64URL',
    description:
      'A variant of Base64 encoding where `+`, `/`, and `=` — characters that cause problems in URLs and filenames — are replaced with `-`, `_`, and omitted, respectively. Each segment of a JWT is encoded this way.',
  },
];
---

<Layout
  title="JWT Decoder (Header & Payload Viewer)"
  description="A free tool that decodes a JWT (JSON Web Token) in your browser and displays the header and payload as formatted JSON. Time-based claims like exp, iat, and nbf are also shown as human-readable dates. The signature is not verified. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">JWT Decoder</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Paste a JWT (JSON Web Token) to see its header and payload formatted as
    JSON. Time-based claims such as
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">exp</code>
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">iat</code>
    <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">nbf</code>
    are also shown as human-readable dates. The signature is not verified, so
    this tool cannot confirm whether a token is authentic. The payload is just
    JSON, so for a closer look at the formatted result, also try the
    <a
      href="/en/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON Formatter
    </a>
    tool.
  </p>

  <div>
    <label
      for="jwt-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      JWT
    </label>
    <textarea
      id="jwt-input"
      class="h-32 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm break-all focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
      spellcheck="false"
      autocomplete="off"
    ></textarea>
  </div>

  <div
    id="jwt-error"
    class="mt-2 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300"
    role="alert"
  ></div>

  <div id="jwt-result" class="mt-4 hidden space-y-6">
    <div>
      <div class="mb-1 flex items-center justify-between">
        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
          Header
        </p>
        <div class="flex items-center gap-3">
          <button
            id="jwt-header-copy-button"
            type="button"
            class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
          >
            Copy
          </button>
          <span
            id="jwt-header-copy-status"
            class="text-sm text-green-600 dark:text-green-400"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre
        id="jwt-header-output"
        class="w-full overflow-x-auto rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm whitespace-pre-wrap dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></pre>
    </div>

    <div>
      <div class="mb-1 flex items-center justify-between">
        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
          Payload
        </p>
        <div class="flex items-center gap-3">
          <button
            id="jwt-payload-copy-button"
            type="button"
            class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
          >
            Copy
          </button>
          <span
            id="jwt-payload-copy-status"
            class="text-sm text-green-600 dark:text-green-400"
            aria-live="polite"
          ></span>
        </div>
      </div>
      <pre
        id="jwt-payload-output"
        class="w-full overflow-x-auto rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm whitespace-pre-wrap dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></pre>
    </div>

    <div id="jwt-claims-wrapper" class="hidden">
      <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
        Time-based claims
      </p>
      <div class="overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
        <table class="w-full min-w-[420px] text-left text-sm">
          <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <tr>
              <th class="px-3 py-2 font-medium">Claim</th>
              <th class="px-3 py-2 font-medium">Unix seconds</th>
              <th class="px-3 py-2 font-medium">Date (local time zone)</th>
            </tr>
          </thead>
          <tbody
            id="jwt-claims-body"
            class="divide-y divide-gray-200 dark:divide-gray-800"
          ></tbody>
        </table>
      </div>
    </div>

    <div>
      <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
        Signature (not verified)
      </p>
      <div
        id="jwt-signature-output"
        class="w-full overflow-x-auto rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm break-all dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></div>
    </div>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      This tool does not verify the signature. It only decodes the header and
      payload from Base64URL and displays them as JSON — it cannot confirm that
      a token was actually issued by a trusted source.
    </li>
    <li>
      A JWT payload can contain sensitive information. Everything runs entirely
      in your browser and the token you enter is never sent to a server, but
      still handle real production tokens with care.
    </li>
    <li>
      Time-based claims (
      <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">exp</code>
      <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">iat</code>
      <code class="rounded bg-gray-100 px-1 py-0.5 dark:bg-gray-800">nbf</code>)
      are interpreted as Unix seconds (seconds since January 1, 1970) and shown
      in your device's local time zone.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    decodeJwt,
    unixSecondsToDate,
    type JwtPart,
  } from '../../../../lib/tools/jwt-decoder';

  const input = document.getElementById('jwt-input') as HTMLTextAreaElement;
  const errorEl = document.getElementById('jwt-error')!;
  const resultEl = document.getElementById('jwt-result')!;
  const headerOutput = document.getElementById('jwt-header-output')!;
  const payloadOutput = document.getElementById('jwt-payload-output')!;
  const signatureOutput = document.getElementById('jwt-signature-output')!;
  const claimsWrapper = document.getElementById('jwt-claims-wrapper')!;
  const claimsBody = document.getElementById('jwt-claims-body')!;
  const headerCopyButton = document.getElementById(
    'jwt-header-copy-button',
  ) as HTMLButtonElement;
  const headerCopyStatus = document.getElementById('jwt-header-copy-status')!;
  const payloadCopyButton = document.getElementById(
    'jwt-payload-copy-button',
  ) as HTMLButtonElement;
  const payloadCopyStatus = document.getElementById('jwt-payload-copy-status')!;

  const TIME_CLAIMS = ['exp', 'iat', 'nbf'] as const;

  function renderPart(part: JwtPart): string {
    if (part.errorCode === 'invalid-base64') {
      return 'Could not decode: not a valid Base64URL string.';
    }
    if (part.errorCode === 'invalid-json') {
      return 'Could not parse the decoded value as JSON.';
    }
    return JSON.stringify(part.json, null, 2);
  }

  function render() {
    headerCopyStatus.textContent = '';
    payloadCopyStatus.textContent = '';

    const token = input.value;
    if (token.trim() === '') {
      errorEl.classList.add('hidden');
      resultEl.classList.add('hidden');
      return;
    }

    const result = decodeJwt(token);

    if (!result.isValid) {
      errorEl.textContent =
        'This does not look like a valid JWT. It must be three parts — header, payload, and signature — separated by dots.';
      errorEl.classList.remove('hidden');
      resultEl.classList.add('hidden');
      return;
    }
    errorEl.classList.add('hidden');
    resultEl.classList.remove('hidden');

    headerOutput.textContent = renderPart(result.header!);
    payloadOutput.textContent = renderPart(result.payload!);
    signatureOutput.textContent = result.signature;

    const payloadJson = result.payload!.json;
    const rows: string[] = [];
    if (payloadJson && typeof payloadJson === 'object') {
      for (const claim of TIME_CLAIMS) {
        const value = (payloadJson as Record<string, unknown>)[claim];
        const date = unixSecondsToDate(value);
        if (date === null) continue;
        rows.push(`<tr>
          <td class="px-3 py-2 font-mono">${claim}</td>
          <td class="px-3 py-2 font-mono">${String(value)}</td>
          <td class="px-3 py-2">${date.toLocaleString()}</td>
        </tr>`);
      }
    }
    if (rows.length === 0) {
      claimsWrapper.classList.add('hidden');
    } else {
      claimsBody.innerHTML = rows.join('');
      claimsWrapper.classList.remove('hidden');
    }
  }

  input.addEventListener('input', render);

  async function copyText(text: string, statusEl: Element) {
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  }

  headerCopyButton.addEventListener('click', () => {
    void copyText(headerOutput.textContent ?? '', headerCopyStatus);
  });
  payloadCopyButton.addEventListener('click', () => {
    void copyText(payloadOutput.textContent ?? '', payloadCopyStatus);
  });

  render();
</script>
