---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Hiragana & Katakana',
    description:
      'Both are phonetic Japanese scripts (kana) representing the same set of sounds. Even for the same sound, hiragana and katakana are treated as different characters by computers, so converting between them is often needed to normalize inconsistent text or prepare data for full-text search.',
  },
  {
    term: 'Iteration marks',
    description:
      'Symbols that represent a repetition of the previous character: "ゝ"/"ゞ" in hiragana and "ヽ"/"ヾ" in katakana. This tool converts these as well.',
  },
];
---

<Layout
  title="Hiragana / Katakana Converter"
  description="A free tool that converts between hiragana and katakana, including voiced, semi-voiced, contracted, and geminate sounds, plus iteration marks. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Hiragana / Katakana Converter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Enter text and it will be converted between hiragana and katakana, including
    voiced and semi-voiced sounds, contracted and geminate sounds, "ゔ"/"ヴ",
    and iteration marks (ゝゞ / ヽヾ). Kanji, alphanumerics, and other
    characters are left unchanged. For text that includes half-width katakana,
    try the
    <a
      href="/en/tools/zenkaku-hankaku/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Full-width / Half-width Converter
    </a>
    as well.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="kana-converter-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label="Direction"
    >
      <button
        type="button"
        data-mode="toKatakana"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        Hiragana → Katakana
      </button>
      <button
        type="button"
        data-mode="toHiragana"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        Katakana → Hiragana
      </button>
    </div>
    <button
      id="kana-converter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="kana-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="kana-converter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="kana-converter-input"
        class="h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="Enter text to convert"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="kana-converter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="kana-converter-output"
        readonly
        class="h-64 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    convertKana,
    type KanaDirection,
  } from '../../../../lib/tools/kana-converter';

  const input = document.getElementById(
    'kana-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'kana-converter-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#kana-converter-mode [data-mode]',
  );
  const copyButton = document.getElementById('kana-converter-copy-button')!;
  const statusEl = document.getElementById('kana-converter-status')!;

  let direction: KanaDirection = 'toKatakana';

  function convert() {
    statusEl.textContent = '';
    output.value = convertKana(input.value, direction);
  }

  input.addEventListener('input', convert);

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      direction = button.dataset.mode as KanaDirection;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  convert();
</script>
