---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'event.key',
    description:
      'The character or function name a pressed key represents (e.g. "a", "Enter", "ArrowUp"). Its value can change depending on keyboard layout, whether Shift is held, or whether an IME is mid-conversion.',
  },
  {
    term: 'event.code',
    description:
      'A string representing the physical location of a key on the keyboard (e.g. "KeyA", "Digit1"). Pressing the "1" key gives event.key a value of "1" or "!" depending on Shift, but event.code always stays "Digit1" regardless of keyboard layout.',
  },
  {
    term: 'KeyboardEvent.location',
    description:
      'Distinguishes keys that appear more than once on a keyboard, such as Shift, Ctrl, Alt, and Enter. 0 means standard, 1 means left, 2 means right, and 3 means the numeric keypad.',
  },
  {
    term: 'keyCode / which (deprecated)',
    description:
      'Older browser APIs that represent a key as a number. Their interpretation varies across browsers and keyboard layouts, so they are deprecated — new code should use event.key or event.code instead.',
  },
  {
    term: 'Modifier key',
    description:
      'A general term for keys such as Ctrl, Alt, Shift, and Meta that are held down together with another key. The Meta key corresponds to the Windows key on Windows and the Command key on Mac.',
  },
];
---

<Layout
  title="Keycode (e.code / e.key) Checker — Keyboard Event Inspector"
  description="Shows the event.key, event.code, keyCode, location, and modifier keys of any key you press, in real time — free, and works entirely in your browser. Handy for checking the difference between event.key and event.code, or keyboard layout quirks. Your data is processed locally and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Keycode (e.code / e.key) Checker</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Click the box below to focus it, then press any key to see its
    <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-sm dark:bg-gray-800">
      event.key
    </code>
    ,
    <code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-sm dark:bg-gray-800">
      event.code
    </code>
    , keyCode, location, and modifier key state in real time. Handy for checking
    real-device values while implementing keyboard event handling in JavaScript,
    or for understanding the difference between event.key and event.code.
    Everything happens in your browser, and the keys you press are never sent to
    a server. If you also need to test input patterns, try the
    <a
      href="/en/tools/regex-tester/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Regex Tester
    </a>
    as well.
  </p>

  <div
    id="keycode-capture"
    tabindex="0"
    role="application"
    aria-label="Key input detection area"
    class="flex min-h-32 cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 p-6 text-center text-gray-500 focus:border-blue-400 focus:text-blue-600 focus:outline-none dark:border-gray-700 dark:text-gray-400 dark:focus:border-blue-400 dark:focus:text-blue-400"
  >
    <p id="keycode-placeholder">Click here to focus, then press any key</p>
  </div>

  <div id="keycode-result" class="mt-6 hidden">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[420px] border-collapse text-sm">
        <tbody>
          {[
            { id: 'key', label: 'event.key' },
            { id: 'code', label: 'event.code' },
            { id: 'keycode', label: 'keyCode (deprecated)' },
            { id: 'location', label: 'location' },
            { id: 'modifiers', label: 'Modifier keys' },
            { id: 'repeat', label: 'Repeat (held down)' },
          ].map(({ id, label }) => (
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-2 pr-4 text-gray-600 dark:text-gray-400">
                {label}
              </td>
              <td
                id={`keycode-${id}`}
                class="py-2 text-right font-mono text-gray-900 dark:text-gray-100"
              />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-lg font-bold">History (last 10)</h2>
      <button
        type="button"
        id="keycode-clear-button"
        class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
      >
        Clear history
      </button>
    </div>
    <ol
      id="keycode-history"
      class="flex flex-col-reverse gap-1"
      aria-live="polite"
    ></ol>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      To detect a key press, click the box above to focus it first, then press
      any key.
    </li>
    <li>
      While the box is focused, browser default actions such as Tab moving focus
      or F5 reloading the page are prevented so you can see their values
      (clicking outside the box, or pressing Escape, restores normal behavior).
    </li>
    <li>
      Keys pressed while an IME is mid-conversion may report a special event.key
      value such as "Process", depending on your environment.
    </li>
    <li>
      The same physical key can report a different event.key value depending on
      keyboard layout (e.g. JIS vs. US). event.code represents the physical
      position and does not depend on layout.
    </li>
    <li>
      Some keys, such as media keys or shortcuts reserved by the browser, may
      not be detectable depending on your browser and OS combination.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    buildKeyEventInfo,
    type KeyEventInfo,
    type KeyEventLabels,
    type KeyLocation,
  } from '../../../../lib/tools/keycode-checker';

  const LABELS: KeyEventLabels = {
    location: {
      standard: 'standard',
      left: 'left',
      right: 'right',
      numpad: 'numpad',
      unknown: 'unknown',
    },
    none: 'None',
  };

  const capture = document.getElementById('keycode-capture')!;
  const placeholderEl = document.getElementById('keycode-placeholder')!;
  const resultEl = document.getElementById('keycode-result')!;
  const historyEl = document.getElementById(
    'keycode-history',
  ) as HTMLOListElement;
  const clearButton = document.getElementById(
    'keycode-clear-button',
  ) as HTMLButtonElement;

  type FieldId =
    'key' | 'code' | 'keycode' | 'location' | 'modifiers' | 'repeat';

  function fieldEl(id: FieldId): HTMLElement {
    return document.getElementById(`keycode-${id}`)!;
  }

  const MAX_HISTORY = 10;

  function displayKey(key: string): string {
    return key === ' ' ? 'Space (" ")' : key;
  }

  function render(info: KeyEventInfo) {
    fieldEl('key').textContent = displayKey(info.key);
    fieldEl('code').textContent = info.code;
    fieldEl('keycode').textContent = String(info.keyCode);
    fieldEl('location').textContent =
      `${info.location} (${info.locationLabel})`;
    fieldEl('modifiers').textContent = info.modifierLabel;
    fieldEl('repeat').textContent = info.repeat ? 'Yes (held down)' : 'No';
    placeholderEl.classList.add('hidden');
    resultEl.classList.remove('hidden');
  }

  function addHistory(info: KeyEventInfo) {
    const li = document.createElement('li');
    li.className =
      'rounded border border-gray-200 px-2 py-1 font-mono text-xs text-gray-700 dark:border-gray-700 dark:text-gray-300';
    li.textContent = `${info.code} (${displayKey(info.key)})`;
    historyEl.append(li);
    while (historyEl.children.length > MAX_HISTORY) {
      historyEl.removeChild(historyEl.firstElementChild!);
    }
  }

  capture.addEventListener('keydown', (event) => {
    // Escape is exempted from preventDefault so it can blur the box and
    // restore normal Tab navigation as an escape hatch.
    if (event.key !== 'Escape') {
      event.preventDefault();
    }
    const info = buildKeyEventInfo(
      {
        key: event.key,
        code: event.code,
        keyCode: event.keyCode,
        location: event.location as KeyLocation,
        shiftKey: event.shiftKey,
        ctrlKey: event.ctrlKey,
        altKey: event.altKey,
        metaKey: event.metaKey,
        repeat: event.repeat,
      },
      LABELS,
    );
    render(info);
    if (!info.repeat) {
      addHistory(info);
    }
    if (event.key === 'Escape') {
      capture.blur();
    }
  });

  capture.addEventListener('click', () => capture.focus());

  clearButton.addEventListener('click', () => {
    historyEl.replaceChildren();
  });
</script>
