---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'LF (line ending)',
    description:
      'Short for Line Feed, the "\\n" control character used to represent a newline. The standard on macOS and Linux.',
  },
  {
    term: 'CRLF (line ending)',
    description:
      'Short for Carriage Return + Line Feed, the two-character sequence "\\r\\n" used to represent a newline. The standard on Windows, and a common source of mixed line endings when exchanging text files across operating systems.',
  },
  {
    term: 'CR (line ending)',
    description:
      'Short for Carriage Return, the single "\\r" character used to represent a newline. Used by classic Mac OS (up to version 9) but rarely seen today.',
  },
];
---

<Layout
  title="Line Ending Converter (LF / CRLF / CR)"
  description="Free tool to detect and convert line endings in your text to LF, CRLF, or CR. Shows a breakdown of the line endings currently present. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">
    Line Ending Converter (LF / CRLF / CR)
  </h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Detects the line endings (LF, CRLF, or CR) in your text and converts them
    all to the type you choose. Handy for fixing mixed line endings after
    exchanging files between Windows and macOS/Linux, or for keeping unrelated
    line-ending changes out of a Git diff. To check the number of lines or
    characters, also try the
    <a
      href="/en/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Character Counter
    </a>
    tool.
  </p>

  <div>
    <span class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
      Load a file (for accurate line-ending detection and conversion)
    </span>
    <div
      id="lec-dropzone"
      class="rounded-lg border-2 border-dashed border-gray-300 p-4 text-center transition-colors dark:border-gray-700"
    >
      <input
        id="lec-file-input"
        type="file"
        accept=".txt,.md,.csv,.json,.yml,.yaml,.log,text/plain"
        class="block w-full text-sm text-gray-700 file:mr-4 file:min-h-11 file:cursor-pointer file:rounded-lg file:border-0 file:bg-gray-100 file:px-4 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-300 dark:file:bg-gray-800 dark:file:text-gray-200 dark:hover:file:bg-gray-700"
      />
      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        You can also drag and drop a file here
      </p>
    </div>
    <p
      id="lec-file-name"
      class="mt-1 text-xs text-gray-500 dark:text-gray-400"
    ></p>
  </div>

  <div class="mt-4">
    <label
      for="lec-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      Or type/paste text directly
    </label>
    <textarea
      id="lec-input"
      class="h-52 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      placeholder="Paste the text you want to convert"
      spellcheck="false"
    ></textarea>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      Note: browsers always normalize line endings to LF for text typed or
      pasted into this field. To accurately detect and convert an existing
      file's line endings, use "Load a file" above instead.
    </p>
    <p id="lec-stats" class="mt-1 text-xs text-gray-500 dark:text-gray-400"></p>
  </div>

  <div class="mt-4">
    <span class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
      Target line ending
    </span>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <label class="flex min-h-11 items-center gap-2">
        <input
          type="radio"
          name="lec-target"
          value="lf"
          id="lec-target-lf"
          class="h-4 w-4"
          checked
        />
        <span class="text-gray-700 dark:text-gray-300">
          LF (\n) — macOS/Linux
        </span>
      </label>
      <label class="flex min-h-11 items-center gap-2">
        <input
          type="radio"
          name="lec-target"
          value="crlf"
          id="lec-target-crlf"
          class="h-4 w-4"
        />
        <span class="text-gray-700 dark:text-gray-300">
          CRLF (\r\n) — Windows
        </span>
      </label>
      <label class="flex min-h-11 items-center gap-2">
        <input
          type="radio"
          name="lec-target"
          value="cr"
          id="lec-target-cr"
          class="h-4 w-4"
        />
        <span class="text-gray-700 dark:text-gray-300">
          CR (\r) — classic Mac OS
        </span>
      </label>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <button
      id="lec-copy-button"
      type="button"
      disabled
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <button
      id="lec-download-button"
      type="button"
      disabled
      class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-gray-700 dark:disabled:text-gray-400"
    >
      Download as file
    </button>
    <span
      id="lec-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4">
    <div class="mb-1 flex items-center justify-between">
      <span class="block text-sm font-medium text-gray-700 dark:text-gray-300">
        Result
      </span>
      <span
        id="lec-output-stats"
        class="text-xs text-gray-500 dark:text-gray-400"
      ></span>
    </div>
    <pre
      id="lec-output"
      class="h-52 w-full overflow-auto rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm whitespace-pre-wrap dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    ></pre>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      Browser &lt;textarea&gt; fields always normalize pasted or typed line
      endings to LF. To accurately detect and convert an existing file's line
      endings, use "Load a file" instead of typing directly.
    </li>
    <li>
      The file saved via "Download as file" contains exactly the line ending you
      chose. If you paste the copied result into another text editor or app
      instead, that app or OS may still convert the line endings on its own.
    </li>
    <li>
      Loaded files are read as UTF-8. Files in another encoding, such as
      Shift-JIS, may appear garbled.
    </li>
    <li>
      All processing happens in your browser — the file or text you load is
      never sent to a server.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    convertLineEndings,
    countLineEndings,
    type LineEnding,
    type LineEndingStats,
  } from '../../../../lib/tools/line-ending-converter';

  const input = document.getElementById('lec-input') as HTMLTextAreaElement;
  const dropzone = document.getElementById('lec-dropzone')!;
  const fileInput = document.getElementById(
    'lec-file-input',
  ) as HTMLInputElement;
  const fileNameEl = document.getElementById('lec-file-name')!;
  const statsEl = document.getElementById('lec-stats')!;
  const outputEl = document.getElementById('lec-output') as HTMLPreElement;
  const outputStatsEl = document.getElementById('lec-output-stats')!;
  const copyButton = document.getElementById(
    'lec-copy-button',
  ) as HTMLButtonElement;
  const downloadButton = document.getElementById(
    'lec-download-button',
  ) as HTMLButtonElement;
  const statusEl = document.getElementById('lec-status')!;
  const targetRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="lec-target"]',
  );

  // <textarea> normalizes CRLF/CR to LF by spec, so the text actually used
  // for detection/conversion is tracked here instead of re-reading input.value
  let currentText = '';
  let convertedText = '';

  function getTarget(): LineEnding {
    return (
      (Array.from(targetRadios).find((r) => r.checked)?.value as LineEnding) ??
      'lf'
    );
  }

  function formatStats(stats: LineEndingStats): string {
    return `LF ${stats.lf} / CRLF ${stats.crlf} / CR ${stats.cr}`;
  }

  function process() {
    statusEl.textContent = '';

    const stats = countLineEndings(currentText);
    statsEl.textContent =
      currentText === '' ? '' : `Current line endings: ${formatStats(stats)}`;

    convertedText = convertLineEndings(currentText, getTarget());
    outputEl.textContent = convertedText;

    const outputStats = countLineEndings(convertedText);
    outputStatsEl.textContent =
      convertedText === ''
        ? ''
        : `Converted line endings: ${formatStats(outputStats)}`;

    const hasResult = convertedText !== '';
    copyButton.disabled = !hasResult;
    downloadButton.disabled = !hasResult;
  }

  input.addEventListener('input', () => {
    currentText = input.value;
    process();
  });

  function loadFile(file: File) {
    const reader = new FileReader();
    reader.onload = () => {
      currentText = typeof reader.result === 'string' ? reader.result : '';
      input.value = currentText;
      fileNameEl.textContent = `Loaded: ${file.name}`;
      process();
    };
    reader.readAsText(file);
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    loadFile(file);
  });

  const dropzoneActiveClasses = ['border-blue-400', 'bg-blue-50'];

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add(...dropzoneActiveClasses);
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove(...dropzoneActiveClasses);
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove(...dropzoneActiveClasses);
    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    loadFile(file);
  });

  targetRadios.forEach((radio) => radio.addEventListener('change', process));

  copyButton.addEventListener('click', async () => {
    if (!convertedText) return;
    try {
      await navigator.clipboard.writeText(convertedText);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Copy failed';
    }
  });

  downloadButton.addEventListener('click', () => {
    if (!convertedText) return;
    const blob = new Blob([convertedText], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `converted-${getTarget()}.txt`;
    a.click();
    URL.revokeObjectURL(url);
    statusEl.textContent = 'Downloaded';
  });

  process();
</script>
