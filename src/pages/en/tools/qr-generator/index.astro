---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';
import { ERROR_CORRECTION_LEVEL_OPTIONS } from '../../../../lib/tools/qr-generator';

const LEVEL_LABELS: Record<string, string> = {
  L: 'Low (~7% recovery)',
  M: 'Medium (~15% recovery)',
  Q: 'High (~25% recovery)',
  H: 'Highest (~30% recovery)',
};

const glossaryTerms = [
  {
    term: 'QR code',
    description:
      'A two-dimensional barcode made of a black-and-white grid that encodes data. It can be scanned quickly with a smartphone camera to read a URL or text.',
  },
  {
    term: 'Error correction level',
    description:
      'How much redundant data the QR code carries so it can still be read even if part of it is smudged or damaged. A higher level tolerates more damage, but makes the pattern denser.',
  },
  {
    term: 'Quiet zone',
    description:
      "The blank margin required around a QR code. If this margin is too narrow or gets cropped, a camera may fail to recognize the code's boundaries and cannot scan it.",
  },
];
---

<Layout
  title="QR Code Generator"
  description="A free tool to create a QR code from any URL or text. Choose an error correction level and image size, then download it as a PNG. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">QR Code Generator</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Enter a URL or text and instantly preview the generated QR code. Everything
    happens in your browser, and nothing you type is ever sent to a server. Want
    to check how many characters you're about to enter? Try the
    <a
      href="/en/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Character Counter
    </a>
    as well.
  </p>

  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <label
        for="qr-generator-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Text / URL
      </label>
      <textarea
        id="qr-generator-input"
        class="h-40 w-full rounded-lg border border-gray-300 p-4 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="https://example.com"
        spellcheck="false"
      ></textarea>

      <div class="mt-4 flex flex-wrap gap-4">
        <div>
          <label
            for="qr-generator-level"
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Error correction level
          </label>
          <select
            id="qr-generator-level"
            class="h-11 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
          >
            {ERROR_CORRECTION_LEVEL_OPTIONS.map((option) => (
              <option value={option.value} selected={option.value === 'M'}>
                {LEVEL_LABELS[option.value]}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="qr-generator-size"
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            Download image size
          </label>
          <select
            id="qr-generator-size"
            class="h-11 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
          >
            <option value="256">Small (256px)</option>
            <option value="512" selected>
              Medium (512px)
            </option>
            <option value="1024">Large (1024px)</option>
            <option value="2048">Extra large (2048px)</option>
          </select>
        </div>
      </div>

      <p
        id="qr-generator-error"
        class="mt-3 text-sm text-red-600 dark:text-red-400"
        aria-live="polite"
      ></p>
    </div>

    <div class="flex flex-col items-center gap-3">
      <canvas
        id="qr-generator-canvas"
        class="h-64 w-64 max-w-full rounded-lg border border-gray-300 bg-white dark:border-gray-700"
      ></canvas>
      <div class="flex items-center gap-3">
        <button
          id="qr-generator-download-button"
          type="button"
          disabled
          class="min-h-11 rounded-lg bg-blue-600 px-4 text-sm font-medium text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-gray-700 dark:disabled:text-gray-400"
        >
          Download PNG
        </button>
      </div>
      <span
        id="qr-generator-status"
        class="text-sm text-green-600 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      How much text fits depends on the error correction level. If a long text
      or URL fails to generate, try lowering the error correction level.
    </li>
    <li>
      After generating, we recommend testing that the code actually scans with a
      smartphone camera.
    </li>
    <li>
      QR Code is a registered trademark of DENSO WAVE INCORPORATED in Japan and
      in other countries.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import { generateQrMatrix } from '../../../../lib/tools/qr-generator';
  import type {
    ErrorCorrectionLevel,
    QrMatrix,
  } from '../../../../lib/tools/qr-generator';

  const QUIET_ZONE_MODULES = 4;

  const input = document.getElementById(
    'qr-generator-input',
  ) as HTMLTextAreaElement;
  const levelSelect = document.getElementById(
    'qr-generator-level',
  ) as HTMLSelectElement;
  const sizeSelect = document.getElementById(
    'qr-generator-size',
  ) as HTMLSelectElement;
  const canvas = document.getElementById(
    'qr-generator-canvas',
  ) as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const errorEl = document.getElementById('qr-generator-error')!;
  const statusEl = document.getElementById('qr-generator-status')!;
  const downloadButton = document.getElementById(
    'qr-generator-download-button',
  ) as HTMLButtonElement;

  function drawMatrix(matrix: QrMatrix, targetSize: number) {
    const cellSize = Math.max(
      1,
      Math.floor(targetSize / (matrix.moduleCount + QUIET_ZONE_MODULES * 2)),
    );
    const canvasSize = (matrix.moduleCount + QUIET_ZONE_MODULES * 2) * cellSize;

    canvas.width = canvasSize;
    canvas.height = canvasSize;

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, canvasSize, canvasSize);
    ctx.fillStyle = '#000000';
    for (let row = 0; row < matrix.moduleCount; row++) {
      for (let col = 0; col < matrix.moduleCount; col++) {
        if (matrix.isDark(row, col)) {
          ctx.fillRect(
            (col + QUIET_ZONE_MODULES) * cellSize,
            (row + QUIET_ZONE_MODULES) * cellSize,
            cellSize,
            cellSize,
          );
        }
      }
    }
  }

  function clearCanvas() {
    canvas.width = 256;
    canvas.height = 256;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }

  function generate() {
    statusEl.textContent = '';
    errorEl.textContent = '';

    const result = generateQrMatrix(
      input.value,
      levelSelect.value as ErrorCorrectionLevel,
    );

    if (!result.ok) {
      clearCanvas();
      downloadButton.disabled = true;
      if (input.value !== '') {
        errorEl.textContent =
          'The input is too long to generate a QR code. Try shortening it or lowering the error correction level.';
      }
      return;
    }

    drawMatrix(result.matrix, Number(sizeSelect.value));
    downloadButton.disabled = false;
  }

  input.addEventListener('input', generate);
  levelSelect.addEventListener('change', generate);
  sizeSelect.addEventListener('change', generate);

  downloadButton.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'qrcode.png';
      a.click();
      URL.revokeObjectURL(url);
      statusEl.textContent = 'Downloaded';
    }, 'image/png');
  });

  clearCanvas();
  generate();
</script>
