---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'TOML',
    description:
      "Short for Tom's Obvious, Minimal Language — a simple data format for writing config as `key = value` pairs. Widely used for package config files such as Rust's `Cargo.toml` and Python's `pyproject.toml`.",
  },
  {
    term: 'YAML',
    description:
      'A human-friendly data format that represents structure through indentation. Widely used for config files such as Docker Compose, GitHub Actions, and Kubernetes manifests.',
  },
  {
    term: 'JSON',
    description:
      'Short for JavaScript Object Notation — a text format that represents data as key/value pairs. Used everywhere from API payloads to config files.',
  },
  {
    term: 'Table',
    description:
      "TOML's equivalent of a nested object. A header in square brackets, such as `[address]`, marks every `key = value` line that follows as belonging to that table.",
  },
];
---

<Layout
  title="TOML to JSON/YAML Converter"
  description="A free tool for converting between TOML, JSON, and YAML. Handy for checking the contents of a Cargo.toml or pyproject.toml as JSON or YAML, with clear syntax error messages. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">TOML to JSON/YAML Converter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Converts freely between any pair of TOML, JSON, and YAML. Handy for checking
    a TOML config file such as Cargo.toml or pyproject.toml as JSON or YAML. For
    JSON⇔YAML only, also try the
    <a
      href="/en/tools/yaml-json-converter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      YAML to JSON Converter
    </a>
    , and if you want to further format or validate the resulting JSON, try the
    <a
      href="/en/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON Formatter
    </a>
    tool.
  </p>

  <div class="flex flex-wrap items-end gap-3">
    <div>
      <label
        for="toml-converter-from"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        From
      </label>
      <select
        id="toml-converter-from"
        class="min-h-11 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      >
        <option value="toml" selected>
          TOML
        </option>
        <option value="json">JSON</option>
        <option value="yaml">YAML</option>
      </select>
    </div>
    <button
      id="toml-converter-swap-button"
      type="button"
      aria-label="Swap the from and to formats"
      title="Swap the from and to formats"
      class="flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8 7h12m0 0-4-4m4 4-4 4M16 17H4m0 0 4 4m-4-4 4-4"
        />
      </svg>
    </button>
    <div>
      <label
        for="toml-converter-to"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        To
      </label>
      <select
        id="toml-converter-to"
        class="min-h-11 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      >
        <option value="toml">TOML</option>
        <option value="json" selected>
          JSON
        </option>
        <option value="yaml">YAML</option>
      </select>
    </div>
    <div id="toml-converter-indent-wrapper">
      <label
        for="toml-converter-indent"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Indent width
      </label>
      <select
        id="toml-converter-indent"
        class="min-h-11 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      >
        <option value="2">2 spaces</option>
        <option value="4">4 spaces</option>
      </select>
    </div>
    <button
      id="toml-converter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      Copy
    </button>
    <span
      id="toml-converter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="toml-converter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Input
      </label>
      <textarea
        id="toml-converter-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="toml-converter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        Result
      </label>
      <textarea
        id="toml-converter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="toml-converter-error"
    hidden
    role="alert"
    class="mt-4 max-w-2xl overflow-x-auto rounded-lg border border-red-200 bg-red-50 p-3 font-mono text-xs whitespace-pre-wrap text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      TOML requires its top level to be a table (object). JSON or YAML whose top
      level is an array, string, or other non-object value cannot be converted
      to TOML.
    </li>
    <li>
      TOML has no equivalent of <code>null</code>. A <code>null</code> field in
      JSON/YAML is dropped when converting to TOML.
    </li>
    <li>
      Choosing the same format for both "from" and "to" reformats the document
      in place (e.g. TOML→TOML normalizes indentation and spacing).
    </li>
    <li>
      Everything runs entirely in your browser — the data you enter is never
      sent to a server.
    </li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    convert,
    type DataFormat,
  } from '../../../../lib/tools/toml-converter';

  const input = document.getElementById(
    'toml-converter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'toml-converter-output',
  ) as HTMLTextAreaElement;
  const fromSelect = document.getElementById(
    'toml-converter-from',
  ) as HTMLSelectElement;
  const toSelect = document.getElementById(
    'toml-converter-to',
  ) as HTMLSelectElement;
  const swapButton = document.getElementById('toml-converter-swap-button')!;
  const indentWrapper = document.getElementById(
    'toml-converter-indent-wrapper',
  )!;
  const indentSelect = document.getElementById(
    'toml-converter-indent',
  ) as HTMLSelectElement;
  const copyButton = document.getElementById('toml-converter-copy-button')!;
  const statusEl = document.getElementById('toml-converter-status')!;
  const errorEl = document.getElementById('toml-converter-error')!;

  const samples: Record<DataFormat, string> = {
    toml: 'name = "Taro"\nhobbies = ["reading", "coding"]\n',
    json: '{\n  "name": "Taro",\n  "hobbies": ["reading", "coding"]\n}\n',
    yaml: 'name: Taro\nhobbies:\n  - reading\n  - coding\n',
  };

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function updateIndentVisibility() {
    indentWrapper.classList.toggle('hidden', toSelect.value === 'toml');
  }

  function runConvert() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const from = fromSelect.value as DataFormat;
    const to = toSelect.value as DataFormat;
    const indent = Number(indentSelect.value);
    const result = convert(from, to, input.value, indent);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(`Syntax error: ${result.message}`);
    }
  }

  input.addEventListener('input', runConvert);
  indentSelect.addEventListener('change', runConvert);

  fromSelect.addEventListener('change', () => {
    input.value = samples[fromSelect.value as DataFormat];
    runConvert();
  });

  toSelect.addEventListener('change', () => {
    updateIndentVisibility();
    runConvert();
  });

  swapButton.addEventListener('click', () => {
    const from = fromSelect.value;
    const to = toSelect.value;
    fromSelect.value = to;
    toSelect.value = from;
    input.value = output.value || samples[fromSelect.value as DataFormat];
    updateIndentVisibility();
    runConvert();
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'Copied';
    } catch {
      statusEl.textContent = 'Failed to copy';
    }
  });

  input.value = samples.toml;
  updateIndentVisibility();
  runConvert();
</script>
