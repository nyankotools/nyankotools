---
import Glossary from '../../../../components/Glossary.astro';
import Layout from '../../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'Unix timestamp (Unix time / epoch seconds)',
    description:
      'A way of representing a point in time as the number of seconds elapsed since 00:00:00 UTC on January 1, 1970. Because it does not depend on a timezone, it is commonly used to exchange dates and times between systems.',
  },
  {
    term: 'Millisecond timestamp',
    description:
      "A Unix timestamp multiplied by 1000 and expressed in milliseconds. Commonly seen in JavaScript's Date.now() and in log timestamps, typically around 13 digits long.",
  },
  {
    term: 'UTC (Coordinated Universal Time)',
    description:
      'The global time standard. Local timezones are expressed as an offset from UTC, such as UTC+9 for Japan Standard Time.',
  },
];
---

<Layout
  title="Unix Timestamp Converter"
  description="A free tool to convert between a Unix timestamp (epoch seconds or milliseconds) and a date/time. Also shows the current timestamp. Your data is processed in the browser and never sent to a server."
>
  <h1 class="mb-2 text-2xl font-bold">Unix Timestamp Converter</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    Converts a Unix timestamp (epoch seconds or milliseconds) to a date/time and
    back, in real time. The unit is auto-detected from the number of digits, but
    you can also switch it manually. Everything happens in your browser, and
    nothing you type is ever sent to a server. Need to check the length of a
    formatted log line? Check out the
    <a
      href="/en/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Character Counter
    </a>
    as well.
  </p>

  <section class="mb-8 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-2 text-lg font-bold">Current Unix time</h2>
    <div class="flex flex-wrap items-center gap-3">
      <span
        id="unix-timestamp-now"
        class="font-mono text-2xl tabular-nums"
      ></span>
      <button
        type="button"
        id="unix-timestamp-now-copy"
        class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
      >
        Copy
      </button>
    </div>
    <p
      id="unix-timestamp-now-local"
      class="mt-1 text-sm text-gray-600 dark:text-gray-400"
    ></p>
  </section>

  <section class="mb-8 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">Timestamp &rarr; Date/time</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <label
          for="unix-timestamp-input"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Timestamp
        </label>
        <input
          id="unix-timestamp-input"
          type="text"
          inputmode="numeric"
          placeholder="1700000000"
          spellcheck="false"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <label
          for="unix-timestamp-unit"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Unit
        </label>
        <select
          id="unix-timestamp-unit"
          class="h-11 rounded-lg border border-gray-300 bg-white px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        >
          <option value="auto">Auto-detect</option>
          <option value="seconds">Seconds</option>
          <option value="milliseconds">Milliseconds</option>
        </select>
      </div>
    </div>
    <p
      id="unix-timestamp-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <dl class="mt-4 space-y-2 text-sm">
      <div class="flex flex-wrap items-center gap-2">
        <dt class="w-24 shrink-0 text-gray-500 dark:text-gray-400">
          Local time
        </dt>
        <dd id="unix-timestamp-local" class="font-mono"></dd>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <dt class="w-24 shrink-0 text-gray-500 dark:text-gray-400">UTC</dt>
        <dd id="unix-timestamp-utc" class="font-mono"></dd>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <dt class="w-24 shrink-0 text-gray-500 dark:text-gray-400">ISO 8601</dt>
        <dd id="unix-timestamp-iso" class="font-mono"></dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">Date/time &rarr; Timestamp</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div class="min-w-0 flex-1">
        <label
          for="unix-timestamp-datetime"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          Date/time (local)
        </label>
        <input
          id="unix-timestamp-datetime"
          type="datetime-local"
          step="1"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        />
      </div>
      <button
        type="button"
        id="unix-timestamp-datetime-now"
        class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
      >
        Use current date/time
      </button>
    </div>

    <dl class="mt-4 space-y-2 text-sm">
      <div class="flex flex-wrap items-center gap-2">
        <dt class="w-24 shrink-0 text-gray-500 dark:text-gray-400">Seconds</dt>
        <dd id="unix-timestamp-result-seconds" class="font-mono"></dd>
        <button
          type="button"
          data-copy-target="unix-timestamp-result-seconds"
          class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Copy
        </button>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <dt class="w-24 shrink-0 text-gray-500 dark:text-gray-400">
          Milliseconds
        </dt>
        <dd id="unix-timestamp-result-milliseconds" class="font-mono"></dd>
        <button
          type="button"
          data-copy-target="unix-timestamp-result-milliseconds"
          class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          Copy
        </button>
      </div>
    </dl>
    <span
      id="unix-timestamp-status"
      class="mt-2 block text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">Notes</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      With "Auto-detect", values of 10 digits or fewer are treated as seconds
      and 11 digits or more as milliseconds. Microsecond and nanosecond
      timestamps are not supported.
    </li>
    <li>
      The "Date/time &rarr; Timestamp" field is interpreted in your device's
      local timezone.
    </li>
    <li>Dates before 1970 result in a negative timestamp.</li>
  </ul>

  <Glossary terms={glossaryTerms} heading="Glossary" />
</Layout>

<script>
  import {
    dateToTimestamp,
    detectTimestampUnit,
    formatDateTimeLocalValue,
    parseDateTimeLocalValue,
    parseTimestampInput,
    timestampToDate,
    type TimestampUnit,
  } from '../../../../lib/tools/unix-timestamp';

  const nowEl = document.getElementById('unix-timestamp-now')!;
  const nowLocalEl = document.getElementById('unix-timestamp-now-local')!;
  const nowCopyButton = document.getElementById(
    'unix-timestamp-now-copy',
  ) as HTMLButtonElement;

  const input = document.getElementById(
    'unix-timestamp-input',
  ) as HTMLInputElement;
  const unitSelect = document.getElementById(
    'unix-timestamp-unit',
  ) as HTMLSelectElement;
  const errorEl = document.getElementById('unix-timestamp-error')!;
  const localEl = document.getElementById('unix-timestamp-local')!;
  const utcEl = document.getElementById('unix-timestamp-utc')!;
  const isoEl = document.getElementById('unix-timestamp-iso')!;

  const datetimeInput = document.getElementById(
    'unix-timestamp-datetime',
  ) as HTMLInputElement;
  const datetimeNowButton = document.getElementById(
    'unix-timestamp-datetime-now',
  ) as HTMLButtonElement;
  const resultSecondsEl = document.getElementById(
    'unix-timestamp-result-seconds',
  )!;
  const resultMillisecondsEl = document.getElementById(
    'unix-timestamp-result-milliseconds',
  )!;
  const statusEl = document.getElementById('unix-timestamp-status')!;

  const localFormatter = new Intl.DateTimeFormat('en-US', {
    dateStyle: 'full',
    timeStyle: 'medium',
  });
  const utcFormatter = new Intl.DateTimeFormat('en-US', {
    dateStyle: 'full',
    timeStyle: 'medium',
    timeZone: 'UTC',
  });

  function updateNow() {
    const now = new Date();
    nowEl.textContent = String(dateToTimestamp(now).seconds);
    nowLocalEl.textContent = localFormatter.format(now);
  }
  updateNow();
  setInterval(updateNow, 1000);

  nowCopyButton.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(nowEl.textContent ?? '');
    } catch {
      // Clipboard API unavailable; do nothing
    }
  });

  function renderTimestampToDate() {
    errorEl.textContent = '';
    localEl.textContent = '';
    utcEl.textContent = '';
    isoEl.textContent = '';

    if (input.value.trim() === '') return;

    const value = parseTimestampInput(input.value);
    if (value === null) {
      errorEl.textContent =
        'Please enter an integer timestamp (e.g. 1700000000)';
      return;
    }

    const unitOption = unitSelect.value as TimestampUnit | 'auto';
    const unit: TimestampUnit =
      unitOption === 'auto' ? detectTimestampUnit(value) : unitOption;

    const date = timestampToDate(value, unit);
    if (!date) {
      errorEl.textContent = 'Could not convert to a date/time';
      return;
    }

    localEl.textContent = localFormatter.format(date);
    utcEl.textContent = utcFormatter.format(date);
    isoEl.textContent = date.toISOString();
  }

  input.addEventListener('input', renderTimestampToDate);
  unitSelect.addEventListener('change', renderTimestampToDate);

  function renderDateToTimestamp() {
    statusEl.textContent = '';
    resultSecondsEl.textContent = '';
    resultMillisecondsEl.textContent = '';

    const date = parseDateTimeLocalValue(datetimeInput.value);
    if (!date) return;

    const { seconds, milliseconds } = dateToTimestamp(date);
    resultSecondsEl.textContent = String(seconds);
    resultMillisecondsEl.textContent = String(milliseconds);
  }

  datetimeInput.addEventListener('input', renderDateToTimestamp);

  datetimeNowButton.addEventListener('click', () => {
    datetimeInput.value = formatDateTimeLocalValue(new Date());
    renderDateToTimestamp();
  });

  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-target]')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const targetId = button.dataset.copyTarget!;
        const target = document.getElementById(targetId);
        if (!target?.textContent) return;
        try {
          await navigator.clipboard.writeText(target.textContent);
          statusEl.textContent = 'Copied';
        } catch {
          statusEl.textContent = 'Copy failed';
        }
      });
    });

  datetimeInput.value = formatDateTimeLocalValue(new Date());
  renderDateToTimestamp();
</script>
