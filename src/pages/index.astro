---
import Layout from '../layouts/Layout.astro';
import { getLocalizedTools } from '../data/tools';
import { groupByCategory } from '../lib/home-filter';
import { useTranslations } from '../i18n/ui';
import HomeToolSections from '../components/HomeToolSections.astro';

const t = useTranslations('ja');
const tools = getLocalizedTools('ja');
const categories = groupByCategory(tools);
// "{count}" の前後で分割し、件数だけ大きく表示する（[前, 件数, 後]）
const [countBefore, countAfter] = t('home.toolCount').split('{count}');
const toolCountParts = [countBefore, '', countAfter];
---

<Layout
  title="日本語処理も得意な無料Webツール集"
  description={t('home.meta.description').replace('{count}', String(tools.length))}
>
  <h1 class="mb-2 text-2xl font-bold">{t('home.title')}</h1>
  <p class="mb-3 inline-flex items-baseline gap-1 rounded-full border border-blue-200 bg-blue-50 px-5 py-2 text-blue-800 dark:border-blue-800 dark:bg-blue-950/50 dark:text-blue-200">
    {toolCountParts.map((part, i) =>
      i === 1 ? (
        <span class="text-3xl font-extrabold tabular-nums">{tools.length}</span>
      ) : (
        <span class="text-sm font-semibold">{part}</span>
      ),
    )}
  </p>
  <p class="mb-8 text-gray-600 dark:text-gray-400">{t('home.lead')}</p>

  <div class="mb-6 space-y-4">
    <div>
      <label for="tool-search" class="sr-only">
        {t('home.search.label')}
      </label>
      <input
        id="tool-search"
        type="search"
        placeholder={t('home.search.placeholder')}
        class="w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm shadow-sm focus:border-blue-600 focus:outline-2 focus:outline-blue-600 dark:focus:border-blue-400 dark:focus:outline-blue-400 focus:ring-2 focus:ring-blue-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      />
    </div>

    <div
      data-drag-scroll
      class="relative -my-1 flex cursor-grab gap-2 py-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      role="group"
      aria-label={t('home.category.groupLabel')}
    >
      <button
        type="button"
        data-category-filter="all"
        aria-pressed="true"
        class="inline-flex min-h-11 shrink-0 cursor-[inherit] items-center rounded-full border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 transition hover:border-blue-300 hover:text-blue-700 aria-pressed:border-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-400"
      >
        {t('home.category.all')}
      </button>
      {categories.map((category) => (
        <button
          type="button"
          data-category-filter={category.id}
          aria-pressed="false"
          class="inline-flex min-h-11 shrink-0 cursor-[inherit] items-center rounded-full border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 transition hover:border-blue-300 hover:text-blue-700 aria-pressed:border-blue-600 aria-pressed:bg-blue-600 aria-pressed:text-white dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-400"
        >
          {category.label}
        </button>
      ))}
    </div>
  </div>

  <p id="no-results" hidden class="text-sm text-gray-500 dark:text-gray-400">
    {t('home.noResults')}
  </p>

  <HomeToolSections tools={tools} locale="ja" />
  <nav class="mt-10" aria-labelledby="home-categories-heading">
    <h2 id="home-categories-heading" class="mb-3 text-lg font-semibold">
      {t('category.viewAll')}
    </h2>
    <ul class="flex flex-wrap gap-2">
      {categories.map((category) => (
        <li>
          <a
            href={`/tools/category/${category.id}/`}
            class="inline-flex min-h-11 items-center rounded-full border border-gray-200 bg-white px-4 text-sm font-medium text-gray-700 hover:border-blue-300 hover:text-blue-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-400"
          >
            {category.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</Layout>

<script>
  import { initHomePage } from '../lib/home-page';

  initHomePage();
</script>
