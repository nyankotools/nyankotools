---
import ShindanLayout from '../../layouts/ShindanLayout.astro';
import ShindanRunner from '../../components/shindan/ShindanRunner.astro';
import { shindanThemes, type ShindanTheme } from '../../data/themes';
import { shindanUiJa as ui } from '../../i18n/shindan/ui';

export function getStaticPaths() {
  return shindanThemes.map((theme) => ({
    params: { theme: theme.spec.id },
    props: { theme },
  }));
}

interface Props {
  theme: ShindanTheme;
}

const { theme } = Astro.props;
const texts = theme.texts.ja;
const sectionHeading = 'mb-3 text-lg font-bold';
---

<ShindanLayout
  title={texts.title}
  description={texts.description}
  structuredName={texts.name}
  breadcrumbs={[{ name: ui.sectionName, path: '/shindan/' }]}
>
  <nav aria-label="パンくずリスト" class="mb-3 text-sm">
    <a
      href="/shindan/"
      class="text-gray-600 hover:text-blue-700 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
    >
      {ui.sectionName}
    </a>
    <span class="mx-1 text-gray-400" aria-hidden="true">
      ›
    </span>
    <span aria-current="page">{texts.name}</span>
  </nav>
  <h1 class="mb-4 text-2xl font-bold">{texts.h1}</h1>

  <ShindanRunner theme={theme} />

  <section class="mb-10">
    <h2 class={sectionHeading}>{ui.howItWorksHeading}</h2>
    <div class="space-y-3 text-gray-700 dark:text-gray-300">
      {texts.howItWorks.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="mb-10">
    <h2 class={sectionHeading}>{ui.typesHeading}</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {theme.spec.scoring.types.map((type) => {
        const typeTexts = texts.types[type.id];
        const image = theme.images[type.id];
        return (
          <li class="flex gap-3 rounded-xl border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">
            <img
              src={image.src}
              width={image.width}
              height={image.height}
              alt=""
              loading="lazy"
              decoding="async"
              class="h-20 w-20 shrink-0 rounded-xl"
            />
            <div class="min-w-0">
              <h3 class="font-bold">{typeTexts.name}</h3>
              <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
                {typeTexts.description}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mb-6 rounded-xl bg-gray-100 p-4 text-sm text-gray-700 dark:bg-gray-900 dark:text-gray-300">
    <h2 class="mb-2 font-bold">{ui.disclaimerHeading}</h2>
    <ul class="list-disc space-y-1 pl-5">
      {ui.disclaimers.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
</ShindanLayout>
