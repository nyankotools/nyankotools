---
import ShindanLayout from '../../layouts/ShindanLayout.astro';
import { shindanThemes } from '../../data/themes';
import { shindanUiJa as ui } from '../../i18n/shindan/ui';
---

<ShindanLayout title={ui.sectionName} description={ui.sectionDescription}>
  <h1 class="mb-2 text-2xl font-bold">{ui.sectionName}</h1>
  <p class="mb-8 text-gray-600 dark:text-gray-400">{ui.sectionDescription}</p>

  <h2 class="mb-3 text-lg font-bold">{ui.themesHeading}</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {shindanThemes.map((theme) => {
      const texts = theme.texts.ja;
      const image = theme.images[theme.spec.scoring.types[0].id];
      return (
        <li>
          <a
            href={`/shindan/${theme.spec.id}/`}
            class="flex h-full gap-3 rounded-xl border border-gray-200 bg-white p-3 hover:border-[#4a2f63] hover:bg-violet-50 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-violet-300 dark:hover:bg-gray-800"
          >
            <img
              src={image.src}
              width={image.width}
              height={image.height}
              alt=""
              class="h-20 w-20 shrink-0 rounded-xl"
            />
            <span class="min-w-0">
              <span class="block font-bold">{texts.name}</span>
              <span class="mt-1 block text-sm text-gray-700 dark:text-gray-300">
                {texts.intro}
              </span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</ShindanLayout>
