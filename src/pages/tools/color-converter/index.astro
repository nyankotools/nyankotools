---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'HEX（16進数カラーコード）',
    description:
      '「#3b82f6」のように#と6桁（または3桁）の16進数で色を表す形式です。CSSやデザインツールで最も一般的に使われます。',
  },
  {
    term: 'RGB',
    description:
      '赤(Red)・緑(Green)・青(Blue)の光の三原色を、それぞれ0〜255の数値で表す形式です。',
  },
  {
    term: 'HSL',
    description:
      '色相(Hue・0〜360度)、彩度(Saturation・0〜100%)、明度(Lightness・0〜100%)で色を表す形式です。「同じ色味で明るさだけ変える」といった調整がしやすいのが特徴です。',
  },
];
---

<Layout
  title="カラーコード変換（HEX/RGB/HSL）"
  description="HEX・RGB・HSLのカラーコードを相互に変換できる無料ツールです。カラーピッカーで直感的に色を選ぶこともできます。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">カラーコード変換（HEX/RGB/HSL）</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    HEX・RGB・HSL形式のカラーコードをリアルタイムで相互変換します。いずれかの欄に値を入力するか、カラーピッカーで色を選ぶと他の形式に自動で反映されます。ブラウザ内で処理され、入力内容がサーバーに送信されることはありません。QRコードの色指定などにお困りの場合は
    <a
      href="/tools/qr-generator/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      QRコード生成
    </a>
    もあわせてご利用ください。
  </p>

  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <div class="flex flex-col items-center gap-2">
      <input
        id="color-converter-picker"
        type="color"
        value="#3b82f6"
        aria-label="カラーピッカー"
        class="h-24 w-24 cursor-pointer rounded-lg border border-gray-300 bg-transparent p-1 dark:border-gray-700"
      />
    </div>

    <div class="flex-1 space-y-4">
      {[
        { id: 'hex', label: 'HEX', placeholder: '#3b82f6' },
        { id: 'rgb', label: 'RGB', placeholder: 'rgb(59, 130, 246)' },
        { id: 'hsl', label: 'HSL', placeholder: 'hsl(217, 91%, 60%)' },
      ].map((field) => (
        <div>
          <label
            for={`color-converter-${field.id}`}
            class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
          >
            {field.label}
          </label>
          <div class="flex gap-2">
            <input
              id={`color-converter-${field.id}`}
              type="text"
              placeholder={field.placeholder}
              spellcheck="false"
              class="h-11 w-full min-w-0 rounded-lg border border-gray-300 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
            />
            <button
              type="button"
              data-copy-target={`color-converter-${field.id}`}
              class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
            >
              コピー
            </button>
          </div>
        </div>
      ))}
      <p
        id="color-converter-error"
        class="text-sm text-red-600 dark:text-red-400"
        aria-live="polite"
      ></p>
      <span
        id="color-converter-status"
        class="block text-sm text-green-600 dark:text-green-400"
        aria-live="polite"
      ></span>
    </div>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意事項</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      RGB・HSLは「rgb(255, 0, 0)」「hsl(0, 100%,
      50%)」のような形式のほか、「255, 0,
      0」のようにカンマ区切りの数値だけでも入力できます。
    </li>
    <li>
      入力した値が形式として不正な場合、他の欄への反映は行われずエラーメッセージを表示します。
    </li>
    <li>
      透明度（アルファ値）には対応していません。rgba()・hsla()形式を入力した場合はアルファ値を無視して変換します。
    </li>
  </ul>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import {
    formatHsl,
    formatRgb,
    hexToRgb,
    hslToRgb,
    parseHslString,
    parseRgbString,
    rgbToHex,
    rgbToHsl,
    type RgbColor,
  } from '../../../lib/tools/color-converter';

  const picker = document.getElementById(
    'color-converter-picker',
  ) as HTMLInputElement;
  const hexInput = document.getElementById(
    'color-converter-hex',
  ) as HTMLInputElement;
  const rgbInput = document.getElementById(
    'color-converter-rgb',
  ) as HTMLInputElement;
  const hslInput = document.getElementById(
    'color-converter-hsl',
  ) as HTMLInputElement;
  const errorEl = document.getElementById('color-converter-error')!;
  const statusEl = document.getElementById('color-converter-status')!;
  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');

  type Source = 'hex' | 'rgb' | 'hsl' | 'picker' | 'init';

  function applyRgb(rgb: RgbColor, source: Source) {
    errorEl.textContent = '';
    const hex = rgbToHex(rgb);
    if (source !== 'hex') hexInput.value = hex;
    if (source !== 'rgb') rgbInput.value = formatRgb(rgb);
    if (source !== 'hsl') hslInput.value = formatHsl(rgbToHsl(rgb));
    if (source !== 'picker') picker.value = hex;
  }

  hexInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (hexInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const rgb = hexToRgb(hexInput.value);
    if (!rgb) {
      errorEl.textContent = 'HEXの形式が正しくありません（例: #3b82f6）';
      return;
    }
    applyRgb(rgb, 'hex');
  });

  rgbInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (rgbInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const rgb = parseRgbString(rgbInput.value);
    if (!rgb) {
      errorEl.textContent =
        'RGBの形式が正しくありません（例: rgb(59, 130, 246)）';
      return;
    }
    applyRgb(rgb, 'rgb');
  });

  hslInput.addEventListener('input', () => {
    statusEl.textContent = '';
    if (hslInput.value === '') {
      errorEl.textContent = '';
      return;
    }
    const hsl = parseHslString(hslInput.value);
    if (!hsl) {
      errorEl.textContent =
        'HSLの形式が正しくありません（例: hsl(217, 91%, 60%)）';
      return;
    }
    applyRgb(hslToRgb(hsl), 'hsl');
  });

  picker.addEventListener('input', () => {
    statusEl.textContent = '';
    const rgb = hexToRgb(picker.value);
    if (!rgb) return;
    applyRgb(rgb, 'picker');
  });

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      try {
        await navigator.clipboard.writeText(target.value);
        statusEl.textContent = 'コピーしました';
      } catch {
        statusEl.textContent = 'コピーに失敗しました';
      }
    });
  });

  applyRgb(hexToRgb(picker.value)!, 'init');
</script>
