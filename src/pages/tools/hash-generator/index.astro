---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="ハッシュ生成（MD5/SHA-1/SHA-256）"
  description="テキストからMD5・SHA-1・SHA-256のハッシュ値を無料で計算できるツールです。ファイルの改ざんチェックやパスワードのハッシュ化確認などにご利用ください。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">ハッシュ生成（MD5/SHA-1/SHA-256）</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    入力したテキストのMD5・SHA-1・SHA-256ハッシュ値をリアルタイムで計算します。ブラウザ内で処理され、入力内容がサーバーに送信されることはありません。ランダムな文字列が必要な場合は
    <a
      href="/tools/password-generator/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      パスワード生成
    </a>
    もあわせてご利用ください。
  </p>

  <div>
    <label
      for="hash-generator-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      入力
    </label>
    <textarea
      id="hash-generator-input"
      class="h-40 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      placeholder="ハッシュ化したいテキストを入力"
      spellcheck="false"
    ></textarea>
  </div>

  <div class="mt-4 space-y-3">
    {[
      { id: 'md5', label: 'MD5' },
      { id: 'sha1', label: 'SHA-1' },
      { id: 'sha256', label: 'SHA-256' },
    ].map((algorithm) => (
      <div>
        <label
          for={`hash-generator-${algorithm.id}`}
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          {algorithm.label}
        </label>
        <div class="flex gap-2">
          <input
            id={`hash-generator-${algorithm.id}`}
            type="text"
            readonly
            class="h-11 w-full min-w-0 rounded-lg border border-gray-300 bg-gray-50 px-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
          />
          <button
            type="button"
            data-copy-target={`hash-generator-${algorithm.id}`}
            class="min-h-11 shrink-0 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
          >
            コピー
          </button>
        </div>
      </div>
    ))}
    <span
      id="hash-generator-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意事項</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      MD5・SHA-1は既知の脆弱性があり、パスワードの保存など安全性が求められる用途には使用しないでください。
    </li>
    <li>入力は改行やスペースも含めて厳密に区別されます。</li>
  </ul>
</Layout>

<script>
  import { computeHashes } from '../../../lib/tools/hash-generator';

  const input = document.getElementById(
    'hash-generator-input',
  ) as HTMLTextAreaElement;
  const outputs = {
    MD5: document.getElementById('hash-generator-md5') as HTMLInputElement,
    'SHA-1': document.getElementById('hash-generator-sha1') as HTMLInputElement,
    'SHA-256': document.getElementById(
      'hash-generator-sha256',
    ) as HTMLInputElement,
  };
  const statusEl = document.getElementById('hash-generator-status')!;
  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]');

  async function generate() {
    statusEl.textContent = '';
    const hashes = await computeHashes(input.value);
    for (const [algorithm, value] of Object.entries(hashes)) {
      outputs[algorithm as keyof typeof outputs].value = value;
    }
  }

  input.addEventListener('input', generate);

  copyButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.dataset.copyTarget!;
      const target = document.getElementById(targetId) as HTMLInputElement;
      if (!target.value) return;
      try {
        await navigator.clipboard.writeText(target.value);
        statusEl.textContent = 'コピーしました';
      } catch {
        statusEl.textContent = 'コピーに失敗しました';
      }
    });
  });

  generate();
</script>
