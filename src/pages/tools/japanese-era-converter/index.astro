---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';
import { ERAS } from '../../../lib/tools/japanese-era-converter';

const glossaryTerms = [
  {
    term: '元号（げんごう）',
    description:
      '日本独自の紀年法で、天皇の即位などを機に定められる年の呼び方です。現在の元号は「令和」で、2019年5月1日の改元により始まりました。',
  },
  {
    term: '和暦（われき）',
    description:
      '元号と元号年（例: 令和6年）で年を表す方式です。西暦と対比して使われます。',
  },
  {
    term: '元年（がんねん）',
    description:
      'その元号が始まった最初の年のことです。「令和元年」のように、1年目は「1年」ではなく「元年」と表記します。',
  },
];
---

<Layout
  title="和暦⇔西暦変換（元号早見表）"
  description="令和・平成・昭和・大正・明治の和暦と西暦を相互に変換できる無料ツールです。改元日をまたぐ日付にも対応。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">和暦⇔西暦変換</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    明治・大正・昭和・平成・令和の和暦と西暦をリアルタイムで相互変換します。改元日（例:
    昭和64年1月7日→平成元年1月8日）をまたぐ日付も正しく判定します。ブラウザ内で処理され、入力内容がサーバーに送信されることはありません。生年月日から年齢を計算したい場合は
    <a
      href="/tools/unix-timestamp/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      Unixタイムスタンプ変換
    </a>
    もあわせてご利用ください。
  </p>

  <section class="mb-8 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">西暦 → 和暦</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <span
          id="era-w2j-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          西暦の日付
        </span>
        <div
          class="flex items-center gap-1"
          role="group"
          aria-labelledby="era-w2j-label"
        >
          <input
            id="era-w2j-year"
            type="number"
            inputmode="numeric"
            min="1"
            max="9999"
            placeholder="2024"
            aria-label="西暦の年"
            class="h-11 w-24 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">年</span>
          <input
            id="era-w2j-month"
            type="number"
            inputmode="numeric"
            min="1"
            max="12"
            placeholder="6"
            aria-label="西暦の月"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">月</span>
          <input
            id="era-w2j-day"
            type="number"
            inputmode="numeric"
            min="1"
            max="31"
            placeholder="15"
            aria-label="西暦の日"
            class="h-11 w-16 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
          />
          <span class="text-sm text-gray-600 dark:text-gray-400">日</span>
        </div>
      </div>
    </div>
    <p
      id="era-w2j-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-w2j-result"
      aria-live="polite"
    ></p>
  </section>

  <section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">和暦 → 西暦</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label
          for="era-j2w-era"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          元号
        </label>
        <select
          id="era-j2w-era"
          class="h-11 rounded-lg border border-gray-300 bg-white px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        >
          {ERAS.slice()
            .reverse()
            .map((era) => (
              <option value={era.name}>{era.name}</option>
            ))}
        </select>
      </div>
      <div class="w-24">
        <label
          for="era-j2w-year"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          年
        </label>
        <input
          id="era-j2w-year"
          type="number"
          min="1"
          max="99"
          inputmode="numeric"
          placeholder="6"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label
          for="era-j2w-month"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          月
        </label>
        <input
          id="era-j2w-month"
          type="number"
          min="1"
          max="12"
          inputmode="numeric"
          placeholder="6"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div class="w-20">
        <label
          for="era-j2w-day"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          日
        </label>
        <input
          id="era-j2w-day"
          type="number"
          min="1"
          max="31"
          inputmode="numeric"
          placeholder="15"
          class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
    </div>
    <p
      id="era-j2w-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>
    <p
      class="mt-4 text-2xl font-bold"
      id="era-j2w-result"
      aria-live="polite"
    ></p>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">元号早見表</h2>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-left dark:border-gray-700">
          <th class="py-2 pr-4">元号</th>
          <th class="py-2 pr-4">開始日</th>
          <th class="py-2">元年の西暦</th>
        </tr>
      </thead>
      <tbody>
        {ERAS.slice()
          .reverse()
          .map((era) => (
            <tr class="border-b border-gray-100 dark:border-gray-800">
              <td class="py-2 pr-4 font-medium">{era.name}</td>
              <td class="py-2 pr-4">
                {era.start.year}年{era.start.month}月{era.start.day}日
              </td>
              <td class="py-2">{era.start.year}年</td>
            </tr>
          ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意事項</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      対応範囲は明治元年（1868年1月25日）以降です。それより前の日付は変換できません。
    </li>
    <li>
      改元日の前後（例:
      昭和64年1月7日と平成元年1月8日）は特に間違えやすいため、日付単位で正確に判定しています。
    </li>
    <li>元号年の1年目は「元年」と表示されます（例: 令和元年）。</li>
  </ul>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import {
    formatEraYear,
    warekiToWestern,
    westernToWareki,
  } from '../../../lib/tools/japanese-era-converter';

  const w2jYearInput = document.getElementById(
    'era-w2j-year',
  ) as HTMLInputElement;
  const w2jMonthInput = document.getElementById(
    'era-w2j-month',
  ) as HTMLInputElement;
  const w2jDayInput = document.getElementById(
    'era-w2j-day',
  ) as HTMLInputElement;
  const w2jErrorEl = document.getElementById('era-w2j-error')!;
  const w2jResultEl = document.getElementById('era-w2j-result')!;

  function renderWesternToWareki() {
    w2jErrorEl.textContent = '';
    w2jResultEl.textContent = '';

    if (
      w2jYearInput.value === '' ||
      w2jMonthInput.value === '' ||
      w2jDayInput.value === ''
    ) {
      return;
    }

    const result = westernToWareki(
      Number(w2jYearInput.value),
      Number(w2jMonthInput.value),
      Number(w2jDayInput.value),
    );
    if (!result) {
      w2jErrorEl.textContent =
        '変換できませんでした（明治元年1868年1月25日以降の日付を指定してください）';
      return;
    }

    w2jResultEl.textContent = `${result.era.name}${formatEraYear(result.eraYear)}`;
  }

  w2jYearInput.addEventListener('input', renderWesternToWareki);
  w2jMonthInput.addEventListener('input', renderWesternToWareki);
  w2jDayInput.addEventListener('input', renderWesternToWareki);

  const j2wEraSelect = document.getElementById(
    'era-j2w-era',
  ) as HTMLSelectElement;
  const j2wYearInput = document.getElementById(
    'era-j2w-year',
  ) as HTMLInputElement;
  const j2wMonthInput = document.getElementById(
    'era-j2w-month',
  ) as HTMLInputElement;
  const j2wDayInput = document.getElementById(
    'era-j2w-day',
  ) as HTMLInputElement;
  const j2wErrorEl = document.getElementById('era-j2w-error')!;
  const j2wResultEl = document.getElementById('era-j2w-result')!;

  function renderWarekiToWestern() {
    j2wErrorEl.textContent = '';
    j2wResultEl.textContent = '';

    if (
      j2wYearInput.value === '' ||
      j2wMonthInput.value === '' ||
      j2wDayInput.value === ''
    ) {
      return;
    }

    const year = warekiToWestern(
      j2wEraSelect.value,
      Number(j2wYearInput.value),
      Number(j2wMonthInput.value),
      Number(j2wDayInput.value),
    );
    if (year === null) {
      j2wErrorEl.textContent =
        '変換できませんでした（存在しない日付か、その元号の期間外の日付です）';
      return;
    }

    j2wResultEl.textContent = `西暦${year}年${j2wMonthInput.value}月${j2wDayInput.value}日`;
  }

  j2wEraSelect.addEventListener('change', renderWarekiToWestern);
  j2wYearInput.addEventListener('input', renderWarekiToWestern);
  j2wMonthInput.addEventListener('input', renderWarekiToWestern);
  j2wDayInput.addEventListener('input', renderWarekiToWestern);

  const today = new Date();
  w2jYearInput.value = String(today.getFullYear());
  w2jMonthInput.value = String(today.getMonth() + 1);
  w2jDayInput.value = String(today.getDate());
  renderWesternToWareki();

  const todayWareki = westernToWareki(
    today.getFullYear(),
    today.getMonth() + 1,
    today.getDate(),
  );
  if (todayWareki) {
    j2wEraSelect.value = todayWareki.era.name;
    j2wYearInput.value = String(todayWareki.eraYear);
    j2wMonthInput.value = String(today.getMonth() + 1);
    j2wDayInput.value = String(today.getDate());
  }
  renderWarekiToWestern();
</script>
