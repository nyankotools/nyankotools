---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'JSON',
    description:
      'JavaScript Object Notation の略で、データをキーと値の組み合わせで表現するテキスト形式です。APIのやり取りや設定ファイルなど、幅広い場面で使われています。',
  },
  {
    term: '構文エラー（シンタックスエラー）',
    description:
      'JSONのルール（括弧・カンマ・引用符の対応など）に違反した記述があるときに発生するエラーです。多くの場合、閉じ忘れた括弧や末尾の余分なカンマが原因です。',
  },
];
---

<Layout
  title="JSON整形"
  description="JSONデータをブラウザ上で整形・圧縮・検証できる無料ツールです。構文エラーの内容も分かりやすく表示します。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">JSON整形・検証ツール</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    JSONを入力すると自動で整形して表示します。構文エラーがある場合はエラー内容を表示します。テキストの文字数を数えたい場合は
    <a
      href="/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      文字数カウント
    </a>
    もあわせてご利用ください。
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <label
      for="json-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      インデント幅
    </label>
    <select
      id="json-formatter-indent"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="2">半角スペース2個</option>
      <option value="4">半角スペース4個</option>
      <option value="tab">タブ</option>
    </select>
    <button
      id="json-formatter-minify-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      圧縮
    </button>
    <button
      id="json-formatter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      コピー
    </button>
    <span
      id="json-formatter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="json-formatter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        入力
      </label>
      <textarea
        id="json-formatter-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={'{"key": "value"}'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="json-formatter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        結果
      </label>
      <textarea
        id="json-formatter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="json-formatter-error"
    hidden
    class="mt-4 max-w-2xl whitespace-pre-line rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import { formatJson, minifyJson } from '../../../lib/tools/json-formatter';

  const input = document.getElementById(
    'json-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'json-formatter-output',
  ) as HTMLTextAreaElement;
  const indentSelect = document.getElementById(
    'json-formatter-indent',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('json-formatter-minify-button')!;
  const copyButton = document.getElementById('json-formatter-copy-button')!;
  const statusEl = document.getElementById('json-formatter-status')!;
  const errorEl = document.getElementById('json-formatter-error')!;

  function getIndent(): number | string {
    return indentSelect.value === 'tab' ? '\t' : Number(indentSelect.value);
  }

  function explainJsonErrorJa(message: string): string {
    if (/Unexpected end of (JSON input|input)/.test(message)) {
      return '（内容: 入力が途中で終わっています。閉じ括弧（} や ]）や引用符の閉じ忘れがないか確認してください。）';
    }
    if (/Unexpected non-whitespace character/.test(message)) {
      return '（内容: JSONの末尾に余分な文字があります。閉じ括弧の後ろに不要な文字が入っていないか確認してください。）';
    }
    if (/Expected double-quoted property name/.test(message)) {
      return '（内容: プロパティ名はダブルクォート(")で囲む必要があります。）';
    }
    if (/Unterminated string/.test(message)) {
      return '（内容: 文字列が閉じられていません。引用符(")の閉じ忘れがないか確認してください。）';
    }
    if (/Bad control character/.test(message)) {
      return '（内容: 文字列内に使用できない制御文字が含まれています。）';
    }
    if (/Unexpected token/.test(message)) {
      return '（内容: 予期しない記号があります。末尾の余分なカンマや、括弧・引用符の閉じ忘れがないか確認してください。）';
    }
    return '（内容: JSONの構文に誤りがあります。カンマ・括弧・引用符の対応を確認してください。）';
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `構文エラー: ${message}\n${explainJsonErrorJa(message)}`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function format() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = formatJson(input.value, getIndent());
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  function minify() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const result = minifyJson(input.value);
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  input.addEventListener('input', format);
  indentSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'コピーしました';
    } catch {
      statusEl.textContent = 'コピーに失敗しました';
    }
  });

  format();
</script>
