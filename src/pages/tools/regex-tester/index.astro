---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: '正規表現（Regular Expression）',
    description:
      '文字列のパターンを表現するための記法です。「数字が1文字以上連続する箇所」「@を含むメールアドレスらしき文字列」のような条件を、`\\d+` や `[\\w.]+@[\\w.]+` といった短い記述で表せます。バリデーションや文字列の検索・置換に広く使われます。',
  },
  {
    term: 'フラグ',
    description:
      '正規表現の挙動を切り替えるオプションです。`i` は大文字・小文字を区別しない、`m` は複数行モード（`^` `$` が各行の先頭・末尾にマッチ）、`s` は `.` が改行にもマッチするモード、`u` はUnicodeモード（サロゲートペアや\\u{}記法を正しく扱う）を表します。',
  },
  {
    term: 'キャプチャグループ',
    description:
      'パターンの一部を `(...)` で囲むと、その部分にマッチした文字列を個別に取り出せます。`(\\d+)-(\\d+)` なら1つ目・2つ目の数字の並びをそれぞれ取得できます。`(?<name>...)` の形式で名前を付けたものは「名前付きキャプチャグループ」と呼ばれます。',
  },
  {
    term: '置換パターン',
    description:
      'マッチした文字列を置き換える際に使う書式です。`$1` `$2` でキャプチャグループを、`$<name>` で名前付きキャプチャグループを参照できます。例えば `(\\d+)-(\\d+)` に対して `$2/$1` と指定すると、順序を入れ替えて置換できます。',
  },
];
---

<Layout
  title="正規表現テスター（マッチ確認・置換プレビュー）"
  description="正規表現（Regular Expression）のパターンをブラウザ上でリアルタイムに検証できる無料ツールです。マッチ箇所のハイライト表示、キャプチャグループの一覧、置換結果のプレビューに対応。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">正規表現テスター</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    正規表現のパターンとテスト対象の文字列を入力すると、マッチした箇所をハイライト表示し、キャプチャグループの内容も一覧で確認できます。置換パターンを指定すれば、置換後の結果もその場でプレビューできます。JavaScript（ECMAScript）の正規表現構文に対応しています。文字列そのものの変換であれば
    <a
      href="/tools/html-escape/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      HTML/JS文字列エスケープ・アンエスケープ
    </a>
    もあわせてご利用ください。
  </p>

  <div>
    <label
      for="regex-pattern-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      正規表現パターン
    </label>
    <div class="flex items-center gap-1 font-mono text-sm">
      <span class="text-gray-400 dark:text-gray-500">/</span>
      <input
        id="regex-pattern-input"
        type="text"
        class="w-full rounded-lg border border-gray-300 p-3 focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="\d+"
        spellcheck="false"
        autocomplete="off"
      />
      <span id="regex-flags-label" class="text-gray-400 dark:text-gray-500">
        /g
      </span>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-i" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        i（大文字・小文字を区別しない）
      </span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-m" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        m（複数行モード：^ $ が各行の先頭・末尾にマッチ）
      </span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-s" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        s（. が改行にもマッチ）
      </span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="regex-flag-u" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">u（Unicodeモード）</span>
    </label>
  </div>
  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
    ※ すべてのマッチ箇所を表示するため、g（グローバル検索）は常に有効です。
  </p>

  <div class="mt-4">
    <label
      for="regex-test-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      テスト対象の文字列
    </label>
    <textarea
      id="regex-test-input"
      class="h-40 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      placeholder="マッチを確認したいテキストを入力"
      spellcheck="false"
    ></textarea>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <span
      id="regex-status"
      class="text-sm font-medium text-gray-700 dark:text-gray-300"
      aria-live="polite"
    ></span>
  </div>

  <div
    id="regex-error"
    class="mt-2 hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300"
    role="alert"
  ></div>

  <div class="mt-2">
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      マッチ箇所のハイライト表示
    </p>
    <div
      id="regex-highlight"
      class="min-h-24 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm break-words whitespace-pre-wrap dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    ></div>
  </div>

  <div id="regex-matches-wrapper" class="mt-4 hidden">
    <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
      マッチ結果の一覧
    </p>
    <div class="overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
      <table class="w-full min-w-[520px] text-left text-sm">
        <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          <tr>
            <th class="px-3 py-2 font-medium">#</th>
            <th class="px-3 py-2 font-medium">位置</th>
            <th class="px-3 py-2 font-medium">マッチ文字列</th>
            <th class="px-3 py-2 font-medium">キャプチャグループ</th>
          </tr>
        </thead>
        <tbody
          id="regex-matches-body"
          class="divide-y divide-gray-200 dark:divide-gray-800"
        ></tbody>
      </table>
    </div>
  </div>

  <div class="mt-6">
    <label
      for="regex-replacement-input"
      class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
    >
      置換パターン（任意）
    </label>
    <input
      id="regex-replacement-input"
      type="text"
      class="w-full rounded-lg border border-gray-300 p-3 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
      placeholder="例: $2/$1"
      spellcheck="false"
      autocomplete="off"
    />
  </div>

  <div id="regex-replace-wrapper" class="mt-2 hidden">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm font-medium text-gray-700 dark:text-gray-300">
        置換結果のプレビュー
      </p>
      <div class="flex items-center gap-3">
        <button
          id="regex-replace-copy-button"
          type="button"
          class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
        >
          コピー
        </button>
        <span
          id="regex-replace-copy-status"
          class="text-sm text-green-600 dark:text-green-400"
          aria-live="polite"
        ></span>
      </div>
    </div>
    <textarea
      id="regex-replace-result"
      class="mt-2 h-32 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      readonly
    ></textarea>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意点</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      構文はJavaScript（ECMAScript）の正規表現に準拠します。他言語（PHP・Python・Java等）の正規表現とは一部記法が異なる場合があります。
    </li>
    <li>
      パターンが不正な場合や、危険なバックトラック（破滅的バックトラッキング）を招く複雑なパターンでは、ブラウザが一時的に固まる可能性があります。大きなテキストで試す際はご注意ください。
    </li>
    <li>
      すべての処理はブラウザ内で完結しており、入力したパターンやテキストがサーバーに送信されることはありません。
    </li>
  </ul>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import { escapeHtml } from '../../../lib/tools/html-escape';
  import {
    replaceWithRegex,
    testRegex,
    type RegexMatchResult,
  } from '../../../lib/tools/regex-tester';

  const patternInput = document.getElementById(
    'regex-pattern-input',
  ) as HTMLInputElement;
  const flagsLabel = document.getElementById('regex-flags-label')!;
  const flagI = document.getElementById('regex-flag-i') as HTMLInputElement;
  const flagM = document.getElementById('regex-flag-m') as HTMLInputElement;
  const flagS = document.getElementById('regex-flag-s') as HTMLInputElement;
  const flagU = document.getElementById('regex-flag-u') as HTMLInputElement;
  const testInput = document.getElementById(
    'regex-test-input',
  ) as HTMLTextAreaElement;
  const statusEl = document.getElementById('regex-status')!;
  const errorEl = document.getElementById('regex-error')!;
  const highlightEl = document.getElementById('regex-highlight')!;
  const matchesWrapper = document.getElementById('regex-matches-wrapper')!;
  const matchesBody = document.getElementById('regex-matches-body')!;
  const replacementInput = document.getElementById(
    'regex-replacement-input',
  ) as HTMLInputElement;
  const replaceWrapper = document.getElementById('regex-replace-wrapper')!;
  const replaceResult = document.getElementById(
    'regex-replace-result',
  ) as HTMLTextAreaElement;
  const replaceCopyButton = document.getElementById(
    'regex-replace-copy-button',
  ) as HTMLButtonElement;
  const replaceCopyStatus = document.getElementById(
    'regex-replace-copy-status',
  )!;

  function currentFlags(): string {
    let flags = 'g';
    if (flagI.checked) flags += 'i';
    if (flagM.checked) flags += 'm';
    if (flagS.checked) flags += 's';
    if (flagU.checked) flags += 'u';
    return flags;
  }

  function formatGroups(match: RegexMatchResult): string {
    if (match.groups.length === 0) return '-';
    return match.groups
      .map((g, i) => {
        const label = g.name ?? String(i + 1);
        const value = g.value === undefined ? '(なし)' : g.value;
        return `${label}: ${value}`;
      })
      .join(', ');
  }

  function render() {
    flagsLabel.textContent = `/${currentFlags()}`;
    replaceCopyStatus.textContent = '';

    const pattern = patternInput.value;
    const flags = currentFlags();
    const text = testInput.value;
    const result = testRegex(pattern, flags, text);

    if (!result.isValid) {
      errorEl.textContent = `正規表現が不正です: ${result.error}`;
      errorEl.classList.remove('hidden');
      statusEl.textContent = '';
      highlightEl.textContent = text;
      matchesWrapper.classList.add('hidden');
      replaceWrapper.classList.add('hidden');
      return;
    }
    errorEl.classList.add('hidden');

    if (pattern === '') {
      statusEl.textContent = '';
      highlightEl.textContent = text;
      matchesWrapper.classList.add('hidden');
      replaceWrapper.classList.add('hidden');
      return;
    }

    statusEl.textContent = `${result.matches.length}件マッチしました。`;

    let html = '';
    let lastIndex = 0;
    for (const match of result.matches) {
      html += escapeHtml(text.slice(lastIndex, match.index));
      html += `<mark class="rounded bg-yellow-200 px-0.5 dark:bg-yellow-600 dark:text-gray-900">${escapeHtml(
        match.match,
      )}</mark>`;
      lastIndex = match.index + match.match.length;
    }
    html += escapeHtml(text.slice(lastIndex));
    highlightEl.innerHTML = html || '&nbsp;';

    if (result.matches.length === 0) {
      matchesWrapper.classList.add('hidden');
    } else {
      matchesBody.innerHTML = result.matches
        .map(
          (match, i) => `<tr>
            <td class="px-3 py-2">${i + 1}</td>
            <td class="px-3 py-2">${match.index}</td>
            <td class="px-3 py-2 font-mono">${escapeHtml(match.match)}</td>
            <td class="px-3 py-2 font-mono text-xs">${escapeHtml(formatGroups(match))}</td>
          </tr>`,
        )
        .join('');
      matchesWrapper.classList.remove('hidden');
    }

    if (replacementInput.value === '') {
      replaceWrapper.classList.add('hidden');
    } else {
      const replaced = replaceWithRegex(
        pattern,
        flags,
        text,
        replacementInput.value,
      );
      replaceResult.value = replaced.error ? text : replaced.result;
      replaceWrapper.classList.remove('hidden');
    }
  }

  patternInput.addEventListener('input', render);
  testInput.addEventListener('input', render);
  replacementInput.addEventListener('input', render);
  for (const flag of [flagI, flagM, flagS, flagU]) {
    flag.addEventListener('change', render);
  }

  replaceCopyButton.addEventListener('click', async () => {
    if (!replaceResult.value) return;
    try {
      await navigator.clipboard.writeText(replaceResult.value);
      replaceCopyStatus.textContent = 'コピーしました';
    } catch {
      replaceCopyStatus.textContent = 'コピーに失敗しました';
    }
  });

  render();
</script>
