---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: 'SQL方言（dialect）',
    description:
      'MySQL・PostgreSQL・SQLiteなど、データベース製品ごとに存在する構文・記法の違いのことです。識別子の引用符（`や"）などが方言によって異なるため、整形時に指定すると崩れにくくなります。',
  },
  {
    term: 'ミニファイ',
    description:
      '改行・インデント・コメントを取り除き、SQLを1行の最小限の空白だけで表現することです。ログやコードへの埋め込みなど、行数を減らしたい場面で使います。',
  },
  {
    term: 'キーワードの大文字/小文字',
    description:
      'SELECT・FROM・WHEREなどのSQL予約語を大文字・小文字・入力したまま（そのまま）のどれで表示するかの設定です。',
  },
];
---

<Layout
  title="SQL整形"
  description="SQLクエリをブラウザ上で整形・ミニファイ（圧縮）できる無料ツールです。MySQL・PostgreSQL・SQLite・BigQuery等の方言、インデント幅、キーワードの大文字/小文字に対応。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">SQL整形・ミニファイツール</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    SQLクエリを入力すると自動で読みやすく整形して表示します。方言・インデント幅・キーワードの大文字/小文字を指定可能。1行に圧縮したい場合は「ミニファイ」ボタンを使ってください。整形結果をさらにJSONとして確認したい場合は
    <a
      href="/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON整形
    </a>
    もあわせてご利用ください。
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <label
      for="sql-formatter-dialect"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      SQL方言
    </label>
    <select
      id="sql-formatter-dialect"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="sql">標準SQL</option>
      <option value="mysql">MySQL</option>
      <option value="mariadb">MariaDB</option>
      <option value="postgresql">PostgreSQL</option>
      <option value="sqlite">SQLite</option>
      <option value="bigquery">BigQuery</option>
      <option value="transactsql">SQL Server（T-SQL）</option>
      <option value="plsql">Oracle（PL/SQL）</option>
    </select>

    <label
      for="sql-formatter-indent"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      インデント幅
    </label>
    <select
      id="sql-formatter-indent"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="2">半角スペース2個</option>
      <option value="4">半角スペース4個</option>
      <option value="tab">タブ</option>
    </select>

    <label
      for="sql-formatter-keyword-case"
      class="text-sm text-gray-700 dark:text-gray-300"
    >
      キーワード
    </label>
    <select
      id="sql-formatter-keyword-case"
      class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
    >
      <option value="upper">大文字（SELECT）</option>
      <option value="lower">小文字（select）</option>
      <option value="preserve">そのまま</option>
    </select>

    <button
      id="sql-formatter-minify-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      ミニファイ
    </button>
    <button
      id="sql-formatter-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      コピー
    </button>
    <span
      id="sql-formatter-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="sql-formatter-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        入力
      </label>
      <textarea
        id="sql-formatter-input"
        class="h-80 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder={'select id, name from users where age > 20 order by id'}
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="sql-formatter-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        結果
      </label>
      <textarea
        id="sql-formatter-output"
        readonly
        class="h-80 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <p
    id="sql-formatter-error"
    hidden
    class="mt-4 max-w-2xl whitespace-pre-line rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-400"
  ></p>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import {
    formatSqlQuery,
    minifySqlQuery,
    type SqlDialect,
    type SqlKeywordCase,
  } from '../../../lib/tools/sql-formatter';

  const input = document.getElementById(
    'sql-formatter-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'sql-formatter-output',
  ) as HTMLTextAreaElement;
  const dialectSelect = document.getElementById(
    'sql-formatter-dialect',
  ) as HTMLSelectElement;
  const indentSelect = document.getElementById(
    'sql-formatter-indent',
  ) as HTMLSelectElement;
  const keywordCaseSelect = document.getElementById(
    'sql-formatter-keyword-case',
  ) as HTMLSelectElement;
  const minifyButton = document.getElementById('sql-formatter-minify-button')!;
  const copyButton = document.getElementById('sql-formatter-copy-button')!;
  const statusEl = document.getElementById('sql-formatter-status')!;
  const errorEl = document.getElementById('sql-formatter-error')!;

  function getIndentOptions(): { tabWidth: number; useTabs: boolean } {
    if (indentSelect.value === 'tab') {
      return { tabWidth: 2, useTabs: true };
    }
    return { tabWidth: Number(indentSelect.value), useTabs: false };
  }

  function showError(message: string) {
    output.value = '';
    errorEl.textContent = `構文エラー: ${message}\n（内容: SQLの構文に誤りがあります。括弧・引用符の対応や、選択したSQL方言が入力内容に合っているかを確認してください。）`;
    errorEl.hidden = false;
  }

  function showOutput(value: string) {
    output.value = value;
    errorEl.hidden = true;
    errorEl.textContent = '';
  }

  function format() {
    statusEl.textContent = '';
    if (input.value.trim() === '') {
      showOutput('');
      return;
    }
    const { tabWidth, useTabs } = getIndentOptions();
    const result = formatSqlQuery(input.value, {
      dialect: dialectSelect.value as SqlDialect,
      tabWidth,
      useTabs,
      keywordCase: keywordCaseSelect.value as SqlKeywordCase,
    });
    if (result.success) {
      showOutput(result.output);
    } else {
      showError(result.message);
    }
  }

  function minify() {
    statusEl.textContent = '';
    showOutput(minifySqlQuery(input.value, dialectSelect.value as SqlDialect));
  }

  input.addEventListener('input', format);
  dialectSelect.addEventListener('change', format);
  indentSelect.addEventListener('change', format);
  keywordCaseSelect.addEventListener('change', format);
  minifyButton.addEventListener('click', minify);

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'コピーしました';
    } catch {
      statusEl.textContent = 'コピーに失敗しました';
    }
  });

  format();
</script>
