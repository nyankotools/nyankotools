---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: '税抜金額と税込金額',
    description:
      '税抜金額は消費税を含まない商品・サービスの価格、税込金額は消費税を加えた実際の支払額です。日本では「総額表示」が原則のため、消費者向けの価格表示は税込金額で行うのが基本です。',
  },
  {
    term: '標準税率と軽減税率',
    description:
      '2019年10月から消費税は10%（標準税率）ですが、飲食料品（酒類・外食を除く）や新聞などは8%の軽減税率が適用されます。同じ店舗でもテイクアウトは8%、店内飲食は10%になるなど対象の判定には注意が必要です。',
  },
  {
    term: '消費税額の端数処理',
    description:
      '消費税額に小数点以下の端数が出た場合の処理方法（切り捨て・四捨五入・切り上げ）は、法律上どの方式でも認められており、事業者が選択できます。レシートの表示額と本ツールの計算結果が数円ずれる場合は、採用している端数処理方式の違いによるものです。',
  },
];
---

<Layout
  title="消費税・割引計算機（税込/税抜換算・セール価格計算）"
  description="消費税の税込/税抜金額を相互に変換し、割引率や割引額からセール後の価格も計算できる無料ツールです。標準税率10%・軽減税率8%・カスタム税率に対応し、端数処理方式も選択できます。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">消費税・割引計算機</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    税抜・税込のどちらかの金額を入力するだけで、消費税額ともう一方の金額を計算します。標準税率（10%）・軽減税率（8%）・カスタム税率を切り替え可能です。あわせて、割引率または割引額からセール後の価格も計算できます。ブラウザ内で処理され、入力内容がサーバーに送信されることはありません。時給・月給から金額を計算したい場合は
    <a
      href="/tools/hourly-wage-calculator/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      時給・日給・月給換算＆残業代計算機
    </a>
    もあわせてご利用ください。
  </p>

  <section class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">1. 税込/税抜金額の計算</h2>

    <div class="mb-3">
      <span
        id="tax-calc-mode-label"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        入力する金額
      </span>
      <div
        class="flex flex-wrap gap-3"
        role="radiogroup"
        aria-labelledby="tax-calc-mode-label"
      >
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="tax-calc-mode" value="exclusive" checked />
          税抜金額
        </label>
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="tax-calc-mode" value="inclusive" />
          税込金額
        </label>
      </div>
    </div>

    <div class="mb-3">
      <span
        id="tax-calc-rate-label"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        税率
      </span>
      <div
        class="flex flex-wrap items-center gap-3"
        role="radiogroup"
        aria-labelledby="tax-calc-rate-label"
      >
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="tax-calc-rate" value="10" checked />
          標準税率（10%）
        </label>
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="tax-calc-rate" value="8" />
          軽減税率（8%）
        </label>
        <label class="flex items-center gap-1 text-sm">
          <input type="radio" name="tax-calc-rate" value="custom" />
          カスタム
        </label>
        <input
          id="tax-calc-rate-custom"
          type="number"
          inputmode="decimal"
          min="0"
          step="0.1"
          placeholder="例: 5"
          disabled
          class="h-9 w-20 rounded-lg border border-gray-300 px-2 text-sm focus:border-blue-400 focus:outline-none disabled:opacity-50 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
        />
        <span class="text-sm text-gray-600 dark:text-gray-400">%</span>
      </div>
    </div>

    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label
          for="tax-calc-amount"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          金額（円）
        </label>
        <input
          id="tax-calc-amount"
          type="number"
          inputmode="decimal"
          min="0"
          placeholder="1000"
          class="h-11 w-32 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <span
          id="tax-calc-rounding-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          消費税額の端数処理
        </span>
        <div
          class="flex flex-wrap gap-3"
          role="radiogroup"
          aria-labelledby="tax-calc-rounding-label"
        >
          <label class="flex items-center gap-1 text-sm">
            <input
              type="radio"
              name="tax-calc-rounding"
              value="floor"
              checked
            />
            切り捨て
          </label>
          <label class="flex items-center gap-1 text-sm">
            <input type="radio" name="tax-calc-rounding" value="round" />
            四捨五入
          </label>
          <label class="flex items-center gap-1 text-sm">
            <input type="radio" name="tax-calc-rounding" value="ceil" />
            切り上げ
          </label>
        </div>
      </div>
    </div>

    <p
      id="tax-calc-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <dl
      id="tax-calc-results"
      class="mt-4 hidden grid grid-cols-1 gap-3 sm:grid-cols-3"
      aria-live="polite"
    >
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">税抜金額</dt>
        <dd class="text-lg font-semibold" id="tax-calc-result-excluded"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">消費税額</dt>
        <dd class="text-lg font-semibold" id="tax-calc-result-tax"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">税込金額</dt>
        <dd class="text-lg font-semibold" id="tax-calc-result-included"></dd>
      </div>
    </dl>
  </section>

  <section class="mt-6 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
    <h2 class="mb-3 text-lg font-bold">2. 割引後の価格計算</h2>

    <div class="mb-3 flex flex-wrap items-end gap-3">
      <div>
        <label
          for="discount-calc-original"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          元の価格（円）
        </label>
        <input
          id="discount-calc-original"
          type="number"
          inputmode="decimal"
          min="0"
          placeholder="5000"
          class="h-11 w-32 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <span
          id="discount-calc-type-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          割引の指定方法
        </span>
        <div
          class="flex flex-wrap gap-3"
          role="radiogroup"
          aria-labelledby="discount-calc-type-label"
        >
          <label class="flex items-center gap-1 text-sm">
            <input
              type="radio"
              name="discount-calc-type"
              value="percent"
              checked
            />
            割引率（%）
          </label>
          <label class="flex items-center gap-1 text-sm">
            <input type="radio" name="discount-calc-type" value="amount" />
            割引額（円）
          </label>
        </div>
      </div>
      <div>
        <label
          for="discount-calc-value"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          割引の値
        </label>
        <input
          id="discount-calc-value"
          type="number"
          inputmode="decimal"
          min="0"
          placeholder="20"
          class="h-11 w-32 rounded-lg border border-gray-300 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        />
      </div>
      <div>
        <span
          id="discount-calc-rounding-label"
          class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
        >
          割引額の端数処理
        </span>
        <div
          class="flex flex-wrap gap-3"
          role="radiogroup"
          aria-labelledby="discount-calc-rounding-label"
        >
          <label class="flex items-center gap-1 text-sm">
            <input
              type="radio"
              name="discount-calc-rounding"
              value="floor"
              checked
            />
            切り捨て
          </label>
          <label class="flex items-center gap-1 text-sm">
            <input type="radio" name="discount-calc-rounding" value="round" />
            四捨五入
          </label>
          <label class="flex items-center gap-1 text-sm">
            <input type="radio" name="discount-calc-rounding" value="ceil" />
            切り上げ
          </label>
        </div>
      </div>
    </div>

    <p
      id="discount-calc-error"
      class="mt-2 text-sm text-red-600 dark:text-red-400"
      aria-live="polite"
    ></p>

    <dl
      id="discount-calc-results"
      class="mt-4 hidden grid grid-cols-1 gap-3 sm:grid-cols-3"
      aria-live="polite"
    >
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">割引額</dt>
        <dd class="text-lg font-semibold" id="discount-calc-result-amount"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">割引後の価格</dt>
        <dd class="text-lg font-semibold" id="discount-calc-result-price"></dd>
      </div>
      <div>
        <dt class="text-sm text-gray-600 dark:text-gray-400">割引率</dt>
        <dd class="text-lg font-semibold" id="discount-calc-result-rate"></dd>
      </div>
    </dl>
  </section>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意事項</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      消費税額に小数点以下の端数が出る場合の処理方法（切り捨て・四捨五入・切り上げ）は、実際のレシートや請求書の表示と異なる場合があります。事業者ごとに採用している方式が異なるためです。
    </li>
    <li>
      割引後の価格計算では、割引率・割引額それぞれ単独での計算結果を表示しています。割引後にさらに消費税を加算する場合は、割引後の価格を「1.
      税込/税抜金額の計算」の税抜金額として入力してください。
    </li>
    <li>
      本ツールは概算のシミュレーションであり、実際の税務処理・価格表示の根拠資料としては利用できません。
    </li>
  </ul>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import {
    calculateDiscount,
    calculateTax,
    type DiscountType,
    type RoundingMode,
  } from '../../../lib/tools/tax-calculator';

  const yen = new Intl.NumberFormat('ja-JP', {
    style: 'currency',
    currency: 'JPY',
    maximumFractionDigits: 0,
  });
  const percent = new Intl.NumberFormat('ja-JP', {
    maximumFractionDigits: 2,
  });

  // --- 1. 税込/税抜金額の計算 ---

  const amountInput = document.getElementById(
    'tax-calc-amount',
  ) as HTMLInputElement;
  const modeInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="tax-calc-mode"]',
  );
  const rateInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="tax-calc-rate"]',
  );
  const rateCustomInput = document.getElementById(
    'tax-calc-rate-custom',
  ) as HTMLInputElement;
  const roundingInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="tax-calc-rounding"]',
  );

  const taxErrorEl = document.getElementById('tax-calc-error')!;
  const taxResultsEl = document.getElementById('tax-calc-results')!;
  const resultExcludedEl = document.getElementById('tax-calc-result-excluded')!;
  const resultTaxEl = document.getElementById('tax-calc-result-tax')!;
  const resultIncludedEl = document.getElementById('tax-calc-result-included')!;

  function selectedMode(): boolean {
    return (
      Array.from(modeInputs).find((el) => el.checked)?.value === 'inclusive'
    );
  }

  function selectedTaxRounding(): RoundingMode {
    return (
      (Array.from(roundingInputs).find((el) => el.checked)
        ?.value as RoundingMode) ?? 'floor'
    );
  }

  function selectedTaxRate(): number {
    const selected = Array.from(rateInputs).find((el) => el.checked);
    if (selected?.value === 'custom') return Number(rateCustomInput.value);
    return Number(selected?.value ?? 10);
  }

  function renderTax() {
    taxErrorEl.textContent = '';
    taxResultsEl.classList.add('hidden');

    if (amountInput.value.trim() === '') return;

    const result = calculateTax({
      amount: Number(amountInput.value),
      taxRatePercent: selectedTaxRate(),
      priceIncludesTax: selectedMode(),
      rounding: selectedTaxRounding(),
    });

    if (result === null) {
      taxErrorEl.textContent =
        '計算できませんでした（金額・税率は0以上の値を入力してください）';
      return;
    }

    resultExcludedEl.textContent = yen.format(result.taxExcludedAmount);
    resultTaxEl.textContent = yen.format(result.taxAmount);
    resultIncludedEl.textContent = yen.format(result.taxIncludedAmount);
    taxResultsEl.classList.remove('hidden');
  }

  amountInput.addEventListener('input', renderTax);
  rateCustomInput.addEventListener('input', renderTax);
  modeInputs.forEach((el) => el.addEventListener('change', renderTax));
  roundingInputs.forEach((el) => el.addEventListener('change', renderTax));
  rateInputs.forEach((el) =>
    el.addEventListener('change', () => {
      rateCustomInput.disabled =
        Array.from(rateInputs).find((r) => r.checked)?.value !== 'custom';
      renderTax();
    }),
  );

  // --- 2. 割引後の価格計算 ---

  const originalInput = document.getElementById(
    'discount-calc-original',
  ) as HTMLInputElement;
  const discountTypeInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="discount-calc-type"]',
  );
  const discountValueInput = document.getElementById(
    'discount-calc-value',
  ) as HTMLInputElement;
  const discountValueLabel = document.querySelector(
    'label[for="discount-calc-value"]',
  )!;
  const discountRoundingInputs = document.querySelectorAll<HTMLInputElement>(
    'input[name="discount-calc-rounding"]',
  );

  const discountErrorEl = document.getElementById('discount-calc-error')!;
  const discountResultsEl = document.getElementById('discount-calc-results')!;
  const resultDiscountAmountEl = document.getElementById(
    'discount-calc-result-amount',
  )!;
  const resultDiscountPriceEl = document.getElementById(
    'discount-calc-result-price',
  )!;
  const resultDiscountRateEl = document.getElementById(
    'discount-calc-result-rate',
  )!;

  function selectedDiscountType(): DiscountType {
    return (
      (Array.from(discountTypeInputs).find((el) => el.checked)
        ?.value as DiscountType) ?? 'percent'
    );
  }

  function selectedDiscountRounding(): RoundingMode {
    return (
      (Array.from(discountRoundingInputs).find((el) => el.checked)
        ?.value as RoundingMode) ?? 'floor'
    );
  }

  function renderDiscount() {
    discountErrorEl.textContent = '';
    discountResultsEl.classList.add('hidden');

    if (
      originalInput.value.trim() === '' ||
      discountValueInput.value.trim() === ''
    )
      return;

    const result = calculateDiscount({
      originalPrice: Number(originalInput.value),
      discountType: selectedDiscountType(),
      discountValue: Number(discountValueInput.value),
      rounding: selectedDiscountRounding(),
    });

    if (result === null) {
      discountErrorEl.textContent =
        '計算できませんでした（元の価格は0より大きく、割引率は0〜100%、割引額は元の価格以下で入力してください）';
      return;
    }

    resultDiscountAmountEl.textContent = yen.format(result.discountAmount);
    resultDiscountPriceEl.textContent = yen.format(result.discountedPrice);
    resultDiscountRateEl.textContent = `${percent.format(result.discountRatePercent)}%`;
    discountResultsEl.classList.remove('hidden');
  }

  originalInput.addEventListener('input', renderDiscount);
  discountValueInput.addEventListener('input', renderDiscount);
  discountTypeInputs.forEach((el) =>
    el.addEventListener('change', () => {
      discountValueLabel.textContent =
        selectedDiscountType() === 'percent' ? '割引率（%）' : '割引額（円）';
      renderDiscount();
    }),
  );
  discountRoundingInputs.forEach((el) =>
    el.addEventListener('change', renderDiscount),
  );

  amountInput.value = '1000';
  originalInput.value = '5000';
  discountValueInput.value = '20';
  renderTax();
  renderDiscount();
</script>
