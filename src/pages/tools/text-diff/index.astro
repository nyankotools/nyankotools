---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: '差分（diff）',
    description:
      '2つのテキストを比較し、追加された行・削除された行・変わらない行を洗い出したものです。ソースコードの変更確認や、文章の校正前後の比較などに使われます。',
  },
  {
    term: '行単位の比較',
    description:
      'このツールは1文字ずつではなく、改行で区切った「行」を最小単位として比較します。1行の中の一部だけが変わった場合でも、その行全体が「削除された行」と「追加された行」のペアとして表示されます。',
  },
];
---

<Layout
  title="テキスト差分比較（diff）ツール"
  description="2つのテキストを行単位で比較し、追加・削除された箇所をハイライト表示する無料ツールです。空白や大文字小文字の違いを無視する比較にも対応。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">テキスト差分比較（diff）</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    2つのテキストを行単位で比較し、追加された行を緑、削除された行を赤でハイライト表示します。設定ファイルや文章の変更前後を見比べたいときに便利です。JSONの内容だけを整えたい場合は
    <a
      href="/tools/json-formatter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      JSON整形
    </a>
    もあわせてご利用ください。
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label
        for="diff-input-a"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        テキストA（変更前）
      </label>
      <textarea
        id="diff-input-a"
        class="h-52 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="比較したいテキストを入力"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="diff-input-b"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        テキストB（変更後）
      </label>
      <textarea
        id="diff-input-b"
        class="h-52 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="比較したいテキストを入力"
        spellcheck="false"
      ></textarea>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <label class="flex min-h-11 items-center gap-2">
      <input id="diff-ignore-whitespace" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        行頭・行末の空白の違いを無視する
      </span>
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input id="diff-ignore-case" type="checkbox" class="h-4 w-4" />
      <span class="text-gray-700 dark:text-gray-300">
        大文字・小文字の違いを無視する
      </span>
    </label>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <span
      id="diff-status"
      class="text-sm font-medium text-gray-700 dark:text-gray-300"
      aria-live="polite"
    ></span>
  </div>

  <div class="mt-2 overflow-x-auto rounded-lg border border-gray-300 dark:border-gray-700">
    <table class="w-full min-w-[480px] text-left text-sm">
      <thead class="bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
        <tr>
          <th class="w-12 px-2 py-2 text-right font-medium">A</th>
          <th class="w-12 px-2 py-2 text-right font-medium">B</th>
          <th class="px-3 py-2 font-medium">内容</th>
        </tr>
      </thead>
      <tbody id="diff-body" class="font-mono"></tbody>
    </table>
  </div>

  <h2 class="mt-10 mb-2 text-lg font-bold">注意点</h2>
  <ul class="list-inside list-disc space-y-1 text-sm text-gray-600 dark:text-gray-400">
    <li>
      比較は行単位で行われます。1行の中の一部分だけをハイライトする機能はありません。
    </li>
    <li>
      非常に長いテキスト（数千行以上）を比較すると、ブラウザの処理が重くなる場合があります。
    </li>
    <li>
      すべての処理はブラウザ内で完結しており、入力したテキストがサーバーに送信されることはありません。
    </li>
  </ul>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import { escapeHtml } from '../../../lib/tools/html-escape';
  import {
    diffLines,
    getDiffStats,
    type DiffLine,
  } from '../../../lib/tools/text-diff';

  const inputA = document.getElementById('diff-input-a') as HTMLTextAreaElement;
  const inputB = document.getElementById('diff-input-b') as HTMLTextAreaElement;
  const ignoreWhitespace = document.getElementById(
    'diff-ignore-whitespace',
  ) as HTMLInputElement;
  const ignoreCase = document.getElementById(
    'diff-ignore-case',
  ) as HTMLInputElement;
  const statusEl = document.getElementById('diff-status')!;
  const bodyEl = document.getElementById('diff-body')!;

  const rowClass: Record<DiffLine['type'], string> = {
    equal: '',
    added: 'bg-green-50 dark:bg-green-950 text-green-800 dark:text-green-300',
    removed: 'bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300',
  };
  const prefix: Record<DiffLine['type'], string> = {
    equal: ' ',
    added: '+',
    removed: '-',
  };

  function render() {
    const lines = diffLines(inputA.value, inputB.value, {
      ignoreWhitespace: ignoreWhitespace.checked,
      ignoreCase: ignoreCase.checked,
    });
    const stats = getDiffStats(lines);
    statusEl.textContent = `追加: ${stats.added}行 / 削除: ${stats.removed}行 / 変更なし: ${stats.equal}行`;

    bodyEl.innerHTML = lines
      .map((line) => {
        const leftLabel = line.leftLine ?? '';
        const rightLabel = line.rightLine ?? '';
        const text = escapeHtml(line.text) || '&nbsp;';
        return `<tr class="${rowClass[line.type]}">
          <td class="w-12 px-2 py-0.5 text-right text-gray-400 dark:text-gray-600 select-none">${leftLabel}</td>
          <td class="w-12 px-2 py-0.5 text-right text-gray-400 dark:text-gray-600 select-none">${rightLabel}</td>
          <td class="px-3 py-0.5 whitespace-pre-wrap"><span class="mr-1 select-none">${prefix[line.type]}</span>${text}</td>
        </tr>`;
      })
      .join('');
  }

  inputA.addEventListener('input', render);
  inputB.addEventListener('input', render);
  ignoreWhitespace.addEventListener('change', render);
  ignoreCase.addEventListener('change', render);

  render();
</script>
