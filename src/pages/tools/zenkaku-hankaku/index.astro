---
import Glossary from '../../../components/Glossary.astro';
import Layout from '../../../layouts/Layout.astro';

const glossaryTerms = [
  {
    term: '全角・半角',
    description:
      '全角文字は日本語の文字幅（正方形）で表示される文字、半角文字はその半分の幅で表示される文字です。同じ「A」でも「Ａ」（全角）と「A」（半角）はコンピューター上では別の文字として扱われ、検索やプログラムの動作に影響することがあります。',
  },
  {
    term: '半角カタカナ',
    description:
      'JIS X 0201で定義された、半角幅で表示されるカタカナです。濁点・半濁点は「ﾞ」「ﾟ」として別の文字になるため、変換時は直前の文字と組み合わせて1文字の全角カタカナに変換されます。',
  },
];
---

<Layout
  title="全角/半角変換"
  description="英数字・記号・カタカナ・スペースを対象に、全角と半角を相互に変換できる無料ツールです。変換したい文字種を個別に選択可能。データはブラウザ内で処理され、サーバーには送信されません。"
>
  <h1 class="mb-2 text-2xl font-bold">全角/半角変換</h1>
  <p class="mb-6 text-gray-600 dark:text-gray-400">
    テキストを入力すると、選択した文字種（英数字・記号・カタカナ・スペース）を全角⇔半角に変換します。フォーム入力の表記ゆれ統一や、半角カタカナが混在したデータの正規化などにご利用いただけます。変換後の文字数を確認したい場合は
    <a
      href="/tools/char-counter/"
      class="text-blue-700 underline hover:no-underline dark:text-blue-400"
    >
      文字数カウント
    </a>
    もあわせてご利用ください。
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <div
      id="zenkaku-hankaku-mode"
      class="flex rounded-lg border border-gray-300 p-1 text-sm dark:border-gray-700"
      role="group"
      aria-label="変換方向"
    >
      <button
        type="button"
        data-mode="toHalf"
        aria-pressed="true"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        全角→半角
      </button>
      <button
        type="button"
        data-mode="toFull"
        aria-pressed="false"
        class="min-h-9 rounded-md px-3 font-medium text-gray-700 aria-pressed:bg-blue-600 aria-pressed:text-white dark:text-gray-300"
      >
        半角→全角
      </button>
    </div>
    <button
      id="zenkaku-hankaku-copy-button"
      type="button"
      class="min-h-11 rounded-lg border border-gray-300 px-4 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
    >
      コピー
    </button>
    <span
      id="zenkaku-hankaku-status"
      class="text-sm text-green-600 dark:text-green-400"
      aria-live="polite"
    ></span>
  </div>

  <fieldset class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm">
    <legend class="mb-1 w-full text-sm font-medium text-gray-700 dark:text-gray-300">
      変換する文字種
    </legend>
    <label class="flex min-h-11 items-center gap-2">
      <input
        type="checkbox"
        data-option="alphanumeric"
        checked
        class="h-4 w-4"
      />
      英数字
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input type="checkbox" data-option="symbol" checked class="h-4 w-4" />
      記号
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input type="checkbox" data-option="katakana" checked class="h-4 w-4" />
      カタカナ
    </label>
    <label class="flex min-h-11 items-center gap-2">
      <input type="checkbox" data-option="space" checked class="h-4 w-4" />
      スペース
    </label>
  </fieldset>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div>
      <label
        for="zenkaku-hankaku-input"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        入力
      </label>
      <textarea
        id="zenkaku-hankaku-input"
        class="h-64 w-full rounded-lg border border-gray-300 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder-gray-500"
        placeholder="変換したいテキストを入力"
        spellcheck="false"
      ></textarea>
    </div>
    <div>
      <label
        for="zenkaku-hankaku-output"
        class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"
      >
        結果
      </label>
      <textarea
        id="zenkaku-hankaku-output"
        readonly
        class="h-64 w-full rounded-lg border border-gray-300 bg-gray-50 p-4 font-mono text-sm focus:border-blue-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
      ></textarea>
    </div>
  </div>

  <Glossary terms={glossaryTerms} />
</Layout>

<script>
  import {
    convertWidth,
    type ConversionDirection,
    type ConversionOptions,
  } from '../../../lib/tools/zenkaku-hankaku';

  const input = document.getElementById(
    'zenkaku-hankaku-input',
  ) as HTMLTextAreaElement;
  const output = document.getElementById(
    'zenkaku-hankaku-output',
  ) as HTMLTextAreaElement;
  const modeButtons = document.querySelectorAll<HTMLButtonElement>(
    '#zenkaku-hankaku-mode [data-mode]',
  );
  const optionCheckboxes =
    document.querySelectorAll<HTMLInputElement>('[data-option]');
  const copyButton = document.getElementById('zenkaku-hankaku-copy-button')!;
  const statusEl = document.getElementById('zenkaku-hankaku-status')!;

  let direction: ConversionDirection = 'toHalf';

  function getOptions(): ConversionOptions {
    const options: ConversionOptions = {
      alphanumeric: false,
      symbol: false,
      katakana: false,
      space: false,
    };
    optionCheckboxes.forEach((checkbox) => {
      const key = checkbox.dataset.option as keyof ConversionOptions;
      options[key] = checkbox.checked;
    });
    return options;
  }

  function convert() {
    statusEl.textContent = '';
    output.value = convertWidth(input.value, direction, getOptions());
  }

  input.addEventListener('input', convert);
  optionCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', convert);
  });

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      direction = button.dataset.mode as ConversionDirection;
      modeButtons.forEach((b) => {
        b.setAttribute('aria-pressed', String(b === button));
      });
      convert();
    });
  });

  copyButton.addEventListener('click', async () => {
    if (!output.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      statusEl.textContent = 'コピーしました';
    } catch {
      statusEl.textContent = 'コピーに失敗しました';
    }
  });

  convert();
</script>
